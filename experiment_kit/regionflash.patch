+/* key.c — 配置の鍵の比較（§9.11、v0.2.6）。
+ * key: 書き込み時に分かる鍵 X で分類する。X は hash（id のハッシュ。無作為な分割の対照）・size（log2 サイズ）・
+ *   dram（DRAM でのヒット数）・gap（直前 2 回の要求の間隔）・age（最後の要求からの経過時間）・freq（これまでの要求回数）。
+ *   hash 以外は log2 のバケットにし、受け入れの重み（weight=bytes ならバイト、count なら回数）で k 等分した境界で分ける
+ *   （oracle_gdt と同じ規則。鍵どうしで境界の作り方をそろえ、鍵の情報だけを比べる）。履歴のない物は最後のバケット。
+ *   q=f1,f2,… を与えると等分の代わりに累積の重みの割合 f で切る（分位点）。thr=v1,v2,… を与えると鍵の生の値
+ *   （size: バイト、dram: DRAM ヒット数 + 1、freq: 要求回数、gap・age: 要求数）を固定の閾値で切る（fixed と同じく区間 (v_{i−1}, v_i]。v を超えると上の分類。k = 閾値の数 + 1）。
+ *   sizefreq はサイズと要求回数を別々に同じ規則で k ÷ kf 個・kf 個に分け、その組（サイズの分類 × kf + 回数の分類）を分類にする
+ *   （回数側は fthr・fq。与えればそれで kf が決まる）。
+ *   gap・age は全要求を on_get で見て、物ごとの直前 2 回の時刻と回数を幽霊表に持つ（サイズが変われば捨てる）。
+ *   回数は fsrc で取り方を選ぶ: ghost（幽霊表の正確な回数）・dram（DRAM 段での参照回数 = DRAM ヒット数 + 1。追加の記憶なし）・
+ *   cms（4 行 8 ビットの Count-Min スケッチ、fmem バイト。fwin 要求ごとに半減）・bloom（2 つの Bloom フィルタ A・B、各 fmem/2 バイト。
+ *   A にあれば B に入れ、なければ A に入れる。B にあれば 2 回以上 = 回数 2、なければ 1。fwin 要求ごとに両方を消す）。
+ *   cms・bloom は (id, サイズ) の組で数える（幽霊表と同じく、サイズが変われば別の物。id だけで数えると、サイズの変わる
+ *   トレースで回数が膨らむ）。
+ * oracle_key: 未来の情報で分ける（E2）。dist（次のアクセスまでの距離）・rate（受け入れから W 要求のあいだの参照回数）・
+ *   dens（rate ÷ サイズ）・live（もう一度参照されるか）・wlive（W のあいだに参照されるか）。境界の規則は key と同じ。
+ *   rate・dens・wlive は 2 パス: 1 パス目（log=PATH）で全要求の (id, サイズ) の混ぜ値の列を書き、2 パス目（events=PATH）で
+ *   物ごとの次の参照の添字の鎖を作り、受け入れの時刻 t と次のアクセスまでの距離 d から t + d を起点に鎖をたどって数える。
+ *   起点の混ぜ値が受け入れた物と一致しなかった数を report の mismatch に書く（0 であること）。
+ * oracle_keyinfo: 分類はしない（常に 0）。受け入れのたびに、各鍵 X と将来の値 Y（次のアクセスまでの距離 d、
+ *   または d × サイズ）の同時度数を数え、相互情報量 I(X; Y)、H(Y)、窓ごとの I のばらつき、k 個の連続した区間に
+ *   まとめたときに保てる割合 I_k / I（最適な区切りを動的計画で求める）を report に書く。未来の情報を使うので oracle_。
+ *   events と W を与えると、率 λ̂ = W のあいだの参照回数（L = log2(回数 + 1)）と正規化した位相 φ = d × (回数 + 1) ÷ W
+ *   （64 倍して log2 のバケット。次のアクセスなしは別のバケット）を作り、I(X; L) と I(X; φ | L) = I(X; L, φ) − I(X; L) を書く。
+ * 分類はサイズの区間ではないので bounds は 0 個、エポックは変えない（oracle_gdt と同じ）。 */
+#include "../util/hashmap.h"
+#include "regionflash_hint.h"
+
+#define NB 64                                         /* X のバケット */
+#define NY 65                                         /* Y のバケット（最後 = 次のアクセスなし） */
+#define NL 16                                         /* 率のバケット */
+#define NP 64                                         /* 位相のバケット（最後 = 次のアクセスなし） */
+#define CAP 4096                                      /* 窓の参照回数の上限（鎖をたどる長さ） */
+enum { X_HASH, X_SIZE, X_DRAM, X_GAP, X_AGE, X_FREQ, X_TIME, NX, X_SF = NX };          /* X_SF は key だけ（oracle_keyinfo は測らない） */
+enum { O_DIST = 16, O_RATE, O_DENS, O_LIVE, O_WLIVE };
+enum { F_GHOST, F_DRAM, F_CMS, F_BLOOM };
+static const char *XN[NX] = {"hash", "size", "dram", "gap", "age", "freq", "time"};
+static const char *ON[] = {"dist", "rate", "dens", "live", "wlive"};
+typedef struct { uint64_t id, last, prev; uint32_t cnt, size; } gh_t;
+struct rf_hint {
+    int info, key, wbytes; uint32_t k; uint64_t recalc, den, n, window, nw;
+    double hb[NB], hb2[NB]; int cut[KMAX_LIMIT], cut2[KMAX_LIMIT]; uint32_t kf;  /* key: 重みと境界（2 は sizefreq の回数側） */
+    double thr[KMAX_LIMIT], fthr[KMAX_LIMIT], q[KMAX_LIMIT], fq[KMAX_LIMIT]; int nthr, nfthr, nq, nfq;
+    hmap_t g; gh_t *gh; uint64_t gn, gcap; int ghost;
+    int fsrc; uint8_t *sk; uint64_t skw, fwin, nacc, fcap, maxn, skipn, seen;  /* 近似の回数（cms: 4 × skw、bloom: 2 × skw バイト） */
+    FILE *log; uint64_t *ev; uint32_t *nxt; uint64_t nev, W, mismatch, walks;   /* oracle の 2 パス */
+    double *jt, *jw, *jr;                             /* info: 度数 [2][NX][NY][NB]（全体・今の窓）、[NX][NL][NP][NB] */
+    double wsum[2][NX], wsq[2][NX]; uint64_t nwin;
+};
+#define JIX(y, x, yy, xx) ((((size_t)(y) * NX + (x)) * NY + (yy)) * NB + (xx))
+#define RIX(x, l, p, b) ((((size_t)(x) * NL + (l)) * NP + (p)) * NB + (b))
+
+static const param_spec_t P_KEY[] = {
+    {"key", P_ENUM, "size", "hash|size|dram|gap|age|freq|sizefreq", "分ける鍵"},
+    {"k", P_UINT, "4", NULL, "分類数（2 以上。thr を与えれば閾値の数 + 1）"},
+    {"kf", P_UINT, "2", NULL, "sizefreq: 回数の分類数（k を割り切ること。fthr・fq を与えればその数 + 1）"},
+    {"weight", P_ENUM, "bytes", "bytes|count", "境界を等分する重み"},
+    {"recalc", P_UINT, "100000", NULL, "境界の再計算の間隔（受け入れ数）"},
+    {"ema_den", P_UINT, "16", NULL, "減衰 v ← v×(ema_den−1)/ema_den"},
+    {"fsrc", P_ENUM, "ghost", "ghost|dram|cms|bloom", "freq・sizefreq: 回数の取り方"},
+    {"fmem", P_BYTES, "16M", NULL, "fsrc=cms・bloom の記憶量"},
+    {"fwin", P_UINT, "10000000", NULL, "fsrc=cms: 半減 / bloom: 消去の間隔（要求数）"},
+    {"fcap", P_UINT, "255", NULL, "fsrc=cms: カウンタの上限（15 = 4 ビット相当）"},
+    {"q", P_LIST, "", NULL, "累積の重みの割合で切る（昇順。例 30%）"},
+    {"fq", P_LIST, "", NULL, "sizefreq の回数側の q"},
+    {"thr", P_LIST, "", NULL, "鍵の生の値の固定の閾値（昇順。K/M/G 可）"},
+    {"fthr", P_LIST, "", NULL, "sizefreq の回数側の thr"}, {NULL}};
+static const param_spec_t P_OKEY[] = {
+    {"key", P_ENUM, "rate", "dist|rate|dens|live|wlive", "分ける将来の値"},
+    {"k", P_UINT, "4", NULL, "分類数（live・wlive は 2）"},
+    {"weight", P_ENUM, "bytes", "bytes|count", "境界を等分する重み"},
+    {"recalc", P_UINT, "100000", NULL, "境界の再計算の間隔（受け入れ数）"},
+    {"ema_den", P_UINT, "16", NULL, "減衰 v ← v×(ema_den−1)/ema_den"},
+    {"W", P_UINT, "0", NULL, "rate・dens・wlive の窓（要求数）"},
+    {"log", P_STRING, "", NULL, "1 パス目: 全要求の列を書くファイル（分類は常に 0）"},
+    {"events", P_STRING, "", NULL, "2 パス目: 1 パス目のファイル"},
+    {"q", P_LIST, "", NULL, "累積の重みの割合で切る（昇順）"}, {NULL}};
+static const param_spec_t P_INFO[] = {
+    {"window", P_UINT, "1000000", NULL, "I のばらつきを測る窓（受け入れ数）"},
+    {"W", P_UINT, "0", NULL, "率の窓（要求数。events と併せて使う）"},
+    {"events", P_STRING, "", NULL, "oracle_key:log= で書いた全要求の列"},
+    {"maxn", P_UINT, "0", NULL, "測る受け入れの数の上限（0 = 無制限）"},
+    {"skipn", P_UINT, "0", NULL, "測り始める前に読み飛ばす受け入れの数"},
+    {"fsrc", P_ENUM, "ghost", "ghost|dram|cms|bloom", "freq 列の回数の取り方"},
+    {"fmem", P_BYTES, "16M", NULL, "fsrc=cms・bloom の記憶量"},
+    {"fwin", P_UINT, "10000000", NULL, "fsrc=cms: 半減 / bloom: 消去の間隔（要求数）"},
+    {"fcap", P_UINT, "255", NULL, "fsrc=cms: カウンタの上限（15 = 4 ビット相当）"}, {NULL}};
+static const char MAGIC[8] = {'C', 'S', 'A', 'C', 'C', '0', '0', '1'};
+
+/* the ghost table and the event log keep sizes in 32 bits (saturated) */
+static uint32_t sz32(uint64_t s) { return s > UINT32_MAX ? UINT32_MAX : (uint32_t)s; }
+static uint64_t evkey(uint64_t id, uint32_t size) { return splitmix64(id ^ ((uint64_t)size * 0x9E3779B97F4A7C15ULL)); }
+/* 1 パス目の列を読み、物ごとに次の参照の添字（なし = UINT32_MAX）を作る */
+static void load_events(rf_hint_t *h, const char *path) {
+    FILE *f = fopen(path, "rb");
+    char mg[8];
+    if (!f || fread(mg, 1, 8, f) != 8 || memcmp(mg, MAGIC, 8)) die("oracle_key: cannot read event log %s", path);
+    if (fseek(f, 0, SEEK_END)) die("oracle_key: cannot seek %s", path);
+    h->nev = ((uint64_t)ftell(f) - 8) / 8;
+    if (h->nev >= UINT32_MAX) die("oracle_key: too many requests in %s", path);
+    fseek(f, 8, SEEK_SET);
+    h->ev = xmalloc(h->nev * 8 + 8); h->nxt = xmalloc(h->nev * 4 + 4);
+    if (fread(h->ev, 8, h->nev, f) != h->nev) die("oracle_key: short read %s", path);
+    fclose(f);
+    hmap_t m; hm_init(&m, 1 << 20);
+    for (uint64_t i = h->nev; i-- > 0;) {
+        uint64_t *p = hm_get(&m, h->ev[i]);
+        h->nxt[i] = p ? (uint32_t)*p : UINT32_MAX;
+        hm_put(&m, h->ev[i], i);
+    }
+    hm_free(&m);
+}
+/* 受け入れの時刻 t から W 要求のあいだの参照回数（次のアクセスまでの距離 nd を起点にする） */
+static uint64_t wcount(rf_hint_t *h, const rf_hint_ev_t *a) {
+    if (a->next_dist < 0) return 0;
+    uint64_t j = a->t + (uint64_t)a->next_dist, c = 0;
+    if (j >= h->nev) return 0;
+    if (h->ev[j] != evkey(a->id, sz32(a->size))) { h->mismatch++; return 0; }
+    for (uint32_t i = (uint32_t)j; i != UINT32_MAX && i <= a->t + h->W && c < CAP; i = h->nxt[i]) c++;
+    h->walks += c;
+    return c;
+}
+
+static void set_list(const param_vals_t *v, const char *key, double *out, int *n) { *n = pv_list(v, key, out, KMAX_LIMIT - 1); }
+static void common_create(rf_hint_t *h, const param_vals_t *v) {
+    h->k = (uint32_t)pv_int(v, "k"); h->wbytes = !strcmp(pv_str(v, "weight"), "bytes");
+    h->recalc = (uint64_t)pv_int(v, "recalc"); h->den = (uint64_t)pv_int(v, "ema_den");
+    set_list(v, "q", h->q, &h->nq);
+    if (!h->recalc || h->den < 1) die("key: recalc must be > 0 and ema_den >= 1");
+    for (uint32_t j = 0; j < KMAX_LIMIT; j++) h->cut[j] = h->cut2[j] = NB;
+}
+static void sketch_init(rf_hint_t *h, const param_vals_t *v, int usesf) {
+    const char *fs = pv_str(v, "fsrc");
+    h->fsrc = !strcmp(fs, "ghost") ? F_GHOST : !strcmp(fs, "dram") ? F_DRAM : !strcmp(fs, "cms") ? F_CMS : F_BLOOM;
+    h->fwin = (uint64_t)pv_int(v, "fwin"); h->fcap = (uint64_t)pv_int(v, "fcap");
+    if (!h->fcap || h->fcap > 255) die("key: fcap must be in [1, 255]");
+    if (usesf && (h->fsrc == F_CMS || h->fsrc == F_BLOOM)) {
+        uint64_t m = (uint64_t)pv_int(v, "fmem");
+        h->skw = m / (h->fsrc == F_CMS ? 4 : 2);
+        if (h->skw < 64 || !h->fwin) die("key: fmem must be >= 256 bytes and fwin > 0");
+        if (h->fsrc == F_BLOOM) h->skw &= ~7ULL;
+        h->sk = xcalloc(h->fsrc == F_CMS ? 4 : 2, h->skw);
+    }
+}
+static int key_create(rf_hint_t **hp, const param_vals_t *v, const hint_env_t *env) {
+    rf_hint_t *h = xcalloc(1, sizeof(*h));
+    const char *k = pv_str(v, "key");
+    if (!strcmp(k, "sizefreq")) h->key = X_SF; else for (h->key = 0; strcmp(XN[h->key], k); h->key++) {}
+    common_create(h, v);
+    h->kf = (uint32_t)pv_int(v, "kf");
+    set_list(v, "thr", h->thr, &h->nthr); set_list(v, "fthr", h->fthr, &h->nfthr); set_list(v, "fq", h->fq, &h->nfq);
+    if (h->nthr && h->nq) die("key: give thr or q, not both");
+    if (h->key == X_SF) {
+        uint32_t ks = h->nthr ? (uint32_t)h->nthr + 1 : h->nq ? (uint32_t)h->nq + 1 : h->k / (h->kf ? h->kf : 1);
+        if (h->nfthr || h->nfq) h->kf = (uint32_t)(h->nfthr ? h->nfthr : h->nfq) + 1;
+        if (h->nthr || h->nq) h->k = ks * h->kf;
+        if (h->kf < 2 || h->k % h->kf || h->k / h->kf < 2) die("key: sizefreq needs kf >= 2, k divisible by kf and k / kf >= 2");
+    } else if (h->nthr || h->nq) h->k = (uint32_t)(h->nthr ? h->nthr : h->nq) + 1;
+    if (h->nthr && h->key == X_HASH) die("key: hash has no thresholds");
+    if (h->k < 2 || h->k > env->k_max) die("key: k must be in [2, k_max = %u]", env->k_max);
+    int usesf = h->key == X_FREQ || h->key == X_SF;
+    sketch_init(h, v, usesf);
+    h->ghost = h->key == X_GAP || h->key == X_AGE || (usesf && h->fsrc == F_GHOST);
+    if (h->ghost) hm_init(&h->g, 1024);
+    *hp = h;
+    return 0;
+}
+static int okey_create(rf_hint_t **hp, const param_vals_t *v, const hint_env_t *env) {
+    rf_hint_t *h = xcalloc(1, sizeof(*h));
+    const char *k = pv_str(v, "key");
+    for (h->key = 0; strcmp(ON[h->key], k); h->key++) {}
+    h->key += O_DIST;
+    common_create(h, v);
+    if (h->nq) h->k = (uint32_t)h->nq + 1;
+    if (h->key == O_LIVE || h->key == O_WLIVE) h->k = 2;
+    h->W = (uint64_t)pv_int(v, "W");
+    const char *lp = pv_str(v, "log"), *ep = pv_str(v, "events");
+    int need = h->key == O_RATE || h->key == O_DENS || h->key == O_WLIVE;
+    if (*lp) { h->log = fopen(lp, "wb"); if (!h->log || fwrite(MAGIC, 1, 8, h->log) != 8) die("oracle_key: cannot write %s", lp); h->k = 1; }
+    else if (need) {
+        if (!*ep || !h->W) die("oracle_key: key=%s needs events=PATH (from a log= run) and W > 0", k);
+        load_events(h, ep);
+    }
+    if (!h->log && (h->k < 2 || h->k > env->k_max)) die("oracle_key: k must be in [2, k_max = %u]", env->k_max);
+    *hp = h;
+    return 0;
+}
+static int info_create(rf_hint_t **hp, const param_vals_t *v, const hint_env_t *env) {
+    (void)env;
+    rf_hint_t *h = xcalloc(1, sizeof(*h));
+    h->info = 1; h->ghost = 1; h->window = (uint64_t)pv_int(v, "window"); h->W = (uint64_t)pv_int(v, "W");
+    h->maxn = (uint64_t)pv_int(v, "maxn"); h->skipn = (uint64_t)pv_int(v, "skipn");
+    sketch_init(h, v, 1);
+    if (!h->window) die("oracle_keyinfo: window must be > 0");
+    hm_init(&h->g, 1024);
+    h->jt = xcalloc((size_t)2 * NX * NY * NB, 8); h->jw = xcalloc((size_t)2 * NX * NY * NB, 8);
+    const char *ep = pv_str(v, "events");
+    if (*ep) {
+        if (!h->W) die("oracle_keyinfo: events needs W > 0");
+        load_events(h, ep);
+        h->jr = xcalloc((size_t)NX * NL * NP * NB, 8);
+    }
+    *hp = h;
+    return 0;
+}
+static void destroy(rf_hint_t *h) {
+    if (h->ghost) hm_free(&h->g);
+    if (h->log) fclose(h->log);
+    free(h->gh); free(h->jt); free(h->jw); free(h->jr); free(h->sk); free(h->ev); free(h->nxt); free(h);
+}
+
+static uint64_t skh(uint64_t id, int r) { return splitmix64(id + 0x9E3779B97F4A7C15ULL * (uint64_t)(r + 1)); }
+static int bl_has(const rf_hint_t *h, int f, uint64_t id) {
+    const uint8_t *b = h->sk + (size_t)f * h->skw;
+    for (int r = 0; r < 3; r++) { uint64_t x = skh(id, r) % (h->skw * 8); if (!(b[x >> 3] >> (x & 7) & 1)) return 0; }
+    return 1;
+}
+static void bl_put(rf_hint_t *h, int f, uint64_t id) {
+    uint8_t *b = h->sk + (size_t)f * h->skw;
+    for (int r = 0; r < 3; r++) { uint64_t x = skh(id, r) % (h->skw * 8); b[x >> 3] |= (uint8_t)(1u << (x & 7)); }
+}
+static uint32_t cms_get(const rf_hint_t *h, uint64_t id) {
+    uint32_t m = 255;
+    for (int r = 0; r < 4; r++) { uint8_t c = h->sk[(size_t)r * h->skw + skh(id, r) % h->skw]; if (c < m) m = c; }
+    return m;
+}
+/* every request (id and size): the event log, the sketches and the ghost table */
+static void on_get(rf_hint_t *h, const rf_hint_ev_t *ev) {
+    uint64_t t = ev->t, id = ev->id;
+    uint32_t size = sz32(ev->size);
+    if (h->log) { uint64_t e = evkey(id, size); if (fwrite(&e, 8, 1, h->log) != 1) die("oracle_key: write failed"); }
+    if (h->sk) {
+        if (h->fsrc == F_CMS) for (int r = 0; r < 4; r++) { uint8_t *c = &h->sk[(size_t)r * h->skw + skh(evkey(id, size), r) % h->skw]; if (*c < h->fcap) (*c)++; }
+        else bl_put(h, bl_has(h, 0, evkey(id, size)) ? 1 : 0, evkey(id, size));
+        if (++h->nacc % h->fwin == 0) {
+            if (h->fsrc == F_CMS) for (uint64_t i = 0; i < 4 * h->skw; i++) h->sk[i] >>= 1;
+            else memset(h->sk, 0, 2 * h->skw);
+        }
+    }
+    if (!h->ghost) return;
+    uint64_t *p = hm_get(&h->g, id);
+    gh_t *x;
+    if (p) x = &h->gh[*p];
+    else { GROW(h->gh, h->gcap, h->gn + 1); x = &h->gh[h->gn]; *x = (gh_t){id, 0, 0, 0, size}; hm_put(&h->g, id, h->gn++); }
+    if (x->size != size) { x->last = x->prev = 0; x->cnt = 0; x->size = size; }   /* サイズが変われば別の物 */
+    x->prev = x->last; x->last = t + 1; x->cnt++;                                  /* 0 を「なし」に使う */
+}
+static int lg(uint64_t v) { int b = ilog2_u64(v ? v : 1); return b < NB - 1 ? b : NB - 2; }
+static int vb(uint64_t v) { if (v == UINT64_MAX) return NB - 1; int b = v ? 1 + ilog2_u64(v) : 0; return b < NB - 1 ? b : NB - 2; }
+static const gh_t *ghost_of(const rf_hint_t *h, const rf_hint_ev_t *a) {
+    uint64_t *p = hm_get(&h->g, a->id);
+    const gh_t *x = p ? &h->gh[*p] : NULL;
+    return x && x->size == sz32(a->size) && x->last ? x : NULL;
+}
+/* 回数（fsrc による）。0 = 履歴なし */
+static uint64_t fval(const rf_hint_t *h, const rf_hint_ev_t *a) {
+    if (h->fsrc == F_DRAM) return (uint64_t)a->dram_hits + 1;
+    if (h->fsrc == F_CMS) return cms_get(h, evkey(a->id, sz32(a->size)));
+    if (h->fsrc == F_BLOOM) return bl_has(h, 1, evkey(a->id, sz32(a->size))) ? 2 : 1;
+    const gh_t *x = ghost_of(h, a);
+    return x ? x->cnt : 0;
+}
+/* 鍵の生の値（thr と比べる）。履歴のない物は UINT64_MAX */
+static uint64_t rawv(rf_hint_t *h, int key, const rf_hint_ev_t *a) {
+    if (key == X_SIZE) return a->size;
+    if (key == X_DRAM) return (uint64_t)a->dram_hits + 1;
+    if (key == X_FREQ) { uint64_t f = fval(h, a); return f ? f : UINT64_MAX; }
+    if (key >= O_DIST) {
+        if (key == O_DIST) return a->next_dist < 0 ? UINT64_MAX : (uint64_t)a->next_dist;
+        if (key == O_LIVE) return a->next_dist >= 0;
+        uint64_t c = wcount(h, a);
+        return key == O_RATE ? c : key == O_WLIVE ? c > 0 : (c << 40) / (a->size ? a->size : 1);
+    }
+    const gh_t *x = ghost_of(h, a);
+    if (!x) return UINT64_MAX;
+    return key == X_AGE ? a->t + 1 - x->last + 1 : x->prev ? x->last - x->prev + 1 : UINT64_MAX;
+}
+/* 鍵 X のバケット。履歴のない物は最後のバケット NB−1 */
+static int xbucket(rf_hint_t *h, int key, const rf_hint_ev_t *a) {
+    if (key == X_HASH) return (int)(splitmix64(a->id ^ 0x6b65796b6579ULL) >> 58);
+    if (key == X_SIZE) return lg(a->size);
+    if (key == X_DRAM) return lg((uint64_t)a->dram_hits + 1);
+    if (key == X_TIME) return a->t >> 14 < NB - 1 ? (int)(a->t >> 14) : NB - 2;   /* 対照: 位置だけ */
+    if (key >= O_DIST) return vb(rawv(h, key, a));
+    if (key == X_FREQ && h->fsrc != F_GHOST) return lg(fval(h, a));
+    const gh_t *x = ghost_of(h, a);
+    if (!x) return NB - 1;
+    if (key == X_AGE) return lg(a->t + 1 - x->last + 1);
+    if (key == X_FREQ) return lg(x->cnt);
+    return x->prev ? lg(x->last - x->prev + 1) : NB - 1;                            /* X_GAP */
+}
+
+/* 重みの境界。累積の重みの割合が f[j]（q がなければ (j+1)/k の k 等分）に達したバケットで切る。ただし 1 つのバケットに
+ * 重みが集まっても分類が潰れないよう、空でないバケットをどの分類にも 1 つ以上残す（空でないバケットが k 個未満なら、
+ * その数の分類にする）。履歴のない物（最後のバケット）が多い鍵では、それが 1 つの分類になる */
+static void cuts(double *hb, int *cut, uint32_t k, uint64_t den, const double *f, int nf) {
+    int nb[NB], m = 0;
+    double tot = 0, cum = 0;
+    for (int b = 0; b < NB; b++) if (hb[b] > 0) { nb[m++] = b; tot += hb[b]; }
+    if (!(tot > 0)) return;
+    uint32_t j = 0, kk = (uint32_t)m < k ? (uint32_t)m : k;   /* 分類の数（空でないバケットが k 個未満ならその数） */
+    int prev = -1;
+    for (int i = 0; i < m && j + 1 < kk; i++) {
+        cum += hb[nb[i]];
+        int left = m - 1 - i;                                   /* この後に残る空でないバケット */
+        while (j + 1 < kk && i > prev && left >= (int)(kk - 1 - j) &&
+               ((nf ? cum >= tot * f[j] : cum * kk >= tot * (j + 1)) || left == (int)(kk - 1 - j))) {
+            cut[j++] = nb[i]; prev = i;
+        }
+    }
+    while (j + 1 < k) cut[j++] = NB;
+    for (int b = 0; b < NB; b++) hb[b] = hb[b] * (double)(den - 1) / (double)den;
+}
+static void recompute(rf_hint_t *h) {
+    if (h->key != X_SF) { cuts(h->hb, h->cut, h->k, h->den, h->q, h->nq); return; }
+    cuts(h->hb, h->cut, h->k / h->kf, h->den, h->q, h->nq); cuts(h->hb2, h->cut2, h->kf, h->den, h->fq, h->nfq);
+}
+static uint32_t cls_of(const int *cut, uint32_t k, int b) { uint32_t c = 0; while (c + 1 < k && b > cut[c]) c++; return c; }
+static uint32_t cls_thr(const double *thr, int n, uint64_t v) { uint32_t c = 0; while ((int)c < n && (double)v > thr[c]) c++; return c; }
+
+/* 度数 c[ny][NB]（行 = Y）から I(X; Y) と H(Y)（ビット） */
+static double mi_g(const double *c, int ny, double *hy) {
+    double n = 0, px[NB] = {0}, I = 0, H = 0;
+    for (int y = 0; y < ny; y++) for (int x = 0; x < NB; x++) { px[x] += c[y * NB + x]; n += c[y * NB + x]; }
+    if (!(n > 0)) { if (hy) *hy = 0; return 0; }
+    for (int y = 0; y < ny; y++) {
+        double py = 0;
+        for (int x = 0; x < NB; x++) py += c[y * NB + x];
+        if (!(py > 0)) continue;
+        H -= py / n * log2(py / n);
+        for (int x = 0; x < NB; x++) { double v = c[y * NB + x]; if (v > 0) I += v / n * log2(v * n / (px[x] * py)); }
+    }
+    if (hy) *hy = H;
+    return I;
+}
+static double mi(const double *c, double *hy) { return mi_g(c, NY, hy); }
+/* X のバケットを k 個の連続した区間にまとめたときの最大の I（動的計画。O(k · NB² · NY)） */
+static double mi_k(const double *c, int k) {
+    double n = 0, py[NY] = {0}, pre[NY][NB + 1];
+    for (int y = 0; y < NY; y++) { pre[y][0] = 0; for (int x = 0; x < NB; x++) pre[y][x + 1] = pre[y][x] + c[y * NB + x]; py[y] = pre[y][NB]; n += py[y]; }
+    if (!(n > 0)) return 0;
+    double f[NB + 1][NB + 1], dp[KMAX_LIMIT + 1][NB + 1];
+    for (int l = 0; l <= NB; l++) for (int r = l + 1; r <= NB; r++) {          /* 区間 [l, r) の寄与 */
+        double ng = 0, s = 0;
+        for (int y = 0; y < NY; y++) ng += pre[y][r] - pre[y][l];
+        for (int y = 0; y < NY; y++) { double v = pre[y][r] - pre[y][l]; if (v > 0) s += v / n * log2(v * n / (ng * py[y])); }
+        f[l][r] = s;
+    }
+    for (int r = 0; r <= NB; r++) dp[1][r] = r ? f[0][r] : 0;
+    for (int j = 2; j <= k; j++)
+        for (int r = 0; r <= NB; r++) {
+            dp[j][r] = dp[j - 1][r];
+            for (int l = 1; l < r; l++) if (dp[j - 1][l] + f[l][r] > dp[j][r]) dp[j][r] = dp[j - 1][l] + f[l][r];
+        }
+    return dp[k][NB];
+}
+
+static void end_window(rf_hint_t *h) {
+    for (int y = 0; y < 2; y++)
+        for (int x = 0; x < NX; x++) {
+            double I = mi(&h->jw[JIX(y, x, 0, 0)], NULL);
+            h->wsum[y][x] += I; h->wsq[y][x] += I * I;
+        }
+    h->nwin++; memset(h->jw, 0, (size_t)2 * NX * NY * NB * 8); h->nw = 0;
+}
+
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *a) {
+    if (h->info) {
+        if (h->seen++ < h->skipn || (h->maxn && h->n >= h->maxn)) return 0;
+        if (a->next_dist == -2) die("oracle_keyinfo needs next-access information in the trace (oracleGeneral or a next-access column)");
+        uint64_t d = (uint64_t)(a->next_dist > 0 ? a->next_dist : 1);
+        int y0 = a->next_dist == -1 ? NY - 1 : ilog2_u64(d), y1 = a->next_dist == -1 ? NY - 1 : ilog2_u64(d * (uint64_t)(a->size ? a->size : 1));
+        if (y1 > NY - 2) y1 = NY - 2;
+        int l = 0, p = 0;
+        if (h->jr) {
+            uint64_t c = wcount(h, a);
+            l = ilog2_u64(c + 1);
+            if (a->next_dist < 0) p = NP - 1;
+            else { p = vb((uint64_t)a->next_dist * (c + 1) * 64 / h->W); if (p > NP - 2) p = NP - 2; }
+        }
+        for (int x = 0; x < NX; x++) {
+            int b = xbucket(h, x, a);
+            h->jt[JIX(0, x, y0, b)] += 1; h->jw[JIX(0, x, y0, b)] += 1;
+            h->jt[JIX(1, x, y1, b)] += 1; h->jw[JIX(1, x, y1, b)] += 1;
+            if (h->jr) h->jr[RIX(x, l, p, b)] += 1;
+        }
+        h->n++;
+        if (++h->nw >= h->window) end_window(h);
+        return 0;
+    }
+    if (h->log) return 0;
+    if (h->key >= O_DIST && a->next_dist == -2) die("oracle_key needs next-access information in the trace");
+    if (h->key == X_HASH) return (uint32_t)(splitmix64(a->id ^ 0x6b65796b6579ULL) % h->k);
+    double w = h->wbytes ? (double)a->size : 1;
+    if (h->key == X_SF) {
+        uint32_t ks = h->k / h->kf, cs, cf;
+        if (h->nthr) cs = cls_thr(h->thr, h->nthr, a->size);
+        else { int bs = xbucket(h, X_SIZE, a); h->hb[bs] += w; cs = cls_of(h->cut, ks, bs); }
+        if (h->nfthr) cf = cls_thr(h->fthr, h->nfthr, rawv(h, X_FREQ, a));
+        else { int bf = xbucket(h, X_FREQ, a); h->hb2[bf] += w; cf = cls_of(h->cut2, h->kf, bf); }
+        if (++h->n % h->recalc == 0) recompute(h);
+        return cs * h->kf + cf;
+    }
+    if (h->nthr) return cls_thr(h->thr, h->nthr, rawv(h, h->key, a));
+    int b = xbucket(h, h->key, a);
+    h->hb[b] += w;
+    if (++h->n % h->recalc == 0) recompute(h);
+    return cls_of(h->cut, h->k, b);
+}
+static uint32_t epoch(const rf_hint_t *h) { (void)h; return 0; }
+static uint32_t maxc(const rf_hint_t *h) { return h->info ? 1 : h->k; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) { (void)h; (void)out; (void)max; return 0; }
+
+static void put_cuts(FILE *f, const char *name, const int *cut, uint32_t k) {
+    fprintf(f, ", \"%s\": [", name);
+    for (uint32_t j = 0; j + 1 < k; j++) fprintf(f, "%s%d", j ? ", " : "", cut[j]);
+    fputs("]", f);
+}
+static void report(rf_hint_t *h, FILE *f) {
+    if (!h->info) {
+        int sf = h->key == X_SF;
+        uint32_t ks = sf ? h->k / h->kf : h->k;
+        const char *kn = h->key >= O_DIST ? ON[h->key - O_DIST] : sf ? "sizefreq" : XN[h->key];
+        fprintf(f, "{ \"name\": \"%s\", \"key\": \"%s\", \"k\": %u, \"ghost_objs\": %lu, \"sketch_bytes\": %lu",
+                h->key >= O_DIST ? "oracle_key" : "key", kn, h->k, (unsigned long)h->gn,
+                (unsigned long)(h->sk ? h->skw * (h->fsrc == F_CMS ? 4 : 2) : 0));
+        if (h->key >= O_DIST) fprintf(f, ", \"events\": %lu, \"mismatch\": %lu, \"walk_steps\": %lu", (unsigned long)h->nev,
+                                      (unsigned long)h->mismatch, (unsigned long)h->walks);
+        put_cuts(f, "cut", h->cut, h->nthr ? 1 : ks);
+        if (sf) put_cuts(f, "cut_freq", h->cut2, h->nfthr ? 1 : h->kf);
+        fputs(" }", f);
+        return;
+    }
+    if (h->nw) end_window(h);
+    static const char *YN[2] = {"dist", "bytetime"};
+    fprintf(f, "{ \"name\": \"oracle_keyinfo\", \"admissions\": %lu, \"admissions_seen\": %lu, \"windows\": %lu, \"ghost_objs\": %lu, \"freq_src\": %d, \"sketch_bytes\": %lu",
+            (unsigned long)h->n, (unsigned long)h->seen, (unsigned long)h->nwin, (unsigned long)h->gn, h->fsrc,
+            (unsigned long)(h->sk ? h->skw * (h->fsrc == F_CMS ? 4 : 2) : 0));
+    for (int y = 0; y < 2; y++) {
+        double H, I0 = mi(&h->jt[JIX(y, X_HASH, 0, 0)], &H);
+        (void)I0;
+        fprintf(f, ", \"%s\": { \"H\": %.6f", YN[y], H);
+        for (int x = 0; x < NX; x++) {
+            const double *c = &h->jt[JIX(y, x, 0, 0)];
+            double I = mi(c, NULL), m = h->nwin ? h->wsum[y][x] / (double)h->nwin : 0;
+            double sd = h->nwin > 1 ? sqrt(fmax(0, h->wsq[y][x] / (double)h->nwin - m * m)) : 0;
+            fprintf(f, ", \"%s\": { \"I\": %.6f, \"I_over_H\": %.6f, \"win_mean\": %.6f, \"win_sd\": %.6f", XN[x], I, H > 0 ? I / H : 0, m, sd);
+            if (y == 0) {                                 /* X のバケットの度数（どこに集まるか） */
+                fputs(", \"xhist\": [", f);
+                for (int b = 0; b < NB; b++) {
+                    double sb = 0;
+                    for (int yy = 0; yy < NY; yy++) sb += c[yy * NB + b];
+                    fprintf(f, "%s%.0f", b ? "," : "", sb);
+                }
+                fputs("]", f);
+            }
+            if (x != X_HASH) fprintf(f, ", \"I2_over_I\": %.6f, \"I4_over_I\": %.6f", I > 0 ? mi_k(c, 2) / I : 0, I > 0 ? mi_k(c, 4) / I : 0);
+            fputs(" }", f);
+        }
+        fputs(" }", f);
+    }
+    if (h->jr) {                                      /* 率 L と位相 φ への分解 */
+        static double cl[NL * NB];
+        fprintf(f, ", \"rate_phase\": { \"W\": %lu, \"mismatch\": %lu", (unsigned long)h->W, (unsigned long)h->mismatch);
+        for (int x = 0; x < NX; x++) {
+            const double *c = &h->jr[RIX(x, 0, 0, 0)];
+            memset(cl, 0, sizeof cl);
+            for (int l = 0; l < NL; l++) for (int p = 0; p < NP; p++) for (int b = 0; b < NB; b++) cl[l * NB + b] += c[((size_t)l * NP + p) * NB + b];
+            double HL, HLP, IL = mi_g(cl, NL, &HL), ILP = mi_g(c, NL * NP, &HLP);
+            fprintf(f, ", \"%s\": { \"I_L\": %.6f, \"I_LP\": %.6f, \"I_P_given_L\": %.6f, \"H_L\": %.6f, \"H_LP\": %.6f }", XN[x], IL, ILP, ILP - IL, HL, HLP);
+        }
+        fputs(" }", f);
+    }
+    fputs(" }", f);
+}
+
+#define KEY_OPS(NAME, PARAMS, CREATE)                                                       {.name = NAME, .params = PARAMS, .create = CREATE, .destroy = destroy, .on_get = on_get,      .on_insert = on_insert, .epoch = epoch, .bounds = bounds, .max_classes = maxc, .report = report}
+const rf_hint_ops_t rf_hint_key_ops = KEY_OPS("key", P_KEY, key_create);
+const rf_hint_ops_t rf_hint_oracle_key_ops = KEY_OPS("oracle_key", P_OKEY, okey_create);
+const rf_hint_ops_t rf_hint_oracle_keyinfo_ops = KEY_OPS("oracle_keyinfo", P_INFO, info_create);
diff --git a/libCacheSim/cache/eviction/flash/hint/oracle_gdt.c b/libCacheSim/cache/eviction/flash/hint/oracle_gdt.c
new file mode 100644
index 0000000..2bb3a60
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/oracle_gdt.c
@@ -0,0 +1,78 @@
+/* oracle_gdt.c — oracle_gdt（§9.10）: 配置だけで達成できる性能の参照点（SIZE_SEPARATION_THEORY P13）。
+ * 受け入れ時に、次のアクセスまでの距離 d（rf_hint_ev_t.next_dist）で分類する。
+ * metric=bytetime では d × サイズ（次のヒットまでに占める「バイト × 時間」。ヒット密度の逆数）で分類する。
+ *   次のアクセスがないもの → 最後の分類 k−1（one-hit wonder・用済みのバイトの溜まり場）
+ *   あるもの → log2(d) のバケットを、受け入れバイトの重みで k−1 等分した分類 0..k−2（d が短いほど小さい番号）
+ * 等分の境界は recalc 回の受け入れごとに作り直し、ヒストグラムは split_threshold と同じ整数減衰で忘れる。
+ * 分類はサイズの区間ではないので bounds は 0 個（要求の分類別集計は分類 0 にまとまる）。エポックは変えない。 */
+#include "regionflash_hint.h"
+
+#define NB 64
+struct rf_hint {
+  uint32_t k;
+  int bt;
+  uint64_t recalc, den, n;
+  uint64_t hb[NB];
+  int cut[KMAX_LIMIT];
+};
+static const param_spec_t P[] = {
+    {"k", P_UINT, "4", NULL, "分類数（2 以上。最後の 1 つは次のアクセスなし）"},
+    {"metric", P_ENUM, "dist", "dist|bytetime", "分ける量: 次のアクセスまでの距離 / 距離 × サイズ"},
+    {"recalc", P_UINT, "100000", NULL, "境界の再計算の間隔（受け入れ数）"},
+    {"ema_den", P_UINT, "16", NULL, "減衰 v ← v×(ema_den−1)/ema_den"}, {NULL}};
+
+static int create(rf_hint_t **hp, const param_vals_t *v, const hint_env_t *env) {
+  rf_hint_t *h = xcalloc(1, sizeof(*h));
+  h->k = (uint32_t)pv_int(v, "k");
+  h->bt = !strcmp(pv_str(v, "metric"), "bytetime");
+  h->recalc = (uint64_t)pv_int(v, "recalc");
+  h->den = (uint64_t)pv_int(v, "ema_den");
+  if (h->k < 2 || h->k > env->k_max) die("oracle_gdt: k must be in [2, k_max = %u]", env->k_max);
+  if (!h->recalc || h->den < 1) die("oracle_gdt: recalc must be > 0 and ema_den >= 1");
+  for (uint32_t j = 0; j + 1 < h->k; j++) h->cut[j] = NB;  // 境界なし: 次のアクセスがあれば分類 0
+  *hp = h;
+  return 0;
+}
+static void destroy(rf_hint_t *h) { free(h); }
+
+/* バケット b 以下の累積バイトが全体の (j+1)/(k−1) に達する最小の b を、分類 j の上端にする */
+static void recompute(rf_hint_t *h) {
+  uint64_t tot = 0, cum = 0;
+  for (int b = 0; b < NB; b++) tot += h->hb[b];
+  if (!tot) return;
+  uint32_t m = h->k - 1, j = 0;
+  for (int b = 0; b < NB && j + 1 < m; b++) {
+    cum += h->hb[b];
+    while (j + 1 < m && cum * m >= tot * (j + 1)) h->cut[j++] = b;
+  }
+  while (j + 1 < m) h->cut[j++] = NB;
+  for (int b = 0; b < NB; b++) h->hb[b] = h->hb[b] * (h->den - 1) / h->den;
+}
+
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) {
+  if (e->next_dist == -2)
+    die("oracle_gdt needs next-access information in the trace (oracleGeneral or a next-access column)");
+  if (e->next_dist == -1) return h->k - 1;
+  uint64_t key = (uint64_t)(e->next_dist > 0 ? e->next_dist : 1) * (h->bt ? (e->size ? e->size : 1) : 1);
+  int b = ilog2_u64(key);
+  h->hb[b] += e->size;
+  if (++h->n % h->recalc == 0) recompute(h);
+  uint32_t c = 0;
+  while (c + 2 < h->k && b > h->cut[c]) c++;
+  return c;
+}
+static uint32_t epoch(const rf_hint_t *h) {
+  (void)h;
+  return 0;
+}
+static uint32_t max_classes(const rf_hint_t *h) { return h->k; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) {
+  (void)h;
+  (void)out;
+  (void)max;
+  return 0;
+}
+
+const rf_hint_ops_t rf_hint_oracle_gdt_ops = {
+    .name = "oracle_gdt", .params = P, .create = create, .destroy = destroy,
+    .on_insert = on_insert, .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
diff --git a/libCacheSim/cache/eviction/flash/hint/pdens.c b/libCacheSim/cache/eviction/flash/hint/pdens.c
new file mode 100644
index 0000000..f5f181a
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/pdens.c
@@ -0,0 +1,223 @@
+/* pdens.c — 予測したコスト密度で分ける（hint=pdens）。
+ * Region 単位で消すキャッシュの損失は、Region 内の物の密度のばらつきで抑えられる（region_theory.html の定理 1）。
+ * そこで、書く物の密度 ρ = λ × (1 + s* ÷ s) を予測し、分類の中の ρ のばらつきが小さくなるように k 個に分ける
+ * （分類 k−1 が最も密度が高い）。
+ *   λ: 書いてから H 要求のあいだに来る要求の数の期待値（BMR の密度はバイトあたりのバイトヒット = 物の要求率）。
+ *      物の履歴のセル（これまでの要求回数の log2 × 直前 2 回の要求の間隔の log2）ごとに、書いたバイトあたりの
+ *      「H 以内に来た要求のバイト」で推定する（書いた時にセルを覚え、H が過ぎるまで数える。全体の値へ縮める
+ *      事前分布つき、ema_den で減衰）。
+ *   s*: 損益分岐のサイズ c_req ÷ c_byte。0 なら BMR の密度（λ だけ。サイズは分類に効かない）、大きいほど OHR の密度（λ ÷ s）。
+ *   H: 0 なら SSD の平均滞在（on_evict の residence の移動平均。最初の追い出しまでは 100 万要求）。
+ * 境界は recalc 回の書き込みごとに作り直す: (サイズの log2, セル) の組を予測した ρ の順に並べ、書いたバイトでほぼ等しい
+ * 256 群にまとめ、split=dp なら分類の中の ρ の二乗和（Σ W ρ² − (Σ W ρ)² ÷ Σ W）が最小になる k−1 個の切れ目を動的計画法で、
+ * split=eq なら群を k 等分する切れ目を選ぶ（1 つの組は分けないので、等分にならないことがある）。
+ * cells=PATH: 終了時に、実際の SSD 書き込みを（サイズの log2 × 回数の log2 × 間隔の log2）のセルに分け、書き込み数・バイトと、
+ *   書いてから H のあいだに来た要求の数 n のバケット（0, 1, 2–3, 4–7, …）ごとの書き込みバイトを TSV で書く（law.py で読む）。
+ *   k=1 なら分類せずに測るだけ。
+ * 幽霊表は key の gap・freq と同じ作り（サイズが変われば別の物）。 */
+#include "../util/hashmap.h"
+#include "regionflash_hint.h"
+
+#define NKB 16          /* 回数のバケット */
+#define NGB 32          /* 間隔のバケット（0 = 要求 1 回だけ） */
+#define NC (NKB * NGB)  /* セル */
+#define NSB 34          /* サイズのバケット（33 = UINT32_MAX） */
+#define NE (NSB * NC)   /* (サイズ, セル) の組 */
+#define NG 256          /* 境界を選ぶ群 */
+#define NN 18           /* cells の n のバケット */
+
+typedef struct { uint64_t id, last, prev, wt; uint32_t cnt, size, wc, ws, wn; } pd_t;  /* 開いている窓: wc = セル + 1、ws = サイズのバケット、wn = 来た要求 */
+typedef struct { double n, W, b[NN]; } lc_t;
+typedef struct { double rho, w, a, b; int e; } en_t;  /* 予測した ρ、W、W ρ、W ρ²、組の番号 */
+struct rf_hint {
+    uint32_t k; int fixH, eq, usek, useg; double sstar, H, avgw; uint64_t recalc, den, n, nres, windows, rereq, nrecalc;
+    double num[NC], dw[NC], wsc[NE]; uint8_t cls[NE];
+    hmap_t g; pd_t *x; uint64_t xn, xcap;
+    char cpath[256]; lc_t *lc;  /* [NE] */
+    en_t *en;
+};
+static const param_spec_t P_PD[] = {
+    {"k", P_UINT, "4", NULL, "分類数（1 = 分けずに測るだけ）"},
+    {"sstar", P_BYTES, "0", NULL, "損益分岐のサイズ s*（0 = BMR の密度）"},
+    {"H", P_UINT, "0", NULL, "要求を数える窓（要求数。0 = SSD の平均滞在）"},
+    {"recalc", P_UINT, "100000", NULL, "境界の再計算の間隔（書き込み数）"},
+    {"ema_den", P_UINT, "16", NULL, "減衰 v ← v×(ema_den−1)/ema_den"},
+    {"keys", P_ENUM, "kg", "kg|k|g", "履歴のセル: kg = 回数 × 間隔、k = 回数だけ、g = 間隔だけ"},
+    {"split", P_ENUM, "dp", "dp|eq", "境界: dp = 分類内の ρ の二乗和を最小に、eq = 書いたバイトで k 等分"},
+    {"cells", P_STRING, "", NULL, "終了時にセルごとの書き込みと要求の数を書く TSV"}, {NULL}};
+
+static uint32_t sz32(uint64_t s) { return s > UINT32_MAX ? UINT32_MAX : (uint32_t)s; }
+static double rep_size(int sb) { return sb == 33 ? 4294967296.0 : ldexp(1.4142135623730951, sb); }
+static int create(rf_hint_t **hp, const param_vals_t *v, const hint_env_t *env) {
+    rf_hint_t *h = xcalloc(1, sizeof(*h));
+    h->k = (uint32_t)pv_int(v, "k"); h->sstar = (double)pv_int(v, "sstar");
+    h->H = (double)pv_int(v, "H"); h->fixH = h->H > 0; if (!h->fixH) h->H = 1e6;
+    h->recalc = (uint64_t)pv_int(v, "recalc"); h->den = (uint64_t)pv_int(v, "ema_den");
+    h->eq = !strcmp(pv_str(v, "split"), "eq");
+    h->usek = strcmp(pv_str(v, "keys"), "g") != 0; h->useg = strcmp(pv_str(v, "keys"), "k") != 0;
+    if (h->k < 1 || h->k > env->k_max) die("pdens: k must be in [1, k_max = %u]", env->k_max);
+    if (!h->recalc || h->den < 2) die("pdens: recalc must be > 0 and ema_den >= 2");
+    snprintf(h->cpath, sizeof(h->cpath), "%s", pv_str(v, "cells"));
+    if (h->cpath[0]) h->lc = xcalloc(NE, sizeof(lc_t));
+    h->en = xmalloc(NE * sizeof(en_t));
+    hm_init(&h->g, 1024);
+    *hp = h;
+    return 0;
+}
+/* 書き込みの窓を閉じる（cells に数える） */
+static void close_win(rf_hint_t *h, pd_t *x) {
+    if (h->lc) {
+        int b = x->wn ? 1 + ilog2_u64(x->wn) : 0;
+        h->lc[(size_t)x->ws * NC + x->wc - 1].b[b < NN ? b : NN - 1] += x->size ? x->size : 1;
+    }
+    h->windows++;
+    x->wc = 0;
+}
+static void destroy(rf_hint_t *h) {
+    for (uint64_t i = 0; i < h->xn; i++) if (h->x[i].wc) close_win(h, &h->x[i]);
+    FILE *f = h->lc ? fopen(h->cpath, "w") : NULL;
+    if (h->lc && !f) fprintf(stderr, "pdens: cannot write %s\n", h->cpath);
+    if (f) {
+        fputs("sb\tkb\tgb\tn\tW", f);
+        for (int j = 0; j < NN; j++) fprintf(f, "\tB%d", j);
+        fputc('\n', f);
+        for (int e = 0; e < NE; e++) {
+            const lc_t *l = &h->lc[e];
+            if (l->n == 0) continue;
+            fprintf(f, "%d\t%d\t%d\t%.0f\t%.0f", e / NC, e % NC / NGB, e % NGB, l->n, l->W);
+            for (int j = 0; j < NN; j++) fprintf(f, "\t%.0f", l->b[j]);
+            fputc('\n', f);
+        }
+        fclose(f);
+    }
+    hm_free(&h->g); free(h->x); free(h->lc); free(h->en); free(h);
+}
+
+static pd_t *ghost(rf_hint_t *h, uint64_t id, uint32_t size, int add) {
+    uint64_t *p = hm_get(&h->g, id);
+    if (!p && !add) return NULL;
+    pd_t *x;
+    if (p) x = &h->x[*p];
+    else { GROW(h->x, h->xcap, h->xn + 1); x = &h->x[h->xn]; *x = (pd_t){id, 0, 0, 0, 0, size, 0, 0, 0}; hm_put(&h->g, id, h->xn++); }
+    if (x->size != size) {   /* サイズが変われば別の物 */
+        if (!add) return NULL;
+        if (x->wc) close_win(h, x);
+        *x = (pd_t){id, 0, 0, 0, 0, size, 0, 0, 0};
+    }
+    return x;
+}
+static int cell(const rf_hint_t *h, const pd_t *x) {
+    if (!x || !x->cnt) return 0;
+    int kb = h->usek ? ilog2_u64(x->cnt) : 0, gb = h->useg && x->prev ? 1 + ilog2_u64(x->last - x->prev) : 0;
+    return (kb < NKB ? kb : NKB - 1) * NGB + (gb < NGB ? gb : NGB - 1);
+}
+static int cmp_rho(const void *a, const void *b) {
+    const en_t *x = a, *y = b;   /* 同じ ρ は組の番号の順（決定的に） */
+    return x->rho < y->rho ? -1 : x->rho > y->rho ? 1 : (x->e > y->e) - (x->e < y->e);
+}
+/* 境界の作り直しと減衰 */
+static void recompute(rf_hint_t *h) {
+    double tn = 0, td = 0, f = (double)(h->den - 1) / (double)h->den, lam[NC];
+    for (int c = 0; c < NC; c++) { tn += h->num[c]; td += h->dw[c]; }
+    double l0 = td > 0 ? tn / td : 1, m = 16 * h->avgw;
+    for (int c = 0; c < NC; c++) lam[c] = (h->num[c] + m * l0) / (h->dw[c] + m);   /* 全体の値へ縮める */
+    int ne = 0;
+    double tw = 0;
+    for (int e = 0; e < NE; e++) {
+        if (!(h->wsc[e] > 0)) continue;
+        double r = lam[e % NC] * (1 + h->sstar / rep_size(e / NC));
+        h->en[ne++] = (en_t){r, h->wsc[e], h->wsc[e] * r, h->wsc[e] * r * r, e};
+        tw += h->wsc[e];
+    }
+    if (ne > 0 && h->k > 1) {
+        en_t *s = h->en;
+        qsort(s, (size_t)ne, sizeof(en_t), cmp_rho);
+        /* 書いたバイトでほぼ等しい NG 群（群 g は s[gs[g], gs[g+1])）と、その累積 */
+        int gs[NG + 1], ng = 0;
+        double cw[NG + 1] = {0}, ca[NG + 1] = {0}, cb[NG + 1] = {0}, acc = 0;
+        gs[0] = 0;
+        for (int i = 0; i < ne; i++) {
+            acc += s[i].w;
+            if ((acc * NG >= tw * (ng + 1) && (i == ne - 1 || s[i + 1].rho != s[i].rho)) || i == ne - 1) {   /* 同じ ρ の組は分けない */
+                gs[++ng] = i + 1;
+                cw[ng] = cw[ng - 1]; ca[ng] = ca[ng - 1]; cb[ng] = cb[ng - 1];
+                for (int j = gs[ng - 1]; j <= i; j++) cw[ng] += s[j].w, ca[ng] += s[j].a, cb[ng] += s[j].b;
+            }
+        }
+        uint32_t k = h->k < (uint32_t)ng ? h->k : (uint32_t)ng;
+        int cut[KMAX_LIMIT + 1];
+        cut[0] = 0; cut[k] = ng;
+        if (h->eq) {
+            for (uint32_t q = 1; q < k; q++) cut[q] = (int)(q * ng / k);
+        } else {
+            /* 群 [i, j) を 1 つの分類にした二乗和 */
+#define SSE(i, j) ((cb[j] - cb[i]) - ((cw[j] - cw[i]) > 0 ? (ca[j] - ca[i]) * (ca[j] - ca[i]) / (cw[j] - cw[i]) : 0))
+            static double F[KMAX_LIMIT + 1][NG + 1];
+            static int A[KMAX_LIMIT + 1][NG + 1];
+            for (int j = 0; j <= ng; j++) F[1][j] = SSE(0, j), A[1][j] = 0;
+            for (uint32_t q = 2; q <= k; q++)
+                for (int j = q; j <= ng; j++) {
+                    F[q][j] = INFINITY;
+                    for (int i = q - 1; i < j; i++) {
+                        double v = F[q - 1][i] + SSE(i, j);
+                        if (v < F[q][j]) F[q][j] = v, A[q][j] = i;
+                    }
+                }
+#undef SSE
+            for (uint32_t q = k; q > 1; q--) cut[q - 1] = A[q][cut[q]];
+        }
+        for (uint32_t q = 1; q <= k; q++)
+            for (int g = cut[q - 1]; g < cut[q]; g++)
+                for (int i = gs[g]; i < gs[g + 1]; i++) h->cls[s[i].e] = (uint8_t)(q - 1);
+    }
+    for (int c = 0; c < NC; c++) h->num[c] *= f, h->dw[c] *= f;
+    for (int e = 0; e < NE; e++) h->wsc[e] *= f;
+    h->nrecalc++;
+}
+
+/* 要求ごと: 開いている窓に数えるか閉じ、履歴を進める */
+static void on_get(rf_hint_t *h, const rf_hint_ev_t *e) {
+    uint32_t size = sz32(e->size);
+    pd_t *x = ghost(h, e->id, size, 1);
+    if (x->wc) {
+        if ((double)(e->t + 1 - x->wt) <= h->H) { h->num[x->wc - 1] += size; x->wn++; h->rereq++; }
+        else close_win(h, x);
+    }
+    x->prev = x->last; x->last = e->t + 1; x->cnt++;   /* 0 を「なし」に使う */
+}
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) {
+    pd_t *x = ghost(h, e->id, sz32(e->size), 0);
+    int c = cell(h, x), sb = e->size >= UINT32_MAX ? 33 : ilog2_u64(e->size ? e->size : 1), en = sb * NC + c;
+    double s = (double)(e->size ? e->size : 1);
+    h->dw[c] += s;
+    h->wsc[en] += s;
+    h->avgw += (s - h->avgw) / (double)(h->n + 1 < 1000 ? h->n + 1 : 1000);
+    if (h->lc) { h->lc[en].n++; h->lc[en].W += s; }
+    if (x) {
+        if (x->wc) close_win(h, x);   /* 書き直し: 前の窓はここまで */
+        x->wc = (uint32_t)c + 1; x->wt = e->t + 1; x->ws = (uint32_t)sb; x->wn = 0;
+    }
+    uint32_t cl = h->k > 1 ? h->cls[en] : 0;
+    if (++h->n % h->recalc == 0) recompute(h);
+    return cl;
+}
+static void on_evict(rf_hint_t *h, const rf_hint_ev_t *e) {
+    h->nres++;
+    if (!h->fixH) h->H = h->nres == 1 ? (double)e->residence : h->H + ((double)e->residence - h->H) / 10000.0;
+}
+static uint32_t epoch(const rf_hint_t *h) { (void)h; return 0; }
+static uint32_t maxc(const rf_hint_t *h) { return h->k; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) { (void)h; (void)out; (void)max; return 0; }
+static void report(rf_hint_t *h, FILE *f) {
+    double wc[KMAX_LIMIT] = {0}, tw = 0;   /* 最後の境界での、分類ごとの書き込みバイト（減衰後）の割合 */
+    for (int e = 0; e < NE; e++) { wc[h->cls[e]] += h->wsc[e]; tw += h->wsc[e]; }
+    fprintf(f, "{ \"name\": \"pdens\", \"k\": %u, \"sstar\": %.0f, \"H\": %.0f, \"ghost_objs\": %lu, \"writes\": %lu, "
+            "\"windows_closed\": %lu, \"rerequests\": %lu, \"recalcs\": %lu, \"class_bytes\": [", h->k, h->sstar, h->H,
+            (unsigned long)h->xn, (unsigned long)h->n, (unsigned long)h->windows, (unsigned long)h->rereq,
+            (unsigned long)h->nrecalc);
+    for (uint32_t j = 0; j < h->k; j++) fprintf(f, "%s%.4f", j ? ", " : "", tw > 0 ? wc[j] / tw : 0);
+    fputs("] }", f);
+}
+const rf_hint_ops_t rf_hint_pdens_ops = {.name = "pdens", .params = P_PD, .create = create, .destroy = destroy,
+                                         .on_get = on_get, .on_insert = on_insert, .on_evict = on_evict, .epoch = epoch,
+                                         .bounds = bounds, .max_classes = maxc, .report = report};
diff --git a/libCacheSim/cache/eviction/flash/hint/profile.c b/libCacheSim/cache/eviction/flash/hint/profile.c
new file mode 100644
index 0000000..08b4996
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/profile.c
@@ -0,0 +1,125 @@
+/* profile.c — 前の実行の sizebin_profile.csv から静的に τ を決める（§9.3、2 パス）。
+ * 分布は SSD 受け入れ（admit_*）を使う。受け入れが 0 の場合だけ全要求（raw_*）で代用する。
+ * ビン [lo, hi) の右端で切るとき τ = hi − 1（s > τ ⇔ s ≥ hi）。
+ * stseg / hrseg はビンを log2 バケット（lo のバケット）に寄せてから適用する。 */
+#include "../util/hint_stats.h"
+#include "../util/segment.h"
+#include "../util/sst_wrap.h"
+#include "regionflash_hint.h"
+
+struct rf_hint { int64_t taus[KMAX_LIMIT]; uint32_t n; };
+static const param_spec_t P[] = {
+    {"path", P_STRING, "", NULL, "sizebin_profile.csv のパス"},
+    {"method", P_ENUM, "qbytes", "qcount|qbytes|geo|stseg|hrseg", "分割方法"},
+    {"k", P_UINT, "2", NULL, "分類数（hrseg では上限）"},
+    {"stat", P_ENUM, "hd", "hd|reuse|useful", "hrseg の派生統計"},
+    {"weight", P_ENUM, "bytes", "bytes|count", "hrseg の重み"},
+    {"min_obs", P_DOUBLE, "200", NULL, "hrseg の有効バケット条件"},
+    {"min_share", P_DOUBLE, "0.02", NULL, "hrseg の区間重みの下限"},
+    {"eps", P_DOUBLE, "0.05", NULL, "hrseg の肘の閾値"},
+    {"eps_log", P_DOUBLE, "1e-12", NULL, "hrseg の log(stat + eps_log)"},
+    {"lambda", P_INT, "0", NULL, "stseg の λ×256"},
+    {"min_band", P_INT, "2", NULL, "stseg の狭帯ゲート"},
+    {"no_split_pct", P_INT, "5", NULL, "stseg の大 pool ゲート"}, {NULL}};
+
+enum { C_LO, C_HI, C_RAWN, C_RAWB, C_AN, C_AB, C_SH, C_SHB, C_EN, C_EB, C_CN, C_CB, C_RES, NCOL };
+static const char *COLS[NCOL] = {"lo", "hi", "raw_reqs", "raw_bytes", "admit_objs", "admit_bytes", "ssd_hits",
+                                 "ssd_hit_bytes", "evict_objs", "evict_bytes", "cold_objs", "cold_bytes", "res_sum"};
+
+static int create(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env) {
+    rf_hint_t *x = xcalloc(1, sizeof(*x));
+    const char *path = pv_str(v, "path"), *m = pv_str(v, "method");
+    uint32_t k = (uint32_t)pv_int(v, "k");
+    if (k < 1 || k > env->k_max) die("profile: k=%u must be in [1, --k-max=%u]", k, env->k_max);
+    FILE *f = fopen(path, "r");
+    if (!f) die("profile: cannot open '%s'", path);
+    char line[8192]; int idx[NCOL];
+    double (*rows)[NCOL] = NULL; size_t nr = 0, cap = 0;
+    if (!fgets(line, sizeof line, f)) die("profile: empty file %s", path);
+    for (int c = 0; c < NCOL; c++) {
+        idx[c] = -1; int i = 0;
+        char *dup = xstrdup(line), *save = NULL;
+        for (char *t = strtok_r(dup, ",\r\n", &save); t; t = strtok_r(NULL, ",\r\n", &save), i++)
+            if (!strcmp(t, COLS[c])) idx[c] = i;
+        free(dup);
+        if (idx[c] < 0) die("profile: column '%s' missing in %s", COLS[c], path);
+    }
+    while (fgets(line, sizeof line, f)) {
+        GROW(rows, cap, nr + 1);
+        int i = 0; char *save = NULL;
+        double vals[64] = {0};
+        for (char *t = strtok_r(line, ",\r\n", &save); t && i < 64; t = strtok_r(NULL, ",\r\n", &save)) vals[i++] = strtod(t, NULL);
+        for (int c = 0; c < NCOL; c++) rows[nr][c] = vals[idx[c]];
+        nr++;
+    }
+    fclose(f);
+    double tot_n = 0;
+    for (size_t r = 0; r < nr; r++) tot_n += rows[r][C_AN];
+    int un = tot_n > 0 ? C_AN : C_RAWN, ub = tot_n > 0 ? C_AB : C_RAWB;
+
+    int64_t t[KMAX_LIMIT]; uint32_t n = 0;
+    if (!strcmp(m, "qcount") || !strcmp(m, "qbytes")) {
+        int col = m[1] == 'c' ? un : ub; double tot = 0, cum = 0; uint32_t j = 1;
+        size_t last = 0;
+        for (size_t r = 0; r < nr; r++) { tot += rows[r][col]; if (rows[r][col] > 0) last = r; }
+        for (size_t r = 0; r < nr && j < k && tot > 0; r++) {
+            cum += rows[r][col];
+            if (r < last && cum >= tot * j / k) {
+                int64_t tau = (int64_t)rows[r][C_HI] - 1;
+                if (!n || tau > t[n - 1]) t[n++] = tau;
+                while (j < k && cum >= tot * j / k) j++;
+            }
+        }
+    } else if (!strcmp(m, "geo")) {
+        double lo = -1, hi = -1;
+        for (size_t r = 0; r < nr; r++) if (rows[r][un] > 0) { if (lo < 0) lo = rows[r][C_LO] > 0 ? rows[r][C_LO] : 1; hi = rows[r][C_HI] - 1; }
+        for (uint32_t j = 1; j < k && lo > 0 && hi > lo; j++) {
+            int64_t tau = (int64_t)floor(lo * pow(hi / lo, (double)j / k));
+            if (!n || tau > t[n - 1]) t[n++] = tau;
+        }
+    } else if (!strcmp(m, "stseg")) {
+        split_thresh_t s;
+        sst_init(&s, (int)pv_int(v, "lambda"));
+        s.min_band_oct = (int)pv_int(v, "min_band"); s.nosplit_pct = (int)pv_int(v, "no_split_pct");
+        for (size_t r = 0; r < nr; r++) {
+            int b = sst_bucket((uint64_t)(rows[r][C_LO] > 1 ? rows[r][C_LO] : 1));
+            s.count[b] += (uint64_t)rows[r][un]; s.all_bytes[b] += (uint64_t)rows[r][ub]; s.cold_bytes[b] += (uint64_t)rows[r][C_CB];
+        }
+        sst_recompute(&s);
+        n = (uint32_t)st_split_taus(&s, s.threshold, 64, (int)k, t);
+    } else {                                                  /* hrseg */
+        hint_stats_t hs; memset(&hs, 0, sizeof hs);
+        for (size_t r = 0; r < nr; r++) {
+            int b = hs_bucket((uint64_t)(rows[r][C_LO] > 1 ? rows[r][C_LO] : 1));
+            hs.admit_n[b] += rows[r][C_AN]; hs.admit_bytes[b] += rows[r][C_AB]; hs.hit_n[b] += rows[r][C_SH];
+            hs.hit_bytes[b] += rows[r][C_SHB]; hs.evict_n[b] += rows[r][C_EN]; hs.evict_bytes[b] += rows[r][C_EB];
+            hs.cold_n[b] += rows[r][C_CN]; hs.cold_bytes[b] += rows[r][C_CB]; hs.res_sum[b] += rows[r][C_RES];
+        }
+        double sv[HS_NB], xx[HS_NB], w[HS_NB]; uint8_t val[HS_NB]; seg_t sg;
+        hs_derive(&hs, hs_parse_stat(pv_str(v, "stat")), hs_parse_weight(pv_str(v, "weight")), pv_dbl(v, "min_obs"),
+                  pv_dbl(v, "eps_log"), sv, xx, w, val);
+        int l = 0, r = HS_NB - 1;
+        while (l <= r && w[l] <= 0) l++;
+        while (r >= l && w[r] <= 0) r--;
+        seg_run(xx, w, l, r, (int)k, pv_dbl(v, "min_share"), &sg);
+        int j = seg_elbow(&sg, pv_dbl(v, "eps"));
+        for (int i = 1; i < j; i++) t[n++] = ((int64_t)1 << sg.start[j][i]) - 1;
+    }
+    free(rows);
+    memcpy(x->taus, t, n * sizeof(int64_t)); x->n = n;
+    *h = x;
+    return 0;
+}
+static void destroy(rf_hint_t *h) { free(h); }
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) { return class_of_taus(h->taus, h->n, e->size); }
+static uint32_t epoch(const rf_hint_t *h) { (void)h; return 0; }
+static uint32_t max_classes(const rf_hint_t *h) { return h->n + 1; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) {
+    uint32_t n = h->n < max ? h->n : max;
+    memcpy(out, h->taus, n * sizeof(int64_t));
+    return n;
+}
+
+const rf_hint_ops_t rf_hint_profile_ops = {
+    .name = "profile", .params = P, .create = create, .destroy = destroy,
+    .on_insert = on_insert, .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
diff --git a/libCacheSim/cache/eviction/flash/hint/refine.c b/libCacheSim/cache/eviction/flash/hint/refine.c
new file mode 100644
index 0000000..4ebae27
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/refine.c
@@ -0,0 +1,146 @@
+/* refine.c — st_hr_refine（提案）と hr_segment（比較）（§9.7）。
+ * st_hr_refine: split_threshold の粗い境界 τ_ST を残し、小 pool（バケット < sB）と大 pool（≥ sB）の
+ *               それぞれをバケット別 SSD ヒット統計の最適分割（§9.6）で細分する。
+ * hr_segment  : τ_ST を使わず、全範囲を同じ最適分割で分ける。
+ * 安定化: 新しい細分は「現在の細分を同じ統計で評価した SSE × (1 − hyst)」以下に下がり、かつ直前の変更から
+ *         dwell 回以上の再計算が経っているときだけ採用。τ_ST が変わったときは無条件に作り直す。 */
+#include "../util/hint_stats.h"
+#include "../util/segment.h"
+#include "../util/sst_wrap.h"
+#include "regionflash_hint.h"
+
+struct rf_hint {
+    int use_st, stat, weight, dwell, nosplit_refine;
+    stw_t w; hint_stats_t hs;
+    double min_obs, min_share, eps, hyst, eps_log;
+    uint32_t kmax, n, ep; uint64_t recalc, ema_den, obs, nrec; int64_t last_change, st_thr;
+    int cuts[HS_NB], ncut;                 /* 細分の切れ目（区間の先頭バケット。τ = 2^b − 1） */
+    int64_t taus[KMAX_LIMIT];
+};
+#define SEG_PARAM_SPECS(KDEF) \
+    {"k_max", P_UINT, KDEF, NULL, "分類数の上限（--k-max 以下）"}, \
+    {"stat", P_ENUM, "hd", "hd|reuse|useful", "分割に使う派生統計"}, \
+    {"weight", P_ENUM, "bytes", "bytes|count", "重み"}, \
+    {"min_obs", P_DOUBLE, "200", NULL, "admit_n・evict_n がこれ未満のバケットは無効"}, \
+    {"min_share", P_DOUBLE, "0.02", NULL, "各区間の重みの下限（範囲全体比）"}, \
+    {"eps", P_DOUBLE, "0.05", NULL, "肘の規則の閾値"}, \
+    {"hyst", P_DOUBLE, "0.05", NULL, "採用に必要な SSE の相対改善"}, \
+    {"dwell", P_UINT, "2", NULL, "変更間に挟む再計算回数"}, \
+    {"eps_log", P_DOUBLE, "1e-12", NULL, "log(stat + eps_log)"}
+static const param_spec_t P_REF[] = {SEG_PARAM_SPECS("4"),
+    {"refine_when_nosplit", P_ENUM, "no", "no|yes", "split_threshold が無分割のときも細分するか"}, ST_PARAM_SPECS, {NULL}};
+static const param_spec_t P_SEG[] = {SEG_PARAM_SPECS("4"),
+    {"recalc", P_UINT, "100000", NULL, "再計算の間隔（受け入れ数）"},
+    {"ema_den", P_UINT, "16", NULL, "減衰 (ema_den−1)/ema_den"}, {NULL}};
+
+static int mk(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env, int use_st) {
+    rf_hint_t *x = xcalloc(1, sizeof(*x));
+    x->use_st = use_st;
+    x->kmax = (uint32_t)pv_int(v, "k_max");
+    if (x->kmax < 1 || x->kmax > env->k_max) die("%s: k_max=%u must be in [1, --k-max=%u]", v->name, x->kmax, env->k_max);
+    if (use_st && x->kmax < 2) die("st_hr_refine: k_max must be >= 2");
+    x->stat = hs_parse_stat(pv_str(v, "stat")); x->weight = hs_parse_weight(pv_str(v, "weight"));
+    x->min_obs = pv_dbl(v, "min_obs"); x->min_share = pv_dbl(v, "min_share"); x->eps = pv_dbl(v, "eps");
+    x->hyst = pv_dbl(v, "hyst"); x->dwell = (int)pv_int(v, "dwell"); x->eps_log = pv_dbl(v, "eps_log");
+    if (use_st) {
+        stw_init(&x->w, v);
+        x->nosplit_refine = !strcmp(pv_str(v, "refine_when_nosplit"), "yes");
+        x->ema_den = x->w.ema_den;
+    } else {
+        x->recalc = (uint64_t)pv_int(v, "recalc"); x->ema_den = (uint64_t)pv_int(v, "ema_den");
+        if (!x->recalc || !x->ema_den) die("hr_segment: recalc and ema_den must be > 0");
+    }
+    x->st_thr = -1; x->last_change = INT64_MIN / 2;
+    *h = x;
+    return 0;
+}
+static int ref_create(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env) { return mk(h, v, env, 1); }
+static int seg_create(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env) { return mk(h, v, env, 0); }
+static void destroy(rf_hint_t *h) { free(h); }
+
+static void recompute(rf_hint_t *h) {
+    int L[2], R[2], nr = 0, budget = 0, st_changed = 0;
+    if (h->use_st) {
+        int64_t thr = h->w.thr;
+        st_changed = thr != h->st_thr; h->st_thr = thr;
+        if (thr >= 0) { int sb = ilog2_u64((uint64_t)thr); L[0] = 0; R[0] = sb - 1; L[1] = sb; R[1] = HS_NB - 1; nr = 2; budget = (int)h->kmax - 2; }
+        else if (h->nosplit_refine) { L[0] = 0; R[0] = HS_NB - 1; nr = 1; budget = (int)h->kmax - 1; }
+    } else { L[0] = 0; R[0] = HS_NB - 1; nr = 1; budget = (int)h->kmax - 1; }
+
+    double statv[HS_NB], x[HS_NB], w[HS_NB]; uint8_t valid[HS_NB];
+    hs_derive(&h->hs, h->stat, h->weight, h->min_obs, h->eps_log, statv, x, w, valid);
+    static seg_t sg[2]; int tl[2], tr[2], j[2];
+    for (int i = 0; i < nr; i++) {               /* 重みのある端まで範囲を詰める */
+        tl[i] = L[i]; tr[i] = R[i];
+        while (tl[i] <= tr[i] && w[tl[i]] <= 0) tl[i]++;
+        while (tr[i] >= tl[i] && w[tr[i]] <= 0) tr[i]--;
+        seg_run(x, w, tl[i], tr[i], budget + 1, h->min_share, &sg[i]);
+        j[i] = sg[i].jmax ? 1 : 0;
+    }
+    for (; budget > 0; budget--) {               /* SSE の減り幅が最大の範囲に 1 区間ずつ足す（肘の規則つき） */
+        int bi = -1; double best = -1;
+        for (int i = 0; i < nr; i++) {
+            const seg_t *s = &sg[i];
+            if (!j[i] || j[i] >= s->jmax || !(s->sse[1] > 0) || s->sse[j[i] + 1] == INFINITY) continue;
+            double red = s->sse[j[i]] - s->sse[j[i] + 1];
+            if (red / s->sse[1] >= h->eps && red > best) { best = red; bi = i; }
+        }
+        if (bi < 0) break;
+        j[bi]++;
+    }
+    int nc[HS_NB], nnc = 0, cc[HS_NB], ncc;
+    double sse_new = 0, sse_cur = 0;
+    for (int i = 0; i < nr; i++) {
+        if (!j[i]) continue;
+        sse_new += sg[i].sse[j[i]];
+        for (int k = 1; k < j[i]; k++) nc[nnc++] = sg[i].start[j[i]][k];
+        ncc = 0;
+        for (int k = 0; k < h->ncut; k++) if (h->cuts[k] > tl[i] && h->cuts[k] <= tr[i]) cc[ncc++] = h->cuts[k];
+        sse_cur += seg_sse_cuts(x, w, tl[i], tr[i], cc, ncc);
+    }
+    int differ = nnc != h->ncut || memcmp(nc, h->cuts, (size_t)nnc * sizeof(int));
+    if (differ && (st_changed || ((int64_t)h->nrec - h->last_change >= h->dwell && sse_new <= (1 - h->hyst) * sse_cur))) {
+        memcpy(h->cuts, nc, (size_t)nnc * sizeof(int)); h->ncut = nnc; h->last_change = (int64_t)h->nrec;
+    }
+
+    int64_t nt[KMAX_LIMIT]; uint32_t n = 0;
+    if (h->use_st && h->st_thr >= 0) nt[n++] = h->st_thr - (int64_t)h->w.add;
+    for (int k = 0; k < h->ncut; k++) nt[n++] = ((int64_t)1 << h->cuts[k]) - 1;
+    for (uint32_t a = 1; a < n; a++)
+        for (uint32_t b = a; b > 0 && nt[b - 1] > nt[b]; b--) { int64_t q = nt[b]; nt[b] = nt[b - 1]; nt[b - 1] = q; }
+    int changed = n != h->n || memcmp(nt, h->taus, n * sizeof(int64_t));
+    if (changed) { h->ep++; h->n = n; memcpy(h->taus, nt, n * sizeof(int64_t)); }
+    h->nrec++;
+    hs_decay(&h->hs, (double)(h->ema_den - 1) / (double)h->ema_den);
+}
+
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) {
+    hs_admit(&h->hs, e->size);
+    int64_t st[6];
+    if (h->use_st) { if (stw_admit(&h->w, e->size + h->w.add, st)) recompute(h); }
+    else if (++h->obs % h->recalc == 0) recompute(h);
+    return class_of_taus(h->taus, h->n, e->size);
+}
+static void on_find(rf_hint_t *h, const rf_hint_ev_t *e) {
+    if (e->outcome == HINT_SSD_HIT) hs_hit(&h->hs, e->size);
+}
+static void on_evict(rf_hint_t *h, const rf_hint_ev_t *e) {
+    hs_evict(&h->hs, e->size, e->freq, e->residence);
+    if (h->use_st) sst_on_evict(&h->w.s, e->size + h->w.add, e->freq);
+}
+static uint32_t epoch(const rf_hint_t *h) { return h->ep; }
+static uint32_t max_classes(const rf_hint_t *h) { return h->kmax; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) {
+    uint32_t n = h->n < max ? h->n : max;
+    memcpy(out, h->taus, n * sizeof(int64_t));
+    return n;
+}
+
+const rf_hint_ops_t rf_hint_st_hr_refine_ops = {
+    .name = "st_hr_refine", .params = P_REF, .create = ref_create, .destroy = destroy,
+    .on_find = on_find, .on_insert = on_insert, .on_evict = on_evict,
+    .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
+const rf_hint_ops_t rf_hint_hr_segment_ops = {
+    .name = "hr_segment", .params = P_SEG, .create = seg_create, .destroy = destroy,
+    .on_find = on_find, .on_insert = on_insert, .on_evict = on_evict,
+    .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
diff --git a/libCacheSim/cache/eviction/flash/hint/regionflash_hint.h b/libCacheSim/cache/eviction/flash/hint/regionflash_hint.h
new file mode 100644
index 0000000..aa0229c
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/regionflash_hint.h
@@ -0,0 +1,95 @@
+//
+//  regionflash_hint.h — RegionFlash's hint interface: a hint provider sees
+//  the cache's operations and gives each SSD write its class (write stream,
+//  RUH = class mod ruh).
+//
+//  One callback per cache operation. Within a request they come in this
+//  order (an operation the request does not make is skipped):
+//
+//    on_find    the SSD lookup of a request DRAM missed: hit or miss
+//    on_insert  each SSD write the request causes (a DRAM victim, a miss
+//               without DRAM, a reinsertion): returns the object's class
+//    on_evict   each object the request's writes push out of the SSD (not
+//               invalidations, not reinsertions); interleaved with on_insert
+//    on_get     the request itself, once it is served, with its outcome
+//
+//  on_get and on_find count requests; on_insert and on_evict count objects.
+//  Sizes are always the whole object's, also when it is written piece-wise.
+//
+//  Every provider in hint/ is written against this interface. A new one:
+//  copy split_threshold.c (the example), list it in RF_HINTS (rf_hint.c)
+//  and in CMakeLists.txt. The shared parts are in ../util/ (parameters,
+//  hashing, SplitThreshold's statistics); ../core/regionflash_stats.h lets
+//  a provider compare the interval in progress with the whole run.
+//
+
+#ifndef REGIONFLASH_HINT_H
+#define REGIONFLASH_HINT_H
+
+#include "../util/params.h"
+#include "../util/rng.h"
+#include "../util/util.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+  uint64_t t;          // request number, from 0 (the warm-up included)
+  uint64_t id, size;   // the object; size in bytes
+  uint32_t cls;        // its class: the one it was written with; never
+                       // written, the class its size maps to (as P.class.csv)
+  uint8_t outcome;     // on_get: HINT_MISS | HINT_DRAM_HIT | HINT_SSD_HIT;
+                       // on_find: HINT_MISS | HINT_SSD_HIT
+  uint8_t source;      // on_insert: SRC_DRAM_EVICT | SRC_MISS | SRC_REINSERT
+  uint8_t dram_hits;   // on_insert: DRAM hits since it entered DRAM
+  uint32_t freq;       // on_evict: SSD hits since it was written, + 1
+  uint64_t residence;  // on_evict: requests since it was written
+  int64_t next_dist;   // on_insert, oracle: requests until its next access,
+                       // -1: none, -2: unknown
+  int64_t gap;         // on_insert: requests since its last request, -1: none
+} rf_hint_ev_t;
+
+typedef struct rf_hint rf_hint_t;  // each provider defines struct rf_hint
+
+enum { HINT_MISS = 0, HINT_DRAM_HIT = 1, HINT_SSD_HIT = 2 };  // rf_hint_ev_t.outcome
+#define HINT_MAX_IV 128  // size intervals (bounds) at most
+
+typedef struct {
+  uint32_t k_max;        // classes the provider may use at most
+  uint64_t region_size;  // R (0 in ssd-mode=object)
+  rng_t *rng;            // the provider's random numbers (seed * 6 + 5)
+} hint_env_t;
+
+typedef struct {
+  const char *name;
+  const param_spec_t *params;  // hint=NAME:k=v/k=v (../util/params.h)
+  int (*create)(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env);
+  void (*destroy)(rf_hint_t *h);
+  /* cache operations; NULL if not used, except on_insert */
+  void (*on_get)(rf_hint_t *h, const rf_hint_ev_t *e);
+  void (*on_find)(rf_hint_t *h, const rf_hint_ev_t *e);
+  uint32_t (*on_insert)(rf_hint_t *h, const rf_hint_ev_t *e);  // < max_classes
+  void (*on_evict)(rf_hint_t *h, const rf_hint_ev_t *e);
+  /* the partition: size intervals (tau_{i-1}, tau_i] and their classes,
+   * read again when epoch() changed after on_insert or on_get */
+  uint32_t (*epoch)(const rf_hint_t *h);
+  uint32_t (*bounds)(const rf_hint_t *h, int64_t *tau_out, uint32_t max);
+  uint32_t (*classes)(const rf_hint_t *h, uint8_t *cls_out, uint32_t max);
+  // classes: NULL or 0 returned: interval i -> class i
+  uint32_t (*max_classes)(const rf_hint_t *h);
+  void (*report)(rf_hint_t *h, FILE *f);  // one JSON value: P.json hint_result
+} rf_hint_ops_t;
+
+/* class = |{ j : s > taus[j] }| (SplitThreshold's poolOf: "larger than") */
+static inline uint32_t class_of_taus(const int64_t *taus, uint32_t n, uint64_t s) {
+  uint32_t c = 0;
+  while (c < n && (int64_t)s > taus[c]) c++;
+  return c;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* REGIONFLASH_HINT_H */
diff --git a/libCacheSim/cache/eviction/flash/hint/rf_hint.c b/libCacheSim/cache/eviction/flash/hint/rf_hint.c
new file mode 100644
index 0000000..beeaae6
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/rf_hint.c
@@ -0,0 +1,147 @@
+//
+//  rf_hint.c — the write path's plugins by name (hint providers RF_HINTS;
+//  admission policies ADMISSIONS, ../admit/admit.c), and what RegionFlash
+//  does with a hint: the class of a size, the partition and its epochs, the
+//  calls into the provider (regionflash_hint.h).
+//
+#include "../regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ***********************************************************************
+// ****                          hint                                 ****
+// ***********************************************************************
+uint32_t rf_class_of(const rf_params_t *p, uint64_t s) {
+  return p->ivcls[class_of_taus(p->taus, p->ntau, s)];
+}
+
+
+/* the hint providers by name (hint=NAME). A new one: a file in hint/ (see
+ * split_threshold.c), one line here, one in CMakeLists.txt */
+extern const rf_hint_ops_t rf_hint_none_ops, rf_hint_fixed_ops, rf_hint_split_threshold_ops,
+    rf_hint_st_recursive_ops, rf_hint_split_threshold_req_ops, rf_hint_st_hitrate_ops,
+    rf_hint_st_hr_refine_ops, rf_hint_hr_segment_ops, rf_hint_profile_ops, rf_hint_oracle_gdt_ops,
+    rf_hint_key_ops, rf_hint_oracle_key_ops, rf_hint_oracle_keyinfo_ops, rf_hint_value_ops,
+    rf_hint_pdens_ops;
+static const rf_hint_ops_t *const RF_HINTS[] = {
+    &rf_hint_none_ops,           &rf_hint_fixed_ops,
+    &rf_hint_split_threshold_ops, &rf_hint_st_recursive_ops,
+    &rf_hint_split_threshold_req_ops, &rf_hint_st_hitrate_ops,
+    &rf_hint_st_hr_refine_ops,   &rf_hint_hr_segment_ops,
+    &rf_hint_profile_ops,        &rf_hint_oracle_gdt_ops,
+    &rf_hint_key_ops,            &rf_hint_oracle_key_ops,
+    &rf_hint_oracle_keyinfo_ops, &rf_hint_value_ops,
+    &rf_hint_pdens_ops,
+    NULL};
+
+/* spec "name:k=v/k=v" -> the ops of an admission policy (kind 0) or a hint
+ * provider (kind 1), and its parameters in pv */
+const void *rf_plugin(int kind, const char *spec, param_vals_t *pv) {
+  typedef struct { const char *name; const param_spec_t *params; } head_t;
+  const void *const *tab0 = kind ? (const void *const *)RF_HINTS : (const void *const *)ADMISSIONS;
+  char buf[256], name[64], err[512];
+  const char *rest;
+  snprintf(buf, sizeof(buf), "%s", spec);
+  /* '/' separates when a key= follows or between list numbers (4K/64K);
+   * otherwise it stays, so paths work: profile:path=/a/b.csv/k=3 */
+  for (char *q = buf + 1; *q; q++) {
+    if (*q != '/') continue;
+    size_t n = strspn(q + 1, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_");
+    bool key = n > 0 && q[1 + n] == '=';
+    bool num = strchr("0123456789.KMGT%", q[-1]) && isdigit((unsigned char)q[1]);
+    if (key || num) *q = ',';
+  }
+  spec_split(buf, name, sizeof(name), &rest);
+  for (const void *const *tab = tab0; *tab; tab++) {
+    const head_t *h = *tab;
+    if (strcmp(h->name, name) != 0) continue;
+    if (!params_build(pv, name, h->params, rest, err, sizeof(err)))
+      rf_die("RegionFlash: %s\n", err);
+    return *tab;
+  }
+  rf_die("RegionFlash: unknown %s %s\n", kind ? "hint" : "admit", name);
+}
+
+/* read the hint's intervals and their classes again */
+void rf_refresh_map(rf_params_t *p) {
+  const char *n = p->pv[1].name;
+  p->ntau = p->hops->bounds(p->hint, p->taus, HINT_MAX_IV);
+  for (uint32_t i = 1; i < p->ntau; i++)
+    if (p->taus[i] <= p->taus[i - 1])
+      rf_die("RegionFlash: hint %s: bounds not strictly increasing\n", n);
+  uint32_t nc = p->hops->classes ? p->hops->classes(p->hint, p->ivcls, HINT_MAX_IV + 1) : 0;
+  if (nc == 0)
+    for (uint32_t i = 0; i <= p->ntau; i++) p->ivcls[i] = (uint8_t)i;
+  else if (nc != p->ntau + 1)
+    rf_die("RegionFlash: hint %s: classes() size mismatch\n", n);
+  memset(p->act, 0, sizeof(p->act));
+  for (uint32_t i = 0; i <= p->ntau; i++) {
+    if (p->ivcls[i] >= p->khint)
+      rf_die("RegionFlash: hint %s maps an interval to class %u >= %u\n", n,
+             p->ivcls[i], p->khint);
+    p->act[p->ivcls[i]] = 1;
+  }
+}
+
+/* the partition changed (cachesim seal-on-repartition): none (default) keeps
+ * writing every OPEN region, as an FDP device appends to its RU anyway;
+ * inactive seals (or frees, if empty) the OPEN region of every class the new
+ * mapping no longer uses; all seals every OPEN region */
+static void rf_repartition(rf_params_t *p) {
+  if (p->seal_rep == SEAL_NONE) return;
+  for (uint32_t c = 0; c < p->kmax; c++) {
+    uint32_t r = p->open[c];
+    if (r == RF_NONE || (p->re_ii && c == p->khint)) continue;
+    if (p->seal_rep == SEAL_INACTIVE && p->act[c]) continue;
+    if (p->reg[r].used == 0) {
+      p->open[c] = RF_NONE;
+      rf_free_region(p, r);
+      continue;
+    }
+    rf_seal(p, r);
+    CNT(p, repartition_seals, c, 1);
+  }
+}
+
+void rf_epoch_check(rf_params_t *p) {
+  uint32_t e = p->hops->epoch(p->hint);
+  if (e == p->epoch) return;
+  p->epoch = e;
+  rf_refresh_map(p);
+  if (p->ssd_mode == SSD_REGION) rf_repartition(p);
+}
+
+/* hint on_insert: the class of an SSD write of o; src: SRC_DRAM_EVICT |
+ * SRC_MISS | SRC_REINSERT. next_dist counts requests from now (t + 1, as
+ * libCacheSim's oracle vtime) */
+uint32_t rf_hint_insert(rf_params_t *p, const cache_obj_t *o, int src) {
+  int64_t na = o->next_access_vtime, now = p->t + 1;
+  int64_t nd = na == -2 ? -2
+               : (na == -1 || na == MAX_REUSE_DISTANCE) ? -1
+               : na > now ? na - now : 0;
+  rf_hint_ev_t e = {.t = (uint64_t)p->t, .id = o->obj_id, .size = (uint64_t)o->obj_size,
+                    .cls = MD(o).cls, .source = (uint8_t)src,
+                    .dram_hits = MD(o).dram_hits, .next_dist = nd,
+                    .gap = MD(o).flags & RF_SEEN ? (int64_t)((uint32_t)p->t - MD(o).last_t) : -1};
+  uint32_t c = p->hops->on_insert(p->hint, &e);
+  rf_epoch_check(p);
+  if (c >= p->khint)
+    rf_die("RegionFlash: hint %s returned class %u >= %u\n", p->pv[1].name, c,
+           p->khint);
+  return c;
+}
+
+/* hint on_get / on_find: a request for id (size s, class c) */
+void rf_hint_req(rf_params_t *p, void (*fn)(rf_hint_t *, const rf_hint_ev_t *),
+                        uint64_t id, uint64_t s, uint32_t c, int outcome) {
+  if (fn == NULL) return;
+  rf_hint_ev_t e = {.t = (uint64_t)p->t, .id = id, .size = s, .cls = c,
+                    .outcome = (uint8_t)outcome};
+  fn(p->hint, &e);
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/hint/split_threshold.c b/libCacheSim/cache/eviction/flash/hint/split_threshold.c
new file mode 100644
index 0000000..409d3a1
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/split_threshold.c
@@ -0,0 +1,91 @@
+/* split_threshold.c — 物を大きさの閾値 τ で分類するヒント（hint=split_threshold）。
+ * τ は研究者の SplitThreshold の規則（../util/sst.h）で、書いた物の大きさの分布から
+ * recalc 回ごとに決め直す。st_recursive は同じ規則を範囲ごとに繰り返し、最大 2^depth 分類にする。
+ *
+ * ── 新しい分類方法を書くときの手本 ──────────────────────────────────────
+ *  1. このファイルを写し、名前を変える（例 hint/my_hint.c、hint=my_hint）。
+ *  2. struct rf_hint に状態を、P[] に引数（hint=名前:k=v/...）を書く。
+ *  3. on_insert で分類番号（0 ≤ 分類 < max_classes）を返す。学ぶなら on_get・on_find・on_evict も使う。
+ *  4. 末尾の rf_hint_..._ops を rf_hint.c の RF_HINTS に、ファイルを CMakeLists.txt に足す。
+ *
+ * 呼ばれる順（1 要求の中。regionflash_hint.h）と、ここでの使い方:
+ *   on_find    DRAM でミスして SSD を引いたとき（ヒットもミスも）  … 使わない（NULL）
+ *   on_insert  SSD に書く物ごと。分類を返す                       … 大きさを数え、τ と比べる
+ *   on_evict   SSD から追い出した物ごと                           … 当たらずに出た物を cold に数える
+ *   on_get     要求の最後（結果つき）                             … 使わない（NULL）
+ * 分類が大きさの区間で決まるヒントは、bounds() で境界 τ を返し、τ を変えたら epoch() の値を
+ * 進める。RegionFlash はそれを見て、分類ごとの集計の区間を作り直し、使われなくなった分類の
+ * 書き込み中の Region を封じる（seal-on-repartition）。区間で決まらないヒントは bounds が 0 個、
+ * epoch は 0 のまま（例 key.c）。
+ * ───────────────────────────────────────────────────────────────────── */
+#include "../util/sst_wrap.h"
+#include "regionflash_hint.h"
+
+struct rf_hint {
+  stw_t w;                   // SplitThreshold の統計（大きさのヒストグラム）・再計算・ヒステリシス
+  int depth;                 // 1: split_threshold、2 以上: st_recursive
+  uint32_t kmax, n, ep;      // 使える分類数、τ の数、エポック（τ が変わるたびに 1 進む）
+  int64_t taus[KMAX_LIMIT];  // 今の τ（昇順）。大きさ s の分類 = s を超える τ の数
+};
+
+static const param_spec_t P_ST[] = {ST_PARAM_SPECS, {NULL}};
+static const param_spec_t P_REC[] = {
+    {"depth", P_UINT, "2", NULL, "再帰の深さ（最大 2^depth 分類）"}, ST_PARAM_SPECS, {NULL}};
+
+static int create_depth(rf_hint_t **out, const param_vals_t *v, const hint_env_t *env, int depth) {
+  if (depth < 1) die("st_recursive: depth must be >= 1");
+  rf_hint_t *h = xcalloc(1, sizeof(*h));
+  stw_init(&h->w, v);
+  h->depth = depth;
+  h->kmax = env->k_max;
+  *out = h;
+  return 0;
+}
+static int create(rf_hint_t **out, const param_vals_t *v, const hint_env_t *env) {
+  return create_depth(out, v, env, 1);
+}
+static int create_rec(rf_hint_t **out, const param_vals_t *v, const hint_env_t *env) {
+  return create_depth(out, v, env, (int)pv_int(v, "depth"));
+}
+static void destroy(rf_hint_t *h) { free(h); }
+
+/* SSD に書く物: 大きさを数え、再計算の回なら τ を決め直し、分類を返す。
+ * τ は「足す前の大きさ」で持つ: s + size_add > thr ⇔ s > thr − size_add */
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) {
+  int64_t st[6], nt[KMAX_LIMIT];
+  if (stw_admit(&h->w, e->size + h->w.add, st)) {
+    uint32_t n = (uint32_t)st_split_taus(&h->w.s, h->w.thr, h->depth, (int)h->kmax, nt);
+    for (uint32_t i = 0; i < n; i++) nt[i] -= (int64_t)h->w.add;
+    if (n != h->n || memcmp(nt, h->taus, n * sizeof(int64_t))) {
+      h->ep++;
+      h->n = n;
+      memcpy(h->taus, nt, n * sizeof(int64_t));
+    }
+  }
+  return class_of_taus(h->taus, h->n, e->size);
+}
+
+/* SSD から追い出した物: 書いてから一度も当たらなかった物（freq ≤ 1）を cold に数える */
+static void on_evict(rf_hint_t *h, const rf_hint_ev_t *e) {
+  sst_on_evict(&h->w.s, e->size + h->w.add, e->freq);
+}
+
+static uint32_t epoch(const rf_hint_t *h) { return h->ep; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) {
+  uint32_t n = h->n < max ? h->n : max;
+  memcpy(out, h->taus, n * sizeof(int64_t));
+  return n;
+}
+static uint32_t max_classes(const rf_hint_t *h) {
+  uint32_t m = h->depth >= 6 ? 64 : 1u << h->depth;
+  return m < h->kmax ? m : h->kmax;
+}
+
+const rf_hint_ops_t rf_hint_split_threshold_ops = {
+    .name = "split_threshold", .params = P_ST, .create = create, .destroy = destroy,
+    .on_insert = on_insert, .on_evict = on_evict,
+    .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
+const rf_hint_ops_t rf_hint_st_recursive_ops = {
+    .name = "st_recursive", .params = P_REC, .create = create_rec, .destroy = destroy,
+    .on_insert = on_insert, .on_evict = on_evict,
+    .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
diff --git a/libCacheSim/cache/eviction/flash/hint/split_threshold_req.c b/libCacheSim/cache/eviction/flash/hint/split_threshold_req.c
new file mode 100644
index 0000000..baf18a3
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/split_threshold_req.c
@@ -0,0 +1,98 @@
+//
+//  split_threshold_req.c — SplitThreshold counted per request: the hint
+//  split_threshold_req (with depth > 1, as st_recursive).
+//
+//  split_threshold (split_threshold.c) observes objects: count[b] and all_bytes[b]
+//  add each object written to the SSD (on_insert), cold_bytes[b] each one
+//  that leaves the SSD without a hit (on_evict, freq <= 1), so its medians
+//  describe what is written. This one observes requests (on_get): count[b]
+//  and all_bytes[b] add every request (scope=all) or every request that
+//  reaches the SSD, a DRAM miss (scope=ssd), and cold_bytes[b] the requests
+//  among them that missed. Its medians are weighted by popularity: count_p50
+//  is the median requested size, byte_p50 the size below which half of the
+//  requested bytes are. b = floor(log2(size + size_add)), size the whole
+//  object's. The rules (../util/sst.h, unmodified), the decay, the
+//  hysteresis and depth are split_threshold's (../util/sst_wrap.h); recalc
+//  counts requests in scope. on_insert only maps a size to its class.
+//
+
+#include "regionflash_hint.h"
+#include "../util/sst_wrap.h"
+
+struct rf_hint {
+  stw_t w;
+  int depth, ssd_only;
+  uint32_t kmax, n, ep;
+  int64_t taus[KMAX_LIMIT];
+};
+
+static const param_spec_t P[] = {
+    {"scope", P_ENUM, "all", "all|ssd", "requests observed: all, or the DRAM misses"},
+    {"depth", P_UINT, "1", NULL, "recursion depth, up to 2^depth classes (1: split_threshold)"},
+    ST_PARAM_SPECS,
+    {NULL}};
+
+static int create(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env) {
+  rf_hint_t *x = xcalloc(1, sizeof(*x));
+  stw_init(&x->w, v);
+  x->depth = (int)pv_int(v, "depth");
+  x->ssd_only = strcmp(pv_str(v, "scope"), "ssd") == 0;
+  x->kmax = env->k_max;
+  if (x->depth < 1) die("split_threshold_req: depth must be >= 1");
+  *h = x;
+  return 0;
+}
+
+static void destroy(rf_hint_t *h) { free(h); }
+
+/* a request in scope is one observation; a miss is also cold (no hit, as
+ * freq <= 1 at an eviction) */
+static void on_get(rf_hint_t *h, const rf_hint_ev_t *e) {
+  if (h->ssd_only && e->outcome == HINT_DRAM_HIT) return;
+  uint64_t sz = e->size + h->w.add;
+  int64_t st[6], nt[KMAX_LIMIT];
+  if (e->outcome == HINT_MISS) sst_on_evict(&h->w.s, sz, 0);
+  if (!stw_admit(&h->w, sz, st)) return;  // recomputed: the thresholds again
+  uint32_t n = (uint32_t)st_split_taus(&h->w.s, h->w.thr, h->depth, (int)h->kmax, nt);
+  for (uint32_t i = 0; i < n; i++) nt[i] -= (int64_t)h->w.add;
+  if (n != h->n || memcmp(nt, h->taus, n * sizeof(int64_t))) {
+    h->ep++;
+    h->n = n;
+    memcpy(h->taus, nt, n * sizeof(int64_t));
+  }
+}
+
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) {
+  return class_of_taus(h->taus, h->n, e->size);
+}
+
+static uint32_t epoch(const rf_hint_t *h) { return h->ep; }
+
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) {
+  uint32_t n = h->n < max ? h->n : max;
+  memcpy(out, h->taus, n * sizeof(int64_t));
+  return n;
+}
+
+static uint32_t max_classes(const rf_hint_t *h) {
+  uint32_t m = h->depth >= 6 ? 64 : 1u << h->depth;
+  return m < h->kmax ? m : h->kmax;
+}
+
+/* the histograms' sums now (decayed): with recalc beyond the run, count =
+ * the requests in scope, bytes = their bytes (+ size_add), cold = missed */
+static void report(rf_hint_t *h, FILE *f) {
+  unsigned long long c = 0, b = 0, k = 0;
+  for (int i = 0; i < SST_NBUCKET; i++) {
+    c += h->w.s.count[i];
+    b += h->w.s.all_bytes[i];
+    k += h->w.s.cold_bytes[i];
+  }
+  fprintf(f, "{\"obs\": %llu, \"epoch\": %u, \"threshold\": %lld, \"count\": %llu, "
+             "\"bytes\": %llu, \"cold_bytes\": %llu}",
+          (unsigned long long)h->w.s.n_obs, h->ep, (long long)h->w.thr, c, b, k);
+}
+
+const rf_hint_ops_t rf_hint_split_threshold_req_ops = {
+    "split_threshold_req", P,      create, destroy, on_get,      NULL,  on_insert,
+    NULL,                  epoch,  bounds, NULL,    max_classes, report};
diff --git a/libCacheSim/cache/eviction/flash/hint/value.c b/libCacheSim/cache/eviction/flash/hint/value.c
new file mode 100644
index 0000000..8cd7a6a
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/value.c
@@ -0,0 +1,254 @@
+//
+//  value.c — the hint "value": an object goes to the write stream of its
+//  predicted value, so that a region holds objects of like value (the
+//  placement side of GL-Cache's learning; region-evict=gl is the eviction
+//  side).
+//
+//  An SSD write's features are a point of a small grid: log2(size), DRAM hits
+//  (up to 7), the source (DRAM victim / miss / reinsertion) and log2(requests
+//  since its last request + 1). One write in `sample` is followed for a label:
+//  1e6 / (requests until its next request) / size if it is requested within
+//  the window W, else 0 (label=oracle: GL-Cache's oracle utility at the write,
+//  1e8 / size / requests until its next access). Every `recalc` labels the
+//  model (gl_model.h) is trained on the last `hist`, every grid point is
+//  predicted in one batch, and the k classes are cut so that each holds about
+//  1 / k of the bytes of the recent writes: class 0 the lowest value. A write
+//  then only looks its point up. Before the first model every write is class 0.
+//  W defaults to the mean SSD residence of an object (on_evict).
+//
+//  hint=value:k=2/label=online|oracle/window=0/sample=16/hist=65536/
+//  recalc=16384/ylog=1. Requests of objects never written are counted in class
+//  0 (the hint has no size bounds).
+//
+
+#include <math.h>
+
+#include "../core/gl_model.h"
+#include "../util/hashmap.h"
+#include "regionflash_hint.h"
+
+#define VH_NF 4
+#define VH_B 48    // log2 buckets of size and of the gap
+#define VH_DH 8    // DRAM hits 0..7
+#define VH_SRC 3   // SRC_DRAM_EVICT, SRC_MISS, SRC_REINSERT
+#define VH_GRID (VH_B * VH_DH * VH_SRC * VH_B)
+#define VH_RES 8192  // recent writes that set the class bounds
+#define VH_TRACK 65536
+
+typedef struct {
+  uint64_t id, size;
+  int64_t t0;
+  uint32_t f;
+  float y;
+  bool done;
+} vh_track_t;
+
+struct rf_hint {
+  uint32_t k, sample, hist, recalc;
+  double window_p, ylog, life;
+  bool oracle;
+  gl_model_t *m;
+  float *gx, *gp;  // the grid's features and predictions
+  uint8_t *cls;    // [VH_GRID]
+  vh_track_t *tr;  // followed writes, a ring in write order
+  uint64_t t_first, t_end;  // its absolute positions [t_first, t_end)
+  hmap_t idx;               // id -> absolute position
+  float *hy;                // training rows: features from the point
+  uint32_t *hf, hn, hpos, since;
+  uint32_t rf[VH_RES];  // recent writes: point and size
+  uint64_t rs[VH_RES], rn;
+  uint64_t n_ins, n_label, n_train, n_life;
+};
+
+static const param_spec_t P[] = {
+    {"k", P_UINT, "2", NULL, "classes (write streams)"},
+    {"label", P_ENUM, "online", "online|oracle", "the label: seen later, or the next access"},
+    {"window", P_UINT, "0", NULL, "label window in requests (0: mean SSD residence)"},
+    {"sample", P_UINT, "16", NULL, "one write in sample is followed for a label"},
+    {"hist", P_UINT, "65536", NULL, "labels trained on (the last ones)"},
+    {"recalc", P_UINT, "16384", NULL, "labels between trainings"},
+    {"ylog", P_UINT, "1", NULL, "train on log(1 + label)"},
+    {NULL}};
+
+static uint32_t vh_log2(uint64_t v) {
+  uint32_t b = 0;
+  while (v > 1 && b < VH_B - 1) v >>= 1, b++;
+  return b;
+}
+
+static uint32_t vh_point(const rf_hint_ev_t *e) {
+  uint32_t s = vh_log2(e->size), d = e->dram_hits < VH_DH ? e->dram_hits : VH_DH - 1;
+  uint32_t src = e->source < VH_SRC ? e->source : VH_SRC - 1;
+  uint32_t g = e->gap < 0 ? VH_B - 1 : vh_log2((uint64_t)e->gap + 1);
+  return ((s * VH_DH + d) * VH_SRC + src) * VH_B + g;
+}
+
+static void vh_features(uint32_t f, float *x) {
+  x[3] = (float)(f % VH_B), f /= VH_B;
+  x[2] = (float)(f % VH_SRC), f /= VH_SRC;
+  x[1] = (float)(f % VH_DH), f /= VH_DH;
+  x[0] = (float)f;
+}
+
+static void vh_row(rf_hint_t *h, uint32_t f, float y) {
+  h->hf[h->hpos] = f;
+  h->hy[h->hpos] = y;
+  h->hpos = (h->hpos + 1) % h->hist;
+  if (h->hn < h->hist) h->hn++;
+  h->since++;
+  h->n_label++;
+}
+
+static int vh_cmp(const void *a, const void *b) {
+  const double *x = a, *y = b;
+  return x[0] < y[0] ? -1 : x[0] > y[0];
+}
+
+/* train; predict the grid; cut the classes by the recent writes' bytes */
+static void vh_train(rf_hint_t *h) {
+  float *x = malloc((size_t)h->hn * VH_NF * sizeof(float)), *y = malloc(h->hn * sizeof(float));
+  for (uint32_t i = 0; i < h->hn; i++) {
+    vh_features(h->hf[i], x + (size_t)i * VH_NF);
+    y[i] = h->ylog > 0 ? (float)log1p(h->hy[i]) : h->hy[i];
+  }
+  uint32_t rounds = gl_model_train(h->m, x, y, h->hn);
+  free(x);
+  free(y);
+  h->since = 0;
+  if (rounds == 0) return;
+  h->n_train++;
+  gl_model_predict(h->m, h->gx, VH_GRID, h->gp);
+  uint64_t n = h->rn < VH_RES ? h->rn : VH_RES, tot = 0, cum = 0;
+  double *pv = malloc((n ? n : 1) * 2 * sizeof(double));  // (prediction, bytes)
+  for (uint64_t i = 0; i < n; i++) {
+    pv[2 * i] = h->gp[h->rf[i]];
+    pv[2 * i + 1] = (double)h->rs[i];
+    tot += h->rs[i];
+  }
+  qsort(pv, n, 2 * sizeof(double), vh_cmp);
+  double bound[KMAX_LIMIT];
+  uint32_t nb = 0;
+  for (uint64_t i = 0; i < n && nb + 1 < h->k; i++) {
+    cum += (uint64_t)pv[2 * i + 1];
+    if (cum * h->k >= tot * (nb + 1)) bound[nb++] = pv[2 * i];
+  }
+  free(pv);
+  for (uint32_t f = 0; f < VH_GRID; f++) {
+    uint32_t c = 0;
+    while (c < nb && h->gp[f] > bound[c]) c++;
+    h->cls[f] = (uint8_t)c;
+  }
+}
+
+/* the oldest followed writes leave: requested, past the window, or no room */
+static void vh_retire(rf_hint_t *h, int64_t t, bool force) {
+  double w = h->window_p > 0 ? h->window_p : h->life;
+  while (h->t_first < h->t_end) {
+    vh_track_t *r = &h->tr[h->t_first % VH_TRACK];
+    if (!r->done && !force && !(w > 0 && (double)(t - r->t0) >= w)) break;
+    if (!r->done) hm_del(&h->idx, r->id);
+    vh_row(h, r->f, r->y);
+    h->t_first++;
+    force = false;
+  }
+}
+
+static int create(rf_hint_t **out, const param_vals_t *v, const hint_env_t *env) {
+  rf_hint_t *h = xcalloc(1, sizeof(*h));
+  h->k = (uint32_t)pv_int(v, "k");
+  h->oracle = strcmp(pv_str(v, "label"), "oracle") == 0;
+  h->window_p = (double)pv_int(v, "window");
+  h->sample = (uint32_t)pv_int(v, "sample");
+  h->hist = (uint32_t)pv_int(v, "hist");
+  h->recalc = (uint32_t)pv_int(v, "recalc");
+  h->ylog = (double)pv_int(v, "ylog");
+  if (h->k < 1 || h->k > env->k_max) die("value: k must be in 1..%u", env->k_max);
+  if (h->sample < 1 || h->hist < 10 || h->recalc < 1) die("value: sample, recalc >= 1, hist >= 10");
+  h->m = gl_model_new(VH_NF);
+  h->gx = xcalloc((size_t)VH_GRID * VH_NF, sizeof(float));
+  h->gp = xcalloc(VH_GRID, sizeof(float));
+  for (uint32_t f = 0; f < VH_GRID; f++) vh_features(f, h->gx + (size_t)f * VH_NF);
+  h->cls = xcalloc(VH_GRID, 1);
+  h->tr = xcalloc(VH_TRACK, sizeof(vh_track_t));
+  h->hf = xcalloc(h->hist, sizeof(uint32_t));
+  h->hy = xcalloc(h->hist, sizeof(float));
+  hm_init(&h->idx, 1024);
+  *out = h;
+  return 0;
+}
+
+static void destroy(rf_hint_t *h) {
+  gl_model_free(h->m);
+  hm_free(&h->idx);
+  free(h->gx);
+  free(h->gp);
+  free(h->cls);
+  free(h->tr);
+  free(h->hf);
+  free(h->hy);
+  free(h);
+}
+
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) {
+  uint32_t f = vh_point(e);
+  h->rf[h->rn % VH_RES] = f;
+  h->rs[h->rn % VH_RES] = e->size;
+  h->rn++;
+  if (h->n_ins++ % h->sample == 0) {
+    if (h->oracle) {
+      vh_row(h, f, e->next_dist >= 0 ? (float)(1.0e8 / (double)e->size /
+                                               (double)(e->next_dist > 0 ? e->next_dist : 1))
+                                     : 0);
+    } else {
+      if (h->t_end - h->t_first == VH_TRACK) vh_retire(h, (int64_t)e->t, true);
+      uint64_t *old = hm_get(&h->idx, e->id);  // written again: the old one ends
+      if (old != NULL) {
+        h->tr[*old % VH_TRACK].done = true;
+        hm_del(&h->idx, e->id);
+      }
+      h->tr[h->t_end % VH_TRACK] = (vh_track_t){e->id, e->size, (int64_t)e->t, f, 0, false};
+      hm_put(&h->idx, e->id, h->t_end++);
+    }
+  }
+  if (!h->oracle) vh_retire(h, (int64_t)e->t, false);
+  if (h->since >= h->recalc && h->hn >= 10) vh_train(h);
+  return h->cls[f] < h->k ? h->cls[f] : 0;
+}
+
+/* the first request after a followed write labels it */
+static void on_get(rf_hint_t *h, const rf_hint_ev_t *e) {
+  if (h->oracle) return;
+  uint64_t *pos = hm_get(&h->idx, e->id);
+  if (pos == NULL) return;
+  vh_track_t *r = &h->tr[*pos % VH_TRACK];
+  if ((int64_t)e->t <= r->t0) return;  // the request that wrote it
+  r->y = (float)(1.0e6 / (double)(e->t - (uint64_t)r->t0) / (double)r->size);
+  r->done = true;
+  hm_del(&h->idx, e->id);
+}
+
+/* the window's default: the mean SSD residence */
+static void on_evict(rf_hint_t *h, const rf_hint_ev_t *e) {
+  double l = (double)e->residence;
+  h->life = h->n_life++ ? h->life + (l - h->life) / 64 : l;
+}
+
+static uint32_t epoch(const rf_hint_t *h) { return 0; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) { return 0; }
+static uint32_t max_classes(const rf_hint_t *h) { return h->k; }
+
+static void report(rf_hint_t *h, FILE *f) {
+  uint64_t bytes[KMAX_LIMIT] = {0}, n = h->rn < VH_RES ? h->rn : VH_RES;
+  for (uint64_t i = 0; i < n; i++) bytes[h->cls[h->rf[i]] < h->k ? h->cls[h->rf[i]] : 0] += h->rs[i];
+  fprintf(f, "{\"label\": \"%s\", \"window\": %.0f, \"writes\": %llu, \"labels\": %llu, "
+             "\"trainings\": %llu, \"recent_bytes_per_class\": [",
+          h->oracle ? "oracle" : "online", h->window_p > 0 ? h->window_p : h->life,
+          (unsigned long long)h->n_ins, (unsigned long long)h->n_label,
+          (unsigned long long)h->n_train);
+  for (uint32_t c = 0; c < h->k; c++) fprintf(f, "%s%llu", c ? ", " : "", (unsigned long long)bytes[c]);
+  fputs("]}", f);
+}
+
+const rf_hint_ops_t rf_hint_value_ops = {
+    "value", P,     create, destroy, on_get,      NULL,  on_insert,
+    on_evict, epoch, bounds, NULL,    max_classes, report};
