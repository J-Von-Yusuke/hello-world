+++ b/scripts/regionflash/exp_gl.sh
@@ -0,0 +1,67 @@
+#!/bin/bash
+# exp_gl.sh — Region-level GL-Cache vs fifo / lru and the oracle upper bound,
+# on the main configurations (re-DESIGN.md §4.1; the settings of stfull.sh).
+# Usage: exp_gl.sh <group>   group = w01 | tencent | meta | fdp | sweep | sweep2 | sweep3
+#   (sweep2 includes w01 when W01=1; ONLY=<pattern> keeps the matching runs)
+# Outputs: $O/<trace>/<hint>/<policy>/P.json (+ time.txt), one line per run in
+# $O/done.log. w01 runs need ~8 GB each: at most 3 at a time.
+set -u
+B=${B:-/root/bg/bin/cachesim}
+O=${O:-/root/exp_gl}
+TC=/root/tc
+POLS="fifo:fifo lru:lru oracle:oracle gl:gl gl_olabel:gl,region-params=label=oracle"
+HINTS="none:none st:split_threshold"
+
+run() {  # run <dir> <trace> <ssd> <dram> <R> <hint> <policy> [cachesim args...]
+  local d=$1 tr=$2 ssd=$3 dram=$4 R=$5 hint=$6 pol=$7; shift 7
+  mkdir -p "$d"; cd "$d" || return
+  local e="dram-size=$dram,dram-algo=lru,region-size=$R,chunk=1M,inclusion=cachelib,interval=1000000,hint=$hint,region-evict=$pol,out=$d/P"
+  /usr/bin/time -v "$B" "$tr" oracleGeneral RegionFlash "$ssd" -e "$e" "$@" > "$d/stdout" 2> "$d/time.txt"
+  echo "$? $d" >> $O/done.log
+}
+
+jobs_of() {  # the runs of a group, one shell command per line
+  case $1 in
+  w01) for h in $HINTS; do for p in $POLS; do
+         echo "run $O/w01/${h%%:*}/${p%%:*} $TC/w01.oracleGeneral.bin.zst 257698037760 4294967296 626M ${h#*:} ${p#*:}"
+       done; done ;;
+  tencent) for h in $HINTS; do for p in $POLS; do
+         echo "run $O/tencent/${h%%:*}/${p%%:*} $TC/tencent.oracleGeneral.zst 10395324211 173255403 64M ${h#*:} ${p#*:}"
+       done; done ;;
+  meta) for h in $HINTS; do for p in $POLS; do
+         echo "run $O/meta10m/${h%%:*}/${p%%:*} $TC/meta.oracleGeneral.zst 257698037760 4294967296 626M ${h#*:} ${p#*:} --num-req 10000000"
+       done; done ;;
+  sweep) for h in $HINTS; do for y in 0 1; do for m in 1 4 16; do  # gl: label window, log label
+         n=gl_r${m}_y$y; [ $m = 1 ] && [ $y = 0 ] && continue           # = gl (the default)
+         echo "run $O/tencent/${h%%:*}/$n $TC/tencent.oracleGeneral.zst 10395324211 173255403 64M ${h#*:} gl,region-params=retrain=$((39 * m))/ylog=$y"
+         echo "run $O/meta10m/${h%%:*}/$n $TC/meta.oracleGeneral.zst 257698037760 4294967296 626M ${h#*:} gl,region-params=retrain=$((98 * m))/ylog=$y --num-req 10000000"
+       done; done; done ;;
+  sweep2) for h in $HINTS; do  # gl with warm=lru: retrain N/16, N/4, N, 4N; log label
+         for v in "wl:4:0" "wl_y1:4:1" "wl_q_y1:16:1" "wl_r4_y1:1:1" "wl_r16_y1:0.25:1"; do
+           IFS=: read n div y <<< "$v"
+           rt=$(python3 -c "import math; print(max(1, math.ceil(154 / $div)))")
+           rm_=$(python3 -c "import math; print(max(1, math.ceil(392 / $div)))")
+           echo "run $O/tencent/${h%%:*}/gl_$n $TC/tencent.oracleGeneral.zst 10395324211 173255403 64M ${h#*:} gl,region-params=warm=lru/retrain=$rt/ylog=$y"
+           echo "run $O/meta10m/${h%%:*}/gl_$n $TC/meta.oracleGeneral.zst 257698037760 4294967296 626M ${h#*:} gl,region-params=warm=lru/retrain=$rm_/ylog=$y --num-req 10000000"
+           [ -n "${W01:-}" ] && echo "run $O/w01/${h%%:*}/gl_$n $TC/w01.oracleGeneral.bin.zst 257698037760 4294967296 626M ${h#*:} gl,region-params=warm=lru/retrain=$rm_/ylog=$y"
+         done; done ;;
+  sweep3) for h in $HINTS; do  # gl, warm=lru, retraining every Q requests (as GL-Cache's time interval)
+         for q in ${QS:-30000 100000 300000 1000000}; do for y in ${YS:-0 1}; do
+           n=gl_q$((q / 1000))k_y$y
+           for t in ${TRACES:-tencent meta}; do case $t in
+             tencent) echo "run $O/tencent/${h%%:*}/$n $TC/tencent.oracleGeneral.zst 10395324211 173255403 64M ${h#*:} gl,region-params=warm=lru/retrain-req=$q/ylog=$y" ;;
+             meta) echo "run $O/meta10m/${h%%:*}/$n $TC/meta.oracleGeneral.zst 257698037760 4294967296 626M ${h#*:} gl,region-params=warm=lru/retrain-req=$q/ylog=$y --num-req 10000000" ;;
+             w01) echo "run $O/w01/${h%%:*}/$n $TC/w01.oracleGeneral.bin.zst 257698037760 4294967296 626M ${h#*:} gl,region-params=warm=lru/retrain-req=$q/ylog=$y" ;;
+           esac; done
+         done; done; done ;;
+  fdp) for p in $POLS; do  # RU = 4 regions, one RUH per class: DLWA of each policy
+         echo "run $O/fdp_tencent/st/${p%%:*} $TC/tencent.oracleGeneral.zst 10395324211 173255403 64M split_threshold ${p#*:},ru-size=256M,ruh=2,fdp-op=0.2"
+         echo "run $O/fdp_meta10m/st/${p%%:*} $TC/meta.oracleGeneral.zst 257698037760 4294967296 626M split_threshold ${p#*:},ru-size=2504M,ruh=2,fdp-op=0.2 --num-req 10000000"
+       done ;;
+  esac
+}
+
+mkdir -p $O
+P=${P:-3}
+export -f run; export B O TC
+jobs_of "$1" | grep -- "${ONLY:-}" | xargs -P "$P" -I{} bash -c '{}'
