+#!/usr/bin/env python3
+"""diff_ref.py — differential test of RegionFlash (C, libCacheSim) against
+cachesim's independent reference model tests/ref_sim.py, plus the FDP mirror in
+fdp_ref.py. Random small traces and configs; every counter the reference model
+keeps must match the C run's <out>.json "total" exactly.
+
+Usage (after building libCacheSim):
+  python diff_ref.py --bin _build/bin/cachesim [--n 300] [--seed 1]
+"""
+import argparse
+import json
+import os
+import random
+import signal
+import subprocess
+import sys
+import tempfile
+
+here = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, here)
+import fdp_ref  # noqa: E402
+
+# every counter ref_sim.py keeps in region mode without reinsertion / stream merge
+REF_KEYS = """reqs req_bytes size_change_misses dram_hits hit_bytes ssd_hits misses miss_bytes
+dram_evict_objs clean_skip_objs ssd_copy_lost_rewrites too_large_objs ssd_admit_objs ssd_admit_bytes
+ssd_evict_objs ssd_evict_bytes dead_evict_objs pad_bytes regions_sealed flash_region_write_bytes
+regions_evicted chunk_objs chunk_pieces chunk_write_aborts chunk_loss_head chunk_loss_other
+chunk_orphan_bytes reinsert_bytes reinsert_stops""".split()
+
+
+def keep_class(ref_sim, base):
+    """reinsert=score|recent (rf_score_keep) on a reference model class: before the base class evicts its
+    victim region, choose the objects to keep — best first (score: 1e8 / size / (age + 1); recent: smallest
+    age; age = requests since the object's last request), ties in write order, while they fit in R *
+    max_frac — and let reinsert_ok accept exactly those (they fit the base's write-order budget too)"""
+    class KeepSim(base):
+        def __init__(self, c):
+            super().__init__(c)
+            self.last, self.keep = {}, set()
+
+        def request(self, oid, size):
+            self.ev_req = 0                        # regions evicted in this request (rf_evict_region)
+            super().request(oid, size)
+            if oid in self.objs:                   # RegionFlash_get: last_t of the object after the request
+                self.last[oid] = self.t - 1
+
+        def reinsert_ok(self, o):
+            return id(o) in self.keep
+
+        def region_evict(self):
+            g, c = self.regions[self.order[-1]], self.c
+            budget, cands, prev = int(self.R * c["re_frac"]), [], None
+            self.ev_req += 1
+            if self.ev_req > 2 * c["N"]:           # the request frees no space: stop rewriting in it
+                budget = 0
+                self.inc("reinsert_stops")
+            for i, e in enumerate(g.entries):      # rf_obj_next: each object once (consecutive pieces)
+                if not self.live(g, i, e):
+                    continue
+                piece = isinstance(e, ref_sim.Piece)
+                o = e.owner if piece else e
+                if piece and o is prev:
+                    continue
+                prev = o if piece else None
+                if (o is getattr(self, "writing", None) or o.size > budget or o.hits < c["re_n"]
+                        or (c.get("re_max_size") and o.size > c["re_max_size"])):
+                    continue
+                age = self.t - self.last[o.id] if o.id in self.last else self.t
+                score = 1e8 / o.size / (age + 1) if c["re_kind"] == "score" else -age
+                cands.append((-score, len(cands), o))
+            for _, _, o in sorted(cands, key=lambda x: (x[0], x[1])):
+                if o.size <= budget:
+                    budget -= o.size
+                    self.keep.add(id(o))
+            super().region_evict()
+            self.keep = set()
+    return KeepSim
+
+
+def rand_case(rng, kinds=("hits",)):
+    R = rng.choice([4096, 10000])
+    taus = rng.choice([[], [R // 4], [R // 8, R // 2]])
+    chunk = rng.choice([0, 0, R // 3])
+    N = rng.randint(len(taus) + 3, 12)
+    cfg = dict(mode="region", R=R, N=N, dram=rng.choice([0, 0, 2 * R]),
+               dram_policy=rng.choice(["lru", "fifo"]),
+               inclusion=rng.choice(["cachelib", "exclusive", "inclusive"]),
+               region_evict=rng.choice(["fifo", "lru"]), taus=taus, chunk=chunk)
+    cfg["c_dram"] = rng.choice(["dram-policy", "dram-algo"])           # same thing, two spellings
+    fdp = None
+    if rng.random() < 0.25:                                                   # ssd-mode=object = ref ideal
+        cfg.update(mode="ideal", ssd=rng.randint(R // 2, 8 * R), ssd_policy=rng.choice(["fifo", "lru"]), chunk=0)
+    elif rng.random() < 0.5:
+        spr, ruh, pi = rng.choice([1, 2, 3, 4]), rng.choice([1, 2]), rng.random() < 0.5
+        cfg["region_evict"] = rng.choice(["fifo", "lru", "lru"])                  # LRU makes device GC copy
+        N = cfg["N"] = rng.randint(12, 40)                                         # many RUs: copies, not just erases
+        need = -(-N // spr) + ruh + (ruh if pi else 1) + (ruh if pi else 1) + 1   # RUs fdp_init requires
+        op = (need * spr + rng.randint(0, spr)) / N - 1 + 1e-9                # smallest OP that passes, + slack
+        fdp = dict(spr=spr, ruh=ruh, pi=pi, trim=rng.random() < 0.5, op=op)
+    if rng.random() < 0.4:                                                    # --reinsert hits:...
+        region = cfg["mode"] == "region"
+        cfg.update(re_on=True, re_n=rng.choice([1, 2]), re_max_size=rng.choice([0, 0, R // 4]),
+                   re_frac=rng.choice([0.25, 0.5, 1.0]), re_mode=rng.choice(["pi", "ii"]) if region else "pi")
+        if tuple(kinds) != ("hits",) and region:                              # --reinsert score|recent:...
+            kind = rng.choice(kinds)
+            if kind != "hits":                                               # any hits, max_frac < 1
+                cfg.update(re_kind=kind, re_n=rng.choice([0, 0, 1]), re_frac=rng.choice([0.25, 0.5, 0.9]))
+        if cfg["re_mode"] == "ii":
+            cfg["N"] = max(cfg["N"], len(taus) + 4)                           # one more OPEN region: the hot class
+    cfg["c_rev"] = cfg["region_evict"]
+    if cfg["region_evict"] == "fifo" and rng.random() < 0.5:
+        cfg["c_rev"] = "lcs:fifo"                                             # libCacheSim FIFO over regions
+    n_obj, sizes, tr = rng.randint(50, 400) if fdp else rng.randint(5, 60), {}, []
+    for _ in range(rng.randint(200, 8000 if fdp else 3000)):
+        i = rng.randint(1, n_obj)
+        if i not in sizes or rng.random() < 0.03:          # size change
+            sizes[i] = rng.choice([0, rng.randint(1, R // 4), rng.randint(1, 3 * R // 2)])
+        tr.append((i, sizes[i]))
+    return cfg, fdp, tr
+
+
+def run_c(binary, cfg, fdp, tr, tmp):
+    trace = os.path.join(tmp, "t.csv")
+    with open(trace, "w") as f:
+        for t, (i, s) in enumerate(tr):   # the CLI drops size-0 requests; ref_sim reads 0 as 1
+            f.write(f"{t + 1},{i},{max(s, 1)}\n")
+    e = [f"dram-size={cfg['dram']}", f"{cfg['c_dram']}={cfg['dram_policy']}", f"inclusion={cfg['inclusion']}",
+         f"out={os.path.join(tmp, 'o')}"]
+    if cfg["mode"] == "ideal":
+        e += ["ssd-mode=object", f"ssd-algo={cfg['ssd_policy']}"]
+    else:
+        e += [f"region-size={cfg['R']}", f"region-evict={cfg['c_rev']}", f"chunk={cfg['chunk']}"]
+    if cfg.get("re_on"):
+        e += [f"reinsert={cfg.get('re_kind', 'hits')}:n={cfg['re_n']}/max_size={cfg['re_max_size']}"
+              f"/max_frac={cfg['re_frac']}/mode={cfg['re_mode']}"]
+    if cfg["taus"]:
+        e += ["hint=fixed", "taus=" + "/".join(map(str, cfg["taus"]))]
+    if fdp:
+        e += [f"ru-size={fdp['spr'] * cfg['R']}", f"ruh={fdp['ruh']}", f"fdp-iso={'pi' if fdp['pi'] else 'ii'}",
+              f"fdp-op={fdp['op']}", f"fdp-trim={int(fdp['trim'])}"]
+    subprocess.run([binary, trace, "csv", "RegionFlash", str(cfg["ssd"] if cfg["mode"] == "ideal" else cfg["N"] * cfg["R"]),
+                    "-t", "time-col=1,obj-id-col=2,obj-size-col=3,has-header=false,obj-id-is-num=true",
+                    "-e", ",".join(e)], check=True, capture_output=True, cwd=tmp, timeout=120)
+    with open(os.path.join(tmp, "o.json")) as f:
+        return json.load(f)["total"]
+
+
+def _ref_timeout(signum, frame):
+    raise TimeoutError
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--bin", required=True)
+    ap.add_argument("--ref", default=os.path.normpath(os.path.join(here, "../../../../cachesim/tests")))
+    ap.add_argument("--n", type=int, default=300)
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--reinsert", default="hits", help="reinsertion kinds to draw, e.g. hits,score,recent")
+    ap.add_argument("--ref-timeout", type=int, default=120, help="seconds the reference model may take per case")
+    a = ap.parse_args()
+    signal.signal(signal.SIGALRM, _ref_timeout)
+    sys.path.insert(0, a.ref)
+    import ref_sim
+
+    binary, rng, bad = os.path.abspath(a.bin), random.Random(a.seed), 0
+    for case in range(a.n):
+        cfg, fdpc, tr = rand_case(rng, a.reinsert.split(","))
+        fdp = fdp_ref.Fdp(cfg["N"], cfg["R"], fdpc["spr"] * cfg["R"], fdpc["ruh"], fdpc["pi"],
+                          fdpc["op"], fdpc["trim"]) if fdpc else None
+        sim = fdp_ref.make_sim(ref_sim, cfg, fdp) if fdp else ref_sim.RefSim(cfg)
+        if cfg.get("re_kind"):
+            sim = keep_class(ref_sim, type(sim))(cfg)
+        signal.alarm(a.ref_timeout)
+        try:
+            for i, s in tr:
+                sim.request(i, s)
+        except TimeoutError:                       # the reference does not end: does the C one?
+            bad += 1
+            with tempfile.TemporaryDirectory() as tmp:
+                try:
+                    run_c(binary, cfg, fdpc, tr, tmp)
+                    c_state = "C ends"
+                except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as err:
+                    c_state = f"C {type(err).__name__}"
+            dump = os.path.join(tempfile.gettempdir(), f"diff_ref_s{a.seed}_c{case}.json")
+            with open(dump, "w") as f:
+                json.dump({"cfg": cfg, "fdp": fdpc, "trace": tr}, f)
+            print(f"case {case}: REF TIMEOUT ({c_state}) {cfg} fdp={fdpc} -> {dump}")
+            continue
+        finally:
+            signal.alarm(0)
+        want = {k: sim.k.get(k, 0) for k in REF_KEYS}
+        if fdp:
+            want["fdp_gc_copy_bytes"] = fdp.gc
+            want["nand_write_bytes"] = fdp.host + fdp.gc
+        with tempfile.TemporaryDirectory() as tmp:
+            try:
+                got = run_c(binary, cfg, fdpc, tr, tmp)
+            except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as err:
+                bad += 1
+                print(f"case {case}: C FAILED {cfg} fdp={fdpc}: {(err.stderr or b'').decode(errors='replace').strip()[-300:]}")
+                continue
+        diff = {k: (v, got.get(k)) for k, v in want.items() if got.get(k) != v}
+        if diff:
+            bad += 1
+            print(f"case {case}: MISMATCH {cfg} fdp={fdpc} {diff}")
+    print(f"{a.n - bad}/{a.n} cases match")
+    sys.exit(1 if bad else 0)
+
+
+if __name__ == "__main__":
+    main()
