diff --git a/libCacheSim/cache/eviction/flash/ssd/fdp.c b/libCacheSim/cache/eviction/flash/ssd/fdp.c
new file mode 100644
index 0000000..dda3d29
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/ssd/fdp.c
@@ -0,0 +1,132 @@
+//
+//  fdp.c — the FDP device model (fdp.h).
+//
+
+#include "fdp.h"
+
+#include <math.h>
+#include <stdlib.h>
+
+#include "libCacheSim/logging.h"
+#include "../util/rf_util.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static void fdp_gc(rf_fdp_t *f);
+
+static uint32_t fdp_alloc(rf_fdp_t *f) {
+  for (uint32_t guard = 0; !f->in_gc && f->n_free <= f->gcres; guard++) {
+    if (guard > f->n_ru) rf_die("FDP: GC cannot free RUs (raise fdp-op)\n");
+    fdp_gc(f);
+  }
+  if (f->n_free == 0) rf_die("FDP: no free RU during GC (raise fdp-op)\n");
+  return f->free_ru[--f->n_free];
+}
+
+/* the host region's previous copy becomes invalid (overwrite or trim) */
+void rf_fdp_kill(rf_fdp_t *f, uint32_t r) {
+  uint32_t s = f->reg_slot[r];
+  if (s == RF_NONE) return;
+  f->slot_reg[s] = RF_NONE;
+  f->ru_valid[s / f->spr]--;
+  f->reg_slot[r] = RF_NONE;
+}
+
+static void fdp_place(rf_fdp_t *f, uint32_t d, uint32_t r, uint8_t c) {
+  uint32_t u = f->dest_ru[d];
+  if (u == RF_NONE) {
+    u = fdp_alloc(f);
+    f->dest_ru[d] = u;
+    f->ru_tag[u] = d < f->n_ruh ? d : (f->pi ? d - f->n_ruh : f->n_ruh);
+  }
+  uint32_t s = u * f->spr + f->ru_fill[u]++;
+  f->slot_reg[s] = r;
+  f->slot_cls[s] = c;
+  f->ru_valid[u]++;
+  f->reg_slot[r] = s;
+  if (f->ru_fill[u] == f->spr) f->dest_ru[d] = RF_NONE;
+}
+
+/* greedy GC: relocate the valid slots of the full RU with the fewest */
+static void fdp_gc(rf_fdp_t *f) {
+  uint32_t v = RF_NONE;
+  for (uint32_t u = 0; u < f->n_ru; u++)
+    if (f->ru_fill[u] == f->spr && (v == RF_NONE || f->ru_valid[u] < f->ru_valid[v]))
+      v = u;
+  if (v == RF_NONE || f->ru_valid[v] == f->spr)
+    rf_die("FDP: no reclaimable RU (raise fdp-op)\n");
+  uint32_t tag = f->ru_tag[v];
+  f->in_gc = true;
+  for (uint32_t i = 0; i < f->spr; i++) {
+    uint32_t s = v * f->spr + i, r = f->slot_reg[s];
+    if (r == RF_NONE) continue;
+    uint8_t c = f->slot_cls[s];
+    rf_fdp_kill(f, r);
+    fdp_place(f, f->pi ? f->n_ruh + tag : f->n_ruh, r, c);
+    f->on_copy(f->ctx, c);
+    if (*f->counting) f->ruh_gc[tag] += f->R;
+  }
+  f->in_gc = false;
+  f->ru_fill[v] = 0;
+  f->free_ru[f->n_free++] = v;
+  f->on_erase(f->ctx);
+}
+
+void rf_fdp_write(rf_fdp_t *f, uint32_t r, uint8_t c) {
+  uint32_t d = c % f->n_ruh;
+  rf_fdp_kill(f, r);
+  fdp_place(f, d, r, c);
+  if (*f->counting) f->ruh_host[d] += f->R;
+}
+
+void rf_fdp_init(rf_fdp_t *f, uint32_t N, uint64_t R, uint32_t kmax) {
+  if (f->ru_size % R) rf_die("FDP: ru-size must be a multiple of region-size\n");
+  if (f->n_ruh == 0) rf_die("FDP: ruh must be >= 1\n");
+  f->N = N;
+  f->R = R;
+  f->spr = (uint32_t)(f->ru_size / R);
+  f->n_ru = (uint32_t)floor((double)N * (double)R * (1 + f->op) / (double)f->ru_size);
+  f->n_dest = f->n_ruh + (f->pi ? f->n_ruh : 1);
+  f->gcres = f->pi ? f->n_ruh : 1;
+  uint32_t need = (N + f->spr - 1) / f->spr + f->n_dest + f->gcres + 1;
+  if (f->n_ru < need)
+    rf_die("FDP: %u RUs < %u needed (N=%u, %u slots/RU); raise fdp-op\n", f->n_ru,
+           need, N, f->spr);
+  if (kmax > f->n_ruh)
+    WARN("FDP: %u classes share %u RUHs (class %% ruh)\n", kmax, f->n_ruh);
+  size_t ns = (size_t)f->n_ru * f->spr;
+  f->slot_reg = malloc(ns * sizeof(uint32_t));
+  f->slot_cls = calloc(ns, 1);
+  f->ru_valid = calloc(f->n_ru, sizeof(uint32_t));
+  f->ru_fill = calloc(f->n_ru, sizeof(uint32_t));
+  f->ru_tag = calloc(f->n_ru, sizeof(uint32_t));
+  f->free_ru = malloc(f->n_ru * sizeof(uint32_t));
+  f->dest_ru = malloc(f->n_dest * sizeof(uint32_t));
+  f->reg_slot = malloc(N * sizeof(uint32_t));
+  f->ruh_host = calloc(f->n_ruh + 1, sizeof(uint64_t));
+  f->ruh_gc = calloc(f->n_ruh + 1, sizeof(uint64_t));
+  for (size_t s = 0; s < ns; s++) f->slot_reg[s] = RF_NONE;
+  for (uint32_t u = 0; u < f->n_ru; u++) f->free_ru[u] = f->n_ru - 1 - u;
+  for (uint32_t d = 0; d < f->n_dest; d++) f->dest_ru[d] = RF_NONE;
+  for (uint32_t r = 0; r < N; r++) f->reg_slot[r] = RF_NONE;
+  f->n_free = f->n_ru;
+}
+
+void rf_fdp_free(rf_fdp_t *f) {
+  free(f->slot_reg);
+  free(f->slot_cls);
+  free(f->ru_valid);
+  free(f->ru_fill);
+  free(f->ru_tag);
+  free(f->free_ru);
+  free(f->dest_ru);
+  free(f->reg_slot);
+  free(f->ruh_host);
+  free(f->ruh_gc);
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/ssd/fdp.h b/libCacheSim/cache/eviction/flash/ssd/fdp.h
new file mode 100644
index 0000000..fc9592e
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/ssd/fdp.h
@@ -0,0 +1,57 @@
+//
+//  fdp.h — FDP (NVMe Flexible Data Placement) device model under RegionFlash.
+//
+//  n_ru Reclaim Units of spr = ru_size / R region slots each. A sealed host
+//  region is written into the open RU of RUH (class % n_ruh); its previous copy
+//  becomes invalid (overwrite, or trim at eviction). When free RUs drop to the
+//  reserve, greedy GC relocates the valid slots of the full RU with the fewest:
+//  destinations 0..n_ruh-1 are the host RUHs, n_ruh is the one shared GC stream
+//  (initially isolated, ii) and n_ruh + ruh the per-RUH ones (persistently
+//  isolated, pi).
+//
+
+#ifndef RF_FDP_H
+#define RF_FDP_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+  /* configuration (set before rf_fdp_init) */
+  uint64_t ru_size;
+  double op;
+  uint32_t n_ruh;
+  bool pi, trim;
+  /* accounting, set by the owner: one relocated region slot of class cls, one
+   * RU erase; ruh_host / ruh_gc count only while *counting */
+  void *ctx;
+  void (*on_copy)(void *ctx, uint8_t cls);
+  void (*on_erase)(void *ctx);
+  const bool *counting;
+  /* state */
+  uint64_t R;
+  uint32_t spr, n_ru, n_dest, gcres, n_free, N;
+  bool in_gc;
+  uint32_t *slot_reg;  // host region in the slot, RF_NONE if invalid / empty
+  uint8_t *slot_cls;
+  uint32_t *ru_valid, *ru_fill, *ru_tag, *free_ru, *dest_ru, *reg_slot;
+  uint64_t *ruh_host, *ruh_gc;  // [n_ruh + 1], the last is the shared GC pool
+} rf_fdp_t;
+
+/* N host regions of R bytes; kmax write streams (only for a warning) */
+void rf_fdp_init(rf_fdp_t *f, uint32_t N, uint64_t R, uint32_t kmax);
+/* the host writes region r (class c) whole */
+void rf_fdp_write(rf_fdp_t *f, uint32_t r, uint8_t c);
+/* region r's copy becomes invalid (trim) */
+void rf_fdp_kill(rf_fdp_t *f, uint32_t r);
+void rf_fdp_free(rf_fdp_t *f);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/libCacheSim/cache/eviction/flash/ssd/rf_region.c b/libCacheSim/cache/eviction/flash/ssd/rf_region.c
new file mode 100644
index 0000000..30b66bf
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/ssd/rf_region.c
@@ -0,0 +1,393 @@
+//
+//  rf_region.c — the SSD's Region store: placement into the OPEN region of a
+//  write stream, sealing (a whole-region write, to the FDP device if any),
+//  piece-wise writes, and evicting a region (with reinsertion). Which region
+//  to evict is the policy's (region_policy.h, or region_lcs.c).
+//
+#include "../regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void rf_seal(rf_params_t *p, uint32_t r) {
+  rf_region_t *g = &p->reg[r];
+  if (g->cls >= RF_KMAX) rf_die("RegionFlash: region %u has class %u\n", r, g->cls);
+  g->state = RF_R_SEALED;
+  g->seal_t = p->t;
+  g->seq = ++p->seq;
+  CNT(p, pad_bytes, g->cls, p->R - g->used);
+  CNT(p, flash_region_write_bytes, g->cls, p->R);  // written whole
+  CNT(p, regions_sealed, g->cls, 1);
+  p->open[g->cls] = RF_NONE;
+  if (p->fdp_on) rf_fdp_write(&p->fdp, r, g->cls);
+  CNT(p, nand_write_bytes, g->cls, p->R);  // the host's write (FDP adds its GC)
+  if (p->rops == NULL)
+    rf_lcs_on_seal(p, r);
+  else if (p->rops->on_seal)
+    p->rops->on_seal(p->rpol, r);
+}
+
+void rf_free_region(rf_params_t *p, uint32_t r) {
+  rf_region_t *g = &p->reg[r];
+  g->state = RF_R_FREE;
+  g->n_ent = g->touches = 0;
+  g->nvalid = g->nactive = 0;
+  g->used = g->valid = 0;
+  p->rfree[p->nfree++] = r;
+  if (p->fdp_on && p->fdp.trim) rf_fdp_kill(&p->fdp, r);
+}
+
+void rf_touch(rf_params_t *p, uint32_t r) {
+  rf_region_t *g = &p->reg[r];
+  g->touches++;
+  g->last_touch_t = p->t;
+  if (g->state != RF_R_SEALED) return;
+  if (p->rops == NULL)
+    rf_lcs_on_touch(p, r);
+  else if (p->rops->on_touch)
+    p->rops->on_touch(p->rpol, r);
+}
+
+void rf_drop(rf_params_t *p, uint32_t r, uint32_t pos, uint64_t s) {
+  p->reg[r].valid -= s;
+  p->reg[r].nvalid--;
+  p->reg[r].ent[pos].o = NULL;
+  p->ssd_used -= s;
+}
+
+/* append an entry of s bytes to the OPEN region of class c */
+static uint32_t rf_place(rf_params_t *p, cache_obj_t *o, uint32_t piece,
+                         uint64_t s, uint32_t c, uint32_t *pos) {
+  uint32_t r;
+  rf_reg_flush(p);
+  for (;;) {  // making space may change the OPEN region, so look again
+    r = p->open[c];
+    if (r != RF_NONE) {
+      if (p->reg[r].used + s <= p->R) break;
+      rf_seal(p, r);  // does not fit: seal, the tail is padding
+      continue;
+    }
+    if (p->nfree == 0) {
+      rf_region_evict(p);
+      continue;
+    }
+    r = p->rfree[--p->nfree];
+    rf_region_t *ng = &p->reg[r];
+    ng->state = RF_R_OPEN;
+    ng->cls = (uint8_t)c;
+    ng->open_t = ng->last_touch_t = p->t;
+    ng->seal_t = 0;
+    p->open[c] = r;
+    break;
+  }
+  rf_region_t *g = &p->reg[r];
+  RF_GROW(g->ent, g->cap_ent, g->n_ent + 1);
+  g->ent[g->n_ent].o = o;
+  g->ent[g->n_ent].piece = piece;
+  *pos = g->n_ent++;
+  g->used += s;
+  g->valid += s;
+  g->nvalid++;
+  g->last_touch_t = p->t;  // a write is a touch
+  p->ssd_used += s;
+  if (g->used == p->R) rf_seal(p, r);
+  return r;
+}
+
+static uint32_t rf_piece_alloc(rf_params_t *p) {
+  if (p->npcfree) return p->pcfree[--p->npcfree];
+  RF_GROW(p->pc, p->cap_pc, p->npc + 1);
+  return p->npc++;
+}
+
+static void rf_piece_free(rf_params_t *p, uint32_t q) {
+  RF_GROW(p->pcfree, p->cap_pcfree, p->npcfree + 1);
+  p->pcfree[p->npcfree++] = q;
+}
+
+/* piece-wise: an object larger than chunk is written as chunk-sized pieces
+ * (it may span regions). Losing one piece drops the whole object. If one of
+ * its own pieces is evicted while it is being written, the write aborts. */
+bool rf_append(rf_params_t *p, cache_obj_t *o, uint32_t c) {
+  uint64_t s = (uint64_t)o->obj_size;
+  uint32_t pos, r;
+  if (!p->chunk || s <= p->chunk) {
+    r = rf_place(p, o, RF_NONE, s, c, &pos);
+    MD(o).loc = r;
+    MD(o).pos = pos;
+    MD(o).flags = (MD(o).flags | RF_SSD) & ~RF_CHUNK;
+    return true;
+  }
+  uint32_t n = (uint32_t)((s + p->chunk - 1) / p->chunk), head = RF_NONE,
+           prev = RF_NONE;
+  if (p->nw == RF_WMAX) rf_die("RegionFlash: piece-wise writes nested too deep\n");
+  uint32_t w = p->nw++;
+  p->wobj[w] = o;
+  p->wab[w] = false;
+  for (uint32_t k = 0; k < n && !p->wab[w]; k++) {
+    uint64_t psz = k + 1 < n ? p->chunk : s - p->chunk * (n - 1);
+    uint32_t q = rf_piece_alloc(p);
+    p->pc[q] = (rf_piece_t){o, RF_NONE, 0, RF_NONE, (uint32_t)psz, false};
+    r = rf_place(p, o, q, psz, c, &pos);
+    p->pc[q].region = r;
+    p->pc[q].pos = pos;
+    p->pc[q].valid = true;
+    if (prev == RF_NONE)
+      head = q;
+    else
+      p->pc[prev].next = q;
+    prev = q;
+  }
+  bool aborted = p->wab[w];
+  p->nw--;  // nested writes have finished: w is the top
+  CNT(p, chunk_objs, c, 1);
+  CNT(p, chunk_pieces, c, n);
+  if (aborted) {
+    for (uint32_t q = head; q != RF_NONE;) {
+      uint32_t nx = p->pc[q].next;
+      if (p->pc[q].valid) rf_drop(p, p->pc[q].region, p->pc[q].pos, p->pc[q].size);
+      rf_piece_free(p, q);
+      q = nx;
+    }
+    MD(o).flags &= ~(RF_SSD | RF_CHUNK);
+    CNT(p, chunk_write_aborts, c, 1);
+    return false;
+  }
+  MD(o).loc = head;
+  MD(o).flags |= RF_SSD | RF_CHUNK;
+  return true;
+}
+
+/* write an object of an evicted region again: its own class (or what the
+ * hint says now, class=reclassify), or the one hot class (mode=ii) */
+static void rf_reinsert(rf_params_t *p, cache_obj_t *o) {
+  uint32_t c = MD(o).cls;
+  if (p->re_hint) {
+    uint32_t nc = rf_hint_insert(p, o, SRC_REINSERT);
+    if (p->re_reclass) c = nc;
+  }
+  if (p->re_ii) c = p->khint;
+  MD(o).cls = (uint8_t)c;
+  MD(o).ssd_hits = 0;  // admit_t is kept
+  bool ok = rf_append(p, o, c);
+  CNT(p, reinsert_objs, c, 1);
+  CNT(p, reinsert_bytes, c, (uint64_t)o->obj_size);
+  if (!ok) rf_evict_account(p, o);  // the piece-wise write aborted
+}
+
+/* reinsert=score (GL-Cache's merge, on flash): the region's objects, best
+ * first by GL-Cache's score 1e8 / size / (requests since its last request
+ * + 1), are kept (RF_KEEP) while they fit in R * max_frac. Not candidates:
+ * an object being written, one larger than max_size, fewer than n SSD hits.
+ * reinsert=recent (Colossus' flash cache): the same, best first by fewest
+ * requests since its last request. A rewrite is not a request, so an object
+ * nobody asks for again cannot stay by being rewritten. */
+typedef struct rf_keep {
+  double score;
+  uint32_t i;  // ties: write order
+  cache_obj_t *o;
+} rf_keep_t;
+
+static int rf_keep_cmp(const void *a, const void *b) {
+  const rf_keep_t *x = a, *y = b;
+  if (x->score != y->score) return x->score > y->score ? -1 : 1;
+  return x->i < y->i ? -1 : x->i > y->i;
+}
+
+static void rf_score_keep(rf_params_t *p, uint32_t r, uint64_t budget) {
+  rf_obj_iter_t it = {&p->reg[r], 0, NULL};
+  uint32_t n = 0;
+  for (cache_obj_t *o; (o = rf_obj_next(&it)) != NULL;) {
+    uint64_t s = (uint64_t)o->obj_size;
+    bool writing = false;
+    for (uint32_t w = 0; w < p->nw; w++) writing |= p->wobj[w] == o;
+    if (writing || s > budget || MD(o).ssd_hits < p->re_n ||
+        (p->re_max_size && s > p->re_max_size))
+      continue;
+    uint64_t age = MD(o).flags & RF_SEEN ? (uint32_t)p->t - MD(o).last_t : (uint64_t)p->t;
+    RF_GROW(p->keep, p->cap_keep, n + 1);
+    double score = p->re_recent ? -(double)age : 1.0e8 / (double)s / (double)(age + 1);
+    p->keep[n] = (rf_keep_t){score, n, o};
+    n++;
+  }
+  qsort(p->keep, n, sizeof(rf_keep_t), rf_keep_cmp);
+  for (uint32_t k = 0; k < n; k++) {
+    uint64_t s = (uint64_t)p->keep[k].o->obj_size;
+    if (s > budget) continue;
+    budget -= s;
+    MD(p->keep[k].o).flags |= RF_KEEP;
+  }
+}
+
+void rf_evict_region(rf_params_t *p, uint32_t r) {
+  rf_region_t *g = &p->reg[r];
+  uint32_t base = p->nre;  // candidates of this eviction: rebuf[base, end)
+  uint64_t budget = p->re_on ? (uint64_t)((double)p->R * p->re_frac) : 0;
+  CNT(p, regions_evicted, g->cls, 1);
+  /* rewrites may fill every region an eviction frees: with n=0 every object
+   * is a candidate, so a region whose valid bytes fit the budget is kept
+   * whole, and a write that needs more free space than that never fits.
+   * After 2N evictions in one request, its evictions rewrite nothing and
+   * each frees a whole region, so the request ends. A request that frees
+   * space as it goes rarely evicts that many; reinsert_stops counts the
+   * evictions this cut */
+  if (p->re_on && ++p->ev_req > 2 * (uint64_t)p->N) {
+    budget = 0;
+    CNT(p, reinsert_stops, g->cls, 1);
+  }
+  if (p->re_on && p->re_score) rf_score_keep(p, r, budget);
+  for (uint32_t i = 0; i < g->n_ent; i++) {
+    cache_obj_t *o = g->ent[i].o;
+    uint32_t piece = g->ent[i].piece;
+    if (o == NULL) continue;
+    if (piece != RF_NONE) {
+      uint32_t w = p->nw;
+      while (w > 0 && p->wobj[w - 1] != o) w--;
+      if (w > 0) {  // a piece of an object being written: abort that write
+        rf_drop(p, r, i, p->pc[piece].size);
+        p->pc[piece].valid = false;
+        p->wab[w - 1] = true;
+        continue;
+      }
+      uint64_t orphan = 0;
+      for (uint32_t q = MD(o).loc; q != RF_NONE; q = p->pc[q].next)
+        if (p->pc[q].valid && p->pc[q].region != r) orphan += p->pc[q].size;
+      if (p->pc[MD(o).loc].region == r)
+        CNT(p, chunk_loss_head, MD(o).cls, 1);
+      else
+        CNT(p, chunk_loss_other, MD(o).cls, 1);
+      CNT(p, chunk_orphan_bytes, MD(o).cls, orphan);
+    }
+    rf_ssd_invalidate(p, o);
+    /* admit=budget: a rewrite also spends the write budget (admit.h charge); no room = not rewritten */
+    bool keep = p->re_score ? (MD(o).flags & RF_KEEP) != 0
+                            : (uint64_t)o->obj_size <= budget && rf_reinsert_ok(p, o) &&
+                                  (p->aops != &adm_budget_ops ||
+                                   adm_budget_charge(p->adm, (uint64_t)p->req_local->clock_time, (uint32_t)o->obj_size));
+    if (keep) {  // rewritten in write order
+      if (!p->re_score) budget -= (uint64_t)o->obj_size;
+      MD(o).flags &= ~RF_KEEP;
+      RF_GROW(p->rebuf, p->cap_re, p->nre + 1);
+      p->rebuf[p->nre++] = o;
+      continue;
+    }
+    rf_evict_account(p, o);
+  }
+  uint32_t end = p->nre;
+  rf_free_region(p, r);
+  for (uint32_t k = base; k < end; k++) rf_reinsert(p, p->rebuf[k]);
+  p->nre = base;
+}
+
+/* nactive of each region holding o (once per region) += d */
+static void rf_active_add(rf_params_t *p, const cache_obj_t *o, int d) {
+  if (!(MD(o).flags & RF_CHUNK)) {
+    p->reg[MD(o).loc].nactive += (uint32_t)d;
+    return;
+  }
+  uint32_t last = RF_NONE;
+  for (uint32_t q = MD(o).loc; q != RF_NONE; q = p->pc[q].next)
+    if (p->pc[q].valid && p->pc[q].region != last) {
+      last = p->pc[q].region;
+      p->reg[last].nactive += (uint32_t)d;
+    }
+}
+
+/* o's entries (all its pieces, if written piece-wise) become invalid */
+void rf_region_invalidate(rf_params_t *p, cache_obj_t *o) {
+  if (MD(o).ssd_hits > 0) rf_active_add(p, o, -1);
+  if (!(MD(o).flags & RF_CHUNK)) {
+    rf_drop(p, MD(o).loc, MD(o).pos, (uint64_t)o->obj_size);
+    return;
+  }
+  for (uint32_t q = MD(o).loc; q != RF_NONE;) {
+    uint32_t nx = p->pc[q].next;
+    if (p->pc[q].valid) rf_drop(p, p->pc[q].region, p->pc[q].pos, p->pc[q].size);
+    p->pc[q].valid = false;
+    rf_piece_free(p, q);
+    q = nx;
+  }
+}
+
+/* an SSD hit reads every piece, touching its region in order */
+void rf_region_read(rf_params_t *p, const cache_obj_t *o) {
+  if (MD(o).ssd_hits == 0) rf_active_add(p, o, 1);  // its first hit since written
+  if (!(MD(o).flags & RF_CHUNK)) {
+    rf_touch(p, MD(o).loc);
+    return;
+  }
+  for (uint32_t q = MD(o).loc; q != RF_NONE; q = p->pc[q].next)
+    rf_touch(p, p->pc[q].region);
+}
+
+/* make one region free */
+void rf_region_evict(rf_params_t *p) {
+  if (p->rops == NULL) {
+    rf_lcs_evict(p);
+    return;
+  }
+  uint32_t r = p->rops->pick(p->rpol);
+  if (r == RF_NONE) rf_die("RegionFlash: no sealed region to evict\n");
+  if (p->reg[r].state != RF_R_SEALED)
+    rf_die("RegionFlash: region-evict %s picked region %u, which is not sealed\n",
+           p->rops->name, r);
+  static FILE *evlog = (FILE *)1;  // 計測用：RF_EVLOG=<file> で追い出しごとに 時刻 分類 年齢 寿命 touch 数
+  if (evlog == (FILE *)1) evlog = getenv("RF_EVLOG") ? fopen(getenv("RF_EVLOG"), "w") : NULL;
+  if (evlog) {  // RF_EVLOG_IDS=1 なら中の物の ID も（合成トレースで Λ = Σλ を後から計算する用）
+    static int ids = -1;
+    if (ids < 0) ids = getenv("RF_EVLOG_IDS") != NULL;
+    fprintf(evlog, "%lld %u %lld %lld %llu", (long long)p->t, p->reg[r].cls,
+            (long long)(p->t - p->reg[r].last_touch_t), (long long)(p->t - p->reg[r].seal_t),
+            (unsigned long long)p->reg[r].touches);
+    for (uint32_t j = 0; ids && j < p->reg[r].n_ent; j++)
+      if (p->reg[r].ent[j].o) fprintf(evlog, " %llu", (unsigned long long)p->reg[r].ent[j].o->obj_id);
+    fputc('\n', evlog);
+  }
+  rf_evict_region(p, r);
+}
+
+/* the FDP device's GC, counted as RegionFlash's writes */
+static void rf_fdp_copied(void *ctx, uint8_t cls) {
+  rf_params_t *p = (rf_params_t *)ctx;
+  CNT(p, fdp_gc_copy_bytes, cls, p->R);
+  CNT(p, nand_write_bytes, cls, p->R);
+}
+
+static void rf_fdp_erased(void *ctx) {
+  CNT((rf_params_t *)ctx, fdp_ru_erases, RF_NONE, 1);
+}
+
+/* N regions of R bytes (p->N, p->R set), the FDP device, and the built-in
+ * eviction policy p->rops (NULL: lcs:<algorithm>, set up by the caller) */
+void rf_regions_init(rf_params_t *p, const char *rparams) {
+  p->reg = calloc(p->N, sizeof(rf_region_t));
+  p->rfree = malloc(p->N * sizeof(uint32_t));
+  for (uint32_t r = 0; r < p->N; r++) p->rfree[r] = p->N - 1 - r;  // 0 first
+  p->nfree = p->N;
+  if (p->fdp_on) {
+    p->fdp.ctx = p;
+    p->fdp.on_copy = rf_fdp_copied;
+    p->fdp.on_erase = rf_fdp_erased;
+    p->fdp.counting = &p->counting;
+    rf_fdp_init(&p->fdp, p->N, p->R, p->kmax);
+  }
+  p->rview = (rf_rview_t){p->reg, p->N, p->kmax, p->R, &p->t, p->admit_n, p->admit_b};
+  if (p->rops != NULL) p->rpol = p->rops->create(&p->rview, rparams);
+}
+
+void rf_regions_free(rf_params_t *p) {
+  if (p->rpol != NULL) p->rops->destroy(p->rpol);
+  for (uint32_t r = 0; p->reg != NULL && r < p->N; r++) free(p->reg[r].ent);
+  free(p->reg);
+  free(p->rfree);
+  free(p->pend);
+  free(p->pc);
+  free(p->pcfree);
+  free(p->keep);
+  rf_fdp_free(&p->fdp);
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/ssd/rf_region.h b/libCacheSim/cache/eviction/flash/ssd/rf_region.h
new file mode 100644
index 0000000..2b95f79
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/ssd/rf_region.h
@@ -0,0 +1,69 @@
+//
+//  rf_region.h — the SSD's Regions as RegionFlash keeps them: what a Region
+//  eviction policy (region_policy.h) may read.
+//
+//  A Region goes FREE -> OPEN (being filled, one per write stream) -> SEALED
+//  (written whole, R bytes) -> FREE (evicted). Its entries are the objects, or
+//  pieces of objects written piece-wise, in write order; an entry whose object
+//  is no longer valid there has o == NULL.
+//
+
+#ifndef RF_REGION_H
+#define RF_REGION_H
+
+#include "libCacheSim/cacheObj.h"
+#include "../util/rf_util.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { RF_R_FREE = 0, RF_R_OPEN = 1, RF_R_SEALED = 2 };
+
+typedef struct {
+  cache_obj_t *o;  // NULL once the entry is no longer valid
+  uint32_t piece;  // RF_NONE: the whole object
+} rf_ent_t;
+
+typedef struct {
+  rf_ent_t *ent;
+  uint32_t n_ent, cap_ent, touches;
+  uint32_t nvalid;            // entries still valid
+  uint32_t nactive;           // valid objects with an SSD hit since written
+  uint64_t used, valid, seq;  // seq: when it was sealed (a counter, newer = larger)
+  uint64_t oid;               // region-evict=<algorithm>: id in the inner cache
+  int64_t open_t, seal_t, last_touch_t;
+  uint8_t state, cls;
+} rf_region_t;
+
+typedef struct {
+  cache_obj_t *o;
+  uint32_t region, pos, next, size;
+  bool valid;
+} rf_piece_t;
+
+/* the valid objects of a region, each once (an object written piece-wise
+ * counts once per run of its consecutive pieces):
+ *   rf_obj_iter_t it = {g, 0, NULL};
+ *   for (cache_obj_t *o; (o = rf_obj_next(&it)) != NULL;) ... */
+typedef struct {
+  const rf_region_t *g;
+  uint32_t i;
+  const cache_obj_t *prev;  // the object of the last piece seen
+} rf_obj_iter_t;
+
+static inline cache_obj_t *rf_obj_next(rf_obj_iter_t *it) {
+  while (it->i < it->g->n_ent) {
+    const rf_ent_t *e = &it->g->ent[it->i++];
+    if (e->o == NULL || (e->piece != RF_NONE && e->o == it->prev)) continue;
+    it->prev = e->piece != RF_NONE ? e->o : NULL;
+    return e->o;
+  }
+  return NULL;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/libCacheSim/cache/eviction/flash/ssd/rf_ssd.c b/libCacheSim/cache/eviction/flash/ssd/rf_ssd.c
new file mode 100644
index 0000000..1b72770
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/ssd/rf_ssd.c
@@ -0,0 +1,153 @@
+//
+//  rf_ssd.c — the SSD tier as the request flow sees it: admission (admit ->
+//  hint -> write), hits, invalidation, eviction accounting and reinsertion's
+//  rule, for both ssd-mode=region (rf_region.c) and ssd-mode=object (an inner
+//  libCacheSim cache, rf_tier.c).
+//
+#include "../regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void rf_ssd_invalidate(rf_params_t *p, cache_obj_t *o) {
+  if (p->ssd_mode == SSD_OBJECT) {
+    rf_tier_remove(p, T_SSD, o->obj_id);
+    p->ssd_used -= (uint64_t)o->obj_size;
+  } else {
+    rf_region_invalidate(p, o);
+  }
+  MD(o).flags &= ~(RF_SSD | RF_CHUNK);
+}
+
+/* SSD hit: read every piece, touching its region in order */
+void rf_ssd_hit(rf_params_t *p, cache_obj_t *o) {
+  if (p->ssd_mode == SSD_OBJECT) {
+    if (!rf_tier_get(p, T_SSD, p->req_local))
+      rf_die("RegionFlash: ssd-algo %s lost an object\n", p->tier[T_SSD].algo);
+  } else {
+    rf_region_read(p, o);
+  }
+}
+
+void rf_evict_account(rf_params_t *p, cache_obj_t *o) {
+  uint32_t c = MD(o).cls;
+  uint64_t s = (uint64_t)o->obj_size;
+  int64_t next = o->next_access_vtime;
+  CNT(p, ssd_evict_objs, c, 1);
+  CNT(p, ssd_evict_bytes, c, s);
+  CNT(p, res_sum, c, (uint64_t)(p->t - MD(o).admit_t));
+  if (MD(o).ssd_hits == 0) {
+    CNT(p, dead_evict_objs, c, 1);
+    CNT(p, dead_evict_bytes, c, s);
+  }
+  if (next == -1 || next == MAX_REUSE_DISTANCE)
+    CNT(p, oracle_never_bytes, c, s);
+  else if (next >= 0)
+    CNT(p, oracle_reused_bytes, c, s);
+  if (p->hops->on_evict) {
+    rf_hint_ev_t e = {.t = (uint64_t)p->t, .id = o->obj_id, .size = s, .cls = c,
+                      .freq = (uint32_t)MD(o).ssd_hits + 1,
+                      .residence = (uint64_t)(p->t - MD(o).admit_t)};
+    p->hops->on_evict(p->hint, &e);
+  }
+  if (MD(o).flags & RF_DRAM)
+    MD(o).flags |= RF_LOST;  // keep the DRAM copy
+  else
+    rf_obj_delete(p, o);
+}
+
+/* reinsertion: enough SSD hits since written, not too large, then a coin */
+bool rf_reinsert_ok(rf_params_t *p, const cache_obj_t *o) {
+  if (!p->re_on || MD(o).ssd_hits < p->re_n) return false;
+  if (p->re_max_size && (uint64_t)o->obj_size > p->re_max_size) return false;
+  return p->re_p >= 1 || rng_double(&p->rng_re) < p->re_p;  // cachesim reinsert_ok
+}
+
+/* ssd-mode=object: a victim the policy keeps goes straight back in, while the
+ * algorithm is still making space (cachesim obj_reinsert; an LRU/FIFO puts it
+ * at the head again). True if it is in again. */
+bool rf_obj_reinsert(rf_params_t *p, cache_obj_t *o) {
+  if (!rf_reinsert_ok(p, o)) return false;
+  if (p->re_hint) rf_hint_insert(p, o, SRC_REINSERT);  // for its statistics only
+  rf_tier_t *x = &p->tier[T_SSD];
+  request_t *q = p->req_re;  // req_ssd is still in use by the get that evicts
+  q->obj_id = o->obj_id;
+  q->obj_size = o->obj_size;
+  q->next_access_vtime = o->next_access_vtime;
+  q->clock_time = p->req_local->clock_time;
+  int prev = p->active;
+  p->active = T_SSD;
+  x->c->insert(x->c, q);
+  p->active = prev;
+  if (!rf_resident(p, T_SSD, o->obj_id, o->obj_size)) return false;
+  MD(o).flags |= RF_SSD;
+  MD(o).ssd_hits = 0;
+  CNT(p, reinsert_objs, MD(o).cls, 1);
+  CNT(p, reinsert_bytes, MD(o).cls, (uint64_t)o->obj_size);
+  CNT(p, nand_write_bytes, MD(o).cls, (uint64_t)o->obj_size);
+  return true;
+}
+
+/* ssd-mode=object: the algorithm makes space and inserts */
+static bool rf_obj_write(rf_params_t *p, cache_obj_t *o) {
+  request_t *q = p->req_ssd;
+  q->obj_id = o->obj_id;
+  q->obj_size = o->obj_size;
+  q->next_access_vtime = o->next_access_vtime;
+  q->clock_time = p->req_local->clock_time;
+  if (rf_tier_get(p, T_SSD, q))
+    rf_die("RegionFlash: ssd-algo %s holds an object not tracked\n",
+           p->tier[T_SSD].algo);
+  if (!rf_resident(p, T_SSD, o->obj_id, o->obj_size)) return false;
+  MD(o).flags |= RF_SSD;
+  p->ssd_used += (uint64_t)o->obj_size;
+  CNT(p, nand_write_bytes, MD(o).cls, (uint64_t)o->obj_size);
+  return true;
+}
+
+void rf_ssd_try_admit(rf_params_t *p, cache_obj_t *o, int src) {
+  uint64_t s = (uint64_t)o->obj_size;
+  if (s > p->ssd_max_obj) {
+    CNT(p, too_large_objs, MD(o).cls, 1);
+    CNT(p, too_large_bytes, MD(o).cls, s);
+    return;
+  }
+  admissioner_t *a = p->cache->admissioner;
+  if (a != NULL) {
+    p->req_tmp->obj_id = o->obj_id;
+    p->req_tmp->obj_size = o->obj_size;
+    if (!a->admit(a, p->req_tmp)) {
+      CNT(p, admit_reject_objs, MD(o).cls, 1);
+      return;
+    }
+  }
+  admit_info_t ai = {(uint64_t)p->t, o->obj_id, rf_u32(s), (uint8_t)src,
+                     MD(o).dram_hits, (uint64_t)p->req_local->clock_time};
+  if (!p->aops->accept(p->adm, &ai)) {
+    CNT(p, admit_reject_objs, MD(o).cls, 1);
+    return;
+  }
+  uint32_t c = rf_hint_insert(p, o, src);
+  MD(o).cls = (uint8_t)c;
+  MD(o).ssd_hits = 0;
+  MD(o).admit_t = p->t;
+  if (p->ssd_mode == SSD_OBJECT) {
+    if (!rf_obj_write(p, o)) {  // the algorithm declined it
+      CNT(p, admit_reject_objs, c, 1);
+      return;
+    }
+  } else {
+    rf_append(p, o, c);
+  }
+  CNT(p, ssd_admit_objs, c, 1);
+  CNT(p, ssd_admit_bytes, c, s);
+  SB(p, ssd_admit_objs, s, 1);
+  SB(p, ssd_admit_bytes, s, s);
+  p->admit_n[c]++;
+  p->admit_b[c] += s;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/hashmap.c b/libCacheSim/cache/eviction/flash/util/hashmap.c
new file mode 100644
index 0000000..a4de6d0
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/hashmap.c
@@ -0,0 +1,52 @@
+#include "hashmap.h"
+#include "rng.h"
+
+void hm_init(hmap_t *m, uint64_t cap_hint) {
+    uint64_t c = 16;
+    while (c < cap_hint) c <<= 1;
+    m->cap = c; m->mask = c - 1; m->n = 0;
+    m->k = xmalloc(c * 8); m->v = xmalloc(c * 8); m->u = xcalloc(c, 1);
+}
+void hm_free(hmap_t *m) { free(m->k); free(m->v); free(m->u); memset(m, 0, sizeof(*m)); }
+void hm_clear(hmap_t *m) { memset(m->u, 0, m->cap); m->n = 0; }
+
+static inline uint64_t home(const hmap_t *m, uint64_t key) { return splitmix64(key) & m->mask; }
+
+uint64_t *hm_get(const hmap_t *m, uint64_t key) {
+    for (uint64_t i = home(m, key);; i = (i + 1) & m->mask) {
+        if (!m->u[i]) return NULL;
+        if (m->k[i] == key) return &m->v[i];
+    }
+}
+
+static void grow(hmap_t *m) {
+    hmap_t o = *m;
+    hm_init(m, o.cap * 2);
+    for (uint64_t i = 0; i < o.cap; i++) if (o.u[i]) hm_put(m, o.k[i], o.v[i]);
+    hm_free(&o);
+}
+
+void hm_put(hmap_t *m, uint64_t key, uint64_t val) {
+    if ((m->n + 1) * 10 > m->cap * 7) grow(m);
+    uint64_t i = home(m, key);
+    for (; m->u[i]; i = (i + 1) & m->mask)
+        if (m->k[i] == key) { m->v[i] = val; return; }
+    m->u[i] = 1; m->k[i] = key; m->v[i] = val; m->n++;
+}
+
+int hm_del(hmap_t *m, uint64_t key) {
+    uint64_t i = home(m, key);
+    for (;; i = (i + 1) & m->mask) {
+        if (!m->u[i]) return 0;
+        if (m->k[i] == key) break;
+    }
+    /* 後方シフト: 空きスロット i を、そこへ戻れる後続要素で埋めていく */
+    for (uint64_t j = (i + 1) & m->mask; m->u[j]; j = (j + 1) & m->mask) {
+        uint64_t h = home(m, m->k[j]);
+        if (((j - h) & m->mask) >= ((j - i) & m->mask)) {
+            m->k[i] = m->k[j]; m->v[i] = m->v[j]; i = j;
+        }
+    }
+    m->u[i] = 0; m->n--;
+    return 1;
+}
diff --git a/libCacheSim/cache/eviction/flash/util/hashmap.h b/libCacheSim/cache/eviction/flash/util/hashmap.h
new file mode 100644
index 0000000..8a326b0
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/hashmap.h
@@ -0,0 +1,15 @@
+/* hashmap.h — uint64 → uint64。オープンアドレス・線形探索・後方シフト削除（墓石なし）、
+ * ハッシュは splitmix64、負荷率 0.7 で倍増（DESIGN.md §5.2） */
+#ifndef RF_UTIL_HASHMAP_H
+#define RF_UTIL_HASHMAP_H
+#include "util.h"
+
+typedef struct { uint64_t *k, *v; uint8_t *u; uint64_t cap, mask, n; } hmap_t;
+
+void      hm_init(hmap_t *m, uint64_t cap_hint);
+void      hm_free(hmap_t *m);
+uint64_t *hm_get(const hmap_t *m, uint64_t key);           /* 値へのポインタ（次の put まで有効）／なければ NULL */
+void      hm_put(hmap_t *m, uint64_t key, uint64_t val);   /* 挿入または上書き */
+int       hm_del(hmap_t *m, uint64_t key);                 /* 1 = 消した */
+void      hm_clear(hmap_t *m);                             /* 全削除（容量はそのまま） */
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/hint_stats.c b/libCacheSim/cache/eviction/flash/util/hint_stats.c
new file mode 100644
index 0000000..4c05321
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/hint_stats.c
@@ -0,0 +1,33 @@
+#include "hint_stats.h"
+
+void hs_admit(hint_stats_t *h, uint64_t s) { int b = hs_bucket(s); h->admit_n[b] += 1; h->admit_bytes[b] += s; }
+void hs_hit(hint_stats_t *h, uint64_t s) { int b = hs_bucket(s); h->hit_n[b] += 1; h->hit_bytes[b] += s; }
+void hs_evict(hint_stats_t *h, uint64_t s, uint32_t freq, uint64_t res) {
+    int b = hs_bucket(s);
+    h->evict_n[b] += 1; h->evict_bytes[b] += s; h->res_sum[b] += (double)res;
+    if (freq <= 1) { h->cold_n[b] += 1; h->cold_bytes[b] += s; }
+}
+void hs_decay(hint_stats_t *h, double f) {
+    double *p = (double *)h;
+    for (size_t i = 0; i < sizeof(*h) / sizeof(double); i++) p[i] *= f;
+}
+
+void hs_derive(const hint_stats_t *h, int stat, int weight, double min_obs, double eps_log,
+               double *statv, double *x, double *w, uint8_t *valid) {
+    for (int b = 0; b < HS_NB; b++) {
+        double v = NAN;
+        int ok = h->admit_n[b] >= min_obs && h->evict_n[b] >= min_obs && h->evict_n[b] > 0;
+        if (ok) {
+            if (stat == HS_HD) {
+                double rbar = h->res_sum[b] / h->evict_n[b], den = h->admit_bytes[b] * rbar;
+                if (den > 0) v = h->hit_n[b] / den; else ok = 0;
+            } else if (stat == HS_REUSE) v = h->hit_n[b] / h->admit_n[b];
+            else v = 1.0 - h->cold_n[b] / h->evict_n[b];
+        }
+        statv[b] = v; valid[b] = (uint8_t)ok;
+        x[b] = ok ? (stat == HS_USEFUL ? v : log(v + eps_log)) : 0;
+        w[b] = ok ? (weight == HS_W_BYTES ? h->admit_bytes[b] : h->admit_n[b]) : 0;
+    }
+}
+int hs_parse_stat(const char *s) { return !strcmp(s, "hd") ? HS_HD : !strcmp(s, "reuse") ? HS_REUSE : HS_USEFUL; }
+int hs_parse_weight(const char *s) { return !strcmp(s, "count") ? HS_W_COUNT : HS_W_BYTES; }
diff --git a/libCacheSim/cache/eviction/flash/util/hint_stats.h b/libCacheSim/cache/eviction/flash/util/hint_stats.h
new file mode 100644
index 0000000..b4137f3
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/hint_stats.h
@@ -0,0 +1,25 @@
+/* hint_stats.h — バケット別の SSD ヒット統計（§9.5）。バケットは split_threshold と同じ log2（48 本） */
+#ifndef HINT_STATS_H
+#define HINT_STATS_H
+#include "util.h"
+
+#define HS_NB 48
+typedef struct hint_stats {
+    double admit_n[HS_NB], admit_bytes[HS_NB], hit_n[HS_NB], hit_bytes[HS_NB];
+    double evict_n[HS_NB], evict_bytes[HS_NB], cold_n[HS_NB], cold_bytes[HS_NB], res_sum[HS_NB];
+} hint_stats_t;
+
+enum { HS_HD, HS_REUSE, HS_USEFUL };
+enum { HS_W_BYTES, HS_W_COUNT };
+
+static inline int hs_bucket(uint64_t s) { int b = ilog2_u64(s ? s : 1); return b > HS_NB - 1 ? HS_NB - 1 : b; }
+void hs_admit(hint_stats_t *h, uint64_t s);
+void hs_hit(hint_stats_t *h, uint64_t s);
+void hs_evict(hint_stats_t *h, uint64_t s, uint32_t freq, uint64_t res);
+void hs_decay(hint_stats_t *h, double f);
+/* 派生統計: stat[b]、分割に使う x[b]、重み w[b]、有効フラグ valid[b]（無効なら w = 0） */
+void hs_derive(const hint_stats_t *h, int stat, int weight, double min_obs, double eps_log,
+               double *statv, double *x, double *w, uint8_t *valid);
+int  hs_parse_stat(const char *s);
+int  hs_parse_weight(const char *s);
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/params.c b/libCacheSim/cache/eviction/flash/util/params.c
new file mode 100644
index 0000000..18ef693
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/params.c
@@ -0,0 +1,170 @@
+#include "params.h"
+#include <ctype.h>
+#include <errno.h>
+
+int parse_bytes(const char *s, uint64_t *out) {
+    char *e; errno = 0;
+    double x = strtod(s, &e);
+    if (e == s || errno || x < 0) return 0;
+    double mul = 1;
+    switch (toupper((unsigned char)*e)) {
+    case 'K': mul = 0x1p10; e++; break;
+    case 'M': mul = 0x1p20; e++; break;
+    case 'G': mul = 0x1p30; e++; break;
+    case 'T': mul = 0x1p40; e++; break;
+    }
+    if (mul > 1 && *e == 'i') e++;
+    if (*e == 'B' || *e == 'b') e++;
+    if (*e) return 0;
+    *out = (uint64_t)llround(x * mul);
+    return 1;
+}
+
+void spec_split(const char *spec, char *name, size_t nsz, const char **rest) {
+    const char *c = strchr(spec, ':');
+    size_t n = c ? (size_t)(c - spec) : strlen(spec);
+    if (n >= nsz) n = nsz - 1;
+    memcpy(name, spec, n); name[n] = 0;
+    *rest = c ? c + 1 : "";
+}
+
+/* 数値（リストの要素・実数引数）: 素の数、末尾 % は ÷100（"20%" = 0.2）、K/M/G/T は 2 進の倍数（"4K" = 4096） */
+int parse_num(const char *s, double *out) {
+    char *e; errno = 0;
+    double x = strtod(s, &e);
+    if (e == s || errno) return 0;
+    if (*e == '%') { x /= 100; e++; }
+    else if (*e) { uint64_t b; if (!parse_bytes(s, &b)) return 0; x = (double)b; e = (char *)s + strlen(s); }
+    if (*e) return 0;
+    *out = x;
+    return 1;
+}
+
+static int check_num(const char *s, int is_double, int allow_neg) {
+    char *e; errno = 0; double d;
+    if (!*s) return 0;
+    if (!allow_neg && strchr(s, '-')) return 0;
+    if (is_double) return parse_num(s, &d);
+    (void)strtoll(s, &e, 10);
+    return !*e && !errno;
+}
+
+static int check(const param_spec_t *p, const char *val, char *err, size_t errsz) {
+    uint64_t b; int ok = 1;
+    switch (p->type) {
+    case P_INT:    ok = check_num(val, 0, 1); break;
+    case P_UINT:   ok = check_num(val, 0, 0); break;
+    case P_DOUBLE: ok = check_num(val, 1, 1); break;
+    case P_BYTES:  ok = parse_bytes(val, &b); break;
+    case P_STRING: break;
+    case P_ENUM: {
+        size_t n = strlen(val); ok = 0;
+        for (const char *c = p->choices; c && *c;) {
+            const char *bar = strchr(c, '|'); size_t m = bar ? (size_t)(bar - c) : strlen(c);
+            if (m == n && !strncmp(c, val, n)) { ok = 1; break; }
+            c = bar ? bar + 1 : NULL;
+        }
+        break;
+    }
+    case P_LIST: {
+        char *dup = xstrdup(val), *save = NULL;
+        for (char *t = strtok_r(dup, ",;", &save); t && ok; t = strtok_r(NULL, ",;", &save)) ok = check_num(t, 1, 1);
+        free(dup);
+        break;
+    }
+    }
+    if (!ok) snprintf(err, errsz, "bad value '%s' for '%s'%s%s", val, p->key,
+                      p->choices ? ", choices: " : "", p->choices ? p->choices : "");
+    return ok;
+}
+
+/* kvs = "key=val,key=val,..."。'=' を含まない欄は直前の値にカンマで連結する（リスト "tau=1024,2048,10000"）。
+ * 先頭が '=' を含まなければ、最初の P_LIST 引数の値とみなす（"fixed:1024,2048,10000"） */
+int params_build(param_vals_t *v, const char *name, const param_spec_t *spec, const char *kvs,
+                 char *err, size_t errsz) {
+    memset(v, 0, sizeof(*v));
+    v->name = xstrdup(name); v->spec = spec;
+    for (; spec[v->n].key; v->n++) {
+        if (v->n >= PV_MAX) die("too many params in spec of %s", name);
+        v->val[v->n] = xstrdup(spec[v->n].def ? spec[v->n].def : "");
+    }
+    char *dup = xstrdup(kvs), *save = NULL;
+    int cur = -1;
+    unsigned char seen[PV_MAX] = {0};
+    for (char *kv = strtok_r(dup, ",", &save); kv; kv = strtok_r(NULL, ",", &save)) {
+        char *eq = strchr(kv, '=');
+        if (!eq) {
+            if (cur < 0) {                                   /* 位置引数: 最初の P_LIST */
+                for (int i = 0; i < v->n && cur < 0; i++) if (spec[i].type == P_LIST) cur = i;
+                if (cur < 0) { snprintf(err, errsz, "%s: expected key=value, got '%s'", name, kv); free(dup); return 0; }
+                if (seen[cur]) { snprintf(err, errsz, "%s: '%s' given twice", name, spec[cur].key); free(dup); return 0; }
+                seen[cur] = 1; free(v->val[cur]); v->val[cur] = xstrdup(kv);
+                continue;
+            }
+            size_t n = strlen(v->val[cur]) + strlen(kv) + 2;
+            char *j = xmalloc(n);
+            snprintf(j, n, "%s,%s", v->val[cur], kv);
+            free(v->val[cur]); v->val[cur] = j;
+            continue;
+        }
+        *eq = 0;
+        int i = 0;
+        while (i < v->n && strcmp(spec[i].key, kv)) i++;
+        if (i == v->n) { snprintf(err, errsz, "%s: unknown param '%s'", name, kv); free(dup); return 0; }
+        if (seen[i]) { snprintf(err, errsz, "%s: '%s' given twice", name, kv); free(dup); return 0; }
+        seen[i] = 1; cur = i;
+        free(v->val[i]); v->val[i] = xstrdup(eq + 1);
+    }
+    free(dup);
+    for (int i = 0; i < v->n; i++)
+        if (!check(&spec[i], v->val[i], err, errsz)) return 0;
+    return 1;
+}
+
+static int find(const param_vals_t *v, const char *key) {
+    for (int i = 0; i < v->n; i++) if (!strcmp(v->spec[i].key, key)) return i;
+    die("internal: plugin %s has no param '%s'", v->name, key);
+}
+int64_t pv_int(const param_vals_t *v, const char *key) {
+    int i = find(v, key);
+    if (v->spec[i].type == P_BYTES) { uint64_t b = 0; parse_bytes(v->val[i], &b); return (int64_t)b; }
+    return strtoll(v->val[i], NULL, 10);
+}
+double pv_dbl(const param_vals_t *v, const char *key) { double d = 0; parse_num(v->val[find(v, key)], &d); return d; }
+const char *pv_str(const param_vals_t *v, const char *key) { return v->val[find(v, key)]; }
+int pv_list(const param_vals_t *v, const char *key, double *out, int max) {
+    char *dup = xstrdup(v->val[find(v, key)]), *save = NULL; int n = 0;
+    for (char *t = strtok_r(dup, ",;", &save); t; t = strtok_r(NULL, ",;", &save)) {
+        if (n >= max) die("%s: list '%s' longer than %d", v->name, key, max);
+        parse_num(t, &out[n++]);
+    }
+    free(dup);
+    return n;
+}
+
+void pv_json(FILE *f, const param_vals_t *v) {
+    fprintf(f, "{ \"name\": \"%s\", \"params\": {", v->name);
+    for (int i = 0; i < v->n; i++) {
+        const param_spec_t *p = &v->spec[i];
+        fprintf(f, "%s\"%s\": ", i ? ", " : "", p->key);
+        if (p->type == P_INT || p->type == P_UINT) fprintf(f, "%lld", (long long)pv_int(v, p->key));   /* 4K・20% も数値で */
+        else if (p->type == P_DOUBLE) fprintf(f, "%.17g", pv_dbl(v, p->key));
+        else if (p->type == P_BYTES) fprintf(f, "%lld", (long long)pv_int(v, p->key));
+        else if (p->type == P_LIST) {
+            double a[256]; int n = pv_list(v, p->key, a, 256);
+            fputc('[', f);
+            for (int j = 0; j < n; j++) fprintf(f, "%s%.17g", j ? ", " : "", a[j]);
+            fputc(']', f);
+        } else fprintf(f, "\"%s\"", v->val[i]);
+    }
+    fputs("} }", f);
+}
+
+void params_print_spec(FILE *f, const param_spec_t *spec) {
+    static const char *tn[] = {"int", "uint", "double", "bytes", "enum", "string", "list"};
+    if (!spec[0].key) { fputs("      (no params)\n", f); return; }
+    for (; spec->key; spec++)
+        fprintf(f, "      %-20s %-7s default=%-10s %s%s%s%s\n", spec->key, tn[spec->type], spec->def ? spec->def : "",
+                spec->help ? spec->help : "", spec->choices ? "  {" : "", spec->choices ? spec->choices : "",
+                spec->choices ? "}" : "");
+}
diff --git a/libCacheSim/cache/eviction/flash/util/params.h b/libCacheSim/cache/eviction/flash/util/params.h
new file mode 100644
index 0000000..db507e1
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/params.h
@@ -0,0 +1,35 @@
+/* params.h — plugin parameters NAME:key=val,...: parsing and type checks */
+#ifndef RF_UTIL_PARAMS_H
+#define RF_UTIL_PARAMS_H
+#include "util.h"
+
+typedef enum { P_INT, P_UINT, P_DOUBLE, P_BYTES, P_ENUM, P_STRING, P_LIST } param_type_t;
+typedef struct {
+    const char  *key;
+    param_type_t type;
+    const char  *def;        /* 既定値の文字列表現 */
+    const char  *choices;    /* P_ENUM のとき "a|b|c" */
+    const char  *help;
+} param_spec_t;              /* 配列の末尾は { NULL } */
+
+#define PV_MAX 48
+typedef struct {
+    const char *name;
+    const param_spec_t *spec;
+    int n;
+    char *val[PV_MAX];       /* spec と同じ順。既定値で補完済み */
+} param_vals_t;
+
+int  parse_bytes(const char *s, uint64_t *out);              /* K/M/G/T（2 進）接尾辞。成功 = 1 */
+int  parse_num(const char *s, double *out);                  /* 数・20%・4K。成功 = 1 */
+void spec_split(const char *spec, char *name, size_t nsz, const char **rest);
+/* 失敗時は err に理由を書いて 0 を返す */
+int  params_build(param_vals_t *v, const char *name, const param_spec_t *spec, const char *kvs,
+                  char *err, size_t errsz);
+int64_t     pv_int(const param_vals_t *v, const char *key);   /* P_INT / P_UINT / P_BYTES */
+double      pv_dbl(const param_vals_t *v, const char *key);
+const char *pv_str(const param_vals_t *v, const char *key);
+int         pv_list(const param_vals_t *v, const char *key, double *out, int max);
+void        pv_json(FILE *f, const param_vals_t *v);
+void        params_print_spec(FILE *f, const param_spec_t *spec);
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/rf_util.h b/libCacheSim/cache/eviction/flash/util/rf_util.h
new file mode 100644
index 0000000..a9a3e26
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/rf_util.h
@@ -0,0 +1,35 @@
+//
+//  rf_util.h — small helpers shared by RegionFlash's modules: fatal errors and
+//  growing arrays.
+//
+
+#ifndef RF_UTIL_H
+#define RF_UTIL_H
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define RF_NONE UINT32_MAX
+
+__attribute__((format(printf, 1, 2), noreturn)) static inline void rf_die(
+    const char *fmt, ...) {
+  va_list ap;
+  va_start(ap, fmt);
+  vfprintf(stderr, fmt, ap);
+  va_end(ap);
+  exit(1);
+}
+
+#define RF_GROW(ptr, cap, need)                                  \
+  do {                                                           \
+    if ((need) > (cap)) {                                        \
+      (cap) = (cap) ? (cap) * 2 : 16;                            \
+      if ((cap) < (need)) (cap) = (need);                        \
+      (ptr) = realloc((ptr), sizeof(*(ptr)) * (size_t)(cap));    \
+      if ((ptr) == NULL) rf_die("RegionFlash: out of memory\n"); \
+    }                                                            \
+  } while (0)
+
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/rng.h b/libCacheSim/cache/eviction/flash/util/rng.h
new file mode 100644
index 0000000..3592b48
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/rng.h
@@ -0,0 +1,37 @@
+/* rng.h — random numbers: xoshiro256** only; hashing: splitmix64 only (the
+ * streams of cachesim, so that runs repeat theirs) */
+#ifndef RF_UTIL_RNG_H
+#define RF_UTIL_RNG_H
+#include <stdint.h>
+
+static inline uint64_t splitmix64(uint64_t x) {
+  x += 0x9e3779b97f4a7c15ULL;
+  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+  return x ^ (x >> 31);
+}
+
+typedef struct {
+  uint64_t s[4];
+} rng_t;
+
+static inline void rng_seed(rng_t *r, uint64_t seed) {
+  for (int i = 0; i < 4; i++) r->s[i] = splitmix64(seed + 0x632be59bd9b4e019ULL * (uint64_t)(i + 1));
+}
+static inline uint64_t rng_rotl(uint64_t x, int k) { return (x << k) | (x >> (64 - k)); }
+static inline uint64_t rng_next(rng_t *r) {
+  uint64_t *s = r->s, res = rng_rotl(s[1] * 5, 7) * 9, t = s[1] << 17;
+  s[2] ^= s[0];
+  s[3] ^= s[1];
+  s[1] ^= s[2];
+  s[0] ^= s[3];
+  s[2] ^= t;
+  s[3] = rng_rotl(s[3], 45);
+  return res;
+}
+static inline double rng_double(rng_t *r) { return (double)(rng_next(r) >> 11) * 0x1.0p-53; }
+static inline uint64_t rng_below(rng_t *r, uint64_t n) {
+  __extension__ typedef unsigned __int128 u128;  // a GCC/Clang extension
+  return (uint64_t)(((u128)rng_next(r) * n) >> 64);
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/segment.c b/libCacheSim/cache/eviction/flash/util/segment.c
new file mode 100644
index 0000000..0491b6c
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/segment.c
@@ -0,0 +1,65 @@
+#include "segment.h"
+
+typedef struct { double W[HS_NB + 1], S[HS_NB + 1], Q[HS_NB + 1]; } pre_t;
+
+static void prefix(const double *x, const double *w, int l, int r, pre_t *p) {
+    p->W[0] = p->S[0] = p->Q[0] = 0;
+    for (int i = 0; i <= r - l; i++) {
+        double wi = w[l + i], xi = x[l + i];
+        p->W[i + 1] = p->W[i] + wi; p->S[i + 1] = p->S[i] + wi * xi; p->Q[i + 1] = p->Q[i] + wi * xi * xi;
+    }
+}
+/* 区間 [a, b]（相対添字、両端含む）の重み付き SSE */
+static double cost(const pre_t *p, int a, int b) {
+    double W = p->W[b + 1] - p->W[a];
+    if (W <= 0) return 0;
+    double S = p->S[b + 1] - p->S[a], c = (p->Q[b + 1] - p->Q[a]) - S * S / W;
+    return c > 0 ? c : 0;
+}
+
+void seg_run(const double *x, const double *w, int l, int r, int jmax, double min_share, seg_t *o) {
+    pre_t p; int n = r - l + 1;
+    o->l = l; o->r = r; o->jmax = jmax < n ? jmax : n;
+    for (int j = 0; j <= HS_NB; j++) o->sse[j] = INFINITY;
+    if (n <= 0) { o->jmax = 0; return; }
+    prefix(x, w, l, r, &p);
+    double wmin = min_share * p.W[n] * (1 - 1e-12);
+    static double dp[HS_NB + 1][HS_NB]; static int arg[HS_NB + 1][HS_NB];
+    for (int e = 0; e < n; e++) dp[1][e] = p.W[e + 1] >= wmin ? cost(&p, 0, e) : INFINITY;
+    for (int j = 2; j <= o->jmax; j++)
+        for (int e = 0; e < n; e++) {
+            dp[j][e] = INFINITY; arg[j][e] = -1;
+            for (int s = j - 1; s <= e; s++) {
+                if (dp[j - 1][s - 1] == INFINITY || p.W[e + 1] - p.W[s] < wmin) continue;
+                double v = dp[j - 1][s - 1] + cost(&p, s, e);
+                if (v < dp[j][e]) { dp[j][e] = v; arg[j][e] = s; }
+            }
+        }
+    for (int j = 1; j <= o->jmax; j++) {
+        o->sse[j] = dp[j][n - 1];
+        if (o->sse[j] == INFINITY) continue;
+        int e = n - 1;
+        for (int i = j - 1; i >= 1; i--) { int s = arg[i + 1][e]; o->start[j][i] = l + s; e = s - 1; }
+        o->start[j][0] = l;
+    }
+}
+
+int seg_elbow(const seg_t *o, double eps) {
+    if (o->jmax < 1) return 0;
+    if (!(o->sse[1] > 0)) return 1;
+    int j = 1;
+    while (j < o->jmax && o->sse[j + 1] < INFINITY && (o->sse[j] - o->sse[j + 1]) / o->sse[1] >= eps) j++;
+    return j;
+}
+
+double seg_sse_cuts(const double *x, const double *w, int l, int r, const int *cuts, int ncut) {
+    pre_t p; double s = 0; int a = 0;
+    if (r < l) return 0;
+    prefix(x, w, l, r, &p);
+    for (int i = 0; i <= ncut; i++) {
+        int b = i < ncut ? cuts[i] - l - 1 : r - l;
+        if (b >= a) s += cost(&p, a, b);
+        a = b + 1;
+    }
+    return s;
+}
diff --git a/libCacheSim/cache/eviction/flash/util/segment.h b/libCacheSim/cache/eviction/flash/util/segment.h
