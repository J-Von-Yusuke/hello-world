+  cache_obj_t *wobj[RF_WMAX];
+  bool wab[RF_WMAX];  // aborted: one of its own pieces was evicted
+  uint32_t nw;
+  uint64_t dram_used, ssd_used, seq, n_rc;
+  rf_tier_t tier[T_N];
+  rf_region_t *reg;
+  uint32_t *rfree, nfree, open[RF_KMAX];
+  uint32_t *pend, npend, cap_pend;  // regions the algorithm dropped by itself
+  rf_piece_t *pc;
+  uint32_t npc, cap_pc, *pcfree, npcfree, cap_pcfree;
+  uint64_t admit_n[RF_KMAX], admit_b[RF_KMAX];  // all-time, for beta
+  rf_fdp_t fdp;
+  rf_ctr_t tot, cls[RF_KMAX], win, cwin[RF_KMAX];
