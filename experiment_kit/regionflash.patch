+static const char *const INC_NAME[] = {"cachelib", "exclusive", "inclusive"};
+static const char *const SSD_NAME[] = {"region", "object"};
+static const char *const SEAL_NAME[] = {"none", "inactive", "all"};
+static const char *const TIER_NAME[] = {"dram-algo", "ssd-algo", "region-evict"};
+
+/* counters: kept for the total and for each hint class, after the warm-up
+ * (tot, cls) and per interval (win, cwin) */
+#define RF_CTRS(X)                                                             \
+  X(reqs) X(req_bytes) X(dram_hits) X(ssd_lookups) X(ssd_hits) X(hit_bytes)    \
+  X(dram_hit_bytes) X(ssd_lookup_bytes) X(ssd_hit_bytes)                       \
+  X(misses) X(miss_bytes) X(size_change_misses) X(dram_evict_objs)             \
+  X(clean_skip_objs) X(ssd_copy_lost_rewrites) X(too_large_objs)               \
+  X(too_large_bytes) X(admit_reject_objs) X(ssd_admit_objs) X(ssd_admit_bytes) \
+  X(ssd_evict_objs) X(ssd_evict_bytes) X(res_sum) X(dead_evict_objs)           \
+  X(dead_evict_bytes) X(oracle_reused_bytes) X(oracle_never_bytes)             \
+  X(regions_sealed) X(regions_evicted) X(pad_bytes)                            \
+  X(flash_region_write_bytes) X(repartition_seals) X(chunk_objs)               \
+  X(chunk_pieces) X(chunk_write_aborts) X(chunk_loss_head)                     \
+  X(chunk_loss_other) X(chunk_orphan_bytes) X(fdp_gc_copy_bytes)              \
+  X(fdp_ru_erases) X(nand_write_bytes) X(reinsert_objs) X(reinsert_bytes)      \
+  X(reinsert_stops) X(delete_objs)
+
+typedef struct {
+#define X(n) uint64_t n;
+  RF_CTRS(X)
+#undef X
+} rf_ctr_t;
+
+/* an inner libCacheSim cache and the removals it reported (candidates) */
+typedef struct {
