diff --git a/libCacheSim/cache/eviction/flash/core/rf_tier.c b/libCacheSim/cache/eviction/flash/core/rf_tier.c
new file mode 100644
index 0000000..212351a
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/core/rf_tier.c
@@ -0,0 +1,127 @@
+//
+//  rf_tier.c — RegionFlash's inner libCacheSim caches: DRAM (dram-algo), the
+//  object-mode SSD (ssd-algo) and region-evict=lcs:<algorithm>. A removal the
+//  inner cache reports is a victim only if find() no longer sees the object.
+//
+#include "../regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ***********************************************************************
+// ****              inner libCacheSim caches (tiers)                 ****
+// ***********************************************************************
+
+void rf_on_remove(void *ctx, obj_id_t id, int64_t size) {
+  rf_params_t *p = (rf_params_t *)ctx;
+  if (p->active < 0) return;
+  rf_tier_t *x = &p->tier[p->active];
+  RF_GROW(x->cand, x->cap_cand, x->ncand + 1);
+  x->cand[x->ncand++] = id;
+}
+
+bool rf_resident(rf_params_t *p, int t, obj_id_t id, int64_t size) {
+  int prev = p->active;
+  p->active = -1;
+  p->req_tmp->obj_id = id;
+  p->req_tmp->obj_size = size;
+  bool r = p->tier[t].c->find(p->tier[t].c, p->req_tmp, false) != NULL;
+  p->active = prev;
+  return r;
+}
+
+/* candidates that find() no longer sees are victims (not internal moves) */
+static void rf_drain(rf_params_t *p, int t) {
+  rf_tier_t *x = &p->tier[t];
+  if (t == T_REG) {
+    rf_reg_collect(p);
+    return;
+  }
+  for (uint32_t i = 0; i < x->ncand; i++) {  // may grow while victims are handled
+    obj_id_t id = x->cand[i];
+    if (id == x->cur) continue;
+    cache_obj_t *o = hashtable_find_obj_id(p->cache->hashtable, id);
+    uint8_t f = t == T_DRAM ? RF_DRAM : RF_SSD;
+    if (o == NULL || !(MD(o).flags & f) || rf_resident(p, t, id, o->obj_size)) continue;
+    MD(o).flags &= ~f;
+    if (t == T_DRAM) {
+      p->dram_used -= (uint64_t)o->obj_size;
+      rf_victim(p, o);
+    } else if (!rf_obj_reinsert(p, o)) {
+      p->ssd_used -= (uint64_t)o->obj_size;
+      rf_evict_account(p, o);
+    }
+  }
+  x->ncand = 0;
+}
+
+/* installed as the inner cache's evict(): one eviction, then its victims */
+static void rf_dram_evict(cache_t *c, const request_t *req) {
+  rf_cur->tier[T_DRAM].evict0(c, req);
+  rf_drain(rf_cur, T_DRAM);
+}
+
+static void rf_ssd_evict(cache_t *c, const request_t *req) {
+  rf_cur->tier[T_SSD].evict0(c, req);
+  rf_drain(rf_cur, T_SSD);
+}
+
+/* one access (get) to an inner cache; returns hit */
+bool rf_tier_get(rf_params_t *p, int t, const request_t *req) {
+  rf_tier_t *x = &p->tier[t];
+  int prev = p->active;
+  obj_id_t prev_cur = x->cur;
+  p->active = t;
+  x->cur = req->obj_id;
+  bool hit = x->c->get(x->c, req);
+  p->active = prev;
+  rf_drain(p, t);  // removals outside evict()
+  x->cur = prev_cur;
+  return hit;
+}
+
+void rf_tier_remove(rf_params_t *p, int t, obj_id_t id) {
+  int prev = p->active;
+  p->active = -1;
+  p->tier[t].c->remove(p->tier[t].c, id);
+  p->active = prev;
+}
+
+void rf_tier_init(rf_params_t *p, int t, const char *algo,
+                         common_cache_params_t cp, uint64_t size) {
+  rf_tier_t *x = &p->tier[t];
+  if (strcasecmp(algo, "RegionFlash") == 0)
+    rf_die("RegionFlash: %s cannot be RegionFlash\n", TIER_NAME[t]);
+  char buf[256];
+  snprintf(buf, sizeof(buf), "%s", p->params[t]);
+  for (char *q = buf; *q; q++)
+    if (*q == '/') *q = ',';
+  cp.cache_size = size;
+  cp.consider_obj_metadata = false;
+  x->c = create_cache_by_name(algo, cp, buf[0] ? buf : NULL);
+  if (x->c == NULL) rf_die("RegionFlash: unknown %s %s\n", TIER_NAME[t], algo);
+  snprintf(x->algo, sizeof(x->algo), "%s", algo);
+  x->evict0 = x->c->evict;
+  if (t == T_DRAM) x->c->evict = rf_dram_evict;
+  if (t == T_SSD) x->c->evict = rf_ssd_evict;
+  x->cur = (obj_id_t)-1;
+}
+
+/* the bytes RegionFlash tracks must be what the inner cache holds */
+void rf_check(const rf_params_t *p) {
+  const uint64_t want[T_N] = {p->dram_used, p->ssd_used, p->n_rc * p->R};
+  for (int t = 0; t < T_N; t++) {
+    const rf_tier_t *x = &p->tier[t];
+    if (x->c == NULL) continue;
+    int64_t got = x->c->get_occupied_byte(x->c);
+    if (got != (int64_t)want[t])
+      rf_die("RegionFlash: %s %s holds %lld B but %llu B are tracked; its "
+             "evictions are not observable\n",
+             TIER_NAME[t], x->algo, (long long)got, (unsigned long long)want[t]);
+  }
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/evict/region_basic.c b/libCacheSim/cache/eviction/flash/evict/region_basic.c
new file mode 100644
index 0000000..909d50f
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/evict/region_basic.c
@@ -0,0 +1,132 @@
+//
+//  region_basic.c — the Region eviction policies ported from cachesim
+//  (rpolicy/reg_basic.c):
+//    fifo  the first sealed
+//    lru   the least recently touched (a write or an SSD hit)
+//    beta  per class, the LRU tail with the largest
+//          (t - last_touch) * (s_ref / mean_c)^beta; s_ref is the smallest
+//          class mean size; beta = 0 is lru (up to ties)
+//  lru takes region-params=fc=<class>/ff=<fraction>: a floor for one class.
+//  When the LRU tail belongs to class fc and fc holds no more than ff * N
+//  sealed regions, the oldest region of another class is evicted instead
+//  (ff = 0, the default, is plain lru).
+//
+
+#include <math.h>
+
+#include "region_policy.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { M_FIFO, M_LRU, M_BETA };
+
+struct rf_rpol {
+  const rf_rview_t *v;
+  int mode;
+  double beta, fc, ff;  // lru: class fc keeps at least ff * N sealed regions
+  uint64_t *useq, cnt;  // lru / beta: order of the last seal or SSD hit
+};
+
+static rf_rpol_t *mk(const rf_rview_t *v, int mode, double beta) {
+  rf_rpol_t *x = calloc(1, sizeof(*x));
+  x->v = v;
+  x->mode = mode;
+  x->beta = beta;
+  x->useq = calloc(v->N, sizeof(uint64_t));
+  return x;
+}
+
+static rf_rpol_t *fifo_create(const rf_rview_t *v, const char *params) {
+  rf_rpol_parse("fifo", params, (const rf_kv_t[]){{NULL, NULL, NULL, 0}});
+  return mk(v, M_FIFO, 0);
+}
+
+static rf_rpol_t *lru_create(const rf_rview_t *v, const char *params) {
+  double fc = 1, ff = 0;
+  rf_rpol_parse("lru", params,
+                (const rf_kv_t[]){{"fc", &fc, NULL, 0}, {"ff", &ff, NULL, 0}, {NULL, NULL, NULL, 0}});
+  rf_rpol_t *x = mk(v, M_LRU, 0);
+  x->fc = fc, x->ff = ff;
+  return x;
+}
+
+static rf_rpol_t *beta_create(const rf_rview_t *v, const char *params) {
+  double beta = 0;
+  rf_rpol_parse("beta", params,
+                (const rf_kv_t[]){{"beta", &beta, NULL, 0}, {NULL, NULL, NULL, 0}});
+  return mk(v, M_BETA, beta);
+}
+
+static void destroy(rf_rpol_t *x) {
+  free(x->useq);
+  free(x);
+}
+
+static void on_seal(rf_rpol_t *x, uint32_t r) { x->useq[r] = ++x->cnt; }
+
+static void on_touch(rf_rpol_t *x, uint32_t r) {
+  if (x->mode != M_FIFO) x->useq[r] = ++x->cnt;
+}
+
+/* is region a older than b in the eviction order */
+static bool older(const rf_rpol_t *x, uint32_t a, uint32_t b) {
+  const rf_region_t *ga = &x->v->reg[a], *gb = &x->v->reg[b];
+  if (x->mode == M_FIFO) return ga->seq < gb->seq;
+  return ga->last_touch_t < gb->last_touch_t ||
+         (ga->last_touch_t == gb->last_touch_t && x->useq[a] < x->useq[b]);
+}
+
+static double class_mean(const rf_rview_t *v, uint32_t c) {
+  return v->admit_n[c] ? (double)v->admit_b[c] / (double)v->admit_n[c] : NAN;
+}
+
+static uint32_t pick(rf_rpol_t *x) {
+  const rf_rview_t *v = x->v;
+  uint32_t tail[256], n[256] = {0};
+  bool per_class = x->mode == M_BETA || x->ff > 0;
+  for (uint32_t c = 0; c < 256; c++) tail[c] = RF_NONE;
+  for (uint32_t r = 0; r < v->N; r++) {
+    if (v->reg[r].state != RF_R_SEALED) continue;
+    uint32_t c = per_class ? v->reg[r].cls : 0;
+    n[c]++;
+    if (tail[c] == RF_NONE || older(x, r, tail[c])) tail[c] = r;
+  }
+  if (x->mode == M_LRU && x->ff > 0) {  // the oldest overall, skipping class fc at its floor
+    uint32_t fc = (uint32_t)x->fc, best = RF_NONE;
+    bool floor = n[fc] <= x->ff * v->N;
+    for (uint32_t c = 0; c < 256; c++)
+      if (tail[c] != RF_NONE && !(floor && c == fc) && (best == RF_NONE || older(x, tail[c], best))) best = tail[c];
+    return best != RF_NONE ? best : tail[fc];
+  }
+  if (x->mode != M_BETA) return tail[0];
+  double sref = INFINITY, best_score = -INFINITY;
+  uint32_t best = RF_NONE;
+  for (uint32_t c = 0; c < v->kmax; c++) {
+    double m = class_mean(v, c);
+    if (m == m && m < sref) sref = m;
+  }
+  for (uint32_t c = 0; c < v->kmax; c++) {
+    if (tail[c] == RF_NONE) continue;
+    double m = class_mean(v, c);
+    double w = (m == m && sref < INFINITY) ? pow(sref / m, x->beta) : 1.0;
+    double score = (double)(*v->t - v->reg[tail[c]].last_touch_t) * w;
+    if (score > best_score) {
+      best_score = score;
+      best = tail[c];
+    }
+  }
+  return best;
+}
+
+const rf_rpol_ops_t rf_rpol_fifo_ops = {"fifo", fifo_create, destroy, on_seal, on_touch,
+                                        pick, NULL, NULL, NULL};
+const rf_rpol_ops_t rf_rpol_lru_ops = {"lru", lru_create, destroy, on_seal, on_touch,
+                                       pick, NULL, NULL, NULL};
+const rf_rpol_ops_t rf_rpol_beta_ops = {"beta", beta_create, destroy, on_seal, on_touch,
+                                        pick, NULL, NULL, NULL};
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/evict/region_gl.c b/libCacheSim/cache/eviction/flash/evict/region_gl.c
new file mode 100644
index 0000000..acbded2
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/evict/region_gl.c
@@ -0,0 +1,370 @@
+//
+//  region_gl.c — region-evict=gl: GL-Cache's group-level learning with the
+//  group = a sealed Region, evicted whole (GL-Cache merges two groups and keeps
+//  the better half; on flash that is rewriting: reinsert=score does it).
+//
+//  As GL-Cache (cache/eviction/GLCache), it learns a region's utility from its
+//  features. Every Q requests (a boundary) it
+//    1. closes the snapshots older than the label window W: their rows join
+//       the last `hist` rows, and the model (gl_model.h) is trained on those,
+//    2. takes a snapshot of `sample` sealed regions not taken before (a region
+//       is taken once per sealing, so a snapshot's regions differ from every
+//       other open one and an object carries one mark at most): each row is a
+//       region's features then; its label is the utility its objects show in
+//       the window: on the first request of each after the snapshot,
+//       += 1e6 / (requests since the snapshot + 1) / size, also if the object
+//       left the cache meanwhile (a ghost entry of its snapshot keeps it).
+//  W defaults to the mean lifetime of a region (sealed to evicted, measured
+//  as it runs; boundaries start at the first eviction) and Q to W / 4: the
+//  label sees the reuse a region's objects get while it could live, and the
+//  model is retrained 4 times as often. label=oracle uses the oracle utility
+//  at the snapshot instead (GL-Cache's train-source-y=oracle). Until the first
+//  model, it evicts with the built-in policy warm= names (region_basic.c).
+//  Then it predicts every sealed region's utility, ranks them (lowest first)
+//  and evicts in that order for ceil(rank-intvl * N) evictions.
+//
+//  Features (GL-Cache's: age, mean object size, hits, active objects, request
+//  rate, miss ratio; in requests rather than seconds, and request rate and miss
+//  ratio replaced by what a region has):
+//    age since sealed, requests since the last touch, touches, objects hit at
+//    least once since written, valid bytes / R, mean valid entry size, class.
+//
+//  region-params: window=W (requests, 0: auto), retrain-req=Q (requests, 0:
+//  W / 4), sample=S (regions per snapshot, default 64, 0: all), hist=H (rows
+//  trained on, default 1024), rank-intvl=F (default 0.02), label=online|oracle,
+//  ylog=0|1 (log(1 + utility), default 1; GL-Cache: 0), warm=fifo|lru (default
+//  lru; GL-Cache: fifo).
+//
+
+#include <math.h>
+#include <string.h>
+
+#include "../core/gl_model.h"
+#include "dataStructure/hashtable/hashtable.h"
+#include "region_policy.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GL_NF 7     // features
+#define GL_SNAP 8   // snapshots open at once
+#define GMD(o) ((o)->RegionFlash)
+
+typedef struct {
+  int64_t t0;  // taken at
+  uint32_t n;  // rows [slot * sample, slot * sample + n)
+  bool open;
+  hashtable_t *ghost;  // its objects that left the cache
+  uint64_t n_ghost;
+} gl_snap_t;
+
+struct rf_rpol {
+  const rf_rview_t *v;
+  /* parameters */
+  double intvl, ylog, window_p, retrain_p, sample_p, hist_p;
+  char label[16], warm[8];
+  bool oracle_label;
+  uint32_t sample, hist;
+  const rf_rpol_ops_t *wops;  // the policy until the first model
+  rf_rpol_t *wpol;
+  /* learner and ranking */
+  gl_model_t *m;
+  rf_rank_t rank;
+  float *fx, *pr;  // features [N * GL_NF] and predictions [N] of a ranking
+  /* snapshots and their rows */
+  gl_snap_t snap[GL_SNAP];
+  float *rx, *ry;     // [GL_SNAP * sample]
+  uint8_t *rgen;      // a row's generation: a mark is valid while it matches
+  uint64_t *taken;    // [N] the region's seq when last taken (0: never)
+  uint32_t cursor;
+  float *hx, *hy;     // the last `hist` closed rows (a ring)
+  uint32_t hn, hpos;
+  /* schedule */
+  double life;  // mean region lifetime (requests)
+  uint64_t n_life;
+  int64_t next_t;  // the next boundary
+  request_t *req;
+  /* statistics */
+  uint64_t n_train, n_snap, n_warm, n_ghost_hit, n_label_hit;
+  uint32_t last_rows, last_rounds;
+};
+
+static double gl_window(const rf_rpol_t *x) {
+  return x->window_p > 0 ? x->window_p : x->life;
+}
+
+static double gl_retrain(const rf_rpol_t *x) {
+  double q = x->retrain_p > 0 ? x->retrain_p : gl_window(x) / 4;
+  return q < 1 ? 1 : q;
+}
+
+/* the region's features at time t */
+static void gl_features(const rf_rview_t *v, uint32_t r, float *f) {
+  const rf_region_t *g = &v->reg[r];
+  int64_t t = *v->t;
+  f[0] = (float)(t - g->seal_t);
+  f[1] = (float)(t - g->last_touch_t);
+  f[2] = (float)g->touches;
+  f[3] = (float)g->nactive;
+  f[4] = (float)((double)g->valid / (double)v->R);
+  f[5] = g->nvalid ? (float)((double)g->valid / g->nvalid) : 0;
+  f[6] = (float)g->cls;
+}
+
+static bool gl_mark_valid(const rf_rpol_t *x, uint32_t row, uint8_t gen) {
+  return gen != 0 && row < GL_SNAP * x->sample && x->rgen[row] == gen &&
+         x->snap[row / x->sample].open;
+}
+
+static void gl_label(rf_rpol_t *x, uint32_t row, int64_t size) {
+  double age = (double)(*x->v->t - x->snap[row / x->sample].t0) + 1;
+  x->ry[row] += (float)(1.0e6 / age / (double)size);
+}
+
+static void gl_train(rf_rpol_t *x) {
+  if (x->hn == 0) return;
+  float *y = malloc(x->hn * sizeof(float));
+  for (uint32_t i = 0; i < x->hn; i++) y[i] = x->ylog > 0 ? (float)log1p(x->hy[i]) : x->hy[i];
+  uint32_t rounds = gl_model_train(x->m, x->hx, y, x->hn);
+  free(y);
+  if (rounds == 0) return;
+  x->n_train++;
+  x->last_rows = x->hn;
+  x->last_rounds = rounds;
+  x->rank.used = x->rank.every;  // rank again with the new model
+}
+
+/* a snapshot's rows join the training rows; its ghosts go */
+static void gl_close(rf_rpol_t *x, uint32_t s) {
+  gl_snap_t *sn = &x->snap[s];
+  for (uint32_t i = 0; i < sn->n; i++) {
+    uint32_t row = s * x->sample + i;
+    memcpy(x->hx + (size_t)x->hpos * GL_NF, x->rx + (size_t)row * GL_NF, GL_NF * sizeof(float));
+    x->hy[x->hpos] = x->ry[row];
+    x->hpos = (x->hpos + 1) % x->hist;
+    if (x->hn < x->hist) x->hn++;
+  }
+  if (sn->ghost != NULL) free_hashtable(sn->ghost);
+  sn->ghost = NULL;
+  sn->n_ghost = 0;
+  sn->open = false;
+}
+
+/* take `sample` sealed regions not taken since sealed into slot s */
+static void gl_take(rf_rpol_t *x, uint32_t s) {
+  const rf_rview_t *v = x->v;
+  gl_snap_t *sn = &x->snap[s];
+  sn->t0 = *v->t;
+  sn->n = 0;
+  sn->open = true;
+  if (!x->oracle_label) sn->ghost = create_hashtable(12);
+  for (uint32_t k = 0; k < v->N && sn->n < x->sample; k++) {
+    uint32_t r = (x->cursor + k) % v->N;
+    const rf_region_t *g = &v->reg[r];
+    if (g->state != RF_R_SEALED || x->taken[r] == g->seq) continue;
+    x->taken[r] = g->seq;
+    uint32_t row = s * x->sample + sn->n++;
+    x->rgen[row] = (uint8_t)(x->rgen[row] % 255 + 1);
+    gl_features(v, r, x->rx + (size_t)row * GL_NF);
+    x->ry[row] = x->oracle_label ? (float)rf_region_utility(v, r) : 0;
+    rf_obj_iter_t it = {g, 0, NULL};
+    for (cache_obj_t *o; !x->oracle_label && (o = rf_obj_next(&it)) != NULL;) {
+      GMD(o).snap_row = row;
+      GMD(o).snap_gen = x->rgen[row];
+    }
+    x->cursor = (r + 1) % v->N;
+  }
+  x->n_snap++;
+}
+
+/* a boundary: close what the window has passed, train, take a snapshot */
+static void gl_boundary(rf_rpol_t *x) {
+  int64_t t = *x->v->t;
+  bool closed = false;
+  uint32_t free_s = GL_SNAP, oldest = GL_SNAP;
+  for (uint32_t s = 0; s < GL_SNAP; s++) {
+    if (x->snap[s].open && (double)(t - x->snap[s].t0) >= gl_window(x)) {
+      gl_close(x, s);
+      closed = true;
+    }
+    if (!x->snap[s].open && free_s == GL_SNAP) free_s = s;
+    if (x->snap[s].open && (oldest == GL_SNAP || x->snap[s].t0 < x->snap[oldest].t0)) oldest = s;
+  }
+  if (free_s == GL_SNAP) {  // every slot open: the oldest closes early
+    gl_close(x, oldest);
+    closed = true;
+    free_s = oldest;
+  }
+  gl_take(x, free_s);
+  if (x->oracle_label) {  // labeled now: a training row at once
+    gl_close(x, free_s);
+    closed = true;
+  }
+  if (closed) gl_train(x);
+}
+
+// ***********************************************************************
+// ****                        policy hooks                           ****
+// ***********************************************************************
+static rf_rpol_t *create(const rf_rview_t *v, const char *params) {
+  rf_rpol_t *x = calloc(1, sizeof(*x));
+  x->v = v;
+  x->intvl = 0.02;
+  x->ylog = 1;
+  x->sample_p = 64;
+  x->hist_p = 1024;
+  snprintf(x->label, sizeof(x->label), "online");
+  snprintf(x->warm, sizeof(x->warm), "lru");
+  rf_rpol_parse("gl", params,
+                (const rf_kv_t[]){{"window", &x->window_p, NULL, 0},
+                                  {"retrain-req", &x->retrain_p, NULL, 0},
+                                  {"sample", &x->sample_p, NULL, 0},
+                                  {"hist", &x->hist_p, NULL, 0},
+                                  {"rank-intvl", &x->intvl, NULL, 0},
+                                  {"label", NULL, x->label, sizeof(x->label)},
+                                  {"ylog", &x->ylog, NULL, 0},
+                                  {"warm", NULL, x->warm, sizeof(x->warm)},
+                                  {NULL, NULL, NULL, 0}});
+  if (strcmp(x->label, "online") != 0 && strcmp(x->label, "oracle") != 0)
+    rf_die("region-evict gl: label must be online or oracle\n");
+  x->oracle_label = strcmp(x->label, "oracle") == 0;
+  if (strcmp(x->warm, "fifo") != 0 && strcmp(x->warm, "lru") != 0)
+    rf_die("region-evict gl: warm must be fifo or lru\n");
+  x->wops = rf_rpol_find(x->warm);
+  x->wpol = x->wops->create(v, "");
+  x->sample = x->sample_p > 0 && x->sample_p < v->N ? (uint32_t)x->sample_p : v->N;
+  x->hist = x->hist_p >= 1 ? (uint32_t)x->hist_p : 1;
+  x->next_t = INT64_MAX;  // no boundary before the first eviction
+  x->m = gl_model_new(GL_NF);
+  rf_rank_init(&x->rank, v, x->intvl);
+  x->fx = malloc((size_t)v->N * GL_NF * sizeof(float));
+  x->pr = malloc(v->N * sizeof(float));
+  x->rx = malloc((size_t)GL_SNAP * x->sample * GL_NF * sizeof(float));
+  x->ry = malloc((size_t)GL_SNAP * x->sample * sizeof(float));
+  x->rgen = calloc((size_t)GL_SNAP * x->sample, 1);
+  x->taken = calloc(v->N, sizeof(uint64_t));
+  x->hx = malloc((size_t)x->hist * GL_NF * sizeof(float));
+  x->hy = malloc(x->hist * sizeof(float));
+  x->req = new_request();
+  return x;
+}
+
+static void destroy(rf_rpol_t *x) {
+  x->wops->destroy(x->wpol);
+  gl_model_free(x->m);
+  rf_rank_free(&x->rank);
+  for (uint32_t s = 0; s < GL_SNAP; s++)
+    if (x->snap[s].ghost != NULL) free_hashtable(x->snap[s].ghost);
+  free_request(x->req);
+  free(x->fx);
+  free(x->pr);
+  free(x->rx);
+  free(x->ry);
+  free(x->rgen);
+  free(x->taken);
+  free(x->hx);
+  free(x->hy);
+  free(x);
+}
+
+/* before a ranking: predict every sealed region in one batch */
+static void gl_prep(void *ctx) {
+  rf_rpol_t *x = ctx;
+  const rf_rview_t *v = x->v;
+  uint32_t n = 0, *id = malloc(v->N * sizeof(uint32_t));
+  for (uint32_t r = 0; r < v->N; r++) {
+    if (v->reg[r].state != RF_R_SEALED) continue;
+    gl_features(v, r, x->fx + (size_t)n * GL_NF);
+    id[n++] = r;
+  }
+  float *out = malloc((n ? n : 1) * sizeof(float));
+  if (n) gl_model_predict(x->m, x->fx, n, out);
+  for (uint32_t i = 0; i < n; i++) x->pr[id[i]] = out[i];
+  free(out);
+  free(id);
+}
+
+static double gl_score(void *ctx, uint32_t r) { return ((rf_rpol_t *)ctx)->pr[r]; }
+
+static uint32_t pick(rf_rpol_t *x) {
+  const rf_rview_t *v = x->v;
+  uint32_t r;
+  if (gl_model_ready(x->m)) {
+    r = rf_rank_next(&x->rank, v, gl_score, gl_prep, x);
+  } else {  // warm= until the first model
+    x->n_warm++;
+    r = x->wops->pick(x->wpol);
+  }
+  if (r != RF_NONE) {  // its lifetime: the window's measure
+    double l = (double)(*v->t - v->reg[r].seal_t);
+    x->life = x->n_life++ ? x->life + (l - x->life) / 16 : l;
+    if (x->next_t == INT64_MAX) x->next_t = *v->t;  // boundaries start
+  }
+  return r;
+}
+
+/* the warm-up policy keeps its order all along (sealing, SSD hits) */
+static void on_seal(rf_rpol_t *x, uint32_t r) { x->wops->on_seal(x->wpol, r); }
+static void on_touch(rf_rpol_t *x, uint32_t r) { x->wops->on_touch(x->wpol, r); }
+
+/* a boundary when due; the first request of a snapshot's object since the
+ * snapshot labels its row */
+static void on_request(rf_rpol_t *x, const request_t *req, cache_obj_t *o) {
+  int64_t t = *x->v->t;
+  if (t >= x->next_t) {
+    gl_boundary(x);
+    x->next_t = t + (int64_t)gl_retrain(x);
+  }
+  if (x->oracle_label) return;
+  if (o != NULL && gl_mark_valid(x, GMD(o).snap_row, GMD(o).snap_gen)) {
+    gl_label(x, GMD(o).snap_row, o->obj_size);
+    GMD(o).snap_gen = 0;
+    x->n_label_hit++;
+    return;
+  }
+  for (uint32_t s = 0; s < GL_SNAP; s++) {
+    gl_snap_t *sn = &x->snap[s];
+    if (!sn->open || sn->n_ghost == 0) continue;
+    cache_obj_t *g = hashtable_find_obj_id(sn->ghost, req->obj_id);
+    if (g == NULL) continue;
+    if (gl_mark_valid(x, GMD(g).snap_row, GMD(g).snap_gen))
+      gl_label(x, GMD(g).snap_row, g->obj_size);
+    hashtable_delete(sn->ghost, g);
+    sn->n_ghost--;
+    x->n_ghost_hit++;
+    return;
+  }
+}
+
+/* an object of an open snapshot leaves the cache: a ghost keeps its row */
+static void on_delete(rf_rpol_t *x, const cache_obj_t *o) {
+  if (x->oracle_label || !gl_mark_valid(x, GMD(o).snap_row, GMD(o).snap_gen)) return;
+  gl_snap_t *sn = &x->snap[GMD(o).snap_row / x->sample];
+  x->req->obj_id = o->obj_id;
+  x->req->obj_size = o->obj_size;
+  cache_obj_t *g = hashtable_insert(sn->ghost, x->req);
+  GMD(g).snap_row = GMD(o).snap_row;
+  GMD(g).snap_gen = GMD(o).snap_gen;
+  sn->n_ghost++;
+}
+
+static void report(const rf_rpol_t *x, FILE *f) {
+  fprintf(f,
+          "{\"window\": %.0f, \"retrain_req\": %.0f, \"sample\": %u, \"hist\": %u, "
+          "\"rank_intvl\": %g, \"label\": \"%s\", \"ylog\": %g, \"warm\": \"%s\", "
+          "\"region_lifetime\": %.0f, \"snapshots\": %llu, \"trainings\": %llu, "
+          "\"warm_picks\": %llu, \"rankings\": %llu, \"last_rows\": %u, \"last_rounds\": %u, "
+          "\"label_hits\": %llu, \"ghost_hits\": %llu}",
+          gl_window(x), gl_retrain(x), x->sample, x->hist, x->intvl, x->label, x->ylog, x->warm,
+          x->life, (unsigned long long)x->n_snap, (unsigned long long)x->n_train,
+          (unsigned long long)x->n_warm, (unsigned long long)x->rank.n_rank, x->last_rows,
+          x->last_rounds, (unsigned long long)x->n_label_hit, (unsigned long long)x->n_ghost_hit);
+}
+
+const rf_rpol_ops_t rf_rpol_gl_ops = {"gl", create, destroy, on_seal, on_touch, pick,
+                                      on_request, on_delete, report};
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/evict/region_lcs.c b/libCacheSim/cache/eviction/flash/evict/region_lcs.c
new file mode 100644
index 0000000..860b154
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/evict/region_lcs.c
@@ -0,0 +1,91 @@
+//
+//  region_lcs.c — region-evict=lcs:<algorithm>: a libCacheSim cache whose
+//  objects are the sealed regions (R bytes each) chooses which to evict. It
+//  may also drop regions by itself (on an insert or a hit); those become
+//  pending evictions, done where a region may vanish (rf_reg_flush).
+//
+#include "../regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* region-evict=<algorithm>: a sealed region is an object of R bytes */
+static request_t *rf_reg_req(rf_params_t *p, uint64_t oid) {
+  p->req_reg->obj_id = oid;
+  p->req_reg->obj_size = (int64_t)p->R;
+  p->req_reg->clock_time = p->req_local->clock_time;
+  return p->req_reg;
+}
+
+/* a sealed region enters the algorithm (a miss, then an insert) */
+void rf_lcs_on_seal(rf_params_t *p, uint32_t r) {
+  rf_region_t *g = &p->reg[r];
+  g->oid = g->seq * p->N + r;  // unique per seal, region = oid % N
+  if (rf_tier_get(p, T_REG, rf_reg_req(p, g->oid)))
+    rf_die("RegionFlash: region-evict %s already held a new region\n",
+           p->tier[T_REG].algo);
+  if (rf_resident(p, T_REG, g->oid, (int64_t)p->R)) {
+    p->n_rc++;
+  } else {  // declined (admission inside the algorithm): evict it next
+    g->oid = 0;
+    RF_GROW(p->pend, p->cap_pend, p->npend + 1);
+    p->pend[p->npend++] = r;
+  }
+}
+
+/* a sealed region was read: a hit in the algorithm */
+void rf_lcs_on_touch(rf_params_t *p, uint32_t r) {
+  rf_region_t *g = &p->reg[r];
+  if (g->oid == 0) return;  // pending eviction
+  if (!rf_tier_get(p, T_REG, rf_reg_req(p, g->oid)))
+    rf_die("RegionFlash: region-evict %s lost a sealed region\n",
+           p->tier[T_REG].algo);
+}
+
+/* the algorithm picks: every sealed region it no longer holds is evicted */
+void rf_lcs_evict(rf_params_t *p) {
+  rf_tier_t *x = &p->tier[T_REG];
+  for (uint64_t k = 0; p->npend == 0; k++) {  // an evict() may only move one
+    if (k > p->N) rf_die("RegionFlash: region-evict %s evicts no region\n", x->algo);
+    int prev = p->active;
+    p->active = T_REG;
+    x->evict0(x->c, rf_reg_req(p, 0));
+    p->active = prev;
+    rf_reg_collect(p);
+  }
+  rf_reg_flush(p);
+}
+
+/* region-evict=<algorithm>: the sealed regions it reported and no longer
+ * holds become pending evictions (it may drop some on an insert or a hit) */
+uint32_t rf_reg_collect(rf_params_t *p) {
+  rf_tier_t *x = &p->tier[T_REG];
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < x->ncand; i++) {
+    uint64_t id = x->cand[i];
+    rf_region_t *g = &p->reg[id % p->N];
+    if (g->state != RF_R_SEALED || g->oid != id || rf_resident(p, T_REG, id, (int64_t)p->R))
+      continue;
+    g->oid = 0;  // no longer in the algorithm (0 is never a seal id)
+    p->n_rc--;
+    RF_GROW(p->pend, p->cap_pend, p->npend + 1);
+    p->pend[p->npend++] = (uint32_t)(id % p->N);
+    n++;
+  }
+  x->ncand = 0;
+  return n;
+}
+
+/* evict the pending regions; called where a region may vanish: before a
+ * write and at the end of a request (never inside a hit or a seal, whose
+ * caller still holds the region) */
+void rf_reg_flush(rf_params_t *p) {
+  for (uint32_t i = 0; i < p->npend; i++)
+    if (p->reg[p->pend[i]].state == RF_R_SEALED) rf_evict_region(p, p->pend[i]);
+  p->npend = 0;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/evict/region_oracle.c b/libCacheSim/cache/eviction/flash/evict/region_oracle.c
new file mode 100644
index 0000000..237efa3
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/evict/region_oracle.c
@@ -0,0 +1,113 @@
+//
+//  region_oracle.c — region-evict=oracle: evict the sealed region whose valid
+//  objects are worth the least from now on, by their next access (GL-Cache's
+//  oracle segment utility, sum of 1e8 / size / requests-until-next-access,
+//  whole-region deletion, no merge). An upper bound for any policy that only
+//  chooses which region to evict; needs next-access times (oracleGeneral).
+//
+//  region-params: rank-intvl=F (0: rank before every eviction, default; else
+//  rank once per ceil(F * N) evictions, as GL-Cache).
+//
+
+#include <math.h>
+
+#include "region_policy.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct rf_rpol {
+  const rf_rview_t *v;
+  rf_rank_t rank;
+  double intvl;
+  bool checked;
+  /* dispersion of utility, measured at every 16th ranking (report) */
+  uint64_t n_stat;
+  double cv_obj, cv_reg, n_mean;
+};
+
+/* is the utility of a region's objects spread less between regions than
+ * between objects? With n objects placed at random, the CV of the region
+ * means would be the objects' CV / sqrt(n). Accumulates, per measurement:
+ * the objects' CV (all valid objects), the CV of the region means and the
+ * mean number of objects per region */
+static void oracle_stats(rf_rpol_t *x) {
+  const rf_rview_t *v = x->v;
+  double o1 = 0, o2 = 0, on = 0, r1 = 0, r2 = 0, rn = 0;
+  for (uint32_t r = 0; r < v->N; r++) {
+    if (v->reg[r].state != RF_R_SEALED) continue;
+    rf_obj_iter_t it = {&v->reg[r], 0, NULL};
+    double s = 0, n = 0;
+    for (cache_obj_t *o; (o = rf_obj_next(&it)) != NULL; n++) {
+      double u = rf_obj_utility(o, *v->t);
+      s += u;
+      o2 += u * u;
+    }
+    o1 += s;
+    on += n;
+    if (n == 0) continue;
+    r1 += s / n;
+    r2 += (s / n) * (s / n);
+    rn++;
+  }
+  if (rn < 2 || o1 <= 0) return;
+  double om = o1 / on, rm = r1 / rn;
+  x->cv_obj += sqrt(fmax(o2 / on - om * om, 0)) / om;
+  x->cv_reg += sqrt(fmax(r2 / rn - rm * rm, 0)) / rm;
+  x->n_mean += on / rn;
+  x->n_stat++;
+}
+
+static rf_rpol_t *create(const rf_rview_t *v, const char *params) {
+  rf_rpol_t *x = calloc(1, sizeof(*x));
+  x->v = v;
+  rf_rpol_parse("oracle", params,
+                (const rf_kv_t[]){{"rank-intvl", &x->intvl, NULL, 0}, {NULL, NULL, NULL, 0}});
+  rf_rank_init(&x->rank, v, x->intvl);
+  return x;
+}
+
+static void destroy(rf_rpol_t *x) {
+  rf_rank_free(&x->rank);
+  free(x);
+}
+
+static double score(void *ctx, uint32_t r) {
+  return rf_region_utility(((const rf_rpol_t *)ctx)->v, r);
+}
+
+static void prep(void *ctx) {
+  rf_rpol_t *x = ctx;
+  if (x->rank.n_rank % 16 == 0) oracle_stats(x);  // before the 1st, 17th, ... ranking
+}
+
+static uint32_t pick(rf_rpol_t *x) { return rf_rank_next(&x->rank, x->v, score, prep, x); }
+
+static void on_request(rf_rpol_t *x, const request_t *req, cache_obj_t *o) {
+  if (x->checked) return;
+  if (req->next_access_vtime == -2)
+    rf_die("region-evict oracle needs next-access times (an oracleGeneral or lcs trace)\n");
+  x->checked = true;
+}
+
+static void report(const rf_rpol_t *x, FILE *f) {
+  fprintf(f, "{\"rank_intvl\": %g, \"picks_per_ranking\": %u, \"rankings\": %llu, \"dispersion\": ",
+          x->intvl, x->rank.every, (unsigned long long)x->rank.n_rank);
+  double k = (double)x->n_stat;
+  if (x->n_stat == 0)
+    fputs("null}", f);
+  else
+    fprintf(f,
+            "{\"measurements\": %llu, \"cv_objects\": %.6g, \"cv_region_means\": %.6g, "
+            "\"objects_per_region\": %.6g, \"cv_random_placement\": %.6g}}",
+            (unsigned long long)x->n_stat, x->cv_obj / k, x->cv_reg / k, x->n_mean / k,
+            x->cv_obj / k / sqrt(x->n_mean / k));
+}
+
+const rf_rpol_ops_t rf_rpol_oracle_ops = {"oracle", create, destroy, NULL, NULL, pick,
+                                          on_request, NULL, report};
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/evict/region_policy.c b/libCacheSim/cache/eviction/flash/evict/region_policy.c
new file mode 100644
index 0000000..06e7fd2
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/evict/region_policy.c
@@ -0,0 +1,144 @@
+//
+//  region_policy.c — what the Region eviction policies share: the table of
+//  built-in policies, their parameters, ranking, and the oracle utility.
+//
+
+#include "region_policy.h"
+
+#include <math.h>
+#include <string.h>
+#include <strings.h>
+
+#include "libCacheSim/const.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern const rf_rpol_ops_t rf_rpol_fifo_ops, rf_rpol_lru_ops, rf_rpol_beta_ops,
+    rf_rpol_oracle_ops, rf_rpol_gl_ops, rf_rpol_sfifo_ops;
+static const rf_rpol_ops_t *const RF_RPOLS[] = {&rf_rpol_fifo_ops,   &rf_rpol_lru_ops,
+                                                &rf_rpol_beta_ops,   &rf_rpol_oracle_ops,
+                                                &rf_rpol_gl_ops,     &rf_rpol_sfifo_ops, NULL};
+
+const rf_rpol_ops_t *rf_rpol_find(const char *name) {
+  for (const rf_rpol_ops_t *const *x = RF_RPOLS; *x != NULL; x++)
+    if (strcasecmp((*x)->name, name) == 0) return *x;
+  return NULL;
+}
+
+void rf_rpol_parse(const char *policy, const char *params, const rf_kv_t *kv) {
+  char buf[512], *cur = buf;
+  snprintf(buf, sizeof(buf), "%s", params != NULL ? params : "");
+  for (char *tok; (tok = strsep(&cur, "/")) != NULL;) {
+    if (*tok == '\0') continue;
+    char *val = strchr(tok, '=');
+    if (val == NULL) rf_die("region-evict %s: parameter %s has no value\n", policy, tok);
+    *val++ = '\0';
+    const rf_kv_t *k = kv;
+    while (k->key != NULL && strcasecmp(k->key, tok) != 0) k++;
+    if (k->key == NULL) rf_die("region-evict %s does not have parameter %s\n", policy, tok);
+    if (k->num != NULL) {
+      char *end;
+      *k->num = strtod(val, &end);
+      if (end == val || *end != '\0')
+        rf_die("region-evict %s: %s=%s is not a number\n", policy, tok, val);
+    } else {
+      snprintf(k->word, k->n, "%s", val);
+    }
+  }
+}
+
+// ***********************************************************************
+// ****                           ranking                             ****
+// ***********************************************************************
+void rf_rank_init(rf_rank_t *k, const rf_rview_t *v, double intvl) {
+  memset(k, 0, sizeof(*k));
+  k->id = malloc(v->N * sizeof(uint32_t));
+  k->seq = malloc(v->N * sizeof(uint64_t));
+  k->score = malloc(v->N * sizeof(double));
+  double e = ceil(intvl * v->N);  // picks per ranking, at least 1
+  k->every = e < 1 ? 1 : (uint32_t)e;
+}
+
+void rf_rank_free(rf_rank_t *k) {
+  free(k->id);
+  free(k->seq);
+  free(k->score);
+}
+
+/* sort by score, then by seal order: a merge sort on indices (stable and
+ * deterministic, no qsort context) */
+static void rf_rank_sort(rf_rank_t *k, uint32_t *tmp) {
+  uint32_t n = k->n, *a = k->id, *b = tmp;
+  for (uint32_t w = 1; w < n; w *= 2) {
+    for (uint32_t lo = 0; lo < n; lo += 2 * w) {
+      uint32_t mid = lo + w < n ? lo + w : n, hi = lo + 2 * w < n ? lo + 2 * w : n;
+      uint32_t i = lo, j = mid, o = lo;
+      while (i < mid && j < hi) {
+        uint32_t x = a[i], y = a[j];
+        bool take_y = k->score[y] < k->score[x] ||
+                      (k->score[y] == k->score[x] && k->seq[y] < k->seq[x]);
+        b[o++] = take_y ? a[j++] : a[i++];
+      }
+      while (i < mid) b[o++] = a[i++];
+      while (j < hi) b[o++] = a[j++];
+    }
+    uint32_t *t = a;
+    a = b;
+    b = t;
+  }
+  if (a != k->id) memcpy(k->id, a, n * sizeof(uint32_t));
+}
+
+static void rf_rank_build(rf_rank_t *k, const rf_rview_t *v, rf_score_fn fn,
+                          rf_prep_fn prep, void *ctx) {
+  if (prep != NULL) prep(ctx);
+  k->n = k->pos = k->used = 0;
+  for (uint32_t r = 0; r < v->N; r++) {
+    if (v->reg[r].state != RF_R_SEALED) continue;
+    k->id[k->n++] = r;
+    k->score[r] = fn(ctx, r);  // indexed by region
+    k->seq[r] = v->reg[r].seq;
+  }
+  uint32_t *tmp = malloc((k->n ? k->n : 1) * sizeof(uint32_t));
+  rf_rank_sort(k, tmp);
+  free(tmp);
+  k->n_rank++;
+}
+
+uint32_t rf_rank_next(rf_rank_t *k, const rf_rview_t *v, rf_score_fn fn, rf_prep_fn prep,
+                      void *ctx) {
+  for (int pass = 0; pass < 2; pass++) {
+    if (pass > 0 || k->used >= k->every || k->pos >= k->n) rf_rank_build(k, v, fn, prep, ctx);
+    while (k->pos < k->n) {
+      uint32_t r = k->id[k->pos++];
+      if (v->reg[r].state == RF_R_SEALED && v->reg[r].seq == k->seq[r]) {
+        k->used++;
+        return r;
+      }
+    }
+  }
+  return RF_NONE;
+}
+
+// ***********************************************************************
+// ****                         utility                               ****
+// ***********************************************************************
+double rf_obj_utility(const cache_obj_t *o, int64_t t) {
+  int64_t na = o->next_access_vtime, now = t + 1;  // libCacheSim's vtime
+  if (na < 0 || na == MAX_REUSE_DISTANCE) return 0;
+  int64_t d = na > now ? na - now : 1;
+  return 1.0e8 / (double)o->obj_size / (double)d;
+}
+
+double rf_region_utility(const rf_rview_t *v, uint32_t r) {
+  rf_obj_iter_t it = {&v->reg[r], 0, NULL};
+  double u = 0;
+  for (cache_obj_t *o; (o = rf_obj_next(&it)) != NULL;) u += rf_obj_utility(o, *v->t);
+  return u;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/evict/region_policy.h b/libCacheSim/cache/eviction/flash/evict/region_policy.h
new file mode 100644
index 0000000..c21d382
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/evict/region_policy.h
@@ -0,0 +1,91 @@
+//
+//  region_policy.h — which sealed Region RegionFlash evicts next.
+//
+//  A policy reads the Regions (rf_region.h) through rf_rview_t and keeps its
+//  own state; it never changes a Region. RegionFlash calls:
+//    on_seal(r)     r was sealed (written whole); it is a candidate from now
+//    on_touch(r)    a sealed r was read (an SSD hit)
+//    pick()         a sealed region to evict now (RF_NONE: none)
+//    on_request()   every request, before it is served (o: the indexed object,
+//                   NULL if none)                                  [optional]
+//    on_delete(o)   o's record is about to be freed                [optional]
+//    report(f)      a JSON value for P.json's "region_policy"      [optional]
+//  OPEN regions are never candidates. Built-in: fifo, lru, beta, sfifo (region_sfifo.c)
+//  (region_basic.c), oracle (region_oracle.c), gl (region_gl.c).
+//  region-evict=lcs:<algorithm> is not a policy here (region_lcs.c).
+//
+
+#ifndef REGION_POLICY_H
+#define REGION_POLICY_H
+
+#include "libCacheSim/request.h"
+#include "../ssd/rf_region.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+  const rf_region_t *reg;              // [N]
+  uint32_t N, kmax;                    // regions, write streams (classes)
+  uint64_t R;                          // region size
+  const int64_t *t;                    // the current request, from 0
+  const uint64_t *admit_n, *admit_b;   // [kmax] objects / bytes admitted, all time
+} rf_rview_t;
+
+typedef struct rf_rpol rf_rpol_t;
+
+typedef struct {
+  const char *name;
+  rf_rpol_t *(*create)(const rf_rview_t *v, const char *params);  // "k=v/k=v"
+  void (*destroy)(rf_rpol_t *x);
+  void (*on_seal)(rf_rpol_t *x, uint32_t r);
+  void (*on_touch)(rf_rpol_t *x, uint32_t r);
+  uint32_t (*pick)(rf_rpol_t *x);
+  void (*on_request)(rf_rpol_t *x, const request_t *req, cache_obj_t *o);
+  void (*on_delete)(rf_rpol_t *x, const cache_obj_t *o);
+  void (*report)(const rf_rpol_t *x, FILE *f);
+} rf_rpol_ops_t;
+
+/* the built-in policy called name, NULL if none */
+const rf_rpol_ops_t *rf_rpol_find(const char *name);
+
+/* policy parameters "k=v/k=v": each key fills a number or a word; an unknown
+ * key is an error */
+typedef struct {
+  const char *key;
+  double *num;
+  char *word;
+  size_t n;
+} rf_kv_t;
+void rf_rpol_parse(const char *policy, const char *params, const rf_kv_t *kv);
+
+/* ranking shared by oracle and gl (GL-Cache's rank-intvl): all sealed regions
+ * sorted by score (lowest first, then the earliest sealed), consumed in order
+ * for `every` picks, then ranked again. A region sealed again since the
+ * ranking is skipped. */
+typedef double (*rf_score_fn)(void *ctx, uint32_t r);
+typedef void (*rf_prep_fn)(void *ctx);  // called just before each ranking
+typedef struct {
+  uint32_t *id, n, pos, used, every;
+  uint64_t *seq;
+  double *score;
+  uint64_t n_rank;  // rankings made
+} rf_rank_t;
+void rf_rank_init(rf_rank_t *k, const rf_rview_t *v, double intvl);
+uint32_t rf_rank_next(rf_rank_t *k, const rf_rview_t *v, rf_score_fn fn, rf_prep_fn prep,
+                      void *ctx);
+void rf_rank_free(rf_rank_t *k);
+
+/* an object's utility now (GL-Cache's oracle object score):
+ * 1e8 / size / (requests until its next access), 0 if never again */
+double rf_obj_utility(const cache_obj_t *o, int64_t t);
+/* the sum over the region's valid objects (an object written piece-wise
+ * counts once per run of consecutive pieces) */
+double rf_region_utility(const rf_rview_t *v, uint32_t r);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/libCacheSim/cache/eviction/flash/evict/region_sfifo.c b/libCacheSim/cache/eviction/flash/evict/region_sfifo.c
new file mode 100644
index 0000000..6240566
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/evict/region_sfifo.c
@@ -0,0 +1,101 @@
+//
+//  region_sfifo.c — region-evict=sfifo: segmented FIFO over the sealed regions
+//  (CacheLib Navy's SegmentedFifoPolicy). A sealed region enters the segment
+//  of its class (class c of kmax goes to segment c * S / kmax, so the classes
+//  of a hint that numbers them by heat fill the segments from the bottom up;
+//  a reinsertion with mode=ii, the last class, enters the top). Each segment
+//  is a FIFO; a segment holding more than its share of the sealed regions
+//  (ratio, from the bottom) gives its oldest region to the segment below, where
+//  it becomes the newest. The oldest region of the lowest non-empty segment
+//  is evicted. One segment (or no hint) is FIFO.
+//
+//  region-params: ratio=1:1 (segment weights from the bottom; ':' between)
+//
+
+#include <string.h>
+
+#include "region_policy.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SF_MAX 16
+
+struct rf_rpol {
+  const rf_rview_t *v;
+  uint32_t S;
+  double ratio[SF_MAX], rsum;
+  uint8_t *seg;      // [N] segment of a sealed region
+  uint64_t *seq, cnt;  // [N] when it entered its segment
+  uint64_t demoted, picks[SF_MAX];
+};
+
+static rf_rpol_t *create(const rf_rview_t *v, const char *params) {
+  char word[128] = "1:1";
+  rf_rpol_parse("sfifo", params,
+                (const rf_kv_t[]){{"ratio", NULL, word, sizeof(word)}, {NULL, NULL, NULL, 0}});
+  rf_rpol_t *x = calloc(1, sizeof(*x));
+  x->v = v;
+  for (char *cur = word, *tok; (tok = strsep(&cur, ":")) != NULL && x->S < SF_MAX;) {
+    double r = strtod(tok, NULL);
+    if (!(r > 0)) rf_die("region-evict sfifo: ratio %s is not positive\n", tok);
+    x->ratio[x->S++] = r;
+    x->rsum += r;
+  }
+  x->seg = calloc(v->N, 1);
+  x->seq = calloc(v->N, sizeof(uint64_t));
+  return x;
+}
+
+static void destroy(rf_rpol_t *x) {
+  free(x->seg);
+  free(x->seq);
+  free(x);
+}
+
+static void on_seal(rf_rpol_t *x, uint32_t r) {
+  uint32_t c = x->v->reg[r].cls, k = x->v->kmax ? x->v->kmax : 1;
+  x->seg[r] = (uint8_t)(c * x->S / k < x->S ? c * x->S / k : x->S - 1);
+  x->seq[r] = ++x->cnt;
+}
+
+static uint32_t pick(rf_rpol_t *x) {
+  const rf_rview_t *v = x->v;
+  uint32_t n[SF_MAX] = {0}, old[SF_MAX], tot = 0;
+  for (;;) {  // rebalance from the top: an over-full segment hands its oldest down
+    for (uint32_t s = 0; s < x->S; s++) n[s] = 0, old[s] = RF_NONE;
+    tot = 0;
+    for (uint32_t r = 0; r < v->N; r++) {
+      if (v->reg[r].state != RF_R_SEALED) continue;
+      uint32_t s = x->seg[r];
+      n[s]++, tot++;
+      if (old[s] == RF_NONE || x->seq[r] < x->seq[old[s]]) old[s] = r;
+    }
+    uint32_t s = x->S - 1;
+    while (s > 0 && (double)n[s] <= x->ratio[s] / x->rsum * tot) s--;
+    if (s == 0) break;
+    x->seg[old[s]] = (uint8_t)(s - 1);
+    x->seq[old[s]] = ++x->cnt;
+    x->demoted++;
+  }
+  for (uint32_t s = 0; s < x->S; s++)
+    if (old[s] != RF_NONE) {
+      x->picks[s]++;
+      return old[s];
+    }
+  return RF_NONE;
+}
+
+static void report(const rf_rpol_t *x, FILE *f) {
+  fprintf(f, "{\"segments\": %u, \"demoted\": %llu, \"evicted_from\": [", x->S, (unsigned long long)x->demoted);
+  for (uint32_t s = 0; s < x->S; s++) fprintf(f, "%s%llu", s ? ", " : "", (unsigned long long)x->picks[s]);
+  fputs("]}", f);
+}
+
+const rf_rpol_ops_t rf_rpol_sfifo_ops = {"sfifo", create, destroy, on_seal, NULL, pick,
+                                         NULL, NULL, report};
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/hint/basic.c b/libCacheSim/cache/eviction/flash/hint/basic.c
new file mode 100644
index 0000000..23fd99c
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/basic.c
@@ -0,0 +1,48 @@
+/* basic.c — none（常に分類 0）と fixed（τ を直接指定。hint=fixed:16K/64K）。エポックは 0 のまま */
+#include "regionflash_hint.h"
+
+struct rf_hint {
+  int64_t taus[KMAX_LIMIT];
+  uint32_t n;
+};
+static const param_spec_t P_NONE[] = {{NULL}};
+static const param_spec_t P_FIXED[] = {
+    {"tau", P_LIST, "", NULL, "境界 τ（昇順。fixed:1024,2048,10000 のように書ける。K/M/G 可）"}, {NULL}};
+
+static int none_create(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env) {
+  (void)v;
+  (void)env;
+  *h = xcalloc(1, sizeof(rf_hint_t));
+  return 0;
+}
+static int fixed_create(rf_hint_t **h, const param_vals_t *v, const hint_env_t *env) {
+  rf_hint_t *x = xcalloc(1, sizeof(*x));
+  double a[KMAX_LIMIT];
+  x->n = (uint32_t)pv_list(v, "tau", a, KMAX_LIMIT);
+  if (x->n + 1 > env->k_max) die("fixed: %u taus give %u classes > k_max %u", x->n, x->n + 1, env->k_max);
+  for (uint32_t i = 0; i < x->n; i++) {
+    x->taus[i] = (int64_t)a[i];
+    if (i && x->taus[i] <= x->taus[i - 1]) die("fixed: tau must be strictly increasing");
+  }
+  *h = x;
+  return 0;
+}
+static void destroy(rf_hint_t *h) { free(h); }
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) { return class_of_taus(h->taus, h->n, e->size); }
+static uint32_t epoch(const rf_hint_t *h) {
+  (void)h;
+  return 0;
+}
+static uint32_t max_classes(const rf_hint_t *h) { return h->n + 1; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) {
+  uint32_t n = h->n < max ? h->n : max;
+  memcpy(out, h->taus, n * sizeof(int64_t));
+  return n;
+}
+
+const rf_hint_ops_t rf_hint_none_ops = {
+    .name = "none", .params = P_NONE, .create = none_create, .destroy = destroy,
+    .on_insert = on_insert, .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
+const rf_hint_ops_t rf_hint_fixed_ops = {
+    .name = "fixed", .params = P_FIXED, .create = fixed_create, .destroy = destroy,
+    .on_insert = on_insert, .epoch = epoch, .bounds = bounds, .max_classes = max_classes};
diff --git a/libCacheSim/cache/eviction/flash/hint/hitrate.c b/libCacheSim/cache/eviction/flash/hint/hitrate.c
new file mode 100644
index 0000000..3450b3d
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/hint/hitrate.c
@@ -0,0 +1,203 @@
+/* hitrate.c — st_hitrate: split_threshold の改良版（サイズ分類 × サイズ帯別ヒット率）。
+ *
+ * サイズ分類 sc（size=st: split_threshold の τ / size=fixed: tau リスト / size=none: 1 分類）と、
+ * 2 のべき乗のサイズ帯（log2 バケット b、48 本）ごとに測ったヒット率の分類 hc[b]（hr リストで区切る）から
+ *   セル = sc × (hr の分類数) + hc[b]
+ * を作り、merge 規則で写したものを分類番号として返す。分類番号はセル番号そのもの（セルの意味は時刻によらず固定）。
+ *
+ * ヒット率（hr_metric）: ssd = SSD 参照（DRAM ミス）のうちの SSD ヒット率 / all = 全要求のヒット率（DRAM を含む）。
+ * 集計（hr_mode）: hr_window 要求ごとに更新し、cum = 開始からの累積、window = 直前の hr_window 要求、
+ *   ema = 区間ごとの参照数とヒット数の指数移動平均の比（A ← (1−α)A + α·区間値）。
+ * 参照数（cum は累積、window / ema は 1 区間あたり）が hr_min_obs 未満のバケットは hr_default の分類。
+ * hc[b] = |{ j : rate_b ≥ hr_j }|（境界ちょうどは上の分類）。hr_hyst = m > 0 なら、前回も有効だったバケットは
+ *   rate が [hr_{c−1} − m, hr_c + m) にある間は前回の分類 c のまま（境界付近の行き来を抑えるヒステリシス）。
+ *
+ * merge=hot: サイズ分類 c ≥ 1 のうちヒット率分類 ≥ merge_level のセルを、まとめ先 d（smallest = 0 / next = c−1）の
+ *   同じヒット率分類のセルへ写す。d にそのセルがなければ（今どのサイズも当てはまらなければ）、d で使われている
+ *   最も高いヒット率分類のセルへ写す。d が丸ごと空なら写さない。 */
+#include "../util/hint_stats.h"
+#include "../util/sst_wrap.h"
+#include "regionflash_hint.h"
+
+#define MAXHR 16
+#define MAXSZ 64
+enum { SZ_ST, SZ_FIXED, SZ_NONE };
+enum { HR_CUM, HR_WINDOW, HR_EMA };
+
+struct rf_hint {
+    int size_src, metric_all, mode, def_high, merge, merge_next;
+    stw_t w;
+    int64_t ftau[MAXSZ]; uint32_t nf;
+    double hrb[MAXHR]; uint32_t nhr, merge_level;
+    uint64_t period, nreq, nupd; double alpha, min_obs, hyst;
+    double cl[HS_NB], ch[HS_NB], al[HS_NB], ah[HS_NB], rate[HS_NB];
+    uint8_t valid[HS_NB], hc[HS_NB];
+    uint32_t nsz_max;
+    int64_t stau[MAXSZ]; uint32_t ns;
+    uint8_t tgt[MAXSZ * MAXHR];
+    int64_t iv[HINT_MAX_IV]; uint8_t ivc[HINT_MAX_IV + 1]; uint32_t niv, ep;
+};
+
+static const param_spec_t P[] = {
+    {"size", P_ENUM, "st", "st|fixed|none", "サイズ分類: split_threshold / tau リスト / なし"},
+    {"tau", P_LIST, "", NULL, "size=fixed の境界（例 1024,2048,10000）"},
+    {"hr", P_LIST, "20%,40%,60%,80%", NULL, "ヒット率の境界（昇順、0〜100%。空なら 1 分類）"},
+    {"hr_metric", P_ENUM, "ssd", "ssd|all", "ssd: SSD 参照のうちの SSD ヒット率 / all: 全要求のヒット率"},
+    {"hr_mode", P_ENUM, "ema", "cum|window|ema", "累積 / 直前の区間 / 指数移動平均"},
+    {"hr_window", P_UINT, "100000", NULL, "ヒット率の更新間隔（要求数）"},
+    {"hr_alpha", P_DOUBLE, "0.3", NULL, "ema: 新しい区間の重み（0 < α ≤ 1）"},
+    {"hr_min_obs", P_DOUBLE, "100", NULL, "参照数がこれ未満のバケットはヒット率なし"},
+    {"hr_default", P_ENUM, "low", "low|high", "ヒット率なしのバケットの分類（最低 / 最高）"},
+    {"hr_hyst", P_DOUBLE, "0", NULL, "ヒット率分類のヒステリシス幅（例 5%。0 = 無効）"},
+    {"merge", P_ENUM, "none", "none|hot", "高ヒット率の大サイズ分類を小サイズ分類へまとめる"},
+    {"merge_level", P_INT, "-1", NULL, "まとめるヒット率分類の下限（-1 = 最上位だけ）"},
+    {"merge_to", P_ENUM, "smallest", "smallest|next", "まとめ先: 最小のサイズ分類 / 1 つ小さいサイズ分類"},
+    ST_PARAM_SPECS, {NULL}};
+
+static int i64cmp(const void *a, const void *b) { int64_t x = *(const int64_t *)a, y = *(const int64_t *)b; return (x > y) - (x < y); }
+
+static uint32_t size_class(const rf_hint_t *h, int64_t s) { uint32_t c = 0; while (c < h->ns && s > h->stau[c]) c++; return c; }
+static uint32_t cell_of(const rf_hint_t *h, int64_t s) { return size_class(h, s) * h->nhr + h->hc[hs_bucket(s < 1 ? 1 : (uint64_t)s)]; }
+
+/* 現在のサイズ分類・ヒット率分類・merge から、区間（bounds）と区間ごとの分類を作り直す */
+static void rebuild(rf_hint_t *h) {
+    h->ns = 0;
+    if (h->size_src == SZ_ST && h->w.thr >= 0) h->stau[h->ns++] = h->w.thr - (int64_t)h->w.add;
+    if (h->size_src == SZ_FIXED) { memcpy(h->stau, h->ftau, h->nf * sizeof(int64_t)); h->ns = h->nf; }
+    /* 分類が変わりうる点: サイズ分類の τ と、バケットの境目 2^b − 1（s > 2^b − 1 ⇔ s ≥ 2^b） */
+    int64_t bp[MAXSZ + HS_NB]; uint32_t n = 0;
+    for (uint32_t i = 0; i < h->ns; i++) bp[n++] = h->stau[i];
+    for (int b = 1; b < HS_NB; b++) bp[n++] = ((int64_t)1 << b) - 1;
+    qsort(bp, n, sizeof(int64_t), i64cmp);
+    uint32_t m = 0;
+    for (uint32_t i = 0; i < n; i++) if (!m || bp[i] != bp[m - 1]) bp[m++] = bp[i];
+    n = m;
+    /* 区間 i = (bp[i−1], bp[i]]。代表点で（merge 前の）セルを求め、使われているセルを記録する */
+    uint32_t cell[MAXSZ + HS_NB + 1]; uint8_t pop[MAXSZ * MAXHR] = {0};
+    for (uint32_t i = 0; i <= n; i++) {
+        int64_t rep = i == 0 ? (bp[0] >= 1 ? 1 : bp[0]) : bp[i - 1] + 1;
+        cell[i] = cell_of(h, rep); pop[cell[i]] = 1;
+    }
+    uint32_t ncell = h->nsz_max * h->nhr;
+    for (uint32_t c = 0; c < ncell; c++) h->tgt[c] = (uint8_t)c;
+    if (h->merge)
+        for (uint32_t c = 1; c <= h->ns; c++)
+            for (uint32_t r = h->merge_level; r < h->nhr; r++) {
+                uint32_t me = c * h->nhr + r, d = h->merge_next ? c - 1 : 0;
+                if (!pop[me]) continue;
+                if (pop[d * h->nhr + r]) { h->tgt[me] = h->tgt[d * h->nhr + r]; continue; }
+                for (int rr = (int)h->nhr - 1; rr >= 0; rr--)          /* d で使われている最も高いヒット率分類 */
+                    if (pop[d * h->nhr + (uint32_t)rr]) { h->tgt[me] = h->tgt[d * h->nhr + (uint32_t)rr]; break; }
+            }
+    /* 写した分類が同じ隣接区間はつなぐ */
+    int64_t iv[HINT_MAX_IV]; uint8_t ivc[HINT_MAX_IV + 1]; uint32_t niv = 0;
+    ivc[0] = h->tgt[cell[0]];
+    for (uint32_t i = 1; i <= n; i++) {
+        uint8_t c = h->tgt[cell[i]];
+        if (c == ivc[niv]) continue;
+        iv[niv++] = bp[i - 1]; ivc[niv] = c;
+    }
+    int changed = niv != h->niv || memcmp(iv, h->iv, niv * sizeof(int64_t)) || memcmp(ivc, h->ivc, niv + 1);
+    if (changed) { h->ep++; h->niv = niv; memcpy(h->iv, iv, niv * sizeof(int64_t)); memcpy(h->ivc, ivc, niv + 1); }
+}
+
+static int create(rf_hint_t **hp, const param_vals_t *v, const hint_env_t *env) {
+    rf_hint_t *h = xcalloc(1, sizeof(*h));
+    const char *sz = pv_str(v, "size");
+    h->size_src = !strcmp(sz, "st") ? SZ_ST : !strcmp(sz, "fixed") ? SZ_FIXED : SZ_NONE;
+    stw_init(&h->w, v);
+    double a[MAXSZ];
+    h->nf = (uint32_t)pv_list(v, "tau", a, MAXSZ - 1);
+    if (h->size_src != SZ_FIXED && h->nf) die("st_hitrate: tau= is only used with size=fixed");
+    for (uint32_t i = 0; i < h->nf; i++) {
+        h->ftau[i] = (int64_t)a[i];
+        if (i && h->ftau[i] <= h->ftau[i - 1]) die("st_hitrate: tau must be strictly increasing");
+    }
+    h->nsz_max = h->size_src == SZ_ST ? 2 : h->size_src == SZ_FIXED ? h->nf + 1 : 1;
+    uint32_t nb = (uint32_t)pv_list(v, "hr", h->hrb, MAXHR - 1);
+    for (uint32_t i = 0; i < nb; i++)
+        if (h->hrb[i] < 0 || h->hrb[i] > 1 || (i && h->hrb[i] <= h->hrb[i - 1]))
+            die("st_hitrate: hr must be strictly increasing values in [0, 1] (e.g. hr=20%%,40%%,60%%,80%%)");
+    h->nhr = nb + 1;
+    if (h->nsz_max * h->nhr > env->k_max)
+        die("st_hitrate: %u size classes x %u hit-rate classes = %u > k_max %u", h->nsz_max, h->nhr, h->nsz_max * h->nhr, env->k_max);
+    h->metric_all = !strcmp(pv_str(v, "hr_metric"), "all");
+    const char *md = pv_str(v, "hr_mode");
+    h->mode = !strcmp(md, "cum") ? HR_CUM : !strcmp(md, "window") ? HR_WINDOW : HR_EMA;
+    h->period = (uint64_t)pv_int(v, "hr_window"); h->alpha = pv_dbl(v, "hr_alpha"); h->min_obs = pv_dbl(v, "hr_min_obs");
+    h->hyst = pv_dbl(v, "hr_hyst");
+    if (h->hyst < 0 || h->hyst >= 1) die("st_hitrate: hr_hyst must be in [0, 1)");
+    if (!h->period) die("st_hitrate: hr_window must be > 0");
+    if (!(h->alpha > 0 && h->alpha <= 1)) die("st_hitrate: hr_alpha must be in (0, 1]");
+    h->def_high = !strcmp(pv_str(v, "hr_default"), "high");
+    h->merge = !strcmp(pv_str(v, "merge"), "hot");
+    h->merge_next = !strcmp(pv_str(v, "merge_to"), "next");
+    int64_t ml = pv_int(v, "merge_level");
+    h->merge_level = ml < 0 ? h->nhr - 1 : (uint32_t)ml;
+    if (h->merge_level >= h->nhr) die("st_hitrate: merge_level must be < number of hit-rate classes (%u)", h->nhr);
+    for (int b = 0; b < HS_NB; b++) { h->hc[b] = (uint8_t)(h->def_high ? h->nhr - 1 : 0); h->rate[b] = NAN; }
+    rebuild(h);
+    *hp = h;
+    return 0;
+}
+static void destroy(rf_hint_t *h) { free(h); }
+
+static void update_hr(rf_hint_t *h) {
+    for (int b = 0; b < HS_NB; b++) {
+        double L, H;
+        if (h->mode == HR_CUM) { h->al[b] += h->cl[b]; h->ah[b] += h->ch[b]; L = h->al[b]; H = h->ah[b]; }
+        else if (h->mode == HR_WINDOW) { L = h->cl[b]; H = h->ch[b]; }
+        else {
+            if (!h->nupd) { h->al[b] = h->cl[b]; h->ah[b] = h->ch[b]; }
+            else { h->al[b] = (1 - h->alpha) * h->al[b] + h->alpha * h->cl[b]; h->ah[b] = (1 - h->alpha) * h->ah[b] + h->alpha * h->ch[b]; }
+            L = h->al[b]; H = h->ah[b];
+        }
+        int was = h->valid[b]; uint32_t old = h->hc[b];
+        h->valid[b] = L > 0 && L >= h->min_obs;
+        h->rate[b] = h->valid[b] ? H / L : NAN;
+        uint32_t c = 0;
+        if (h->valid[b]) while (c < h->nhr - 1 && h->rate[b] >= h->hrb[c]) c++;
+        else c = h->def_high ? h->nhr - 1 : 0;
+        if (h->hyst > 0 && was && h->valid[b] && c != old                      /* 前回の分類の帯（幅を広げたもの）の中なら据え置く */
+            && (old == 0 || h->rate[b] >= h->hrb[old - 1] - h->hyst) && (old == h->nhr - 1 || h->rate[b] < h->hrb[old] + h->hyst)) c = old;
+        h->hc[b] = (uint8_t)c;
+        h->cl[b] = h->ch[b] = 0;
+    }
+    h->nupd++;
+    rebuild(h);
+}
+
+static uint32_t on_insert(rf_hint_t *h, const rf_hint_ev_t *e) {
+    if (h->size_src == SZ_ST) {
+        int64_t st[6];
+        if (stw_admit(&h->w, e->size + h->w.add, st)) rebuild(h);
+    }
+    return h->tgt[cell_of(h, (int64_t)e->size)];
+}
+/* every request: the hit rate of its size band */
+static void on_get(rf_hint_t *h, const rf_hint_ev_t *e) {
+    int b = hs_bucket(e->size);
+    if (h->metric_all) { h->cl[b] += 1; h->ch[b] += e->outcome != HINT_MISS; }
+    else if (e->outcome != HINT_DRAM_HIT) { h->cl[b] += 1; h->ch[b] += e->outcome == HINT_SSD_HIT; }
+    if (++h->nreq % h->period == 0) update_hr(h);
+}
+static void on_evict(rf_hint_t *h, const rf_hint_ev_t *e) {
+    if (h->size_src == SZ_ST) sst_on_evict(&h->w.s, e->size + h->w.add, e->freq);
+}
+static uint32_t epoch(const rf_hint_t *h) { return h->ep; }
+static uint32_t max_classes(const rf_hint_t *h) { return h->nsz_max * h->nhr; }
+static uint32_t bounds(const rf_hint_t *h, int64_t *out, uint32_t max) {
+    uint32_t n = h->niv < max ? h->niv : max;
+    memcpy(out, h->iv, n * sizeof(int64_t));
+    return n;
+}
+static uint32_t classes(const rf_hint_t *h, uint8_t *out, uint32_t max) {
+    uint32_t n = h->niv + 1 < max ? h->niv + 1 : max;
+    memcpy(out, h->ivc, n);
+    return n;
+}
+
+const rf_hint_ops_t rf_hint_st_hitrate_ops = {
+    .name = "st_hitrate", .params = P, .create = create, .destroy = destroy,
+    .on_get = on_get, .on_insert = on_insert, .on_evict = on_evict,
+    .epoch = epoch, .bounds = bounds, .classes = classes, .max_classes = max_classes};
