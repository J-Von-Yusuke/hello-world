+#!/bin/bash
+# exp_gl_all.sh — every group of exp_gl.sh: the small traces first (8 + 4 + 4
+# at a time), then w01 (3 at a time, ~8 GB each), then the report.
+D=$(dirname "$(readlink -f "$0")")
+O=${O:-/root/exp_gl}; export O
+rm -rf "$O"; mkdir -p "$O"
+P=8 bash "$D/exp_gl.sh" tencent & P=4 bash "$D/exp_gl.sh" meta & P=4 bash "$D/exp_gl.sh" fdp & wait
+P=3 bash "$D/exp_gl.sh" w01
+awk '{print $1}' "$O/done.log" | sort | uniq -c
+python3 "$D/exp_gl_report.py" "$O"
diff --git a/scripts/regionflash/exp_gl_report.py b/scripts/regionflash/exp_gl_report.py
