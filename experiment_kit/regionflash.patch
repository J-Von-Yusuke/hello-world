index 0000000..4ab4e20
--- /dev/null
+++ b/scripts/regionflash/plugin_cmp.py
@@ -0,0 +1,81 @@
+"""Run cachesim and RegionFlash on the same oracleGeneral trace for each hint /
+admit config; compare total and per-class counters exactly."""
+import csv, json, os, subprocess, sys
+
+CS, RF, TR = "/root/cs/cachesim", "/root/b/bin/cachesim", "/root/cmp/t.og"
+SSD, R, DRAM = 64 << 20, 1 << 20, 8 << 20
+TOT = """reqs req_bytes dram_hits ssd_hits misses hit_bytes miss_bytes ssd_lookups ssd_admit_objs ssd_admit_bytes
+dram_evict_objs clean_skip_objs admit_reject_objs ssd_copy_lost_rewrites ssd_evict_objs ssd_evict_bytes
+dead_evict_objs dead_evict_bytes oracle_never_bytes oracle_reused_bytes regions_sealed regions_evicted
+repartition_seals pad_bytes flash_region_write_bytes too_large_objs""".split()
+CLS = {"reqs": "reqs", "req_bytes": "req_bytes", "dram_hits": "dram_hits", "ssd_lookups": "ssd_lookups",
+       "ssd_hits": "ssd_hits", "hit_bytes": "hit_bytes", "miss_bytes": "miss_bytes", "admit_objs": "ssd_admit_objs",
+       "admit_bytes": "ssd_admit_bytes", "evict_objs": "ssd_evict_objs", "evict_bytes": "ssd_evict_bytes",
+       "dead_evict_objs": "dead_evict_objs", "dead_evict_bytes": "dead_evict_bytes"}
+
+
+def run(name, hint="none", admit="all", extra_cs=(), extra_rf=""):
+    d = f"/root/cmp/r_{name}"
+    os.makedirs(d, exist_ok=True)
+    subprocess.run([CS, "--trace", TR, "--trace-format", "oracleGeneral", "--ssd-size", str(SSD), "--region-size", str(R),
+                    "--dram-size", str(DRAM), "--hint", hint, "--admit", admit, "--out", d, *extra_cs],
+                   check=True, stdout=subprocess.DEVNULL)
+    sj = json.load(open(f"{d}/summary.json"))
+    cs_tot = sj["result"]
+    cs_cls = {int(r["cls"]): r for r in csv.DictReader(open(f"{d}/class_summary.csv"))}
+    e = (f"dram-size={DRAM},dram-algo=lru,region-size={R},seal-on-repartition=inactive,hint={hint.replace(',', '/')},"
+         f"admit={admit.replace(',', '/')},out={d}/rf{extra_rf}")
+    subprocess.run([RF, TR, "oracleGeneral", "RegionFlash", str(SSD), "-e", e], check=True,
+                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    rj = json.load(open(f"{d}/rf.json"))
+    bad = [f"{k}: cs {cs_tot[k]} rf {rj['total'][k]}" for k in TOT if cs_tot[k] != rj["total"][k]]
+    for c in rj["class"]:
+        r = cs_cls.get(c["class"])
+        for ck, rk in CLS.items():
+            cv = int(float(r[ck])) if r else 0
+            if cv != c[rk]:
+                bad.append(f"class {c['class']} {rk}: cs {cv} rf {c[rk]}")
+    print(f"{name:28s} k={len(rj['class']):2d} OHR cs {cs_tot['ohr']:.6f} rf {rj['total']['ohr']:.6f} "
+          f"{'MATCH' if not bad else 'DIFF ' + str(len(bad))}", flush=True)
+    for b in bad[:6]:
+        print("   ", b)
+    return not bad
+
+
+cases = [
+    ("none", "none", "all"),
+    ("fixed", "fixed:16K,64K", "all"),
+    ("split_threshold", "split_threshold:recalc=20000", "all"),
+    ("st_recursive", "st_recursive:depth=2,recalc=20000", "all"),
+    ("st_hr_refine", "st_hr_refine:recalc=20000,min_obs=20", "all"),
+    ("hr_segment", "hr_segment:recalc=20000,min_obs=20", "all"),
+    ("st_hitrate", "st_hitrate:recalc=20000,hr_window=20000", "all"),
+    ("profile", "profile:path=/root/cmp/r_fixed/sizebin_profile.csv,method=qbytes,k=3", "all"),
+    ("key_size", "key:key=size,recalc=20000", "all"),
+    ("key_hash", "key:key=hash", "all"),
+    ("key_dram", "key:key=dram,k=2,recalc=20000", "all"),
+    ("key_gap", "key:key=gap,recalc=20000", "all"),
+    ("key_freq_cms", "key:key=freq,fsrc=cms,fmem=64K,fwin=50000,recalc=20000", "all"),
+    ("key_sizefreq", "key:key=sizefreq,k=4,kf=2,recalc=20000", "all"),
+    ("oracle_gdt", "oracle_gdt:k=4,recalc=20000", "all"),
+    ("oracle_key_dist", "oracle_key:key=dist,recalc=20000", "all"),
+    ("oracle_keyinfo", "oracle_keyinfo:window=50000", "all"),
+    ("adm_prob", "none", "prob:p=0.5"),
+    ("adm_sizemax", "fixed:16K,64K", "sizemax:max=64K"),
+    ("adm_sizeexp", "fixed:16K,64K", "sizeexp:c=32K"),
+    ("adm_seen", "fixed:16K,64K", "seen:m=50000"),
+    ("adm_cachesack", "fixed:16K,64K", "cachesack:interval=20000"),
+    ("adm_tinylfu", "fixed:16K,64K", "tinylfu:width=65536,window=50000"),
+    ("adm_adaptsize", "fixed:16K,64K", "adaptsize:interval=20000,sample=0.1"),
+    ("adm_oracle_opt_pass1", "none", "oracle_opt:log=/root/cmp/look.bin"),
+    ("adm_oracle_opt_pass2", "fixed:16K,64K", "oracle_opt:episodes=/root/cmp/look.bin"),
+    ("seen_split_threshold", "split_threshold:recalc=20000", "seen:m=50000"),
+    ("seen_nodram", "fixed:16K,64K", "seen:m=50000", ("--dram-size", "0"), ",dram-size=0"),
+    ("st_reinsert_reclass", "split_threshold:recalc=20000", "all",
+     ("--reinsert", "hits:n=1,class=reclassify,hint_on_reinsert=yes"),
+     ",reinsert=hits:n=1/class=reclassify/hint_on_reinsert=yes"),
+    ("obj_key_dram_tinylfu", "key:key=dram,k=2,recalc=20000", "tinylfu:width=65536,window=50000",
+     ("--ssd-mode", "object", "--ssd-policy", "lru"), ",ssd-mode=object,ssd-algo=lru"),
+]
+ok = sum(run(*c) for c in cases if not sys.argv[1:] or c[0] in sys.argv[1:])
+print(f"{ok}/{len(cases) if not sys.argv[1:] else len(sys.argv) - 1} match")
diff --git a/scripts/regionflash/quick_check.sh b/scripts/regionflash/quick_check.sh
new file mode 100644
index 0000000..0523c37
--- /dev/null
+++ b/scripts/regionflash/quick_check.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+# quick_check.sh OLD NEW — a fast check after a change: the first $NREQ requests
+# (default 100000) of each trace, a small SSD so that regions are evicted, every
+# Region eviction policy; the "total" counters of P.json must be the same for
+# both binaries. TRACES (oracleGeneral) and POLS can be overridden.
+OLD=${1:?old binary} NEW=${2:?new binary}
+NREQ=${NREQ:-100000}
+TRACES=${TRACES:-/root/tc/w01.oracleGeneral.bin.zst /root/tc/tencent.oracleGeneral.zst /root/tc/meta.oracleGeneral.zst}
+POLS=${POLS:-"lru fifo beta,beta=0.5 lcs:s3fifo oracle gl gl,region-params=label=oracle gl,region-params=warm=lru/retrain-req=20000/ylog=1"}
+O=${QC_OUT:-/tmp/rf_quick}
+B="dram-size=16MiB,region-size=4MiB,chunk=1M,interval=0"
+rm -rf $O; bad=0; n=0
+for tr in $TRACES; do
+  for h in none split_threshold:recalc=20000; do
+    for p in $POLS; do
+      n=$((n+1)); e="$B,hint=$h,region-evict=$p"
+      for v in old new; do
+        b=$OLD; [ $v = new ] && b=$NEW
+        mkdir -p $O/$v; $b $tr oracleGeneral RegionFlash 256mb -n $NREQ -e "$e,out=$O/$v/c$n" > /dev/null 2>&1 || echo "c$n $v FAILED [$e]"
+      done
+      r=$(python3 -c "import json,sys; a,b=(json.load(open(f))['total'] for f in sys.argv[1:]); d=[k for k in a if a[k]!=b.get(k)]; print('same omr %.4f' % a['omr'] if not d else 'DIFF ' + ' '.join(d[:6]))" $O/old/c$n.json $O/new/c$n.json 2>&1)
+      case $r in same*) ;; *) bad=$((bad+1));; esac
+      echo "c$n $(basename $tr) $h $p: $r"
+    done
+  done
+done
+echo "$((n-bad))/$n runs with identical totals"
diff --git a/scripts/regionflash/regress.sh b/scripts/regionflash/regress.sh
new file mode 100644
index 0000000..853d0ed
--- /dev/null
+++ b/scripts/regionflash/regress.sh
@@ -0,0 +1,47 @@
+#!/bin/bash
+# regress.sh OLD NEW [trace] [format] — byte-identical regression of RegionFlash:
+# runs both binaries on the same configurations and compares every output file
+# (stdout without timings/paths). Covers the Region policies (fifo, lru, beta,
+# lcs:*), FDP (ii, pi, trim), piece-wise writes, reinsertion, object mode and
+# hints. Extra configurations can be given in $EXTRA (one per line).
+OLD=${1:?old binary} NEW=${2:?new binary}
+TR=${3:-/root/cmp/t.og} FMT=${4:-oracleGeneral}
+O=${REG_OUT:-/tmp/rf_regress}
+B="dram-size=8MiB,region-size=1MiB,interval=50000"
+CFG=(
+  "$B" "$B,region-evict=fifo" "$B,region-evict=beta,beta=0.5,hint=fixed:16K/64K"
+  "$B,region-evict=lcs:s3fifo" "$B,region-evict=lcs:fifo" "$B,region-evict=sieve"
+  "$B,hint=fixed:16K/64K,chunk=256K"
+  "$B,hint=split_threshold:recalc=20000,chunk=256K,region-evict=lru,ru-size=4M,ruh=4,fdp-op=1.0,warmup-req=30000"
+  "$B,hint=fixed:16K,ru-size=4M,ruh=1,fdp-op=1.0,fdp-trim=1"
+  "$B,hint=fixed:16K,ru-size=4M,ruh=2,fdp-iso=pi,fdp-op=1.0,region-evict=fifo"
+  "$B,hint=fixed:16K,reinsert=hits:n=1/mode=ii,ru-size=2M,ruh=3,fdp-op=1.0"
+  "$B,hint=split_threshold:recalc=20000,reinsert=hits:n=1/class=reclassify/hint_on_reinsert=yes"
+  "$B,hint=key:key=size/recalc=20000,reinsert=hits:n=1/mode=ii/hint_on_reinsert=yes,region-evict=lcs:s3fifo"
+  "$B,ssd-mode=object,ssd-algo=s3fifo,reinsert=hits:n=1"
+  "dram-size=0,region-size=1MiB,interval=50000,hint=st_hitrate:recalc=20000/hr_window=20000,admit=seen:m=50000"
+  "$B,inclusion=exclusive,dram-algo=s3fifo,region-evict=beta,beta=1"
+)
+while IFS= read -r e; do [ -n "$e" ] && CFG+=("$e"); done <<< "${EXTRA:-}"
+rm -rf $O; n=0; bad=0
+norm() { sed -E 's/tid=[0-9]+//; s/[0-9]{2}-[0-9]{2}-[0-9]{4} [0-9:]{8}//; s/[A-Za-z_]+[.]c:[0-9]+//; s#'$O'/[a-z]+/##; s/throughput.*//; s/ +/ /g' "$1"; }
+for e in "${CFG[@]}"; do
+  n=$((n+1))
+  for v in old new; do
+    mkdir -p $O/$v
+    b=$OLD; [ $v = new ] && b=$NEW
+    $b $TR $FMT RegionFlash 64mb -e "$e,out=$O/$v/c$n" > $O/$v/c$n.stdout 2>&1
+    echo $? > $O/$v/c$n.rc
+  done
+  d=""
+  for f in $O/old/c$n.*; do
+    g=$O/new/$(basename $f)
+    case $f in *.stdout) cmp -s <(norm $f) <(norm $g) || d="$d $(basename $f)";;
+                *) cmp -s $f $g || d="$d $(basename $f)";; esac
+  done
+  nf=$(ls $O/old/c$n.* | wc -l)
+  if [ -n "$d" ]; then bad=$((bad+1)); echo "c$n DIFF:$d  [$e]"
+  else echo "c$n same ($nf files, rc=$(cat $O/new/c$n.rc))  [$e]"; fi
+done
+echo "$((n-bad))/$n configurations identical"
+[ $bad = 0 ]
diff --git a/scripts/regionflash/semantics_check.py b/scripts/regionflash/semantics_check.py
new file mode 100644
index 0000000..98781ef
--- /dev/null
+++ b/scripts/regionflash/semantics_check.py
@@ -0,0 +1,78 @@
+"""hand-made traces whose outcome tells which semantics RegionFlash has.
+1. a piece-wise object's SSD hit touches every region holding a piece (not only the head)
+2. promotion: an SSD hit puts a copy in DRAM; what happens to the SSD copy per inclusion
+3. dram-size=0: every request is an SSD lookup, misses are written straight to the SSD
+argv: binary outdir"""
+import csv, json, os, struct, subprocess, sys
+
+BIN, OUT = sys.argv[1:3]
+os.makedirs(OUT, exist_ok=True)
+K = 1024
+
+
+def trace(name, reqs):
+    p = f"{OUT}/{name}.og"
+    with open(p, "wb") as f:
+        for t, (oid, size) in enumerate(reqs):
+            f.write(struct.pack("<IQIq", t, oid, size, -1))
+    return p
+
+
+def run(name, tr, ssd, e, interval=0):
+    r = subprocess.run([BIN, tr, "oracleGeneral", "RegionFlash", str(ssd), "-e", f"{e},interval={interval},out={OUT}/{name}"],
+                       capture_output=True, text=True)
+    if r.returncode:
+        sys.exit(f"{name}: rc {r.returncode}\n{r.stderr[-800:]}")
+    return json.load(open(f"{OUT}/{name}.json"))["total"]
+
+
+ok = True
+
+
+def expect(what, cond, got):
+    global ok
+    ok &= cond
+    print(f"{'OK  ' if cond else 'FAIL'} {what}: {got}")
+
+
+# 1. R = 4K, 4 regions, chunk = 1K, no DRAM, one class, built-in lru.
+#    A (6K) -> pieces 1-4 fill region 0 (sealed), pieces 5-6 go to region 1;
+#    B, C fill region 1 (sealed at t2); D-G fill region 2; H-K fill region 3.
+#    t11: hit A. t12: write L needs a region: evict the least recently touched.
+#      every piece's region touched -> regions 0 and 1 are recent, region 2 goes, A stays
+#      only the head touched          -> region 1 (t2) goes, A loses pieces 5-6
+#    t13: A again.
+A, L = 1, 99
+seq = [(A, 6 * K)] + [(i, K) for i in range(2, 12)] + [(A, 6 * K), (L, K), (A, 6 * K)]
+t = run("chunk", trace("chunk", seq), 4 * 4 * K, "dram-size=0,region-size=4K,chunk=1K,region-evict=lru")
+expect("1 chunk hit touches every region holding a piece: A hits at t11 and t13",
+       t["ssd_hits"] == 2 and t["chunk_loss_head"] + t["chunk_loss_other"] == 0 and t["regions_evicted"] == 1,
+       f"ssd_hits {t['ssd_hits']} chunk_loss {t['chunk_loss_head']}+{t['chunk_loss_other']} evicted {t['regions_evicted']}")
+
+# 2. DRAM holds one 1K object (dram-size=1K), SSD big. X, Y, X, X, Z, X
+#    t0 X miss -> DRAM. t1 Y miss -> DRAM, X leaves DRAM -> written to SSD.
+#    t2 X: SSD hit -> promoted (copy into DRAM), Y leaves DRAM -> SSD.
+#    t3 X: DRAM hit. t4 Z: X leaves DRAM again (cachelib: its SSD copy is valid,
+#    not written; exclusive: the copy was dropped at t2, written; inclusive:
+#    written again). t5 X: SSD hit, promoted again, Z leaves DRAM -> SSD.
+#    SSD valid bytes after t2: the X copy stays (2K) except exclusive (1K).
+X, Y, Z = 1, 2, 3
+tr = trace("promote", [(X, K), (Y, K), (X, K), (X, K), (Z, K), (X, K)])
+for inc, admits, skips, valid in (("cachelib", 3, 1, 2 * K), ("exclusive", 4, 0, K), ("inclusive", 4, 0, 2 * K)):
+    t = run(f"promote_{inc}", tr, 64 * K, f"dram-size=1K,region-size=4K,inclusion={inc}", interval=1)
+    iv = [r for r in csv.DictReader(open(f"{OUT}/promote_{inc}.interval.csv")) if r["kind"] == "interval"]
+    v = [int(r["ssd_valid_bytes"]) for r in iv]
+    expect(f"2 promotion, inclusion={inc}: DRAM hit after it; SSD writes {admits}, skipped {skips}; SSD valid after t2 = {valid}",
+           t["dram_hits"] == 1 and t["ssd_hits"] == 2 and t["ssd_admit_objs"] == admits and t["clean_skip_objs"] == skips and v[2] == valid,
+           f"dram_hits {t['dram_hits']} ssd_hits {t['ssd_hits']} ssd_admit_objs {t['ssd_admit_objs']} clean_skip {t['clean_skip_objs']} ssd_valid_bytes per request {v}")
+
+# 3. no DRAM: X, Y, X, Y, Z -> every request looks up the SSD, misses are written at once
+tr = trace("nodram", [(X, K), (Y, K), (X, K), (Y, K), (Z, K)])
+res = [run(f"nodram_{inc}", tr, 64 * K, f"dram-size=0,region-size=4K,inclusion={inc}") for inc in ("cachelib", "exclusive", "inclusive")]
+t = res[0]
+expect("3 dram-size=0: lookups = requests, misses written straight to the SSD, no promotion",
+       t["ssd_lookups"] == t["reqs"] == 5 and t["dram_hits"] == 0 and t["ssd_hits"] == 2 and t["ssd_admit_objs"] == 3
+       and t["dram_omr"] == 1 and abs(t["omr"] - t["ssd_omr"]) < 1e-12,
+       f"reqs {t['reqs']} ssd_lookups {t['ssd_lookups']} ssd_hits {t['ssd_hits']} ssd_admit_objs {t['ssd_admit_objs']} dram_omr {t['dram_omr']}")
+expect("3 dram-size=0: inclusion has no effect", res[0] == res[1] == res[2], "3 runs identical" if res[0] == res[1] == res[2] else "differ")
+print("ALL OK" if ok else "FAIL")
diff --git a/scripts/regionflash/st_req_check.py b/scripts/regionflash/st_req_check.py
new file mode 100644
index 0000000..dcb70b2
--- /dev/null
+++ b/scripts/regionflash/st_req_check.py
@@ -0,0 +1,109 @@
+"""check the hint split_threshold_req (RegionFlash, counted per request).
+1. thresholds: an independent model of split_threshold.h fed with every
+   request of the trace (lambda = 0: no cold data needed) gives the threshold
+   after each recalc; RegionFlash with interval = recalc must show the same
+   class bounds at every interval end.
+2. histograms: with recalc beyond the run (no recompute, no decay) the sums
+   in hint_result must equal the interval files' totals: scope=all -> reqs,
+   req_bytes, miss_bytes; scope=ssd -> ssd_lookups, ssd_lookup_bytes,
+   miss_bytes (+ size_add per request).
+argv: binary trace(oracleGeneral, uncompressed) outdir"""
+import csv, json, struct, subprocess, sys
+
+BIN, TR, OUT = sys.argv[1:4]
+NB, EMA, MIN_BAND, NOSPLIT = 48, 16, 2, 5
+bad = []
+
+
+def bucket(s):  # floor(log2(s)), capped (sst_bucket)
+    return min(max(s.bit_length() - 1, 0), NB - 1)
+
+
+def p50(h):
+    tot = sum(h)
+    if tot == 0:
+        return -1
+    cum = 0
+    for b, v in enumerate(h):
+        cum += v
+        if cum * 2 >= tot:
+            return b
+    return NB - 1
+
+
+def recompute(cnt, byt):  # sst_recompute with lambda = 0 (mid)
+    cb, bb = p50(cnt), p50(byt)
+    if cb < 0 or bb < 0 or bb - cb < MIN_BAND:
+        return -1
+    S = 1 << ((cb + bb + 1) // 2)
+    tot = sum(byt)
+    large = sum(v for b, v in enumerate(byt) if (1 << b) > S)
+    return -1 if tot == 0 or large * 100 < tot * NOSPLIT else S
+
+
+def model(sizes, recalc):
+    cnt, byt, thr = [0] * NB, [0] * NB, []
+    for n, s in enumerate(sizes, 1):
+        b = bucket(s)
+        cnt[b] += 1
+        byt[b] += s
+        if n % recalc == 0:
+            thr.append(recompute(cnt, byt))
+            cnt = [v * (EMA - 1) // EMA for v in cnt]
+            byt = [v * (EMA - 1) // EMA for v in byt]
+    return thr
+
+
+def run(name, e):
+    p = f"{OUT}/{name}"
+    r = subprocess.run([BIN, TR, "oracleGeneral", "RegionFlash", "64mb", "-e", f"{e},out={p}"],
+                       capture_output=True, text=True)
+    if r.returncode:
+        sys.exit(f"{name}: rc {r.returncode}\n{r.stderr[-2000:]}")
+    return p
+
+
+raw = open(TR, "rb").read()
+sizes = [s for _, _, s, _ in struct.iter_unpack("<IQIq", raw) if s > 0]  # the CLI skips size 0
+B = "dram-size=8MiB,region-size=1MiB"
+
+# 1. thresholds after each recalc
+for R in (10000, 25000):
+    ref = model(sizes, R)
+    p = run(f"thr{R}", f"{B},interval={R},hint=split_threshold_req:recalc={R}")
+    got = {}
+    for row in csv.DictReader(open(p + ".interval.class.csv")):
+        if row["kind"] == "interval" and row["class"] == "0":
+            got[int(row["interval"])] = -1 if row["hi"] == "inf" else int(row["hi"])
+    n = min(len(ref), len(got))
+    diff = [(k, ref[k], got[k]) for k in range(n) if ref[k] != got[k]]
+    splits = sum(t >= 0 for t in ref)
+    changes = sum(ref[k] != ref[k - 1] for k in range(1, len(ref)))
+    print(f"thresholds recalc={R}: {n} recalcs, {splits} split, {changes} changes, "
+          f"{'MATCH' if not diff and n == len(ref) else 'DIFF'}  values={sorted(set(ref))}")
+    if diff:
+        bad.append(f"recalc={R}: first diffs {diff[:5]}")
+    hr = json.load(open(p + ".json"))["hint_result"]
+    if hr["obs"] != len(sizes):
+        bad.append(f"recalc={R}: obs {hr['obs']} != {len(sizes)} requests")
+
+# 2. histogram sums, no recompute
+for name, e, keys in (
+        ("sum_all", f"{B},hint=split_threshold_req:recalc=1000000000", ("reqs", "req_bytes", "misses", "miss_bytes")),
+        ("sum_ssd", f"{B},hint=split_threshold_req:recalc=1000000000/scope=ssd/size_add=100",
+         ("ssd_lookups", "ssd_lookup_bytes", "misses", "miss_bytes")),
+        ("sum_nodram", "dram-size=0,region-size=1MiB,hint=split_threshold_req:recalc=1000000000/scope=ssd",
+         ("ssd_lookups", "ssd_lookup_bytes", "misses", "miss_bytes"))):
+    p = run(name, f"{e},interval=40000")
+    add = 100 if "size_add=100" in e else 0
+    iv = [r for r in csv.DictReader(open(p + ".interval.csv")) if r["kind"] == "interval"]
+    n, nb, m, mb = (sum(int(r[k]) for r in iv) for k in keys)
+    hr = json.load(open(p + ".json"))["hint_result"]
+    want = {"obs": n, "count": n, "bytes": nb + add * n, "cold_bytes": mb + add * m}
+    d = {k: (hr[k], v) for k, v in want.items() if hr[k] != v}
+    print(f"{name}: obs {hr['obs']} bytes {hr['bytes']} cold {hr['cold_bytes']} "
+          f"{'MATCH' if not d else 'DIFF ' + str(d)}")
+    if d:
+        bad.append(f"{name}: {d}")
+print("ALL OK" if not bad else "FAIL\n  " + "\n  ".join(bad))
+sys.exit(1 if bad else 0)
diff --git a/scripts/regionflash/trace_cmp.py b/scripts/regionflash/trace_cmp.py
new file mode 100644
index 0000000..74f0a8a
--- /dev/null
+++ b/scripts/regionflash/trace_cmp.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""trace_cmp.py — cachesim vs RegionFlash on a real oracleGeneral trace (the
+main experiment settings: region LRU, chunk 1M, cachelib inclusion, DRAM LRU)
+for the hint / admission / reinsertion plugins; every total and per-class
+counter must match exactly.
+
+Usage (in WSL):
+  python3 trace_cmp.py --trace T.oracleGeneral.zst --ssd 10395324211 \
+      --dram 173255403 --R 64M,126M [--max-req N] [--jobs 8] [--out /root/tc] [case ...]
+--max-req reads only the first N requests of the trace (cachesim --max-req, libCacheSim --num-req).
+"""
+import argparse
+import csv
+import json
+import os
+import subprocess
+import sys
+from concurrent.futures import ThreadPoolExecutor
+
+TOT = """reqs req_bytes dram_hits ssd_hits misses hit_bytes miss_bytes ssd_lookups ssd_admit_objs ssd_admit_bytes
+dram_evict_objs clean_skip_objs admit_reject_objs ssd_copy_lost_rewrites ssd_evict_objs ssd_evict_bytes
+dead_evict_objs dead_evict_bytes regions_sealed regions_evicted repartition_seals pad_bytes
+flash_region_write_bytes too_large_objs reinsert_bytes chunk_objs chunk_pieces chunk_write_aborts
+chunk_loss_head chunk_loss_other chunk_orphan_bytes""".split()
+CLS = {"reqs": "reqs", "req_bytes": "req_bytes", "dram_hits": "dram_hits", "ssd_lookups": "ssd_lookups",
+       "ssd_hits": "ssd_hits", "hit_bytes": "hit_bytes", "miss_bytes": "miss_bytes", "admit_objs": "ssd_admit_objs",
+       "admit_bytes": "ssd_admit_bytes", "evict_objs": "ssd_evict_objs", "evict_bytes": "ssd_evict_bytes",
+       "dead_evict_objs": "dead_evict_objs", "dead_evict_bytes": "dead_evict_bytes"}
+HY = "hyst_hold=4,hyst_band=2"
+# name, hint, admit, extra cachesim args, extra RegionFlash -e (cachesim's ',' lists use '/')
+CASES = [
+    ("none", "none", "all", (), ""),
+    ("fifo_none", "none", "all", ("--region-evict", "fifo"), ",region-evict=fifo"),
+    ("fx_32K", "fixed:32K", "all", (), ""),
+    ("fx_16K_64K", "fixed:16K,64K", "all", (), ""),
+    ("st", "split_threshold", "all", (), ""),
+    ("st_h", f"split_threshold:{HY}", "all", (), ""),
+    ("rec2_h", f"st_recursive:depth=2,{HY}", "all", (), ""),
+    ("sthr4_h", f"st_hitrate:hr=50%,hr_hyst=5%,{HY}", "all", (), ""),
+    ("st_hr_refine", "st_hr_refine", "all", (), ""),
+    ("hr_segment", "hr_segment", "all", (), ""),
+    ("og2", "oracle_gdt:k=2", "all", (), ""),
+    ("og4", "oracle_gdt:k=4", "all", (), ""),
+    ("oracle_key_dist", "oracle_key:key=dist", "all", (), ""),
+    ("key_size", "key:key=size", "all", (), ""),
+    ("key_hash", "key:key=hash", "all", (), ""),
+    ("key_dram", "key:key=dram,k=2", "all", (), ""),
+    ("key_gap", "key:key=gap", "all", (), ""),
+    ("key_freq_cms", "key:key=freq,fsrc=cms", "all", (), ""),
+    ("key_sizefreq", "key:key=sizefreq,k=4,kf=2", "all", (), ""),
+    ("adm_prob", "none", "prob:p=0.5", (), ""),
+    ("adm_seen", "split_threshold", "seen", (), ""),
+    ("adm_tinylfu", "split_threshold", "tinylfu", (), ""),
+    ("adm_cachesack", "split_threshold", "cachesack", (), ""),
+    ("adm_adaptsize", "none", "adaptsize", (), ""),
+    ("reinsert_pi", "split_threshold", "all", ("--reinsert", "hits:n=1"), ",reinsert=hits:n=1"),
+    ("reinsert_ii", "split_threshold", "all", ("--reinsert", "hits:n=1,mode=ii"), ",reinsert=hits:n=1/mode=ii"),
+]
+
+
+def run(a, rbin, R, case):
+    name, hint, admit, xcs, xrf = case
+    d = f"{a.out}/R{R}/{name}"
+    os.makedirs(d, exist_ok=True)
+    cs = [a.cachesim, "--trace", a.trace, "--trace-format", "oracleGeneral", "--ssd-size", str(a.ssd),
+          "--region-size", R, "--dram-size", str(a.dram), "--ssd-mode", "region", "--chunk", "1M",
+          "--region-evict", "lru", "--inclusion", "cachelib", "--hint", hint, "--admit", admit, "--out", d, *xcs]
+    if a.max_req:
+        cs += ["--max-req", str(a.max_req)]
+    e = (f"dram-size={a.dram},dram-algo=lru,region-size={R},region-evict=lru,chunk=1M,inclusion=cachelib,seal-on-repartition=inactive,"
+         f"hint={hint.replace(',', '/')},admit={admit.replace(',', '/')},out={d}/rf{xrf}")
+    rf = [rbin, a.trace, "oracleGeneral", "RegionFlash", str(a.ssd), "-e", e]
+    if a.max_req:
+        rf += ["--num-req", str(a.max_req)]
+    for cmd, log in ((cs, "cs.log"), (rf, "rf.log")):
+        with open(f"{d}/{log}", "w") as f:
+            if subprocess.run(cmd, stdout=f, stderr=subprocess.STDOUT).returncode:
+                return f"R={R:5s} {name:16s} FAILED ({log})"
+    sj = json.load(open(f"{d}/summary.json"))
+    ct = sj["result"]
+    cc = {int(r["cls"]): r for r in csv.DictReader(open(f"{d}/class_summary.csv"))}
+    rj = json.load(open(f"{d}/rf.json"))
+    bad = [f"{k}: cs {ct.get(k, 0)} rf {rj['total'][k]}" for k in TOT if ct.get(k, 0) != rj["total"][k]]
+    for c in rj["class"]:
+        r = cc.get(c["class"])
+        for ck, rk in CLS.items():
+            cv = int(float(r[ck])) if r else 0
+            if cv != c[rk]:
+                bad.append(f"class {c['class']} {rk}: cs {cv} rf {c[rk]}")
+    head = (f"R={R:5s} {name:16s} k={len(rj['class']):2d} OHR cs {ct['ohr']:.6f} rf {rj['total']['ohr']:.6f} "
+            f"evicted {rj['total']['regions_evicted']} {'MATCH' if not bad else 'DIFF ' + str(len(bad))}")
+    return "\n".join([head] + ["    " + b for b in bad[:6]])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--trace", required=True)
+    ap.add_argument("--ssd", type=int, required=True)
+    ap.add_argument("--dram", type=int, required=True)
+    ap.add_argument("--R", default="64M")
+    ap.add_argument("--cachesim", default="/root/cs/cachesim")
+    ap.add_argument("--regionflash", default="/root/b/bin/cachesim")
+    ap.add_argument("--out", default="/root/tc")
+    ap.add_argument("--jobs", type=int, default=8)
+    ap.add_argument("--max-req", type=int, default=0)
+    ap.add_argument("cases", nargs="*")
+    a = ap.parse_args()
+    cases = [c for c in CASES if not a.cases or c[0] in a.cases]
