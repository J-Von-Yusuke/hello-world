+//
+//  regionflash_internal.h — RegionFlash's state and the functions its modules
+//  share. Not for use outside cache/eviction/flash/.
+//
+//  Layout (one feature per file; where to add things):
+//    RegionFlash.c         the libCacheSim cache (get, init, free) and the
+//                          request flow: DRAM, its victims, the object records
+//    core/  rf_params.c    parsing the -e parameters (a new parameter: here)
+//           rf_report.c    counters to P.json / P.*.csv, intervals, size bins
+//           rf_tier.c      inner libCacheSim caches (DRAM, object-mode SSD,
+//                          region-evict=lcs:*) and their removals
+//           gl_model.[ch]  the learner (XGBoost) of gl and hint=value
+//    ssd/   rf_ssd.c      the SSD tier: admission, hits, invalidation,
+//                          eviction accounting, reinsertion's rule, object mode
+//           rf_region.[ch] the Region store: OPEN / SEALED / FREE, placement,
+//                          piece-wise writes, evicting a region
+//           fdp.[ch]       the FDP device model under the regions
+//    evict/ region_policy.[ch]  which sealed region to evict: the interface,
+//                          its table, ranking, utility (a new policy: a
+//                          region_*.c plus one line in region_policy.c)
+//           region_basic.c fifo / lru / beta    region_oracle.c  oracle
+//           region_gl.c    gl (GL-Cache's group-level learning)
+//           region_lcs.c   lcs:<algorithm> (a libCacheSim cache over regions)
+//    hint/  the hint: which class (write stream) an SSD write goes to.
+//           regionflash_hint.h is the interface; one file per provider, all
+//           written against it (split_threshold.c is the example to copy);
+//           rf_hint.c lists them (RF_HINTS) and maps sizes to classes
+//    admit/ the admission policies: admit.h is the interface, admit.c lists
+//           them (ADMISSIONS); one file per policy
+//    util/  what the plugins share: params (NAME:k=v/...), rng, hashmap,
+//           SplitThreshold's statistics (sst.h, sst_wrap.h), hint_stats,
+//           segment; rf_util.h (rf_die, RF_GROW) for the rest
+//
+
+#ifndef REGIONFLASH_INTERNAL_H
