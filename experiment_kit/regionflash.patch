index 0000000..c8a1278
--- /dev/null
+++ b/scripts/regionflash/fdp_ref.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""fdp_ref.py — Python mirror of the FDP device model in
+libCacheSim/cache/eviction/flash/ssd/fdp.c, driven by cachesim's reference
+model (tests/ref_sim.py, region mode). Same algorithm and tie-breaks as the C code:
+
+  - n_ru = floor(N*R*(1+op)/ru_size) Reclaim Units of spr = ru_size/R region slots
+  - a sealed region is written to the open RU of RUH (class % n_ruh); a host
+    region's previous slot becomes invalid when it is rewritten (or at eviction
+    with trim)
+  - greedy GC (full RU with the fewest valid slots, lowest index on ties) when
+    free RUs <= gcres; copies go to one shared GC RU (ii) or one per RUH (pi)
+
+Usage: python fdp_ref.py [--ref PATH_TO_cachesim/tests]   (runs the experiment)
+"""
+import argparse
+import os
+import random
+import sys
+
+NONE = None
+
+
+class Fdp:
+    def __init__(self, N, R, ru_size, n_ruh, pi=False, op=0.07, trim=False):
+        assert ru_size % R == 0
+        self.R, self.spr, self.n_ruh, self.pi, self.trim = R, ru_size // R, n_ruh, pi, trim
+        self.n_ru = int(N * R * (1 + op) // ru_size)
+        self.n_dest = n_ruh + (n_ruh if pi else 1)
+        self.gcres = n_ruh if pi else 1
+        need = -(-N // self.spr) + self.n_dest + self.gcres + 1
+        assert self.n_ru >= need, f"{self.n_ru} RUs < {need}: raise op"
+        self.slot_reg = [NONE] * (self.n_ru * self.spr)
+        self.slot_cls = [0] * (self.n_ru * self.spr)
+        self.valid = [0] * self.n_ru
+        self.fill = [0] * self.n_ru
+        self.tag = [0] * self.n_ru
+        self.free = list(range(self.n_ru - 1, -1, -1))
+        self.dest = [NONE] * self.n_dest
+        self.reg_slot = {}
+        self.in_gc = False
+        self.host = self.gc = self.erases = 0
+        self.cls_host, self.cls_gc = {}, {}
+
+    def alloc(self):
+        guard = 0
+        while not self.in_gc and len(self.free) <= self.gcres:
+            assert guard <= self.n_ru, "GC cannot free RUs"
+            self.gc_one()
+            guard += 1
+        assert self.free, "no free RU during GC"
+        return self.free.pop()
+
+    def kill(self, r):
+        s = self.reg_slot.pop(r, NONE)
+        if s is not NONE:
+            self.slot_reg[s] = NONE
+            self.valid[s // self.spr] -= 1
+
+    def place(self, d, r, c):
+        u = self.dest[d]
+        if u is NONE:
+            u = self.alloc()
+            self.dest[d] = u
+            self.tag[u] = d if d < self.n_ruh else (d - self.n_ruh if self.pi else self.n_ruh)
+        s = u * self.spr + self.fill[u]
+        self.fill[u] += 1
+        self.slot_reg[s], self.slot_cls[s] = r, c
+        self.valid[u] += 1
+        self.reg_slot[r] = s
+        if self.fill[u] == self.spr:
+            self.dest[d] = NONE
+
+    def gc_one(self):
+        v = NONE
+        for u in range(self.n_ru):
+            if self.fill[u] == self.spr and (v is NONE or self.valid[u] < self.valid[v]):
+                v = u
+        assert v is not NONE and self.valid[v] < self.spr, "no reclaimable RU"
+        tag = self.tag[v]
+        self.in_gc = True
+        for i in range(self.spr):
+            s = v * self.spr + i
+            r = self.slot_reg[s]
+            if r is NONE:
+                continue
+            c = self.slot_cls[s]
+            self.kill(r)
+            self.place(self.n_ruh + tag if self.pi else self.n_ruh, r, c)
+            self.gc += self.R
+            self.cls_gc[c] = self.cls_gc.get(c, 0) + self.R
+        self.in_gc = False
+        self.fill[v] = 0
+        self.free.append(v)
+        self.erases += 1
+
+    def host_write(self, r, c):
+        self.kill(r)
+        self.place(c % self.n_ruh, r, c)
+        self.host += self.R
+        self.cls_host[c] = self.cls_host.get(c, 0) + self.R
+
+    def dlwa(self):
+        return (self.host + self.gc) / self.host if self.host else float("nan")
+
+
+def make_sim(ref_sim, cfg, fdp):
+    class FdpSim(ref_sim.RefSim):
+        def seal(self, g):
+            super().seal(g)
+            fdp.host_write(g.rid, g.cls)
+
+        def free_region(self, g):
+            if fdp.trim:
+                fdp.kill(g.rid)
+            super().free_region(g)
+    return FdpSim(cfg)
+
+
+def trace(n_req, n_obj, seed=1):
+    """Zipf-like popularity; small objects (1-4 KiB) are popular, large (64-256 KiB) are cold"""
+    rng = random.Random(seed)
+    sizes = [rng.randint(1024, 4096) if i % 4 else rng.randint(65536, 262144) for i in range(n_obj)]
+    w = [1.0 / (i + 1) ** 0.9 for i in range(n_obj)]
+    order = list(range(n_obj))
+    rng.shuffle(order)                       # popularity rank independent of id
+    ids = rng.choices(order, weights=w, k=n_req)
+    return [(i, sizes[i]) for i in ids]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    here = os.path.dirname(os.path.abspath(__file__))
+    ap.add_argument("--ref", default=os.path.normpath(os.path.join(here, "../../../../cachesim/tests")))
+    ap.add_argument("--req", type=int, default=200000)
+    a = ap.parse_args()
+    sys.path.insert(0, a.ref)
+    import ref_sim
+
+    R, N = 1 << 19, 128
+    tr = trace(a.req, 20000)
+    print(f"{'region-evict':12} {'ru/R':>4} {'ruh':>3} {'iso':>3} {'trim':>4} {'OHR':>7} {'DLWA':>7}  per-class DLWA")
+    for rev in ("fifo", "lru"):
+        for spr, n_ruh, pi, trim in ((1, 1, False, False), (4, 1, False, False), (4, 2, False, False),
+                                     (4, 2, True, False), (4, 1, False, True), (4, 2, True, True)):
+            fdp = Fdp(N, R, spr * R, n_ruh, pi=pi, op=0.25, trim=trim)
+            cfg = dict(mode="region", R=R, N=N, dram=0, dram_policy="lru", inclusion="cachelib",
+                       region_evict=rev, taus=[16384])
+            s = make_sim(ref_sim, cfg, fdp)
+            for oid, size in tr:
+                s.request(oid, size)
+            k = s.k
+            assert k["flash_region_write_bytes"] == fdp.host
+            ohr = (k.get("dram_hits", 0) + k.get("ssd_hits", 0)) / k["reqs"]
+            per = " ".join(f"c{c}={(fdp.cls_host[c] + fdp.cls_gc.get(c, 0)) / fdp.cls_host[c]:.3f}"
+                           for c in sorted(fdp.cls_host))
+            print(f"{rev:12} {spr:4} {n_ruh:3} {'pi' if pi else 'ii':>3} {int(trim):4} {ohr:7.4f} {fdp.dlwa():7.3f}  {per}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/regionflash/features.sh b/scripts/regionflash/features.sh
new file mode 100644
index 0000000..1676dd5
--- /dev/null
+++ b/scripts/regionflash/features.sh
@@ -0,0 +1,74 @@
+#!/bin/bash
+# features.sh OLD NEW — every RegionFlash feature on the first $NREQ requests
+# (default 100000) of each trace, small enough that regions are evicted
+# (SSD 256 MB, R 4 MiB, chunk 1 MiB, RU 16 MiB with FDP). Each output file of
+# NEW must equal OLD's (P.json without region_policy); the counters that show
+# the feature ran are printed for NEW.
+OLD=${1:?old binary} NEW=${2:?new binary}
+NREQ=${NREQ:-100000}
+TRACES=${TRACES:-/root/tc/w01.oracleGeneral.bin.zst /root/tc/tencent.oracleGeneral.zst /root/tc/meta.oracleGeneral.zst}
+O=${FT_OUT:-/tmp/rf_features}
+B="dram-size=16MiB,region-size=4MiB,chunk=1M,interval=20000"
+FDP="ru-size=16MiB,fdp-op=0.5"
+CFG=(
+  # DRAM, inclusion, SSD modes
+  "$B" "$B,dram-size=0" "$B,dram-algo=s3fifo" "$B,dram-algo=fifo,inclusion=exclusive"
+  "$B,inclusion=inclusive" "$B,chunk=0" "$B,warmup-req=30000,seed=7"
+  "$B,ssd-mode=object,ssd-algo=s3fifo,chunk=0" "$B,ssd-mode=object,ssd-algo=lru,chunk=0,reinsert=hits:n=1"
+  # Region eviction
+  "$B,region-evict=fifo" "$B,region-evict=beta,beta=0.5,hint=fixed:16K/64K" "$B,region-evict=lcs:s3fifo"
+  "$B,region-evict=sieve" "$B,region-evict=oracle" "$B,region-evict=oracle,region-params=rank-intvl=0.05"
+  "$B,region-evict=gl" "$B,region-evict=gl,region-params=label=oracle"
+  "$B,region-evict=gl,region-params=warm=lru/retrain-req=20000/ylog=1"
+  # hints and admission
+  "$B,hint=fixed:16K/64K" "$B,hint=split_threshold:recalc=20000" "$B,hint=split_threshold_req:recalc=20000"
+  "$B,hint=st_recursive:depth=2/recalc=20000" "$B,hint=key:key=size/recalc=20000"
+  "$B,hint=st_hitrate:recalc=20000/hr_window=20000" "$B,hint=oracle_gdt:k=4/recalc=20000"
+  "$B,hint=split_threshold:recalc=20000,seal-on-repartition=inactive"
+  "$B,admit=seen:m=50000" "$B,admit=tinylfu" "$B,admit=cachesack:interval=20000" "$B,admit=sizemax:max=64K"
+  # reinsertion
+  "$B,reinsert=hits:n=1" "$B,hint=fixed:16K,reinsert=hits:n=1/mode=ii"
+  "$B,hint=split_threshold:recalc=20000,reinsert=hits:n=1/class=reclassify/hint_on_reinsert=yes"
+  # FDP (RU 16 MiB = 4 regions)
+  "$B,hint=fixed:16K,$FDP,ruh=2" "$B,hint=fixed:16K,$FDP,ruh=1,fdp-trim=1" "$B,hint=fixed:16K,$FDP,ruh=2,fdp-iso=pi"
+  "$B,hint=fixed:16K,region-evict=fifo,$FDP,ruh=2" "$B,hint=fixed:16K,region-evict=gl,$FDP,ruh=2"
+  # gl's window / sampling, reinsert=score, the value hint (10-22)
+  "$B,region-evict=gl,region-params=sample=0/window=50000" "$B,reinsert=score:max_frac=0.5"
+  "$B,hint=value:recalc=1000/sample=4,reinsert=score:max_frac=0.3/n=1"
+  "$B,hint=value:k=3/label=oracle/recalc=1000/sample=4,region-evict=gl"
+)
+rm -rf $O; n=0; bad=0
+for tr in $TRACES; do
+  for e in "${CFG[@]}"; do
+    n=$((n+1))
+    for v in old new; do
+      b=$OLD; [ $v = new ] && b=$NEW; mkdir -p $O/$v
+      $b $tr oracleGeneral RegionFlash 256mb -n $NREQ -e "$e,out=$O/$v/c$n" > $O/$v/c$n.stdout 2>&1 || echo "c$n $v FAILED rc=$? [$e]: $(tail -1 $O/$v/c$n.stdout)"
+    done
+    r=$(python3 - $O $n <<'P'
+import json, sys, os, glob
+O, n = sys.argv[1], sys.argv[2]
+d = []
+for f in sorted(glob.glob(f"{O}/old/c{n}.*")):
+    g = f.replace("/old/", "/new/")
+    if f.endswith(".stdout"): continue
+    if f.endswith(".json"):
+        a, b = json.load(open(f)), json.load(open(g))
+        a.pop("region_policy", None); b.pop("region_policy", None)
+        if a != b: d.append(os.path.basename(f))
+    elif open(f, "rb").read() != open(g, "rb").read(): d.append(os.path.basename(f))
+t = json.load(open(f"{O}/new/c{n}.json"))["total"]
+j = json.load(open(f"{O}/new/c{n}.json"))
+show = " ".join(f"{k}={t[k]}" for k in ("regions_evicted", "chunk_objs", "fdp_gc_copy_bytes", "reinsert_objs",
+                                         "admit_reject_objs", "repartition_seals", "ssd_evict_objs") if t.get(k))
+rp, hr = j.get("region_policy") or {}, j.get("hint_result") or {}
+if "snapshots" in rp: show += f" gl:snap={rp['snapshots']},train={rp['trainings']},window={rp['window']}"
+if "recent_bytes_per_class" in hr: show += f" value:train={hr['trainings']},bytes={hr['recent_bytes_per_class']}"
+print(("same" if not d else "DIFF " + ",".join(d)) + f" omr={t['omr']:.4f} {show}")
+P
+)
+    case $r in same*) ;; *) bad=$((bad+1));; esac
+    echo "c$n $(basename $tr | cut -d. -f1) [${e#$B}] $r"
+  done
+done
+echo "$((n-bad))/$n runs identical"
diff --git a/scripts/regionflash/gen_drift_trace.py b/scripts/regionflash/gen_drift_trace.py
new file mode 100644
index 0000000..dd7b8f3
--- /dev/null
+++ b/scripts/regionflash/gen_drift_trace.py
@@ -0,0 +1,28 @@
+"""a trace whose size mix drifts, so a per-request SplitThreshold moves:
+phase 0 small-only (narrow band: no split), then a large tail that grows,
+then the small sizes shift up, then large only (narrow again). Zipf-like
+popularity inside each phase. oracleGeneral, uncompressed; next access -2.
+argv: out n  (st_req_check.py checks split_threshold_req on it)"""
+import random, struct, sys
+
+out, n = sys.argv[1], int(sys.argv[2])
+rnd = random.Random(7)
+phases = [  # (small sizes, large sizes, share of large requests)
+    ((1 << 10, 1 << 12), (1 << 18, 1 << 19), 0.0),
+    ((1 << 10, 1 << 12), (1 << 18, 1 << 20), 0.05),
+    ((1 << 10, 1 << 12), (1 << 18, 1 << 20), 0.25),
+    ((1 << 13, 1 << 15), (1 << 18, 1 << 20), 0.25),
+    ((1 << 13, 1 << 15), (1 << 16, 1 << 17), 0.0),
+]
+nobj = 20000
+with open(out, "wb") as f:
+    for t in range(n):
+        ph = t * len(phases) // n
+        sm, lg, pl = phases[ph]
+        large = rnd.random() < pl
+        rank = int(nobj ** rnd.random())  # ~ 1/rank popularity
+        oid = (ph * 4 + large * 2 + 1) * 10 ** 6 + rank  # new objects per phase
+        r = random.Random(oid)
+        lo, hi = lg if large else sm
+        size = r.randint(lo, hi)
+        f.write(struct.pack("<IQIq", t, oid, size, -2))
diff --git a/scripts/regionflash/gen_oracle_trace.py b/scripts/regionflash/gen_oracle_trace.py
new file mode 100644
index 0000000..071790a
--- /dev/null
+++ b/scripts/regionflash/gen_oracle_trace.py
@@ -0,0 +1,14 @@
+"""oracleGeneral trace: <uint32 t, uint64 id, uint32 size, int64 next(1-based, -1 none)>"""
+import random, struct, sys
+out, n, nobj, seed = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
+rng = random.Random(seed)
+w = [1 / (i + 1) ** 0.9 for i in range(nobj)]
+size = {i: max(1, int(rng.lognormvariate(9.5, 1.6))) % (900 * 1024) + 1 for i in range(nobj)}
+ids = rng.choices(range(nobj), weights=w, k=n)
+nxt, last = [-1] * n, {}
+for k in range(n - 1, -1, -1):
+    nxt[k] = last.get(ids[k], -1)
+    last[ids[k]] = k + 1  # 1-based index of this request
+with open(out, "wb") as f:
+    for k, i in enumerate(ids):
+        f.write(struct.pack("<IQIq", k + 1, i + 1, size[i], nxt[k]))
diff --git a/scripts/regionflash/param_verify.py b/scripts/regionflash/param_verify.py
new file mode 100644
index 0000000..05f3d59
--- /dev/null
+++ b/scripts/regionflash/param_verify.py
@@ -0,0 +1,91 @@
+"""check the RegionFlash parameters that diff_ref.py / plugin_cmp.py do not
+cover. A: against cachesim (region-evict=beta, reinsert p and n=0, warmup,
+seed). B: spellings that must give identical results (taus, region-evict
+without lcs:, out/prefix, sizes, -a size vs admit=sizemax). C: seed and
+interval=0 behave as documented.
+usage: python3 param_verify.py [cachesim_bin regionflash_bin trace(oracleGeneral)]"""
+import glob, json, os, subprocess, sys
+
+CS, RF, TR = (sys.argv[1:4] if len(sys.argv) > 3 else
+              ("/root/cs/cachesim", "/root/b/bin/cachesim", "/root/cmp/t.og"))
+SSD, R, DRAM, OUT = 64 << 20, 1 << 20, 8 << 20, "/root/pverify"
+TOT = """reqs req_bytes dram_hits ssd_hits misses hit_bytes miss_bytes ssd_lookups ssd_admit_objs ssd_admit_bytes
+dram_evict_objs clean_skip_objs admit_reject_objs ssd_copy_lost_rewrites ssd_evict_objs ssd_evict_bytes
+dead_evict_objs dead_evict_bytes regions_sealed regions_evicted repartition_seals pad_bytes
+flash_region_write_bytes reinsert_objs reinsert_bytes""".split()
+bad = []
+
+
+def rf(name, e, extra=()):
+    p = f"{OUT}/{name}"
+    r = subprocess.run([RF, TR, "oracleGeneral", "RegionFlash", str(SSD), *extra, "-e",
+                        f"dram-size={DRAM},region-size={R},seal-on-repartition=inactive,{e},out={p}"], capture_output=True, text=True)
+    if r.returncode:
+        sys.exit(f"{name}: rc {r.returncode}\n{r.stderr[-1500:]}")
+    return p
+
+
+def check(name, ok, detail=""):
+    print(f"{name:52s} {'OK' if ok else 'DIFF'} {detail}")
+    if not ok:
+        bad.append(name)
+
+
+def vs_cachesim(name, cs_args, e):
+    d = f"{OUT}/cs_{name}"
+    os.makedirs(d, exist_ok=True)
+    subprocess.run([CS, "--trace", TR, "--trace-format", "oracleGeneral", "--ssd-size", str(SSD), "--region-size", str(R),
+                    "--dram-size", str(DRAM), "--out", d, *cs_args], check=True, stdout=subprocess.DEVNULL)
+    c = json.load(open(f"{d}/summary.json"))["result"]
+    t = json.load(open(rf(name, e) + ".json"))["total"]
+    diff = [f"{k}: cs {c.get(k, 0)} rf {t[k]}" for k in TOT if c.get(k, 0) != t[k]]
+    check(f"A {name}", not diff, f"OHR {t['ohr']:.6f} evicted {t['regions_evicted']} reinsert {t['reinsert_objs']} " + "; ".join(diff[:3]))
+
+
+def same(name, a, b):
+    ja, jb = (json.load(open(x + ".json")) for x in (a, b))
+    ok = ja["total"] == jb["total"] and ja["class"] == jb["class"]
+    check(f"B {name}", ok, f"OHR {ja['total']['ohr']:.6f}")
+
+
+os.makedirs(OUT, exist_ok=True)
+H = ["--hint", "fixed:16K,64K"]
+# A. against cachesim
+for b in ("0", "1", "-1", "2.5"):
+    vs_cachesim(f"beta_{b}", H + ["--region-evict", f"beta:beta={b}"], f"hint=fixed:16K/64K,region-evict=beta,beta={b}")
+vs_cachesim("reinsert_p0.5", H + ["--reinsert", "hits:n=1,p=0.5"], "hint=fixed:16K/64K,reinsert=hits:n=1/p=0.5")
+vs_cachesim("reinsert_n0_p0.3", H + ["--reinsert", "hits:n=0,p=0.3"], "hint=fixed:16K/64K,reinsert=hits:n=0/p=0.3")
+vs_cachesim("reinsert_ii_p0.7", H + ["--reinsert", "hits:n=2,p=0.7,mode=ii"], "hint=fixed:16K/64K,reinsert=hits:n=2/p=0.7/mode=ii")
+vs_cachesim("obj_reinsert_p0.4", ["--ssd-mode", "object", "--ssd-policy", "lru", "--reinsert", "hits:n=1,p=0.4"],
+            "ssd-mode=object,ssd-algo=lru,reinsert=hits:n=1/p=0.4")
+vs_cachesim("warmup_100k", H + ["--warmup", "100000"], "hint=fixed:16K/64K,warmup-req=100000")
+vs_cachesim("seed7_prob", ["--admit", "prob:p=0.5", "--seed", "7"], "admit=prob:p=0.5,seed=7")
+vs_cachesim("seed7_adaptsize", ["--admit", "adaptsize:interval=20000,sample=0.1", "--seed", "7"],
+            "admit=adaptsize:interval=20000/sample=0.1,seed=7")
+# B. spellings that must agree
+same("taus=16K/64K == hint=fixed:16K/64K", rf("taus", "hint=fixed,taus=16K/64K"), rf("fixed", "hint=fixed:16K/64K"))
+same("region-evict=s3fifo == lcs:s3fifo", rf("rev_plain", "region-evict=s3fifo"), rf("rev_lcs", "region-evict=lcs:s3fifo"))
+same("region-evict=beta,beta=0 == lru (1 class)", rf("beta0", "region-evict=beta,beta=0"), rf("lru", "region-evict=lru"))
+a, b = rf("outname", "interval=50000"), None
+r = subprocess.run([RF, TR, "oracleGeneral", "RegionFlash", str(SSD), "-e",
+                    f"dram-size={DRAM},region-size={R},seal-on-repartition=inactive,interval=50000,prefix={OUT}/prefixname"], capture_output=True)
+fa = sorted(os.path.basename(x)[len("outname"):] for x in glob.glob(f"{OUT}/outname.*"))
+fb = sorted(os.path.basename(x)[len("prefixname"):] for x in glob.glob(f"{OUT}/prefixname.*"))
+check("B out= and prefix= write the same files", fa == fb and all(
+    open(f"{OUT}/outname{s}", "rb").read() == open(f"{OUT}/prefixname{s}", "rb").read() for s in fa), str(fa))
+same("dram-size=8MiB == 8M == 8388608 == 0.0078125G", rf("sz1", "dram-size=8MiB"), rf("sz2", "dram-size=8388608"))
+same("dram-size=8M == 0.0078125G", rf("sz3", "dram-size=8M"), rf("sz4", "dram-size=0.0078125G"))
+same("chunk=1.5K == chunk=1536", rf("ck1", "chunk=1.5K"), rf("ck2", "chunk=1536"))
+same("-a size(<65537) == admit=sizemax:max=64K(<=)", rf("asize", "interval=0", ("-a", "size", "--admission-params", "size=65537")),
+     rf("sizemax", "interval=0,admit=sizemax:max=64K"))
+same("-a size == admit=all when nothing is that large", rf("asize_big", "interval=0", ("-a", "size", "--admission-params", "size=4294967296")),
+     rf("all", "interval=0"))
+# C. behaviour
+same("seed: same seed twice -> same result", rf("s1a", "admit=prob:p=0.5,seed=3"), rf("s1b", "admit=prob:p=0.5,seed=3"))
+j1, j2 = (json.load(open(rf(n, f"admit=prob:p=0.5,seed={s}") + ".json"))["total"] for n, s in (("s2a", 3), ("s2b", 4)))
+check("C seed: another seed -> other coin flips", j1["admit_reject_objs"] != j2["admit_reject_objs"],
+      f"rejects {j1['admit_reject_objs']} vs {j2['admit_reject_objs']}")
+p = rf("noiv", "interval=0")
+check("C interval=0: no interval files", not glob.glob(p + ".interval*") and os.path.exists(p + ".json"))
+print(f"{'ALL OK' if not bad else 'FAIL: ' + ', '.join(bad)}")
+sys.exit(1 if bad else 0)
diff --git a/scripts/regionflash/plugin_cmp.py b/scripts/regionflash/plugin_cmp.py
