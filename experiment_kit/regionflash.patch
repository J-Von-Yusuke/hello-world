@@ -0,0 +1,16 @@
+/* segment.h — 重み付き 1 次元最適分割（§9.6）。B ≤ 48 なので O(B² j) の素直な動的計画法 */
+#ifndef SEGMENT_H
+#define SEGMENT_H
+#include "hint_stats.h"
+
+typedef struct {
+    int l, r, jmax;
+    double sse[HS_NB + 1];                 /* sse[j]（j = 1..jmax、実現不能なら INFINITY） */
+    int start[HS_NB + 1][HS_NB + 1];       /* start[j][i] = j 区間分割の i 番目の区間の先頭バケット */
+} seg_t;
+
+/* 無効バケットは w = 0 で渡す（区間の連続性だけ保つ） */
+void   seg_run(const double *x, const double *w, int l, int r, int jmax, double min_share, seg_t *o);
+int    seg_elbow(const seg_t *o, double eps);            /* 肘の規則で選んだ区間数 */
+double seg_sse_cuts(const double *x, const double *w, int l, int r, const int *cuts, int ncut);
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/sst.h b/libCacheSim/cache/eviction/flash/util/sst.h
new file mode 100644
index 0000000..61a4026
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/sst.h
@@ -0,0 +1,144 @@
+/*
+ * split_threshold.h — 統計だけでサイズ分割閾値を推定 (複数規則を比較・2段構え)
+ *
+ * 3本の log2サイズ・バケット・ヒストグラム:
+ *   count[b]      : オブジェクト「個数」        → count_p50   ┐ admission時に即集積
+ *   all_bytes[b]  : 全オブジェクトの「サイズ和」 → byte_p50    ┘ (evict待ち不要)
+ *   cold_bytes[b] : OHW(在中アクセス<=1)サイズ和 → cold_byte_p50 (eviction時に集積)
+ *
+ * 即時性: count_p50/byte_p50/mid は admission のみで決まるので「最初から」使える。
+ *         cold_byte_p50 は eviction が溜まるほど精度が上がり、min/blendを後から効かせる。
+ *
+ * 2段構え(λ で連続切替):
+ *   mid      = geomean(count_p50, byte_p50)        (帯[count_p50,byte_p50]の中点; 狭帯は無分割)
+ *   min_rule = min(byte_p50, cold_byte_p50)         (実トレース最良+1pt以内; cold必要)
+ *   threshold = log空間で mid と min_rule を λ∈[0,1] 補間   (λ=0→mid, λ=1→min_rule)
+ *   ＋無分割ゲート: 帯が狭い or 大poolのバイト割合が小さい → 無分割
+ *
+ * ドリフト追従: 指数移動平均(周期的に乗法減衰)。集積 O(1), 再計算 O(NBUCKET), メモリ ~1.2KB。
+ */
+#ifndef SPLIT_THRESHOLD_H
+#define SPLIT_THRESHOLD_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define SST_NBUCKET        48          /* 2^0(1B) .. 2^47 */
+#define SST_RECALC_OBS     100000ULL   /* この観測数ごとに 再計算＋EMA減衰 */
+/* EMA: 再計算ごとに hist *= (DEN-1)/DEN。実効窓 ~ DEN×RECALC_OBS 観測 */
+#define SST_EMA_DEN        16          /* 15/16 ずつ残す(=実効窓 ~160万観測) */
+#define SST_NOSPLIT_PCT    5           /* 大poolバイト割合がこれ未満(%)なら無分割 */
+#define SST_MIN_BAND_OCT   2           /* count_p50とbyte_p50が この octave 未満しか離れない → 無分割 */
+#define SST_LAMBDA_DEFAULT 256         /* λ×256。256=min_rule(本命), 0=mid, 中間=blend */
+
+typedef struct {
+  uint64_t count[SST_NBUCKET];
+  uint64_t all_bytes[SST_NBUCKET];
+  uint64_t cold_bytes[SST_NBUCKET];
+  uint64_t n_obs;                      /* admission観測数(再計算/減衰トリガ) */
+  int      lambda_x256;                /* 0..256: mid↔min_rule の補間係数(2段構え) */
+  int      min_band_oct;               /* 狭帯ゲート閾(octave) */
+  int      nosplit_pct;                /* 大poolゲート閾(%) */
+  int64_t  threshold;                  /* 現在の閾値; <0 は「無分割」 */
+} split_thresh_t;
+
+typedef struct {                       /* 比較用: 全候補(<0=データ不足) */
+  int64_t count_p50, byte_p50, cold_byte_p50, mid, min_rule;
+} sst_candidates_t;
+
+static inline int sst_bucket(uint64_t sz) {           /* floor(log2(sz)) */
+  int b = 0; while (sz > 1 && b < SST_NBUCKET - 1) { sz >>= 1; b++; } return b;
+}
+
+static inline void sst_init(split_thresh_t *s, int lambda_x256) {
+  memset(s, 0, sizeof(*s));
+  s->lambda_x256 = lambda_x256;        /* 例: 256=min_rule, 0=mid, 128=中間blend */
+  s->min_band_oct = SST_MIN_BAND_OCT;
+  s->nosplit_pct  = SST_NOSPLIT_PCT;
+  s->threshold = -1;
+}
+
+/* ── 集積点1: admission(ミス挿入)時。count/byte を即時に積む(evict待ち不要) ── */
+static inline void sst_on_admit(split_thresh_t *s, uint64_t obj_size) {
+  int b = sst_bucket(obj_size);
+  s->count[b] += 1;
+  s->all_bytes[b] += obj_size;
+}
+/* ── 集積点2: eviction時。最終 freq で OHW を確定し cold を積む ── */
+static inline void sst_on_evict(split_thresh_t *s, uint64_t obj_size, uint32_t freq) {
+  if (freq <= 1) s->cold_bytes[sst_bucket(obj_size)] += obj_size;
+}
+
+static inline int sst_p50_bucket(const uint64_t *h) {  /* 累積50%のバケット番号; 空=-1 */
+  uint64_t tot = 0; for (int b = 0; b < SST_NBUCKET; b++) tot += h[b];
+  if (tot == 0) return -1;
+  uint64_t cum = 0;
+  for (int b = 0; b < SST_NBUCKET; b++) { cum += h[b]; if (cum * 2 >= tot) return b; }
+  return SST_NBUCKET - 1;
+}
+
+static inline void sst_get_candidates(const split_thresh_t *s, sst_candidates_t *o) {
+  int cb = sst_p50_bucket(s->count);
+  int bb = sst_p50_bucket(s->all_bytes);
+  int kb = sst_p50_bucket(s->cold_bytes);
+  o->count_p50     = (cb < 0) ? -1 : (((int64_t)1) << cb);
+  o->byte_p50      = (bb < 0) ? -1 : (((int64_t)1) << bb);
+  o->cold_byte_p50 = (kb < 0) ? -1 : (((int64_t)1) << kb);
+  o->mid           = (cb < 0 || bb < 0) ? -1 : (((int64_t)1) << ((cb + bb + 1) / 2));
+  if (o->byte_p50 < 0) o->min_rule = -1;
+  else if (o->cold_byte_p50 < 0 || o->byte_p50 < o->cold_byte_p50) o->min_rule = o->byte_p50;
+  else o->min_rule = o->cold_byte_p50;
+}
+
+/* 大pool(>S)バイト割合が小さければ -1(無分割) */
+static inline int64_t sst_apply_pool_gate(const split_thresh_t *s, int64_t S) {
+  if (S < 0) return -1;
+  uint64_t tot = 0, large = 0;
+  for (int b = 0; b < SST_NBUCKET; b++) {
+    tot += s->all_bytes[b];
+    if ((((int64_t)1) << b) > S) large += s->all_bytes[b];
+  }
+  if (tot == 0 || large * 100 < tot * (uint64_t)s->nosplit_pct) return -1;
+  return S;
+}
+
+/* 採用閾値を再計算: 狭帯ゲート → λで mid↔min_rule をlog補間 → 大poolゲート */
+static inline void sst_recompute(split_thresh_t *s) {
+  int cb = sst_p50_bucket(s->count);
+  int bb = sst_p50_bucket(s->all_bytes);
+  if (cb < 0 || bb < 0) { s->threshold = -1; return; }   /* データ不足 */
+
+  /* 狭帯ゲート: count_p50 と byte_p50 が近い(=分離可能な裾が無い) → 無分割 */
+  if (bb - cb < s->min_band_oct) { s->threshold = -1; return; }
+
+  int mid_b = (cb + bb + 1) / 2;
+  int kb = sst_p50_bucket(s->cold_bytes);
+  int min_b = bb;                                         /* min_rule=byte_p50 (cold無ければ) */
+  if (kb >= 0 && kb < bb) min_b = kb;                     /* min(byte_p50, cold_byte_p50) */
+
+  /* log空間で mid_b と min_b を λ補間 (λ=0→mid, 256→min) */
+  int S_b = mid_b + ((min_b - mid_b) * s->lambda_x256 + 128) / 256;
+  if (S_b < 0) S_b = 0; if (S_b >= SST_NBUCKET) S_b = SST_NBUCKET - 1;
+
+  s->threshold = sst_apply_pool_gate(s, ((int64_t)1) << S_b);
+}
+
+/* admission末尾で呼ぶ: 周期再計算 + EMA(乗法減衰) */
+static inline void sst_tick(split_thresh_t *s) {
+  if (++s->n_obs % SST_RECALC_OBS == 0) {
+    sst_recompute(s);
+    for (int b = 0; b < SST_NBUCKET; b++) {               /* EMA: (DEN-1)/DEN を残す */
+      s->count[b]      = s->count[b]      * (SST_EMA_DEN - 1) / SST_EMA_DEN;
+      s->all_bytes[b]  = s->all_bytes[b]  * (SST_EMA_DEN - 1) / SST_EMA_DEN;
+      s->cold_bytes[b] = s->cold_bytes[b] * (SST_EMA_DEN - 1) / SST_EMA_DEN;
+    }
+  }
+}
+
+/* 配置: size>閾値 → 大pool(1); 無分割 → 常に小pool(0) */
+static inline int sst_pool_of(const split_thresh_t *s, uint64_t obj_size) {
+  if (s->threshold < 0) return 0;
+  return (obj_size > (uint64_t)s->threshold) ? 1 : 0;
+}
+
+#endif /* SPLIT_THRESHOLD_H */
diff --git a/libCacheSim/cache/eviction/flash/util/sst_wrap.h b/libCacheSim/cache/eviction/flash/util/sst_wrap.h
new file mode 100644
index 0000000..7103bd1
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/sst_wrap.h
@@ -0,0 +1,129 @@
+/* sst_wrap.h — SplitThreshold (the researcher's rule in sst.h, unmodified)
+ * as the hint providers use it:
+ *   ST_PARAM_SPECS, stw_*   its parameters, the recalculation with any
+ *                           recalc / ema_den, and the hysteresis
+ *   st_range_rule,          the same rule on a range of buckets only, and
+ *   st_split_taus           the recursive split (st_recursive, depth > 1)
+ */
+#ifndef RF_UTIL_SST_WRAP_H
+#define RF_UTIL_SST_WRAP_H
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wmisleading-indentation"
+#include "sst.h"
+#pragma GCC diagnostic pop
+#include "params.h"
+
+#define ST_PARAM_SPECS \
+    {"lambda", P_INT, "0", NULL, "λ×256（0 = mid（既定）, 256 = min_rule = C 版の既定）"}, \
+    {"min_band", P_INT, "2", NULL, "狭帯ゲート（オクターブ）"}, \
+    {"no_split_pct", P_INT, "5", NULL, "大 pool ゲート（%）"}, \
+    {"recalc", P_UINT, "100000", NULL, "再計算の間隔（受け入れ数）"}, \
+    {"ema_den", P_UINT, "16", NULL, "減衰 v ← v×(ema_den−1)/ema_den"}, \
+    {"size_add", P_UINT, "0", NULL, "各オブジェクトに足すバイト（Navy の serializedSize 近似）"}, \
+    {"hyst_hold", P_UINT, "1", NULL, "ヒステリシス: 同じ向きの候補がこの回数続いたら採用（1 = 即時）"}, \
+    {"hyst_band", P_UINT, "0", NULL, "ヒステリシス: 採用中の閾値からこのオクターブ未満の変化は無視（0 = 無効）"}
+
+typedef struct {
+    split_thresh_t s; uint64_t recalc, ema_den, add;
+    int64_t thr;                        /* 採用中の閾値（< 0 は無分割）。分類にはこちらを使う */
+    uint32_t hold, band, pend_n; int pend_dir, started;   /* started: 最初の再計算の候補はすぐ採用する（「まだ情報がない」は無分割の判断ではない） */
+} stw_t;
+
+static inline void stw_init(stw_t *w, const param_vals_t *v) {
+    sst_init(&w->s, (int)pv_int(v, "lambda"));
+    w->s.min_band_oct = (int)pv_int(v, "min_band");
+    w->s.nosplit_pct = (int)pv_int(v, "no_split_pct");
+    w->recalc = (uint64_t)pv_int(v, "recalc"); w->ema_den = (uint64_t)pv_int(v, "ema_den");
+    w->add = (uint64_t)pv_int(v, "size_add");
+    w->thr = -1; w->hold = (uint32_t)pv_int(v, "hyst_hold"); w->band = (uint32_t)pv_int(v, "hyst_band");
+    w->pend_n = 0; w->pend_dir = 0; w->started = 0;
+    if (!w->recalc || w->ema_den < 1) die("split_threshold: recalc must be > 0 and ema_den >= 1");
+    if (!w->hold) die("split_threshold: hyst_hold must be >= 1");
+}
+/* 再計算のたびに、候補 s.threshold を採用するかを決める */
+static inline void stw_hyst(stw_t *w) {
+    int64_t c = w->s.threshold, a = w->thr;
+    int dir;
+    if (!w->started) { w->started = 1; w->thr = c; return; }
+    if (c == a) { w->pend_n = 0; return; }
+    if (c >= 0 && a >= 0) {
+        int d = ilog2_u64((uint64_t)c) - ilog2_u64((uint64_t)a);
+        if ((uint32_t)(d < 0 ? -d : d) < w->band) { w->pend_n = 0; return; }   /* 不感帯 */
+        dir = d > 0 ? 1 : 2;
+    } else dir = c < 0 ? 3 : 4;                                               /* 無分割へ / 分割を始める */
+    w->pend_n = dir == w->pend_dir ? w->pend_n + 1 : 1;
+    w->pend_dir = dir;
+    if (w->pend_n >= w->hold) { w->thr = c; w->pend_n = 0; }
+}
+/* onAdmit(s)（＝ sst_on_admit ＋ tick）。再計算したら 1 を返し、st[6] に再計算時の候補値を入れる */
+static inline int stw_admit(stw_t *w, uint64_t sz, int64_t st[6]) {
+    int will = (w->s.n_obs + 1) % w->recalc == 0;
+    sst_on_admit(&w->s, sz);
+    if (will) {                     /* 再計算が見るのと同じ（減衰前の）ヒストグラムで候補値を取る */
+        sst_candidates_t c; sst_get_candidates(&w->s, &c);
+        st[1] = c.count_p50; st[2] = c.byte_p50; st[3] = c.cold_byte_p50; st[4] = c.mid; st[5] = c.min_rule;
+    }
+    if (w->recalc == SST_RECALC_OBS && w->ema_den == SST_EMA_DEN) sst_tick(&w->s);
+    else if (++w->s.n_obs % w->recalc == 0) {
+        sst_recompute(&w->s);
+        for (int b = 0; b < SST_NBUCKET; b++) {
+            w->s.count[b]      = w->s.count[b]      * (w->ema_den - 1) / w->ema_den;
+            w->s.all_bytes[b]  = w->s.all_bytes[b]  * (w->ema_den - 1) / w->ema_den;
+            w->s.cold_bytes[b] = w->s.cold_bytes[b] * (w->ema_den - 1) / w->ema_den;
+        }
+    }
+    if (will) { st[0] = w->s.threshold; stw_hyst(w); }
+    return will;
+}
+
+/* ---- the rule on a range of buckets [l, r], and the recursive split ---- */
+static inline int st_p50_range(const uint64_t *h, int l, int r) {
+    uint64_t tot = 0, cum = 0;
+    for (int b = l; b <= r; b++) tot += h[b];
+    if (tot == 0) return -1;
+    for (int b = l; b <= r; b++) { cum += h[b]; if (cum * 2 >= tot) return b; }
+    return r;
+}
+
+/* 範囲内での分割バケット sB（τ = 2^sB）。無分割なら -1 */
+static inline int st_range_rule(const split_thresh_t *s, int l, int r) {
+    if (l > r) return -1;
+    int cb = st_p50_range(s->count, l, r), bb = st_p50_range(s->all_bytes, l, r);
+    if (cb < 0 || bb < 0 || bb - cb < s->min_band_oct) return -1;
+    int mid_b = (cb + bb + 1) / 2, kb = st_p50_range(s->cold_bytes, l, r), min_b = bb;
+    if (kb >= 0 && kb < bb) min_b = kb;
+    int S_b = mid_b + ((min_b - mid_b) * s->lambda_x256 + 128) / 256;   /* C の 0 方向切り捨て（§9.4 3.） */
+    if (S_b < 0) S_b = 0;
+    if (S_b >= SST_NBUCKET) S_b = SST_NBUCKET - 1;
+    uint64_t tot = 0, large = 0;
+    for (int b = l; b <= r; b++) { tot += s->all_bytes[b]; if (b > S_b) large += s->all_bytes[b]; }
+    if (tot == 0 || large * 100 < tot * (uint64_t)s->nosplit_pct) return -1;
+    return S_b;
+}
+
+/* 最上位の閾値 thr（sst の threshold。< 0 は無分割）から、幅優先で再帰分割した τ（2^sB の形）を返す。
+ * 小側の範囲 = [l, sB−1]、大側 = [sB, r]（poolOf の「s > 2^sB」に合わせ、バケット sB は大側に数える）。
+ * 分類数は 2^depth と kmax の小さい方まで。戻り値 = τ の個数（昇順に並べて返す）。 */
+static inline int st_split_taus(const split_thresh_t *s, int64_t thr, int depth, int kmax, int64_t *taus) {
+    if (thr < 0 || kmax < 2 || depth < 1) return 0;
+    int n = 0, ql[128], qr[128], qd[128], qh = 0, qt = 0;
+    int sb = ilog2_u64((uint64_t)thr);
+    taus[n++] = thr;
+    ql[qt] = 0; qr[qt] = sb - 1; qd[qt++] = 1;
+    ql[qt] = sb; qr[qt] = SST_NBUCKET - 1; qd[qt++] = 1;
+    while (qh < qt && n + 1 < kmax) {
+        int l = ql[qh], r = qr[qh], d = qd[qh++];
+        if (d >= depth) continue;
+        int b = st_range_rule(s, l, r);
+        if (b < 0) continue;
+        int dup = 0;                                    /* b = l（大側の下端）だと既存の τ と重なる */
+        for (int i = 0; i < n; i++) dup |= taus[i] == ((int64_t)1 << b);
+        if (dup) continue;
+        taus[n++] = (int64_t)1 << b;
+        if (qt + 2 <= 128) { ql[qt] = l; qr[qt] = b - 1; qd[qt++] = d + 1; ql[qt] = b; qr[qt] = r; qd[qt++] = d + 1; }
+    }
+    for (int i = 1; i < n; i++)                         /* 挿入ソート（n ≤ 64） */
+        for (int j = i; j > 0 && taus[j - 1] > taus[j]; j--) { int64_t x = taus[j]; taus[j] = taus[j - 1]; taus[j - 1] = x; }
+    return n;
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/util/util.c b/libCacheSim/cache/eviction/flash/util/util.c
new file mode 100644
index 0000000..9b15930
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/util.c
@@ -0,0 +1,37 @@
+/* util.c — fatal errors and allocation (util.h) */
+#include "util.h"
+
+#include <stdarg.h>
+
+void die(const char *fmt, ...) {
+  va_list ap;
+  va_start(ap, fmt);
+  fputs("RegionFlash: ", stderr);
+  vfprintf(stderr, fmt, ap);
+  fputc('\n', stderr);
+  va_end(ap);
+  exit(2);
+}
+
+void *xmalloc(size_t n) {
+  void *p = malloc(n ? n : 1);
+  if (!p) die("out of memory (%zu bytes)", n);
+  return p;
+}
+
+void *xcalloc(size_t n, size_t sz) {
+  void *p = calloc(n ? n : 1, sz ? sz : 1);
+  if (!p) die("out of memory");
+  return p;
+}
+
+void *xrealloc(void *p, size_t n) {
+  p = realloc(p, n ? n : 1);
+  if (!p) die("out of memory (%zu bytes)", n);
+  return p;
+}
+
+char *xstrdup(const char *s) {
+  size_t n = strlen(s) + 1;
+  return memcpy(xmalloc(n), s, n);
+}
diff --git a/libCacheSim/cache/eviction/flash/util/util.h b/libCacheSim/cache/eviction/flash/util/util.h
new file mode 100644
index 0000000..9f84aba
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/util/util.h
@@ -0,0 +1,39 @@
+/* util.h — what the hint providers and admission policies share: fatal
+ * errors, allocation, growing arrays, a few constants. */
+#ifndef RF_UTIL_COMMON_H
+#define RF_UTIL_COMMON_H
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define NONE32 UINT32_MAX
+#define KMAX_LIMIT 64  // classes (write streams); a class is a uint8_t
+
