+  rf_sb_ctr_t sb_cum[RF_SB_N], sb_cur[RF_SB_N], sb_last[RF_SB_N];
+  uint64_t interval, n_ival, ival_start;
+  FILE *f_iv, *f_ivc, *f_ivs;  // P.interval*.csv
+} rf_params_t;
+
+#define CNT(p, f, c, v)                                   \
+  do {                                                    \
+    uint64_t v_ = (uint64_t)(v);                          \
+    uint32_t c_ = (uint32_t)(c);                          \
+    (p)->win.f += v_;                                     \
+    if (c_ < RF_KMAX) (p)->cwin[c_].f += v_;              \
+    if ((p)->counting) {                                  \
+      (p)->tot.f += v_;                                   \
+      if (c_ < RF_KMAX) (p)->cls[c_].f += v_;             \
+    }                                                     \
+  } while (0)
+
+/* per object-size bin: s is the whole object's size */
+#define SB(p, f, s, v)                         \
+  do {                                         \
+    uint32_t b_ = rf_size_bin(s);              \
+    uint64_t w_ = (uint64_t)(v);               \
+    (p)->sb_cur[b_].f += w_;                   \
+    if ((p)->counting) (p)->sb_cum[b_].f += w_; \
+  } while (0)
