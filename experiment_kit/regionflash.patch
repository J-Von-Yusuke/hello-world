+
+/* rf_hint.c */
+uint32_t rf_class_of(const rf_params_t *p, uint64_t s);
+const void *rf_plugin(int kind, const char *spec, param_vals_t *pv);
+void rf_refresh_map(rf_params_t *p);
+void rf_epoch_check(rf_params_t *p);
+uint32_t rf_hint_insert(rf_params_t *p, const cache_obj_t *o, int src);
+void rf_hint_req(rf_params_t *p, void (*fn)(rf_hint_t *, const rf_hint_ev_t *),
+                 uint64_t id, uint64_t s, uint32_t c, int outcome);
+
+/* rf_report.c */
+const char *rf_rev_name(const rf_params_t *p, char *buf, size_t n);
+void rf_mkdirs(const char *prefix);
+void rf_interval_open(rf_params_t *p);
+void rf_interval_end(rf_params_t *p);
+void rf_report(const rf_params_t *p);
+
+/* rf_params.c */
+void rf_parse(rf_params_t *p, const char *params, char algo[T_N][64]);
+
+#ifdef __cplusplus
+}
