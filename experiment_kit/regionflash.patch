+  request_t *req_local, *req_tmp, *req_ssd, *req_reg, *req_re;
+  /* config */
+  uint64_t R, chunk, dram_cap, ssd_cap, ssd_max_obj;
+  uint32_t N, kmax, khint, ntau;  // kmax = khint (+1: the hot class of re ii)
+  int64_t warmup;
+  int inclusion, ssd_mode, seal_rep;
+  bool fdp_on;
+  /* region-evict: a built-in policy (rops, region_policy.h), or
+   * lcs:<algorithm> (rops == NULL, region_lcs.c) */
+  const rf_rpol_ops_t *rops;
+  rf_rpol_t *rpol;
+  rf_rview_t rview;
+  bool rev_lcs;  // the parameter said lcs:<algorithm>
+  /* reinsertion (cachesim --reinsert hits:..., CacheLib Navy's hits- and
+   * percentage-based policies): an object on an evicted region (or an
+   * object-mode victim) with >= re_n SSD hits since it was written is
+   * written again with probability re_p */
+  bool re_on, re_ii, re_hint, re_reclass;
+  /* reinsert=score|recent: keep the best by GL-Cache's score | the most
+   * recently requested first (Colossus' "most recently used") */
+  bool re_score, re_recent, re_n_set;
+  uint32_t re_n;
+  uint64_t re_max_size;
+  double re_p, re_frac;
+  cache_obj_t **rebuf;  // candidates of the region evictions in progress
+  uint32_t nre, cap_re;
+  struct rf_keep *keep;  // reinsert=score: the scored objects of one region
+  uint32_t cap_keep;
+  double beta;
+  char out[256], params[T_N][256], spec[2][256], taus_s[256], lambda_s[32];
+  /* cachesim plugins (re-DESIGN.md §2): [0] admission, [1] hint */
+  const admission_ops_t *aops;
