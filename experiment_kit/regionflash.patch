diff --git a/libCacheSim/cache/eviction/flash/RegionFlash.c b/libCacheSim/cache/eviction/flash/RegionFlash.c
new file mode 100644
index 0000000..e02b113
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/RegionFlash.c
@@ -0,0 +1,449 @@
+//
+//  RegionFlash.c — DRAM (object unit) + SSD two-tier flash cache, ported from
+//  cachesim (docs/re-DESIGN.md §1, §6).
+//
+//  - DRAM: any libCacheSim algorithm (dram-algo, default lru). A DRAM hit does
+//          not touch the SSD. Every object leaving DRAM is a victim for the SSD.
+//  - SSD, ssd-mode=region: N = floor(cache_size / R) regions, FREE -> OPEN ->
+//          SEALED -> FREE. One OPEN region per hint class (write stream). A
+//          sealed region is written whole (R bytes). OPEN regions are never
+//          evicted. region-evict: fifo | lru | beta, or any libCacheSim
+//          algorithm applied to the sealed regions as objects of R bytes.
+//          Optional piece-wise writes (chunk) and FDP device model (ru-size).
+//  - SSD, ssd-mode=object: any libCacheSim algorithm (ssd-algo) on objects.
+//          The flash write is the admitted bytes (ideal: no device GC).
+//  - hint / admit: at the DRAM->SSD write, admit accept -> hint on_insert ->
+//          class (write stream). The hint sees the cache's operations
+//          (regionflash_hint.h: on_get, on_find, on_insert, on_evict).
+//          hint=NAME[:k=v/..] (hint/, listed in rf_hint.c): none, fixed,
+//          split_threshold, st_*, split_threshold_req, profile, key, oracle_*,
+//          value. admit=NAME[:k=v/..] (admit/, listed in admit.c): all, prob,
+//          sizemax, sizeexp, seen, adaptsize, cachesack, tinylfu, oracle_opt.
+//          Their decisions and random streams are cachesim's. Lists inside use
+//          '/' too: hint=fixed:4K/64K.
+//
+//  An inner libCacheSim cache reports its removals through
+//  cache_set_remove_hook; a removal is a victim only if find() no longer sees
+//  the object (composite algorithms also remove on internal moves). Victims are
+//  handled after each evict() call, so they reach the SSD in eviction order.
+//  After every request the bytes RegionFlash tracks must equal the inner
+//  cache's occupied bytes, otherwise the algorithm is rejected.
+//
+//  Params (-e): dram-size, dram-algo (alias dram-policy), dram-params,
+//  inclusion=cachelib|exclusive|inclusive, ssd-mode=region|object, ssd-algo,
+//  ssd-params, region-size, region-evict, region-params, beta, chunk,
+//  seal-on-repartition=none|inactive|all (default none), hint,
+//  admit, seed, taus / st-lambda (old spellings of fixed:... /
+//  split_threshold:lambda=...), warmup-req, ru-size, ruh, fdp-iso=ii|pi,
+//  fdp-op, fdp-trim, reinsert, interval, out (alias prefix: the path prefix of
+//  every report file; give each parallel run its own). Inner lists use '/' for ',' (the CLI
+//  turns ';' into ','): dram-params=small-size-ratio=0.1/move-to-main-threshold=2,
+//  reinsert=hits:n=1/max_frac=0.5/mode=ii. The positional cache size is the
+//  SSD size. Admission (-a) applies to SSD writes before admit=; its
+//  update() is called on every SSD lookup.
+//
+//  Source layout and where to add a feature: regionflash_internal.h.
+//
+//  Reports (with out=P): P.json, P.class.csv and P.sizebin.csv at the end
+//  (counted after the warm-up); with interval=N (requests, default 1000000)
+//  also P.interval.csv, P.interval.class.csv and P.interval.sizebin.csv, one
+//  "interval" row (that interval only, warm-up included) and one "cumulative"
+//  row (after the warm-up, so far) per interval. Requests, hits and size bins
+//  count whole objects, also when they are written piece-wise.
+//
+
+#include "regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+_Thread_local rf_params_t *rf_cur = NULL;
+
+void rf_obj_delete(rf_params_t *p, cache_obj_t *o) {
+  if (p->rpol != NULL && p->rops->on_delete) p->rops->on_delete(p->rpol, o);
+  hashtable_delete(p->cache->hashtable, o);
+  p->n_obj--;
+}
+
+// ***********************************************************************
+// ****                            DRAM                               ****
+// ***********************************************************************
+/* an object leaving DRAM: skip the write if a valid SSD copy exists
+ * (inclusion=cachelib), otherwise try to admit it to the SSD */
+void rf_victim(rf_params_t *p, cache_obj_t *v) {
+  CNT(p, dram_evict_objs, MD(v).cls, 1);
+  if (p->aops->on_dram_evict)
+    p->aops->on_dram_evict(p->adm, v->obj_id, (uint32_t)v->obj_size);
+  if ((MD(v).flags & RF_SSD) && p->inclusion == INC_CACHELIB) {
+    CNT(p, clean_skip_objs, MD(v).cls, 1);
+  } else {
+    if (MD(v).flags & RF_SSD) rf_ssd_invalidate(p, v);
+    rf_ssd_try_admit(p, v, SRC_DRAM_EVICT);
+    if (MD(v).flags & RF_LOST) {
+      if (MD(v).flags & RF_SSD) CNT(p, ssd_copy_lost_rewrites, MD(v).cls, 1);
+      MD(v).flags &= ~RF_LOST;
+    }
+  }
+  if (!(MD(v).flags & RF_SSD)) rf_obj_delete(p, v);
+}
+
+/* the requested object enters DRAM; DRAM's victims go to the SSD as they are
+ * evicted. One the algorithm does not keep (too large, or declined) is a
+ * victim itself. */
+static void rf_dram_insert(rf_params_t *p, cache_obj_t *o) {
+  MD(o).flags |= RF_DRAM;  // meanwhile, losing its SSD copy keeps the object
+  if ((uint64_t)o->obj_size <= p->dram_cap) MD(o).dram_hits = 0;
+  if (rf_tier_get(p, T_DRAM, p->req_local))
+    rf_die("RegionFlash: dram-algo %s holds an object not tracked\n",
+           p->tier[T_DRAM].algo);
+  if (rf_resident(p, T_DRAM, o->obj_id, o->obj_size)) {
+    p->dram_used += (uint64_t)o->obj_size;
+    return;
+  }
+  MD(o).flags &= ~RF_DRAM;
+  rf_victim(p, o);
+}
+
+static void rf_invalidate_all(rf_params_t *p, cache_obj_t *o) {
+  if (MD(o).flags & RF_DRAM) {
+    rf_tier_remove(p, T_DRAM, o->obj_id);
+    p->dram_used -= (uint64_t)o->obj_size;
+  }
+  if (MD(o).flags & RF_SSD) rf_ssd_invalidate(p, o);
+  rf_obj_delete(p, o);
+}
+
+// ***********************************************************************
+// ****                       cache interface                         ****
+// ***********************************************************************
+static bool RegionFlash_get(cache_t *cache, const request_t *req) {
+  rf_params_t *p = (rf_params_t *)cache->eviction_params;
+  /* the CLI seeds libCacheSim's per-thread random numbers with the time
+   * (bin/cachesim/sim.c), after the caches are made: reseed from `seed` so
+   * that random inner algorithms (Random, LeCaR, LHD, ...) repeat */
+  if (p->t == 0) set_rand_seed(p->seed * 6 + 6);
+  rf_cur = p;
+  cache_set_remove_hook(rf_on_remove, p);
+  cache->n_req += 1;
+  p->ev_req = 0;
+  p->counting = p->t >= p->warmup;
+  *p->req_local = *req;
+  uint64_t s = req->obj_size > 0 ? (uint64_t)req->obj_size : 1;
+  p->req_local->obj_size = (int64_t)s;
+
+  bool hit = true, changed = false;
+  int outcome = HINT_DRAM_HIT;
+  cache_obj_t *o = hashtable_find_obj_id(cache->hashtable, req->obj_id);
+  if (o != NULL && (uint64_t)o->obj_size != s) {  // size change: a new object
+    rf_invalidate_all(p, o);
+    o = NULL;
+    changed = true;
+  }
+  uint32_t rc = o != NULL ? MD(o).cls : rf_class_of(p, s);
+  CNT(p, reqs, rc, 1);
+  CNT(p, req_bytes, rc, s);
+  SB(p, reqs, s, 1);
+  SB(p, req_bytes, s, s);
+  if (changed) CNT(p, size_change_misses, rc, 1);
+  if (p->rpol != NULL && p->rops->on_request) p->rops->on_request(p->rpol, req, o);
+
+  if (o != NULL && (MD(o).flags & RF_DRAM)) {
+    if (!rf_tier_get(p, T_DRAM, p->req_local))
+      rf_die("RegionFlash: dram-algo %s lost an object\n", p->tier[T_DRAM].algo);
+    if (MD(o).dram_hits < UINT8_MAX) MD(o).dram_hits++;
+    CNT(p, dram_hits, rc, 1);
+    CNT(p, hit_bytes, rc, s);
+    CNT(p, dram_hit_bytes, rc, s);
+    SB(p, dram_hits, s, 1);
+    SB(p, dram_hit_bytes, s, s);
+  } else {
+    CNT(p, ssd_lookups, rc, 1);
+    CNT(p, ssd_lookup_bytes, rc, s);
+    SB(p, ssd_lookups, s, 1);
+    SB(p, ssd_lookup_bytes, s, s);
+    if (cache->admissioner != NULL && cache->admissioner->update != NULL)
+      cache->admissioner->update(cache->admissioner, p->req_local, p->ssd_cap);
+    if (p->aops->on_lookup)
+      p->aops->on_lookup(p->adm, (uint64_t)p->t, req->obj_id, rf_u32(s));
+    outcome = HINT_SSD_HIT;
+    if (o != NULL && (MD(o).flags & RF_SSD)) {  // every piece is still there
+      CNT(p, ssd_hits, rc, 1);
+      CNT(p, hit_bytes, rc, s);
+      CNT(p, ssd_hit_bytes, rc, s);
+      SB(p, ssd_hits, s, 1);
+      SB(p, ssd_hit_bytes, s, s);
+      rf_ssd_hit(p, o);
+      if (MD(o).ssd_hits < UINT16_MAX) MD(o).ssd_hits++;
+      rf_hint_req(p, p->hops->on_find, req->obj_id, s, rc, HINT_SSD_HIT);
+      if (p->dram_cap) {  // promote
+        if (p->inclusion == INC_EXCLUSIVE) rf_ssd_invalidate(p, o);
+        rf_dram_insert(p, o);
+      }
+    } else {
+      hit = false;
+      outcome = HINT_MISS;
+      rf_hint_req(p, p->hops->on_find, req->obj_id, s, rc, HINT_MISS);
+      CNT(p, misses, rc, 1);
+      CNT(p, miss_bytes, rc, s);
+      {  // 計測用：RF_MISSLOG=<file> でミスごとに 時刻 物ID
+        static FILE *ml = (FILE *)1;
+        if (ml == (FILE *)1) ml = getenv("RF_MISSLOG") ? fopen(getenv("RF_MISSLOG"), "w") : NULL;
+        if (ml) fprintf(ml, "%lld %llu\n", (long long)p->t, (unsigned long long)req->obj_id);
+      }
+      SB(p, misses, s, 1);
+      SB(p, miss_bytes, s, s);
+      if (o == NULL) {
+        o = hashtable_insert(cache->hashtable, p->req_local);
+        p->n_obj++;
+        MD(o).cls = (uint8_t)rc;
+        MD(o).loc = RF_NONE;
+      }
+      o->next_access_vtime = req->next_access_vtime;
+      if (p->dram_cap) {
+        rf_dram_insert(p, o);
+      } else {
+        rf_ssd_try_admit(p, o, SRC_MISS);
+        if (!(MD(o).flags & RF_SSD)) rf_obj_delete(p, o);
+      }
+    }
+  }
+  if (p->hops->on_get) rf_hint_req(p, p->hops->on_get, req->obj_id, s, rc, outcome);
+  rf_epoch_check(p);  // a provider may change its partition in any callback
+  rf_reg_flush(p);
+  o = hashtable_find_obj_id(cache->hashtable, req->obj_id);
+  if (o != NULL) {
+    o->next_access_vtime = req->next_access_vtime;
+    MD(o).last_t = (uint32_t)p->t;
+    MD(o).flags |= RF_SEEN;
+  }
+  p->t++;
+  if (p->interval && (uint64_t)p->t - p->ival_start == p->interval)
+    rf_interval_end(p);
+  cache_set_remove_hook(NULL, NULL);
+  rf_cur = NULL;
+  rf_check(p);
+  return hit;
+}
+
+static cache_obj_t *RegionFlash_find(cache_t *cache, const request_t *req,
+                                     bool update_cache) {
+  return hashtable_find_obj_id(cache->hashtable, req->obj_id);
+}
+
+static cache_obj_t *RegionFlash_insert(cache_t *cache, const request_t *req) {
+  rf_die("RegionFlash: insert/evict/to_evict are driven by get()\n");
+}
+
+static void RegionFlash_evict(cache_t *cache, const request_t *req) {
+  rf_die("RegionFlash: insert/evict/to_evict are driven by get()\n");
+}
+
+static cache_obj_t *RegionFlash_to_evict(cache_t *cache, const request_t *req) {
+  rf_die("RegionFlash: insert/evict/to_evict are driven by get()\n");
+}
+
+static bool RegionFlash_remove(cache_t *cache, obj_id_t obj_id) {
+  cache_obj_t *o = hashtable_find_obj_id(cache->hashtable, obj_id);
+  if (o == NULL) return false;
+  rf_params_t *p = (rf_params_t *)cache->eviction_params;
+  CNT(p, delete_objs, MD(o).cls, 1);  // a delete op (reader delete-obj-size): not a request
+  rf_invalidate_all(p, o);
+  return true;
+}
+
+static int64_t RegionFlash_get_occupied_byte(const cache_t *cache) {
+  const rf_params_t *p = (const rf_params_t *)cache->eviction_params;
+  return (int64_t)(p->dram_used + p->ssd_used);
+}
+
+static int64_t RegionFlash_get_n_obj(const cache_t *cache) {
+  return ((const rf_params_t *)cache->eviction_params)->n_obj;
+}
+
+static void RegionFlash_free(cache_t *cache) {
+  rf_params_t *p = (rf_params_t *)cache->eviction_params;
+  if (p->interval && (uint64_t)p->t > p->ival_start) rf_interval_end(p);  // the last, shorter one
+  if (p->f_iv != NULL) {
+    fclose(p->f_iv);
+    fclose(p->f_ivc);
+    fclose(p->f_ivs);
+  }
+  if (getenv("RF_ENDDUMP")) {  // 計測用：終了時に残っている Region（状態 分類 封じた時刻 touch 数 物ID...）
+    FILE *f = fopen(getenv("RF_ENDDUMP"), "w");
+    for (uint32_t r = 0; f && r < p->N; r++) {
+      const rf_region_t *g = &p->reg[r];
+      if (g->state != RF_R_SEALED && g->state != RF_R_OPEN) continue;
+      fprintf(f, "%c %u %lld %llu", g->state == RF_R_SEALED ? 'S' : 'O', g->cls, (long long)g->seal_t,
+              (unsigned long long)g->touches);
+      for (uint32_t j = 0; j < g->n_ent; j++)
+        if (g->ent[j].o) fprintf(f, " %llu", (unsigned long long)g->ent[j].o->obj_id);
+      fputc('\n', f);
+    }
+    if (f) fclose(f);
+  }
+  rf_report(p);
+  p->hops->destroy(p->hint);
+  p->aops->destroy(p->adm);
+  for (int k = 0; k < 2; k++) {
+    for (int i = 0; i < p->pv[k].n; i++) free(p->pv[k].val[i]);
+    free((char *)p->pv[k].name);
+  }
+  for (int t = 0; t < T_N; t++) {
+    rf_tier_t *x = &p->tier[t];
+    if (x->c != NULL) {
+      x->c->evict = x->evict0;
+      x->c->cache_free(x->c);
+    }
+    free(x->cand);
+  }
+  rf_regions_free(p);
+  free_request(p->req_local);
+  free_request(p->req_tmp);
+  free_request(p->req_ssd);
+  free_request(p->req_reg);
+  free_request(p->req_re);
+  free(p->rebuf);
+  free(p);
+  cache_struct_free(cache);
+}
+
+cache_t *RegionFlash_init(const common_cache_params_t ccache_params,
+                          const char *cache_specific_params) {
+  cache_t *cache =
+      cache_struct_init("RegionFlash", ccache_params, cache_specific_params);
+  cache->cache_init = RegionFlash_init;
+  cache->cache_free = RegionFlash_free;
+  cache->get = RegionFlash_get;
+  cache->find = RegionFlash_find;
+  cache->insert = RegionFlash_insert;
+  cache->evict = RegionFlash_evict;
+  cache->remove = RegionFlash_remove;
+  cache->to_evict = RegionFlash_to_evict;
+  cache->get_occupied_byte = RegionFlash_get_occupied_byte;
+  cache->get_n_obj = RegionFlash_get_n_obj;
+  cache->obj_md_size = 0;
+
+  rf_params_t *p = calloc(1, sizeof(rf_params_t));
+  cache->eviction_params = p;
+  p->cache = cache;
+  p->req_local = new_request();
+  p->req_tmp = new_request();
+  p->req_ssd = new_request();
+  p->req_reg = new_request();
+  p->req_re = new_request();
+  p->active = -1;
+  p->re_n = 1;
+  p->re_p = 1.0;
+  p->re_frac = 0.5;
+  p->R = 16 * MiB;
+  p->inclusion = INC_CACHELIB;
+  snprintf(p->spec[0], 256, "all");
+  snprintf(p->spec[1], 256, "none");
+  p->seed = 1;  // cachesim --seed
+  p->interval = 1000000;  // cachesim --window
+  p->ssd_mode = SSD_REGION;
+  p->fdp.n_ruh = 8;
+  p->fdp.op = 0.07;
+  char algo[T_N][64] = {"lru", "lru", "lru"};
+  if (cache_specific_params != NULL) rf_parse(p, cache_specific_params, algo);
+
+  if (!p->re_on) p->re_ii = p->re_reclass = p->re_hint = false;
+  if (p->re_on) {  // the same checks as cachesim main.c
+    if (p->re_reclass && !p->re_hint)
+      rf_die("RegionFlash: reinsert class=reclassify requires hint_on_reinsert=yes\n");
+    if (p->re_ii && p->re_reclass)
+      rf_die("RegionFlash: reinsert mode=ii puts every reinserted object in one hot stream\n");
+    if (!(p->re_frac > 0 && p->re_frac <= 1)) rf_die("RegionFlash: reinsert max_frac must be in (0, 1]\n");
+    if (!(p->re_p > 0 && p->re_p <= 1)) rf_die("RegionFlash: reinsert p must be in (0, 1]\n");
+    /* n=0 with p=1 rewrites every evicted object that fits the budget, every
+     * time: with the padding of the regions it fills, an eviction may free
+     * nothing and never end. n >= 1 cannot loop (ssd_hits is reset to 0) */
+    if (!p->re_score && p->re_n == 0 && p->re_p >= 1)
+      rf_die("RegionFlash: reinsert n=0 needs p < 1 (CacheLib's percentage policy)\n");
+    /* score, recent: the best objects up to R * max_frac, any hits (n=0)
+     * unless n= is given, no coin (p); max_frac < 1 so that an eviction
+     * frees space (and a request that never frees enough stops rewriting:
+     * rf_evict_region) */
+    if (p->re_score && !p->re_n_set) p->re_n = 0;
+    if (p->re_score && (p->ssd_mode == SSD_OBJECT || p->re_frac >= 1))
+      rf_die("RegionFlash: reinsert=%s needs ssd-mode=region and max_frac < 1\n",
+             p->re_recent ? "recent" : "score");
+    if (p->ssd_mode == SSD_OBJECT && (p->re_ii || p->re_reclass || p->re_n == 0))
+      rf_die("RegionFlash: ssd-mode=object reinserts in place: mode=ii and class=reclassify "
+             "need ssd-mode=region, and n must be >= 1\n");
+  }
+  p->ssd_cap = ccache_params.cache_size;
+  p->fdp_on = p->fdp.ru_size > 0;
+
+  /* the hint decides k (cachesim --k-max auto); its rng streams as cachesim's */
+  char spec[300];
+  snprintf(spec, sizeof(spec), "%s", p->spec[1]);
+  if (strcmp(spec, "fixed") == 0 && p->taus_s[0])  // old spellings
+    snprintf(spec, sizeof(spec), "fixed:%s", p->taus_s);
+  if (strcmp(spec, "split_threshold") == 0 && p->lambda_s[0])
+    snprintf(spec, sizeof(spec), "split_threshold:lambda=%s", p->lambda_s);
+  rng_seed(&p->rng_a, p->seed * 6 + 4);
+  rng_seed(&p->rng_h, p->seed * 6 + 5);
+  rng_seed(&p->rng_re, p->seed * 6 + 6);
+  uint32_t envk = RF_KMAX - (p->re_ii ? 1 : 0);
+  hint_env_t he = {envk, p->ssd_mode == SSD_REGION ? p->R : 0, &p->rng_h};
+  p->hops = rf_plugin(1, spec, &p->pv[1]);
+  if (p->hops->create(&p->hint, &p->pv[1], &he) != 0) rf_die("RegionFlash: cannot create hint\n");
+  p->khint = p->hops->max_classes(p->hint);
+  if (p->khint < 1 || p->khint > envk)
+    rf_die("RegionFlash: hint %s needs %u classes, %u available\n", p->pv[1].name, p->khint, envk);
+  p->kmax = p->khint + (p->re_ii ? 1 : 0);  // ii: one more stream, the hot class
+  p->epoch = p->hops->epoch(p->hint);
+  rf_refresh_map(p);
+  if (p->dram_cap) rf_tier_init(p, T_DRAM, algo[T_DRAM], ccache_params, p->dram_cap);
+  p->rops = p->rev_lcs ? NULL : rf_rpol_find(algo[T_REG]);  // NULL: lcs:<algorithm>
+
+  if (p->ssd_mode == SSD_OBJECT) {
+    if (p->chunk || p->fdp_on || p->rops == NULL || strcasecmp(p->rops->name, "lru") != 0)
+      rf_die("RegionFlash: chunk, ru-size and region-evict need ssd-mode=region\n");
+    p->ssd_max_obj = p->ssd_cap;
+    rf_tier_init(p, T_SSD, algo[T_SSD], ccache_params, p->ssd_cap);
+  } else {
+    if (p->R == 0 || p->ssd_cap / p->R > UINT32_MAX)
+      rf_die("RegionFlash: bad region-size\n");
+    if (p->chunk > p->R)  // a piece must fit in one region (cachesim main.c)
+      rf_die("RegionFlash: chunk must be <= region-size\n");
+    p->N = (uint32_t)(p->ssd_cap / p->R);
+    if (p->N < p->kmax + 2)
+      rf_die("RegionFlash: N = %u regions < k + 2 = %u\n", p->N, p->kmax + 2);
+    p->ssd_max_obj = p->chunk ? (uint64_t)(p->N - p->kmax - 1) * p->R : p->R;
+    char rparams[300];  // beta's exponent is the beta= parameter
+    snprintf(rparams, sizeof(rparams), "%s", p->params[T_REG]);
+    if (p->rops != NULL && strcmp(p->rops->name, "beta") == 0)
+      snprintf(rparams, sizeof(rparams), "beta=%.17g%s%.256s", p->beta,
+               p->params[T_REG][0] ? "/" : "", p->params[T_REG]);
+    rf_regions_init(p, rparams);
+    if (p->rops == NULL) {
+      common_cache_params_t cp = ccache_params;
+      cp.hashpower = 4;
+      while (cp.hashpower < 30 && (1u << cp.hashpower) < p->N) cp.hashpower++;
+      rf_tier_init(p, T_REG, algo[T_REG], cp, (uint64_t)p->N * p->R);
+    }
+  }
+  admission_env_t ae = {&p->rng_a, p->ssd_mode == SSD_REGION ? (uint64_t)p->N * p->R : p->ssd_cap,
+                        p->ssd_mode == SSD_REGION ? p->R : p->ssd_cap};  // before chunk (cachesim)
+  p->aops = rf_plugin(0, p->spec[0], &p->pv[0]);
+  if (p->aops->create(&p->adm, &p->pv[0], &ae)) rf_die("RegionFlash: cannot create admit\n");
+  for (uint32_t c = 0; c < RF_KMAX; c++) p->open[c] = RF_NONE;
+  if (p->out[0] != '\0') {
+    rf_mkdirs(p->out);
+    if (p->interval) rf_interval_open(p);
+  }
+
+  char rev[80];
+  snprintf(cache->cache_name, CACHE_NAME_ARRAY_LEN, "RegionFlash-%.20s-%.24s%s",
+           p->dram_cap ? algo[T_DRAM] : "none",
+           p->ssd_mode == SSD_OBJECT ? algo[T_SSD] : rf_rev_name(p, rev, sizeof(rev)),
+           p->fdp_on ? "-fdp" : "");
+  return cache;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/admit/adaptsize.c b/libCacheSim/cache/eviction/flash/admit/adaptsize.c
new file mode 100644
index 0000000..bea1151
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/adaptsize.c
@@ -0,0 +1,213 @@
+/* adaptsize.c — AdaptSize（Berger, Sitaraman, Harchol-Balter, NSDI 2017）の受け入れ（§8.2）。
+ * 受け入れ確率は exp(−s/c)（sizeexp と同じ式）で、c を SSD 参照（DRAM ミス）interval 回ごとに候補
+ * log2 c = hi, hi − step, …, lo から選び直す（同点なら大きい c）。SSD 参照の列は SSD の受け入れに依らない
+ * （DRAM にはミスでも SSD ヒットでも入る）ので、どちらの調整器もこの列だけを見る。
+ * tuner=sim（既定）: 物 id のハッシュで割合 sample の物だけを取り出し、容量 sample × SSD 容量の物単位 LRU を候補ごとに
+ *   並行して模擬する（小型模擬。乱数は候補で共通なので受け入れる物の集合は c について入れ子）。各候補の窓ごとのヒット率
+ *   （objective=bhr ならバイトヒット率）を重み alpha で指数移動平均し、最大の候補を採る。
+ * tuner=model: 元の AdaptSize の Markov 近似。窓の物ごとの参照回数とサイズを（log2 サイズ, log2 回数）の 1/4 オクターブの表に
+ *   まとめて指数移動平均し、SSD を LRU とみた特性時間 μ を Σ m s P = 容量 から決め、予測 OHR = Σ m r P / Σ m r が最大の c を採る。
+ *   窓は参照 interval 回以上かつ異なる物のバイトが win × 容量以上。回数を率とみなす代入推定は窓が μ より十分長くないと
+ *   占有を過小に見積もり OHR を過大に予測する。また定常の式（horizon=0）は c → 0 で OHR を過大に予測する（§8.2 の注）。
+ * 配列は倍増でだけ伸ばす（要求ごとの確保なし）。 */
+#include "admit.h"
+#include "../util/hashmap.h"
+
+#define SB 172                                              /* model: 4·log2 サイズ（2^43 未満） */
+#define RB 120                                              /* model: 4·log2 回数（2^30 未満） */
+typedef struct { uint64_t cnt; uint32_t size; } ob_t;
+typedef struct { double m, s, r; } cell_t;
+typedef struct { uint64_t key; uint32_t sz, prv, nxt; } nd_t;
+typedef struct {                                            /* sim: 候補 1 つ分の物単位 LRU（nd の添字の双方向リスト） */
+    hmap_t m; nd_t *nd; uint64_t ncap, nn; uint32_t head, tail, fre; double used, h;
+} mc_t;
+struct admission {
+    rng_t *rng, mr; int model, bhr; double c, cap, maxobj, alpha, lo, hi, step, win, hz, sample, look;
+    uint64_t interval, n, nw, tunes, thr; double ubytes, wlen;
+    int ncand; double *score, *curve; mc_t *mc;             /* 候補ごと: 指数移動平均の評価値、最後の評価値、sim の LRU */
+    hmap_t idx; ob_t *ob; uint64_t ocap, nobj;              /* model: 窓の物（idx は id → ob の添字） */
+    double *H, *Hn; cell_t *cell;                           /* model: 表 [SB][RB][3] = 物の数, サイズの和, 率の和 */
+    double sum_lc, min_lc, max_lc, sum_best;
+    double *tr; uint64_t tcap, tn;                          /* 報告用の記録: (SSD 参照の通し番号, log2 c, 評価値) */
+};
+static const param_spec_t P[] = {
+    {"tuner", P_ENUM, "sim", "sim|model", "c の調整器"},
+    {"interval", P_UINT, "1000000", NULL, "調整の間隔（SSD 参照の回数。model は窓の最小の長さ）"},
+    {"alpha", P_DOUBLE, "0.5", NULL, "新しい窓の重み（指数移動平均）"},
+    {"lo", P_DOUBLE, "8", NULL, "候補 log2 c の下限"},
+    {"hi", P_DOUBLE, "40", NULL, "候補 log2 c の上限"},
+    {"step", P_DOUBLE, "1", NULL, "候補の刻み（log2）"},
+    {"c0", P_BYTES, "1T", NULL, "最初の調整までの c"},
+    {"sample", P_DOUBLE, "0.01", NULL, "sim: 模擬する物の割合（容量も同じ割合に縮める）"},
+    {"objective", P_ENUM, "ohr", "ohr|bhr", "sim: 最大にする指標"},
+    {"win", P_DOUBLE, "2", NULL, "model: 窓の異なる物のバイト数（SSD 容量の何倍か）"},
+    {"horizon", P_DOUBLE, "0", NULL, "model: 期間（窓の長さの何倍か）。0 = 定常（元の AdaptSize）"},
+    {NULL}};
+
+static int create(admission_t **out, const param_vals_t *v, const admission_env_t *e) {
+    admission_t *a = xcalloc(1, sizeof *a);
+    a->rng = e->rng; a->cap = (double)e->ssd_bytes; a->maxobj = (double)e->ssd_max_obj;
+    a->model = !strcmp(pv_str(v, "tuner"), "model"); a->bhr = !strcmp(pv_str(v, "objective"), "bhr");
+    a->c = (double)pv_int(v, "c0"); a->interval = (uint64_t)pv_int(v, "interval"); a->alpha = pv_dbl(v, "alpha");
+    a->lo = pv_dbl(v, "lo"); a->hi = pv_dbl(v, "hi"); a->step = pv_dbl(v, "step");
+    a->sample = pv_dbl(v, "sample"); a->win = pv_dbl(v, "win"); a->hz = pv_dbl(v, "horizon");
+    if (!a->interval || !(a->alpha > 0 && a->alpha <= 1) || !(a->c > 0) || !(a->step > 0) || a->hi < a->lo || !(a->cap > 0)
+        || !(a->sample > 0 && a->sample <= 1) || !(a->win > 0) || !(a->hz >= 0))
+        die("adaptsize: need interval > 0, 0 < alpha <= 1, c0 > 0, step > 0, lo <= hi, 0 < sample <= 1, win > 0, horizon >= 0 and an SSD");
+    a->ncand = (int)floor((a->hi - a->lo) / a->step + 1e-9) + 1;
+    a->score = xcalloc((size_t)a->ncand, 8); a->curve = xcalloc((size_t)a->ncand, 8);
+    a->min_lc = INFINITY; a->max_lc = -INFINITY;
+    if (a->model) {
+        hm_init(&a->idx, 1024);
+        a->H = xcalloc((size_t)SB * RB * 3, 8); a->Hn = xcalloc((size_t)SB * RB * 3, 8); a->cell = xmalloc((size_t)SB * RB * sizeof(cell_t));
+    } else {
+        rng_seed(&a->mr, rng_next(e->rng));
+        a->thr = a->sample >= 1 ? UINT64_MAX : (uint64_t)(a->sample * 0x1.0p64);
+        a->mc = xcalloc((size_t)a->ncand, sizeof(mc_t));
+        for (int j = 0; j < a->ncand; j++) { hm_init(&a->mc[j].m, 1024); a->mc[j].head = a->mc[j].tail = a->mc[j].fre = NONE32; }
+    }
+    *out = a;
+    return 0;
+}
+static void destroy(admission_t *a) {
+    for (int j = 0; a->mc && j < a->ncand; j++) { hm_free(&a->mc[j].m); free(a->mc[j].nd); }
+    if (a->model) hm_free(&a->idx);
+    free(a->mc); free(a->ob); free(a->H); free(a->Hn); free(a->cell); free(a->tr); free(a->score); free(a->curve); free(a);
+}
+
+/* ---- sim: 物単位 LRU ---- */
+static void mc_unlink(mc_t *m, uint32_t i) {
+    nd_t *x = &m->nd[i];
+    if (x->prv != NONE32) m->nd[x->prv].nxt = x->nxt; else m->head = x->nxt;
+    if (x->nxt != NONE32) m->nd[x->nxt].prv = x->prv; else m->tail = x->prv;
+}
+static void mc_front(mc_t *m, uint32_t i) {
+    m->nd[i].prv = NONE32; m->nd[i].nxt = m->head;
+    if (m->head != NONE32) m->nd[m->head].prv = i; else m->tail = i;
+    m->head = i;
+}
+static void mc_remove(mc_t *m, uint32_t i) {
+    mc_unlink(m, i); hm_del(&m->m, m->nd[i].key); m->used -= m->nd[i].sz;
+    m->nd[i].nxt = m->fre; m->fre = i;
+}
+static void sim_lookup(admission_t *a, uint64_t id, uint32_t size) {
+    double u = rng_double(&a->mr), cap = a->cap * a->sample;
+    a->look += a->bhr ? size : 1;
+    for (int j = 0; j < a->ncand; j++) {
+        mc_t *m = &a->mc[j];
+        uint64_t *p = hm_get(&m->m, id);
+        if (p) {
+            uint32_t i = (uint32_t)*p;
+            if (m->nd[i].sz == size) { m->h += a->bhr ? size : 1; mc_unlink(m, i); mc_front(m, i); continue; }
+            mc_remove(m, i);                                 /* サイズが変わった: 別の物として扱う */
+        }
+        if (size > a->maxobj || size > cap || !(u < exp(-(double)size / exp2(a->hi - j * a->step)))) continue;
+        uint32_t i = m->fre;
+        if (i != NONE32) m->fre = m->nd[i].nxt;
+        else { GROW(m->nd, m->ncap, m->nn + 1); i = (uint32_t)m->nn++; }
+        m->nd[i] = (nd_t){id, size, NONE32, NONE32};
+        mc_front(m, i); hm_put(&m->m, id, i); m->used += size;
+        while (m->used > cap) mc_remove(m, m->tail);
+    }
+}
+
+/* ---- model: AdaptSize の Markov 近似 ----
+ * 外→内の率 λ = r a（a = e^{−s/c}）、内→外の率 ν = r / (e^{rμ} − 1)（滞在を指数分布で近似）。
+ * 定常（hz = 0）: π = λ / (λ + ν) = 1 / (1 + e^{−L})、L = ln(e^{rμ} − 1) − s/c（対数で持ち桁あふれを避ける）。
+ * 有限の期間 hz（外から始める）: P = π (1 − (1 − e^{−κ hz}) / (κ hz))、κ = λ + ν（2 状態 Markov 連鎖の時間平均）。 */
+static double pin(const cell_t *x, double c, double mu, double hz) {
+    double rm = x->r * mu, L = (rm < 30 ? log(expm1(rm)) : rm) - x->s / c;
+    double pi = L > 0 ? 1 / (1 + exp(-L)) : exp(L) / (1 + exp(L));
+    if (hz <= 0) return pi;
+    double k = x->r * (exp(-x->s / c) + (rm < 30 ? 1 / expm1(rm) : exp(-rm))) * hz;
+    return pi * (k < 1e-4 ? k / 2 - k * k / 6 : 1 + expm1(-k) / k);
+}
+/* 候補 c での予測 OHR（容量の式 Σ m s P = cap を log μ について二分法で解く。μ = ∞ でも収まるならそのまま） */
+static double predict(const cell_t *cl, int nc, double c, double cap, double hz) {
+    double rsum = 0, occ = 0, h = 0, mu = INFINITY;
+    for (int i = 0; i < nc; i++) { rsum += cl[i].m * cl[i].r; occ += cl[i].m * cl[i].s * pin(&cl[i], c, mu, hz); }
+    if (rsum <= 0) return 0;
+    if (occ > cap) {
+        double lo = log(1e-3), hi = log(1e18);
+        for (int it = 0; it < 50; it++) {
+            double mid = 0.5 * (lo + hi);
+            occ = 0;
+            for (int i = 0; i < nc; i++) occ += cl[i].m * cl[i].s * pin(&cl[i], c, exp(mid), hz);
+            if (occ > cap) hi = mid; else lo = mid;
+        }
+        mu = exp(0.5 * (lo + hi));
+    }
+    for (int i = 0; i < nc; i++) h += cl[i].m * cl[i].r * pin(&cl[i], c, mu, hz);
+    return h / rsum;
+}
+static void model_curve(admission_t *a) {
+    memset(a->Hn, 0, (size_t)SB * RB * 3 * 8);
+    for (uint64_t i = 0; i < a->nobj; i++) {
+        int sb = (int)floor(4 * log2(a->ob[i].size ? a->ob[i].size : 1)), rb = (int)floor(4 * log2((double)a->ob[i].cnt));
+        if (sb >= SB) sb = SB - 1;
+        if (rb >= RB) rb = RB - 1;
+        double *x = &a->Hn[((size_t)sb * RB + (size_t)rb) * 3];
+        x[0] += 1; x[1] += a->ob[i].size; x[2] += (double)a->ob[i].cnt / (double)a->nw;
+    }
+    for (size_t k = 0; k < (size_t)SB * RB * 3; k++) a->H[k] = a->tunes ? a->alpha * a->Hn[k] + (1 - a->alpha) * a->H[k] : a->Hn[k];
+    a->wlen = a->tunes ? a->alpha * (double)a->nw + (1 - a->alpha) * a->wlen : (double)a->nw;
+    hm_clear(&a->idx); a->nobj = 0; a->ubytes = 0;
+    int nc = 0;
+    for (size_t k = 0; k < (size_t)SB * RB; k++) {
+        const double *x = &a->H[k * 3];
+        if (x[0] > 1e-9) a->cell[nc++] = (cell_t){x[0], x[1] / x[0], x[2] / x[0]};
+    }
+    for (int j = 0; j < a->ncand; j++) a->curve[j] = a->score[j] = predict(a->cell, nc, exp2(a->hi - j * a->step), a->cap, a->hz * a->wlen);
+}
+
+static void tune(admission_t *a) {
+    if (a->model) model_curve(a);
+    else for (int j = 0; j < a->ncand; j++) {
+        a->curve[j] = a->look > 0 ? a->mc[j].h / a->look : 0;
+        a->score[j] = a->tunes ? a->alpha * a->curve[j] + (1 - a->alpha) * a->score[j] : a->curve[j];
+        a->mc[j].h = 0;
+    }
+    a->look = 0; a->nw = 0;
+    int b = 0;
+    for (int j = 1; j < a->ncand; j++) if (a->score[j] > a->score[b] + 1e-12) b = j;   /* j = 0 が最大の c */
+    double lc = a->hi - b * a->step;
+    a->c = exp2(lc); a->tunes++;
+    a->sum_lc += lc; a->sum_best += a->score[b];
+    if (lc < a->min_lc) a->min_lc = lc;
+    if (lc > a->max_lc) a->max_lc = lc;
+    GROW(a->tr, a->tcap, a->tn + 3);
+    a->tr[a->tn++] = (double)a->n; a->tr[a->tn++] = lc; a->tr[a->tn++] = a->score[b];
+}
+
+static void on_lookup(admission_t *a, uint64_t t, uint64_t id, uint32_t size) {
+    (void)t;
+    a->n++; a->nw++;
+    if (a->model) {
+        uint64_t *p = hm_get(&a->idx, id);
+        if (p) a->ob[*p].cnt++;
+        else {
+            GROW(a->ob, a->ocap, a->nobj + 1);
+            a->ob[a->nobj] = (ob_t){1, size}; hm_put(&a->idx, id, a->nobj++);
+            a->ubytes += size;
+        }
+        if (a->nw >= a->interval && a->ubytes >= a->win * a->cap) tune(a);
+    } else {
+        if (splitmix64(id ^ 0xada9751ebULL) <= a->thr) sim_lookup(a, id, size);
+        if (a->nw >= a->interval) tune(a);
+    }
+}
+static int accept(admission_t *a, const admit_info_t *in) { return rng_double(a->rng) < exp(-(double)in->size / a->c); }
+
+static void report(admission_t *a, FILE *f) {
+    fprintf(f, "{ \"name\": \"adaptsize\", \"tuner\": \"%s\", \"tunes\": %lu, \"c_final\": %.0f",
+            a->model ? "model" : "sim", (unsigned long)a->tunes, a->c);
+    if (a->tunes) fprintf(f, ", \"log2_c_mean\": %.4f, \"log2_c_min\": %.2f, \"log2_c_max\": %.2f, \"score_mean\": %.6f",
+                          a->sum_lc / (double)a->tunes, a->min_lc, a->max_lc, a->sum_best / (double)a->tunes);
+    fputs(", \"last_curve\": [", f);
+    for (int j = 0; a->tunes && j < a->ncand; j++) fprintf(f, "%s[%.2f, %.6f]", j ? ", " : "", a->hi - j * a->step, a->curve[j]);
+    fputs("], \"trace\": [", f);
+    for (uint64_t i = 0; i < a->tn; i += 3) fprintf(f, "%s[%.0f, %.2f, %.6f]", i ? ", " : "", a->tr[i], a->tr[i + 1], a->tr[i + 2]);
+    fputs("] }", f);
+}
+
+const admission_ops_t adm_adaptsize_ops = {"adaptsize", P, create, destroy, accept, NULL, on_lookup, report};
diff --git a/libCacheSim/cache/eviction/flash/admit/admit.c b/libCacheSim/cache/eviction/flash/admit/admit.c
new file mode 100644
index 0000000..97073d6
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/admit.c
@@ -0,0 +1,11 @@
+/* admit.c — the admission policies by name (admit=NAME). A new policy: a file
+ * in admit/ written against admit.h, one line here, one in CMakeLists.txt. */
+#include "admit.h"
+
+extern const admission_ops_t adm_all_ops, adm_prob_ops, adm_sizemax_ops, adm_sizeexp_ops,
+    adm_seen_ops, adm_adaptsize_ops, adm_cachesack_ops, adm_oracle_opt_ops, adm_tinylfu_ops;
+
+const admission_ops_t *ADMISSIONS[] = {&adm_all_ops,       &adm_prob_ops,       &adm_sizemax_ops,
+                                       &adm_sizeexp_ops,   &adm_seen_ops,       &adm_adaptsize_ops,
+                                       &adm_cachesack_ops, &adm_oracle_opt_ops, &adm_tinylfu_ops,
+                                       &adm_budget_ops,    NULL};
diff --git a/libCacheSim/cache/eviction/flash/admit/admit.h b/libCacheSim/cache/eviction/flash/admit/admit.h
new file mode 100644
index 0000000..91440b2
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/admit.h
@@ -0,0 +1,43 @@
+/* admit.h — the admission policies (admit=NAME:k=v/...): before an object is
+ * written to the SSD, accept() decides whether it is. One file per policy,
+ * listed in ADMISSIONS (admit.c). */
+#ifndef RF_ADMIT_H
+#define RF_ADMIT_H
+#include "../util/params.h"
+#include "../util/rng.h"
+#include "../util/util.h"
+
+typedef struct admission admission_t;  // each policy defines struct admission
+
+typedef struct {
+  uint64_t t, id;
+  uint32_t size;
+  uint8_t source;  // SRC_DRAM_EVICT | SRC_MISS | SRC_REINSERT
+  uint8_t dram_hits;
+  uint64_t clock;  // the trace time (seconds) of the request that causes the write
+} admit_info_t;
+
+typedef struct {
+  rng_t *rng;
+  uint64_t ssd_bytes;    // the SSD's capacity (region mode: N * R)
+  uint64_t ssd_max_obj;  // the largest object the SSD holds
+} admission_env_t;
+
+typedef struct {
+  const char *name;
+  const param_spec_t *params;
+  int (*create)(admission_t **a, const param_vals_t *v, const admission_env_t *env);
+  void (*destroy)(admission_t *a);
+  int (*accept)(admission_t *a, const admit_info_t *info);
+  /* optional (NULL) */
+  void (*on_dram_evict)(admission_t *a, uint64_t id, uint32_t size);
+  void (*on_lookup)(admission_t *a, uint64_t t, uint64_t id, uint32_t size);  // every SSD lookup (DRAM miss)
+  void (*report)(admission_t *a, FILE *f);  // one JSON value: P.json admit_result
+} admission_ops_t;
+
+extern const admission_ops_t *ADMISSIONS[];
+/* admit=budget only (budget.c): a region eviction that rewrites a live object (reinsert=hits:...) spends the same write
+ * budget as an admission. 0 = no room, do not rewrite it. rf_region.c calls it when aops == &adm_budget_ops. */
+extern const admission_ops_t adm_budget_ops;
+int adm_budget_charge(admission_t *a, uint64_t clock, uint32_t size);
+#endif
diff --git a/libCacheSim/cache/eviction/flash/admit/basic.c b/libCacheSim/cache/eviction/flash/admit/basic.c
new file mode 100644
index 0000000..e865c51
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/basic.c
@@ -0,0 +1,68 @@
+/* basic.c — SSD 受け入れ方針 all / prob / sizemax / sizeexp / seen（§8.2） */
+#include "admit.h"
+#include "../util/hashmap.h"
+
+struct admission {
+    int kind; double p, c; uint64_t max; rng_t *rng;
+    uint64_t *ring, m, head, len; hmap_t cnt;      /* seen: 直近 m 件の id と出現回数 */
+};
+enum { A_ALL, A_PROB, A_SIZEMAX, A_SIZEEXP, A_SEEN };
+static const param_spec_t P_NONE[] = {{NULL}};
+static const param_spec_t P_PROB[] = {{"p", P_DOUBLE, "1.0", NULL, "受け入れ確率"}, {NULL}};
+static const param_spec_t P_SMAX[] = {{"max", P_BYTES, "1M", NULL, "s ≤ max なら受け入れ"}, {NULL}};
+static const param_spec_t P_SEXP[] = {{"c", P_BYTES, "64K", NULL, "確率 exp(−s/c)"}, {NULL}};
+static const param_spec_t P_SEEN[] = {{"m", P_UINT, "100000", NULL, "記憶する直近の件数"}, {NULL}};
+
+static admission_t *mk(int kind, const admission_env_t *e) { admission_t *a = xcalloc(1, sizeof(*a)); a->kind = kind; a->rng = e->rng; return a; }
+static int c_all(admission_t **a, const param_vals_t *v, const admission_env_t *r) { (void)v; *a = mk(A_ALL, r); return 0; }
+static int c_prob(admission_t **a, const param_vals_t *v, const admission_env_t *r) { *a = mk(A_PROB, r); (*a)->p = pv_dbl(v, "p"); return 0; }
+static int c_smax(admission_t **a, const param_vals_t *v, const admission_env_t *r) { *a = mk(A_SIZEMAX, r); (*a)->max = (uint64_t)pv_int(v, "max"); return 0; }
+static int c_sexp(admission_t **a, const param_vals_t *v, const admission_env_t *r) {
+    *a = mk(A_SIZEEXP, r); (*a)->c = (double)pv_int(v, "c");
+    if ((*a)->c <= 0) die("sizeexp: c must be > 0");
+    return 0;
+}
+static int c_seen(admission_t **a, const param_vals_t *v, const admission_env_t *r) {
+    admission_t *x = mk(A_SEEN, r);
+    x->m = (uint64_t)pv_int(v, "m");
+    if (!x->m) die("seen: m must be > 0");
+    x->ring = xmalloc(x->m * 8); hm_init(&x->cnt, x->m * 2);
+    *a = x;
+    return 0;
+}
+static void destroy(admission_t *a) { free(a->ring); if (a->cnt.cap) hm_free(&a->cnt); free(a); }
+
+static uint64_t seen_cnt(admission_t *a, uint64_t id) { uint64_t *c = hm_get(&a->cnt, id); return c ? *c : 0; }
+/* ring は (head, len) の循環バッファ。満杯なら最古を落としてから足す */
+static void seen_record(admission_t *a, uint64_t id) {
+    if (a->len == a->m) {
+        uint64_t old = a->ring[a->head], *c = hm_get(&a->cnt, old);
+        if (--*c == 0) hm_del(&a->cnt, old);
+        a->head = (a->head + 1) % a->m; a->len--;
+    }
+    a->ring[(a->head + a->len++) % a->m] = id;
+    uint64_t *c = hm_get(&a->cnt, id);
+    if (c) (*c)++; else hm_put(&a->cnt, id, 1);
+}
+
+static int accept(admission_t *a, const admit_info_t *in) {
+    switch (a->kind) {
+    case A_PROB:    return rng_double(a->rng) < a->p;
+    case A_SIZEMAX: return in->size <= a->max;
+    case A_SIZEEXP: return rng_double(a->rng) < exp(-(double)in->size / a->c);
+    case A_SEEN:
+        /* DRAM 追い出し由来: on_dram_evict が今回の分を記録済みなので 2 回目以上で受け入れ。
+         * DRAM なし（ミス由来）: ミスを記録し、記録前に 1 回以上あれば受け入れ。再挿入は常に受け入れ。 */
+        if (in->source == SRC_DRAM_EVICT) return seen_cnt(a, in->id) >= 2;
+        if (in->source == SRC_MISS) { int ok = seen_cnt(a, in->id) >= 1; seen_record(a, in->id); return ok; }
+        return 1;
+    default: return 1;
+    }
+}
+static void on_dram_evict(admission_t *a, uint64_t id, uint32_t size) { (void)size; if (a->kind == A_SEEN) seen_record(a, id); }
+
+const admission_ops_t adm_all_ops     = {"all",     P_NONE, c_all,  destroy, accept, NULL, NULL, NULL};
+const admission_ops_t adm_prob_ops    = {"prob",    P_PROB, c_prob, destroy, accept, NULL, NULL, NULL};
+const admission_ops_t adm_sizemax_ops = {"sizemax", P_SMAX, c_smax, destroy, accept, NULL, NULL, NULL};
+const admission_ops_t adm_sizeexp_ops = {"sizeexp", P_SEXP, c_sexp, destroy, accept, NULL, NULL, NULL};
+const admission_ops_t adm_seen_ops    = {"seen",    P_SEEN, c_seen, destroy, accept, on_dram_evict, NULL, NULL};
diff --git a/libCacheSim/cache/eviction/flash/admit/budget.c b/libCacheSim/cache/eviction/flash/admit/budget.c
new file mode 100644
index 0000000..a8ef0e1
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/budget.c
@@ -0,0 +1,79 @@
+/* budget.c — 書き込み予算つきの受け入れ（cdn_partial_trace_validity.md §7）。
+ * 予算 = dwpd × SSD 容量 ÷ 86400 バイト/トレース秒。「トレース上の時刻」(request の clock_time) を基準にするので、
+ * シミュレータの処理速度や構成ごとの速さに依存しない（§7.2 の対策 1）。
+ *   トークンバケット: 毎秒 rate だけ溜まり（上限 rate × burst 秒）、受け入れの書き込み（accept）と
+ *   再挿入（adm_budget_charge: rf_region.c の再挿入の選択で呼ぶ）の両方がバイト数だけ引く。足りなければ受け入れ／再挿入しない。
+ *   mode=adapt（既定）: 受け入れる確率 p を、窓 win トレース秒ごとに p = min(1, (rate × win − 再挿入の支出) ÷ 受け入れの要求量)
+ *     （どちらも指数移動平均）で更新する（md §7.2 の対策 3 を時刻基準で行う）。バケットは硬い上限。
+ *   mode=fcfs: p = 1（先着順。バケットだけが制限する。小さな物が通りやすい）。
+ * 再挿入が減れば、同じバケットから新しい物の受け入れに回る（md §7.1）。 */
+#include "admit.h"
+
+struct admission {
+    double rate, cap, tokens, p, win, target, w_spend, w_off, w_ri, off_ema, ri_ema, ri_b, acc_b, off_b, psum;
+    uint64_t last, wstart, nwin, rej_p, rej_t, ri_ok, ri_den, n_acc;
+    int started, fcfs; rng_t *rng;
+};
+static const param_spec_t P[] = {
+    {"dwpd", P_DOUBLE, "3", NULL, "1 日に SSD 容量の何回分まで書くか"},
+    {"win", P_DOUBLE, "3600", NULL, "確率 p を更新する窓（トレース秒）"},
+    {"burst", P_DOUBLE, "7200", NULL, "バケットの上限（トレース秒分の予算）"},
+    {"mode", P_ENUM, "adapt", "adapt|fcfs", "adapt: 確率 p を調整 / fcfs: 先着順"},
+    {NULL}};
+
+static int create(admission_t **out, const param_vals_t *v, const admission_env_t *e) {
+    admission_t *a = xcalloc(1, sizeof *a);
+    double dwpd = pv_dbl(v, "dwpd");
+    a->win = pv_dbl(v, "win"); a->fcfs = !strcmp(pv_str(v, "mode"), "fcfs"); a->rng = e->rng;
+    if (!(dwpd > 0) || !(a->win > 0) || !(pv_dbl(v, "burst") > 0) || !(e->ssd_bytes > 0)) die("budget: need dwpd > 0, win > 0, burst > 0 and an SSD");
+    a->rate = dwpd * (double)e->ssd_bytes / 86400.0;
+    a->cap = a->rate * pv_dbl(v, "burst"); a->target = a->rate * a->win; a->p = 1.0;
+    *out = a; return 0;
+}
+static void destroy(admission_t *a) { free(a); }
+
+static void advance(admission_t *a, uint64_t clock) {
+    if (!a->started) { a->started = 1; a->last = a->wstart = clock; a->tokens = a->target < a->cap ? a->target : a->cap; return; }
+    if (clock > a->last) {
+        a->tokens += (double)(clock - a->last) * a->rate; if (a->tokens > a->cap) a->tokens = a->cap;
+        a->last = clock;
+    }
+    if (clock >= a->wstart + (uint64_t)a->win) {
+        uint64_t k = (clock - a->wstart) / (uint64_t)a->win;   /* 経過した窓の数（最初の 1 つだけ要求量を持つ） */
+        /* 受け入れの要求量（off）と再挿入の支出（ri）を窓ごとに指数移動平均し、p = (目標 − 再挿入) ÷ 要求量。
+         * 支出（バケットで頭打ち）ではなく要求量で決めるので、需要が予算を超えても p が下がる */
+        a->off_ema = a->nwin ? 0.5 * a->off_ema + 0.5 * a->w_off : a->w_off;
+        a->ri_ema = a->nwin ? 0.5 * a->ri_ema + 0.5 * a->w_ri : a->w_ri;
+        if (!a->fcfs && a->off_ema > 0) {
+            double room = a->target - a->ri_ema;
+            a->p = room > 0 ? room / a->off_ema : 1e-6;
+            if (a->p > 1.0) a->p = 1.0;
+            if (a->p < 1e-6) a->p = 1e-6;
+        }
+        a->nwin++; a->psum += a->p; a->w_spend = 0; a->w_off = 0; a->w_ri = 0;
+        a->wstart += k * (uint64_t)a->win;
+    }
+}
+static int accept(admission_t *a, const admit_info_t *in) {
+    advance(a, in->clock);
+    a->off_b += in->size; a->w_off += in->size;
+    if (!a->fcfs && rng_double(a->rng) >= a->p) { a->rej_p++; return 0; }
+    if (a->tokens < (double)in->size) { a->rej_t++; return 0; }
+    a->tokens -= (double)in->size; a->w_spend += (double)in->size; a->acc_b += (double)in->size; a->n_acc++;
+    return 1;
+}
+int adm_budget_charge(admission_t *a, uint64_t clock, uint32_t size) {
+    advance(a, clock);
+    if (a->tokens < (double)size) { a->ri_den++; return 0; }
+    a->tokens -= (double)size; a->w_spend += (double)size; a->w_ri += (double)size; a->ri_b += (double)size; a->ri_ok++;
+    return 1;
+}
+static void report(admission_t *a, FILE *f) {
+    fprintf(f, "{\"rate_Bps\":%.1f,\"offered_bytes\":%.0f,\"accepted_bytes\":%.0f,\"accepted_objs\":%llu,"
+               "\"rejected_by_p\":%llu,\"rejected_by_tokens\":%llu,\"reinsert_charged_bytes\":%.0f,"
+               "\"reinsert_ok_objs\":%llu,\"reinsert_denied_objs\":%llu,\"windows\":%llu,\"p_mean\":%.5f,\"p_final\":%.5f}",
+            a->rate, a->off_b, a->acc_b, (unsigned long long)a->n_acc, (unsigned long long)a->rej_p, (unsigned long long)a->rej_t,
+            a->ri_b, (unsigned long long)a->ri_ok, (unsigned long long)a->ri_den, (unsigned long long)a->nwin,
+            a->nwin ? a->psum / (double)a->nwin : 1.0, a->p);
+}
+const admission_ops_t adm_budget_ops = {"budget", P, create, destroy, accept, NULL, NULL, report};
diff --git a/libCacheSim/cache/eviction/flash/admit/cachesack.c b/libCacheSim/cache/eviction/flash/admit/cachesack.c
new file mode 100644
index 0000000..138e235
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/cachesack.c
@@ -0,0 +1,245 @@
+/* cachesack.c — CacheSack（Yang ほか, USENIX ATC 2022）の受け入れ（§8.2）。
+ * 物をサイズの分類 c = ⌊log2 s ÷ oct⌋ に分け（元論文の分類は表名などのメタデータ）、分類ごとに受け入れ方
+ * NeverAdmit（NA）・AdmitOnSecondMiss（AOSM、LARC）・AdmitOnMiss（AOM）を割合で混ぜる。AdmitOnWrite は
+ * get だけのトレースでは AOM と同じなので持たない。flash の下のバッファキャッシュはないので、flash のミスはすべて裏へ行く。
+ * 推定（元論文の付録 A.2）: SSD 参照（DRAM ミス）の列で、物ごとに直前 2 回の参照時刻を幽霊表に持ち、間隔 d_i で
+ *   保持時間 D の TTL 近似（LRU）をとる。AOM: d_i > D でミスかつ書き込み、占有 s·min(d_i, D)。
+ *   AOSM: max(d_{i−1}, d_i) > D でミス、d_i ≤ D < d_{i−1} で書き込み（占有 s·D）、ヒットなら占有 s·d_i。NA: すべてミス。
+ *   D は格子 D_k = dmin·r^k（k < nd）。d は D_k について区分定数なので、差分配列で 1 参照 O(1) で全 D に足す。
+ * 最適化（付録 A.3〜A.5）: 費用 V = ミス + w × 書き込みバイト ÷ 単位（miss=obj なら単位 = SSD 参照の平均サイズ、byte なら 1）。
+ *   各 D_k で分類ごとの点 (占有, V) の下側凸包を作り、傾きが負の線分を傾きの小さい順に、容量 = SSD 容量 × 窓の長さまで取る。
+ *   費用が最小の D_k を採り、そのときの割合を使う。統計は SSD 参照 interval 回ごとに重み alpha で指数移動平均する。
+ * 実行: 物 id のハッシュ u ∈ [0, 1) で、u < f_NA なら NA、u < f_NA + f_AOSM なら AOSM、それ以外は AOM。
+ *   サイズが変わった物は、シミュレータと同じく別の物として履歴を捨てる（元論文のブロックは不変）。
+ *   AOSM は直前 2 回の参照の間隔が D* 以下なら受け入れる。最初の最適化までは AOM。幽霊表は最後の参照が 2·D* より古い物を捨てる。 */
+#include "admit.h"
+#include "../util/hashmap.h"
+
+#define NCAT 64
+enum { NA, AOSM, AOM, NP };
+enum { Q_S_AOM, Q_W_AOM, Q_UD_AOM, Q_UC_AOM, Q_S_SM, Q_W_SM, Q_UD_SM, Q_UC_SM, Q_S_NA, NQ };   /* 差分配列 */
+enum { M_S, M_W, M_U, NM };                                                                   /* 推定値 */
+typedef struct { double slope, du, dv; int c, i; } seg_t;
+typedef struct { double u, v; int p; } pt_t;
+typedef struct { uint64_t id, last, prev; uint32_t size; } gh_t;   /* last・prev = 0 は「なし」（時刻は 1 から） */
+struct admission {
+    double cap, w, alpha, dmin, ratio, *D; int nd, oct, bytes;
+    uint64_t interval, nw, n, tunes, t0, tnow;
+    hmap_t g; gh_t *gh; uint64_t gn, gcap, gkeep; double gttl;               /* 幽霊表（id → gh の添字）。gkeep = 前回の掃除後の数 */
+    double *acc, *ew, look, lookb, ewspan, ewlook, ewlookb;                  /* acc [NCAT][NQ][nd+1]、ew [NCAT][NP][NM][nd] */
+    double frac[NCAT][NP]; int kstar; double pred_hit, pred_wr;
+    seg_t *seg; pt_t hv[NCAT][NP]; int nh[NCAT], take[NCAT]; double part[NCAT];
+    double *tr; uint64_t tcap, tn;
+};
+static const param_spec_t P[] = {
+    {"w", P_DOUBLE, "1", NULL, "書き込みの費用（単位の書き込み 1 回 = ミス何回分か）"},
+    {"miss", P_ENUM, "obj", "obj|byte", "ミスの数え方（obj = 回数、byte = バイト）"},
+    {"oct", P_UINT, "1", NULL, "分類の幅（log2 サイズのオクターブ数）"},
+    {"interval", P_UINT, "1000000", NULL, "最適化の間隔（SSD 参照の回数）"},
+    {"alpha", P_DOUBLE, "0.5", NULL, "新しい窓の重み（指数移動平均）"},
+    {"dmin", P_DOUBLE, "1000", NULL, "保持時間 D の格子の最小（要求数）"},
+    {"dmax", P_DOUBLE, "1e10", NULL, "保持時間 D の格子の最大（要求数）"},
+    {"nd", P_UINT, "128", NULL, "保持時間 D の格子の数（等比）"},
+    {NULL}};
+
+#define ACC(a, c, q) (&(a)->acc[((size_t)(c) * NQ + (q)) * (size_t)((a)->nd + 1)])
+#define EW(a, c, p, m) (&(a)->ew[(((size_t)(c) * NP + (p)) * NM + (m)) * (size_t)(a)->nd])
+
+static int create(admission_t **out, const param_vals_t *v, const admission_env_t *e) {
+    admission_t *a = xcalloc(1, sizeof *a);
+    double dmax;
+    a->cap = (double)e->ssd_bytes; a->w = pv_dbl(v, "w"); a->bytes = !strcmp(pv_str(v, "miss"), "byte");
+    a->oct = (int)pv_int(v, "oct"); a->interval = (uint64_t)pv_int(v, "interval"); a->alpha = pv_dbl(v, "alpha");
+    a->dmin = pv_dbl(v, "dmin"); dmax = pv_dbl(v, "dmax"); a->nd = (int)pv_int(v, "nd");
+    if (!(a->w >= 0) || a->oct < 1 || !a->interval || !(a->alpha > 0 && a->alpha <= 1) || !(a->dmin > 0) || !(dmax > a->dmin)
+        || a->nd < 2 || !(a->cap > 0))
+        die("cachesack: need w >= 0, oct >= 1, interval > 0, 0 < alpha <= 1, 0 < dmin < dmax, nd >= 2 and an SSD");
+    a->ratio = pow(dmax / a->dmin, 1.0 / (a->nd - 1));
+    a->D = xmalloc((size_t)a->nd * 8);
+    for (int k = 0; k < a->nd; k++) a->D[k] = a->dmin * pow(a->ratio, k);
+    a->acc = xcalloc((size_t)NCAT * NQ * (size_t)(a->nd + 1), 8);
+    a->ew = xcalloc((size_t)NCAT * NP * NM * (size_t)a->nd, 8);
+    a->seg = xmalloc((size_t)NCAT * NP * sizeof(seg_t));
+    a->gttl = INFINITY; a->kstar = -1; a->gkeep = 1 << 20;
+    hm_init(&a->g, 1024);
+    *out = a;
+    return 0;
+}
+static void destroy(admission_t *a) {
+    hm_free(&a->g); free(a->gh); free(a->D); free(a->acc); free(a->ew); free(a->seg); free(a->tr); free(a);
+}
+
+static int cat_of(const admission_t *a, uint32_t s) { int c = ilog2_u64(s ? s : 1) / a->oct; return c < NCAT ? c : NCAT - 1; }
+/* 最初の D_k ≥ x の k（x = ∞ なら nd）。D_k < x ⇔ k < idx(x) */
+static int idx(const admission_t *a, double x) {
+    if (!(x < INFINITY)) return a->nd;
+    if (x <= a->D[0]) return 0;
+    int k = (int)ceil(log(x / a->dmin) / log(a->ratio));
+    if (k > a->nd) k = a->nd;
+    while (k > 0 && a->D[k - 1] >= x) k--;
+    while (k < a->nd && a->D[k] < x) k++;
+    return k;
+}
+static void radd(double *d, int lo, int hi, double v) { if (lo < hi) { d[lo] += v; d[hi] -= v; } }
+
+static int cmp_seg(const void *x, const void *y) {
+    const seg_t *p = x, *q = y;
+    if (p->slope != q->slope) return p->slope < q->slope ? -1 : 1;
+    if (p->c != q->c) return p->c - q->c;
+    return p->i - q->i;
+}
+/* D_k での最小費用。分類ごとに (占有, 費用) の下側凸包を作り、傾きが負の線分を傾きの小さい順に容量 ucap まで取る。
+ * record なら分類ごとに取った線分の数（take）と途中の割合（part）を残す */
+static double solve_k(admission_t *a, int k, double ucap, int record) {
+    double base = 0, used = 0, unit = a->bytes ? 1 : (a->ewlook > 0 ? a->ewlookb / a->ewlook : 1);
+    int ns = 0;
+    for (int c = 0; c < NCAT; c++) {
+        a->nh[c] = 0;
+        if (!(EW(a, c, NA, M_S)[0] > 0)) continue;           /* 参照のない分類 */
+        pt_t pt[NP];
+        for (int p = 0; p < NP; p++)
+            pt[p] = p == NA ? (pt_t){0, EW(a, c, NA, M_S)[0], NA}
+                            : (pt_t){EW(a, c, p, M_U)[k], EW(a, c, p, M_S)[k] + a->w * EW(a, c, p, M_W)[k] / unit, p};
+        for (int i = 1; i < NP; i++)                           /* (占有, 費用) の順に並べる */
+            for (int j = i; j > 0 && (pt[j].u < pt[j - 1].u || (pt[j].u == pt[j - 1].u && pt[j].v < pt[j - 1].v)); j--) {
+                pt_t t = pt[j]; pt[j] = pt[j - 1]; pt[j - 1] = t;
+            }
+        int h = 0;
+        for (int i = 0; i < NP; i++) {                         /* Andrew の単調鎖（下側） */
+            while (h >= 2) {
+                pt_t o = a->hv[c][h - 2], b = a->hv[c][h - 1];
+                if ((b.u - o.u) * (pt[i].v - o.v) - (b.v - o.v) * (pt[i].u - o.u) <= 0) h--; else break;
+            }
+            a->hv[c][h++] = pt[i];
+        }
+        a->nh[c] = h;
+        base += a->hv[c][0].v; used += a->hv[c][0].u;
+        for (int i = 0; i + 1 < h; i++) {
+            double du = a->hv[c][i + 1].u - a->hv[c][i].u, dv = a->hv[c][i + 1].v - a->hv[c][i].v;
+            if (!(du > 0) || !(dv < 0)) break;
+            a->seg[ns++] = (seg_t){dv / du, du, dv, c, i};
+        }
+    }
+    qsort(a->seg, (size_t)ns, sizeof(seg_t), cmp_seg);
+    double rem = ucap - used, cost = base;
+    if (record) for (int c = 0; c < NCAT; c++) { a->take[c] = 0; a->part[c] = 0; }
+    for (int s = 0; s < ns && rem > 0; s++) {
+        double f = a->seg[s].du <= rem ? 1 : rem / a->seg[s].du;
+        cost += f * a->seg[s].dv; rem -= f * a->seg[s].du;
+        if (record) { if (f >= 1) a->take[a->seg[s].c]++; else a->part[a->seg[s].c] = f; }
+    }
+    return cost;
+}
+
+/* 幽霊表から最後の参照が 2·D* より古い物を捨てる（添字を詰め直す）。表が前回の掃除後の 2 倍になったときだけ行う
+ * （毎回だと 1 参照あたり O(表の大きさ ÷ interval) かかり、w01 では遅すぎた）。古い履歴を長く持つだけなので推定は悪くならない */
+static void ghost_prune(admission_t *a) {
+    if (!(a->gttl < INFINITY)) return;
+    uint64_t m = 0;
+    hm_clear(&a->g);
+    for (uint64_t i = 0; i < a->gn; i++) {
+        if ((double)(a->tnow - a->gh[i].last) > a->gttl) continue;
+        a->gh[m] = a->gh[i]; hm_put(&a->g, a->gh[m].id, m); m++;
+    }
+    a->gn = m;
+}
+
+static void tune(admission_t *a) {
+    double span = (double)(a->tnow - a->t0);
+    for (int c = 0; c < NCAT; c++) {
+        double run[NQ];
+        for (int q = 0; q < NQ; q++) run[q] = 0;
+        double fresh[NP][NM];
+        for (int k = 0; k < a->nd; k++) {
+            for (int q = 0; q < NQ; q++) run[q] += ACC(a, c, q)[k];
+            fresh[AOM][M_S] = run[Q_S_AOM]; fresh[AOM][M_W] = run[Q_W_AOM]; fresh[AOM][M_U] = run[Q_UD_AOM] * a->D[k] + run[Q_UC_AOM];
+            fresh[AOSM][M_S] = run[Q_S_SM]; fresh[AOSM][M_W] = run[Q_W_SM]; fresh[AOSM][M_U] = run[Q_UD_SM] * a->D[k] + run[Q_UC_SM];
+            fresh[NA][M_S] = run[Q_S_NA]; fresh[NA][M_W] = 0; fresh[NA][M_U] = 0;
+            for (int p = 0; p < NP; p++)
+                for (int m = 0; m < NM; m++) {
+                    double *x = &EW(a, c, p, m)[k];
+                    *x = a->tunes ? a->alpha * fresh[p][m] + (1 - a->alpha) * *x : fresh[p][m];
+                }
+        }
+    }
+    memset(a->acc, 0, (size_t)NCAT * NQ * (size_t)(a->nd + 1) * 8);
+    a->ewspan = a->tunes ? a->alpha * span + (1 - a->alpha) * a->ewspan : span;
+    a->ewlook = a->tunes ? a->alpha * a->look + (1 - a->alpha) * a->ewlook : a->look;
+    a->ewlookb = a->tunes ? a->alpha * a->lookb + (1 - a->alpha) * a->ewlookb : a->lookb;
+    a->look = a->lookb = 0; a->nw = 0; a->t0 = a->tnow;
+    double ucap = a->cap * a->ewspan, best = INFINITY;
+    int kb = 0;
+    for (int k = 0; k < a->nd; k++) { double v = solve_k(a, k, ucap, 0); if (v < best) { best = v; kb = k; } }
+    solve_k(a, kb, ucap, 1);
+    double S = 0, W = 0;
+    for (int c = 0; c < NCAT; c++) {
+        double *f = a->frac[c];
+        f[NA] = f[AOSM] = 0; f[AOM] = 1;                       /* 参照のない分類は AOM */
+        if (!a->nh[c]) continue;
+        f[AOM] = 0;
+        int i = a->take[c];
+        double pf = a->part[c];
+        f[a->hv[c][i].p] += 1 - pf;
+        if (pf > 0) f[a->hv[c][i + 1].p] += pf;
+        for (int p = 0; p < NP; p++) {
+            S += f[p] * (p == NA ? EW(a, c, NA, M_S)[0] : EW(a, c, p, M_S)[kb]);
+            W += f[p] * (p == NA ? 0 : EW(a, c, p, M_W)[kb]);
+        }
+    }
+    a->kstar = kb; a->gttl = 2 * a->D[kb]; a->tunes++;
+    a->pred_hit = a->ewlook > 0 && !a->bytes ? 1 - S / a->ewlook : a->ewlookb > 0 ? 1 - S / a->ewlookb : 0;
+    a->pred_wr = a->ewlookb > 0 ? W / a->ewlookb : 0;
+    GROW(a->tr, a->tcap, a->tn + 4);
+    a->tr[a->tn++] = (double)a->n; a->tr[a->tn++] = log2(a->D[kb]); a->tr[a->tn++] = a->pred_hit; a->tr[a->tn++] = a->pred_wr;
+    if (a->gn >= 2 * a->gkeep) { ghost_prune(a); if (a->gn > a->gkeep) a->gkeep = a->gn; }
+}
+
+static void on_lookup(admission_t *a, uint64_t t0, uint64_t id, uint32_t size) {
+    uint64_t t = t0 + 1;                                           /* 0 を「なし」に使うので 1 から数える */
+    uint64_t *p = hm_get(&a->g, id);
+    gh_t *x;
+    if (p) x = &a->gh[*p];
+    else { GROW(a->gh, a->gcap, a->gn + 1); x = &a->gh[a->gn]; *x = (gh_t){id, 0, 0, size}; hm_put(&a->g, id, a->gn++); }
+    if (x->size != size) { x->last = x->prev = 0; x->size = size; }   /* サイズが変われば別の物（シミュレータと同じ。§3.3） */
+    double s = size, m = a->bytes ? s : 1;
+    double d = x->last ? (double)(t - x->last) : INFINITY, dp = x->last && x->prev ? (double)(x->last - x->prev) : INFINITY;
+    int c = cat_of(a, size), jd = idx(a, d), jp = idx(a, dp), jm = jd > jp ? jd : jp, nd = a->nd;
+    radd(ACC(a, c, Q_S_AOM), 0, jd, m); radd(ACC(a, c, Q_W_AOM), 0, jd, s); radd(ACC(a, c, Q_UD_AOM), 0, jd, s);
+    if (jd < nd) radd(ACC(a, c, Q_UC_AOM), jd, nd, s * d);
+    radd(ACC(a, c, Q_S_SM), 0, jm, m); radd(ACC(a, c, Q_W_SM), jd, jp, s); radd(ACC(a, c, Q_UD_SM), jd, jp, s);
+    if (jm < nd) radd(ACC(a, c, Q_UC_SM), jm, nd, s * d);
+    radd(ACC(a, c, Q_S_NA), 0, nd, m);
+    if (!a->n++) a->t0 = t - 1;
+    x->prev = x->last; x->last = t;
+    a->look++; a->lookb += s; a->tnow = t;
+    if (++a->nw >= a->interval) tune(a);
+}
+static int accept(admission_t *a, const admit_info_t *in) {
+    if (!a->tunes) return 1;
+    const double *f = a->frac[cat_of(a, in->size)];
+    double u = (double)(splitmix64(in->id ^ 0xcac4e5acULL) >> 11) * 0x1.0p-53;
+    if (u < f[NA]) return 0;
+    if (u >= f[NA] + f[AOSM]) return 1;
+    uint64_t *p = hm_get(&a->g, in->id);                           /* AOSM: 直前 2 回の参照が D* 以内 */
+    return p && a->gh[*p].prev && (double)(a->gh[*p].last - a->gh[*p].prev) <= a->D[a->kstar];
+}
+
+static void report(admission_t *a, FILE *f) {
+    fprintf(f, "{ \"name\": \"cachesack\", \"tunes\": %lu, \"w\": %.6g, \"miss\": \"%s\"", (unsigned long)a->tunes, a->w, a->bytes ? "byte" : "obj");
+    if (a->tunes) fprintf(f, ", \"d_star\": %.6g, \"pred_hit\": %.6f, \"pred_write_ratio\": %.6f, \"ghost_objs\": %lu",
+                          a->D[a->kstar], a->pred_hit, a->pred_wr, (unsigned long)a->gn);
+    fputs(", \"frac\": [", f);
+    int first = 1;
+    for (int c = 0; a->tunes && c < NCAT; c++) {
+        if (!a->nh[c]) continue;
+        fprintf(f, "%s[%llu, %.4f, %.4f, %.4f]", first ? "" : ", ", (unsigned long long)1 << (c * a->oct),
+                a->frac[c][NA], a->frac[c][AOSM], a->frac[c][AOM]);
+        first = 0;
+    }
+    fputs("], \"trace\": [", f);
+    for (uint64_t i = 0; i < a->tn; i += 4)
+        fprintf(f, "%s[%.0f, %.2f, %.6f, %.6f]", i ? ", " : "", a->tr[i], a->tr[i + 1], a->tr[i + 2], a->tr[i + 3]);
+    fputs("] }", f);
+}
+
+const admission_ops_t adm_cachesack_ops = {"cachesack", P, create, destroy, accept, NULL, on_lookup, report};
diff --git a/libCacheSim/cache/eviction/flash/admit/oracle_opt.c b/libCacheSim/cache/eviction/flash/admit/oracle_opt.c
new file mode 100644
index 0000000..0e66dd6
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/oracle_opt.c
@@ -0,0 +1,164 @@
+/* oracle_opt.c — Baleen（Wong ほか, FAST 2024）の OPT（エピソードによる近似最適の受け入れ。§8.2）。2 パス。
+ * 1 パス目（log=PATH）: SSD 参照（DRAM ミス）の列 (t, id, size) をファイルに書き、すべて受け入れる。SSD 参照の列は
+ *   SSD の受け入れに依らない（DRAM にはミスでも SSD ヒットでも入る）ので、同じトレース・同じ DRAM 構成なら 2 パス目と一致する。
+ * 2 パス目（episodes=PATH）: 物ごとの参照を、間隔が退去年齢 E 以下なら同じエピソードにまとめる（サイズが変われば切る）。
+ *   ヒットが 1 回以上あり SSD に入るエピソードを、得点 = 便益 ÷ サイズ（便益は ohr ならヒット数、bhr ならヒットのバイト）の
+ *   大きい順に並べ、書き込み予算 budget（0 = 無制限）を超えない限り上から採る。E は Little の法則による占有
+ *   Σ size·(t_last − t_first + E) ÷ 期間 が SSD 容量に等しくなるよう log E の二分法で決める（eage > 0 なら固定）。
+ *   実行中は、採ったエピソードの最初の参照から最後の参照までのあいだ、受け入れの時点で残りの参照があれば受け入れる。
+ * 未来の情報を使うので oracle_ を名乗る。ログの (t, id) の列のハッシュを 2 パス目でも計算し、一致を報告する。 */
+#include "admit.h"
+#include "../util/hashmap.h"
+
+typedef struct { double score; uint64_t t0, t1; uint32_t o, size, n; } ep_t;
+struct admission {
+    int opt, bhr; FILE *log; double cap, maxobj, budget, eage, occ, plan_w, plan_h;
+    uint64_t n, h, nlog, hlog, neps, nadm;
+    hmap_t adm, cur;                                      /* (id, t_first) の混ぜ値 → t_last、id → 今のエピソードの t_last */
+};
+static const param_spec_t P[] = {
+    {"log", P_STRING, "", NULL, "1 パス目: SSD 参照の列を書くファイル"},
+    {"episodes", P_STRING, "", NULL, "2 パス目: 1 パス目のファイル"},
+    {"budget", P_BYTES, "0", NULL, "書き込み予算（0 = 無制限）"},
+    {"benefit", P_ENUM, "ohr", "ohr|bhr", "便益（ヒット数 / ヒットのバイト）"},
+    {"eage", P_DOUBLE, "0", NULL, "退去年齢 E（要求数。0 = 占有が容量に等しくなるよう決める）"},
+    {NULL}};
+static const char MAGIC[8] = {'C', 'S', 'L', 'O', 'O', 'K', '0', '1'};
+
+static uint64_t mixk(uint64_t id, uint64_t t) { return splitmix64(id ^ splitmix64(t + 0x9e3779b97f4a7c15ULL)); }
+
+static int cmp_ep(const void *x, const void *y) {
+    const ep_t *p = x, *q = y;
+    if (p->score != q->score) return p->score > q->score ? -1 : 1;
+    if (p->t0 != q->t0) return p->t0 < q->t0 ? -1 : 1;
+    return p->o < q->o ? -1 : p->o > q->o;
+}
+typedef struct { uint64_t *t; uint32_t *o, *s; uint64_t nr, no, *ids; double span; } logv_t;
+typedef struct { uint64_t t0, t1; uint32_t n, s; } st_t;      /* 物ごとの作りかけのエピソード */
+typedef struct { ep_t *ep; uint64_t cap, m; st_t *st; } work_t;
+static void close_ep(const admission_t *a, work_t *W, uint32_t o) {
+    st_t *x = &W->st[o];
+    if (x->n >= 2 && x->s <= a->maxobj) {
+        GROW(W->ep, W->cap, W->m + 1);
+        double hits = x->n - 1;
+        W->ep[W->m++] = (ep_t){a->bhr ? hits : hits / x->s, x->t0, x->t1, o, x->s, x->n};
+    }
+    x->n = 0;
+}
+/* 退去年齢 E でエピソードを作って並べ、予算まで採る。占有（容量に対する比）を返し、*ne に採った数を入れる */
+static double episodes(admission_t *a, const logv_t *L, double E, work_t *W, uint64_t *ne) {
+    W->m = 0;
+    memset(W->st, 0, L->no * sizeof(st_t));
+    for (uint64_t i = 0; i < L->nr; i++) {
+        st_t *x = &W->st[L->o[i]];
+        if (x->n && (double)(L->t[i] - x->t1) <= E && L->s[i] == x->s) { x->n++; x->t1 = L->t[i]; continue; }
+        close_ep(a, W, L->o[i]);
+        *x = (st_t){L->t[i], L->t[i], 1, L->s[i]};
+    }
+    for (uint64_t o = 0; o < L->no; o++) close_ep(a, W, (uint32_t)o);
+    qsort(W->ep, (size_t)W->m, sizeof(ep_t), cmp_ep);
+    double w = 0, occ = 0, hits = 0;
+    uint64_t k = 0;
+    for (; k < W->m; k++) {
+        const ep_t *e = &W->ep[k];
+        if (a->budget > 0 && w + e->size > a->budget) break;
+        w += e->size; hits += e->n - 1;
+        occ += (double)e->size * ((double)(e->t1 - e->t0) + E);
+    }
+    *ne = k; a->plan_w = w; a->plan_h = hits;
+    return occ / L->span / a->cap;
+}
+
+static void build(admission_t *a, const char *path) {
+    FILE *f = fopen(path, "rb");
+    char mg[8];
+    if (!f || fread(mg, 1, 8, f) != 8 || memcmp(mg, MAGIC, 8)) die("oracle_opt: cannot read lookup log %s", path);
+    logv_t L = {0};
+    uint64_t icap = 0, nrec;
+    if (fseek(f, 0, SEEK_END) || (nrec = ((uint64_t)ftell(f) - 8) / 20, fseek(f, 8, SEEK_SET))) die("oracle_opt: cannot seek %s", path);
+    L.t = xmalloc(nrec * 8 + 8); L.o = xmalloc(nrec * 4 + 4); L.s = xmalloc(nrec * 4 + 4);   /* 記録の数ちょうど（重いトレースで倍増の分を持たない） */
+    hmap_t dense; hm_init(&dense, 1 << 16);
+    unsigned char rec[20];
+    while (L.nr < nrec && fread(rec, 1, 20, f) == 20) {
+        uint64_t t, id; uint32_t s;
+        memcpy(&t, rec, 8); memcpy(&id, rec + 8, 8); memcpy(&s, rec + 16, 4);
+        a->hlog = splitmix64(a->hlog + mixk(id, t)); a->nlog++;
+        uint64_t *p = hm_get(&dense, id);
+        uint32_t o;
+        if (p) o = (uint32_t)*p;
+        else { GROW(L.ids, icap, L.no + 1); L.ids[L.no] = id; o = (uint32_t)L.no; hm_put(&dense, id, L.no++); }
+        L.t[L.nr] = t; L.o[L.nr] = o; L.s[L.nr++] = s;
+    }
+    fclose(f); hm_free(&dense);
+    if (!L.nr) die("oracle_opt: empty lookup log %s", path);
+    L.span = (double)(L.t[L.nr - 1] - L.t[0] + 1);
+    work_t W = {NULL, 0, 0, xmalloc(L.no * sizeof(st_t))};
+    uint64_t ne = 0;
+    double E = a->eage;
+    if (!(E > 0)) {                                          /* 占有 = 容量 となる E（大きい E ほど占有が増える） */
+        double lo = 0, hi = log(L.span);
+        if (episodes(a, &L, L.span, &W, &ne) <= 1) lo = hi;
+        for (int it = 0; it < 30 && hi - lo > 1e-3; it++) {
+            double mid = 0.5 * (lo + hi);
+            if (episodes(a, &L, exp(mid), &W, &ne) > 1) hi = mid; else lo = mid;
+        }
+        E = exp(lo);
+    }
+    a->occ = episodes(a, &L, E, &W, &ne);
+    a->eage = E; a->neps = W.m; a->nadm = ne;
+    hm_init(&a->adm, ne * 2 + 16); hm_init(&a->cur, 1024);
+    for (uint64_t k = 0; k < ne; k++) hm_put(&a->adm, mixk(L.ids[W.ep[k].o], W.ep[k].t0), W.ep[k].t1);
+    free(W.ep); free(W.st); free(L.t); free(L.o); free(L.s); free(L.ids);
+}
+
+static int create(admission_t **out, const param_vals_t *v, const admission_env_t *e) {
+    admission_t *a = xcalloc(1, sizeof *a);
+    const char *lg = pv_str(v, "log"), *eps = pv_str(v, "episodes");
+    a->cap = (double)e->ssd_bytes; a->maxobj = (double)e->ssd_max_obj; a->budget = (double)pv_int(v, "budget");
+    a->bhr = !strcmp(pv_str(v, "benefit"), "bhr"); a->eage = pv_dbl(v, "eage");
+    if (!*lg == !*eps) die("oracle_opt: give exactly one of log=PATH (pass 1) or episodes=PATH (pass 2)");
+    if (*lg) {
+        if (!(a->log = fopen(lg, "wb")) || fwrite(MAGIC, 1, 8, a->log) != 8) die("oracle_opt: cannot write %s", lg);
+    } else {
+        if (!(a->cap > 0) || !(a->eage >= 0)) die("oracle_opt: pass 2 needs an SSD and eage >= 0");
+        a->opt = 1; build(a, eps);
+    }
+    *out = a;
+    return 0;
+}
+static void destroy(admission_t *a) {
+    if (a->log && fclose(a->log)) die("oracle_opt: error writing the lookup log");
+    if (a->opt) { hm_free(&a->adm); hm_free(&a->cur); }
+    free(a);
+}
+
+static void on_lookup(admission_t *a, uint64_t t, uint64_t id, uint32_t size) {
+    uint64_t k = mixk(id, t);
+    a->h = splitmix64(a->h + k); a->n++;
+    if (!a->opt) {
+        unsigned char rec[20];
+        memcpy(rec, &t, 8); memcpy(rec + 8, &id, 8); memcpy(rec + 16, &size, 4);
+        if (fwrite(rec, 1, 20, a->log) != 20) die("oracle_opt: error writing the lookup log");
+        return;
+    }
+    uint64_t *x = hm_get(&a->cur, id);
+    if (x && t >= *x) hm_del(&a->cur, id);                 /* エピソードの最後の参照 */
+    uint64_t *v = hm_get(&a->adm, k);
+    if (v) hm_put(&a->cur, id, *v);                        /* 採ったエピソードの最初の参照 */
+}
+static int accept(admission_t *a, const admit_info_t *in) {
+    if (!a->opt) return 1;
+    uint64_t *x = hm_get(&a->cur, in->id);
+    return x && in->t < *x;
+}
+static void report(admission_t *a, FILE *f) {
+    fprintf(f, "{ \"name\": \"oracle_opt\", \"pass\": %d, \"lookups\": %lu", a->opt ? 2 : 1, (unsigned long)a->n);
+    if (a->opt)
+        fprintf(f, ", \"log_match\": %s, \"budget\": %.0f, \"eage\": %.6g, \"episodes\": %lu, \"admitted\": %lu, "
+                   "\"plan_write_bytes\": %.0f, \"plan_hits\": %.0f, \"plan_occupancy\": %.6f",
+                a->n == a->nlog && a->h == a->hlog ? "true" : "false", a->budget, a->eage, (unsigned long)a->neps,
+                (unsigned long)a->nadm, a->plan_w, a->plan_h, a->occ);
+    fputs(" }", f);
+}
+
+const admission_ops_t adm_oracle_opt_ops = {"oracle_opt", P, create, destroy, accept, NULL, on_lookup, report};
diff --git a/libCacheSim/cache/eviction/flash/admit/tinylfu.c b/libCacheSim/cache/eviction/flash/admit/tinylfu.c
new file mode 100644
index 0000000..cafcc06
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/admit/tinylfu.c
@@ -0,0 +1,38 @@
+/* tinylfu.c — TinyLFU 型の受け入れ（§8.2、v0.2.6）。SSD 参照（DRAM ミス）ごとに、4 行の count-min sketch（8 ビットの
+ * 飽和カウンタ、行ごとに独立なハッシュ）に id を数え、SSD 参照 window 回ごとに全カウンタを半分にする（老化）。
+ * 推定回数（4 行の最小）が thr 以上なら受け入れる。元の TinyLFU は追い出し候補と頻度を比べるが、Region 方式では
+ * 受け入れの時点で候補が 1 つに決まらないので、閾値と比べる形にした（flash キャッシュでの頻度による受け入れの代表）。 */
+#include "admit.h"
+
+struct admission { uint8_t *c; uint64_t w, mask, window, n; uint32_t thr; };
+static const param_spec_t P[] = {
+    {"width", P_UINT, "16777216", NULL, "1 行のカウンタ数（2 の冪）"},
+    {"window", P_UINT, "10000000", NULL, "老化の間隔（SSD 参照の回数）"},
+    {"thr", P_UINT, "2", NULL, "受け入れる推定回数の下限"}, {NULL}};
+
+static int create(admission_t **out, const param_vals_t *v, const admission_env_t *e) {
+    (void)e;
+    admission_t *a = xcalloc(1, sizeof *a);
+    a->w = (uint64_t)pv_int(v, "width"); a->window = (uint64_t)pv_int(v, "window"); a->thr = (uint32_t)pv_int(v, "thr");
+    if (!a->w || (a->w & (a->w - 1)) || !a->window || !a->thr) die("tinylfu: width must be a power of two, window and thr > 0");
+    a->mask = a->w - 1; a->c = xcalloc(4 * a->w, 1);
+    *out = a;
+    return 0;
+}
+static void destroy(admission_t *a) { free(a->c); free(a); }
+static uint64_t slot(const admission_t *a, uint64_t id, int r) { return (uint64_t)r * a->w + (splitmix64(id + 0x9e3779b97f4a7c15ULL * (uint64_t)(r + 1)) & a->mask); }
+static void on_lookup(admission_t *a, uint64_t t, uint64_t id, uint32_t size) {
+    (void)t; (void)size;
+    for (int r = 0; r < 4; r++) { uint8_t *x = &a->c[slot(a, id, r)]; if (*x < 255) (*x)++; }
+    if (++a->n % a->window == 0) for (uint64_t i = 0; i < 4 * a->w; i++) a->c[i] >>= 1;
+}
+static int accept(admission_t *a, const admit_info_t *in) {
+    uint32_t m = 255;
+    for (int r = 0; r < 4; r++) { uint8_t x = a->c[slot(a, in->id, r)]; if (x < m) m = x; }
+    return m >= a->thr;
+}
+static void report(admission_t *a, FILE *f) {
+    fprintf(f, "{ \"name\": \"tinylfu\", \"lookups\": %lu, \"agings\": %lu }", (unsigned long)a->n, (unsigned long)(a->n / a->window));
+}
+
+const admission_ops_t adm_tinylfu_ops = {"tinylfu", P, create, destroy, accept, NULL, on_lookup, report};
diff --git a/libCacheSim/cache/eviction/flash/core/gl_model.c b/libCacheSim/cache/eviction/flash/core/gl_model.c
new file mode 100644
index 0000000..3bb43b1
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/core/gl_model.c
@@ -0,0 +1,127 @@
+//
+//  gl_model.c — XGBoost behind gl_model.h.
+//
+
+#include "gl_model.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../util/rf_util.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(ENABLE_GLCACHE) && ENABLE_GLCACHE == 1
+#include <xgboost/c_api.h>
+
+#define GL_ROUNDS 20  // GL-Cache N_TRAIN_ITER
+
+struct gl_model {
+  uint32_t nf;
+  BoosterHandle booster;
+  bool ready;
+};
+
+#define XG(call)                                                       \
+  do {                                                                 \
+    if ((call) != 0) rf_die("gl_model: XGBoost: %s\n", XGBGetLastError()); \
+  } while (0)
+
+gl_model_t *gl_model_new(uint32_t n_feature) {
+  gl_model_t *m = calloc(1, sizeof(*m));
+  m->nf = n_feature;
+  return m;
+}
+
+static DMatrixHandle gl_dmatrix(const float *x, const float *y, uint32_t n, uint32_t nf) {
+  DMatrixHandle d;
+  XG(XGDMatrixCreateFromMat(x, n, nf, NAN, &d));
+  if (y != NULL) XG(XGDMatrixSetFloatInfo(d, "label", y, n));
+  return d;
+}
+
+uint32_t gl_model_train(gl_model_t *m, const float *x, const float *y, uint32_t n) {
+  uint32_t nf = m->nf, nt = 0, nv = 0;
+  if (n < 10) return 0;
+  float *tx = malloc((size_t)n * nf * sizeof(float)), *ty = malloc(n * sizeof(float));
+  float *vx = malloc((size_t)n * nf * sizeof(float)), *vy = malloc(n * sizeof(float));
+  for (uint32_t i = 0; i < n; i++) {  // every 10th row validates (GL-Cache)
+    bool valid = i % 10 == 0;
+    float *dx = valid ? vx + (size_t)nv * nf : tx + (size_t)nt * nf;
+    memcpy(dx, x + (size_t)i * nf, nf * sizeof(float));
+    if (valid)
+      vy[nv++] = y[i];
+    else
+      ty[nt++] = y[i];
+  }
+  DMatrixHandle dm[2] = {gl_dmatrix(tx, ty, nt, nf), gl_dmatrix(vx, vy, nv, nf)};
+  const char *names[2] = {"train", "valid"};
+  if (m->booster != NULL) XG(XGBoosterFree(m->booster));
+  XG(XGBoosterCreate(dm, 1, &m->booster));
+  XG(XGBoosterSetParam(m->booster, "booster", "gbtree"));
+  XG(XGBoosterSetParam(m->booster, "verbosity", "0"));
+  XG(XGBoosterSetParam(m->booster, "nthread", "1"));
+  XG(XGBoosterSetParam(m->booster, "objective", "reg:squarederror"));
+  double last = 0;
+  uint32_t stable = 0, rounds = 0;
+  for (int i = 0; i < GL_ROUNDS; i++) {
+    XG(XGBoosterUpdateOneIter(m->booster, i, dm[0]));
+    rounds++;
+    const char *res;
+    XG(XGBoosterEvalOneIter(m->booster, i, dm, names, 2, &res));
+    const char *v = strstr(res, "valid-rmse:");
+    double loss = v != NULL ? strtod(v + 11, NULL) : 0;
+    if (loss > 0 && fabs(last - loss) / loss < 0.01) {
+      if (++stable > 2) break;
+    } else {
+      stable = 0;
+    }
+    last = loss;
+  }
+  XG(XGDMatrixFree(dm[0]));
+  XG(XGDMatrixFree(dm[1]));
+  free(tx);
+  free(ty);
+  free(vx);
+  free(vy);
+  m->ready = true;
+  return rounds;
+}
+
+bool gl_model_ready(const gl_model_t *m) { return m->ready; }
+
+void gl_model_predict(gl_model_t *m, const float *x, uint32_t n, float *out) {
+  DMatrixHandle d = gl_dmatrix(x, NULL, n, m->nf);
+  bst_ulong len;
+  const float *pred;
+  XG(XGBoosterPredict(m->booster, d, 0, 0, 0, &len, &pred));
+  if (len != n) rf_die("gl_model: %llu predictions for %u rows\n", (unsigned long long)len, n);
+  memcpy(out, pred, n * sizeof(float));
+  XG(XGDMatrixFree(d));
+}
+
+void gl_model_free(gl_model_t *m) {
+  if (m->booster != NULL) XGBoosterFree(m->booster);
+  free(m);
+}
+
+#else  // no XGBoost in this build
+
+gl_model_t *gl_model_new(uint32_t n_feature) {
+  rf_die("region-evict gl needs XGBoost: build libCacheSim with -DENABLE_GLCACHE=ON\n");
+}
+uint32_t gl_model_train(gl_model_t *m, const float *x, const float *y, uint32_t n) {
+  return 0;
+}
+bool gl_model_ready(const gl_model_t *m) { return false; }
+void gl_model_predict(gl_model_t *m, const float *x, uint32_t n, float *out) {}
+void gl_model_free(gl_model_t *m) {}
+
+#endif
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/core/gl_model.h b/libCacheSim/cache/eviction/flash/core/gl_model.h
new file mode 100644
index 0000000..2f1dd0a
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/core/gl_model.h
@@ -0,0 +1,34 @@
+//
+//  gl_model.h — the learner of region-evict=gl: gradient-boosted trees
+//  (XGBoost) regressing a region's utility on its features, set up as
+//  GL-Cache's (train.c: gbtree, reg:squarederror, at most 20 rounds, every
+//  10th row validates and stops the rounds early). Needs a build with
+//  ENABLE_GLCACHE=ON (XGBoost); otherwise gl_model_new() reports that.
+//
+
+#ifndef GL_MODEL_H
+#define GL_MODEL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct gl_model gl_model_t;
+
+gl_model_t *gl_model_new(uint32_t n_feature);
+/* fit on n rows: x[n * n_feature], y[n]; replaces the previous model.
+ * Returns the number of trees, 0 if there were too few rows to train */
+uint32_t gl_model_train(gl_model_t *m, const float *x, const float *y, uint32_t n);
+bool gl_model_ready(const gl_model_t *m);
+/* out[n]: the predicted utility of n rows */
+void gl_model_predict(gl_model_t *m, const float *x, uint32_t n, float *out);
+void gl_model_free(gl_model_t *m);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/libCacheSim/cache/eviction/flash/core/regionflash_stats.h b/libCacheSim/cache/eviction/flash/core/regionflash_stats.h
new file mode 100644
index 0000000..b0dfdd1
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/core/regionflash_stats.h
@@ -0,0 +1,87 @@
+//
+//  regionflash_stats.h — what RegionFlash measures per object-size bin, for
+//  hint providers that compare the recent past with the whole run.
+//
+//  Size bins are powers of two up to uint32's limit: bin 0 holds sizes <= 1,
+//  bin b (1..32) holds (2^(b-1), 2^b], and bin 32 ends at 2^32 - 1 (larger
+//  sizes count in bin 32 too). The upper end is inclusive, as in the hint's
+//  "class = |{ tau : size > tau }|" rule, so a power-of-two bound never cuts a
+//  bin. The size is the whole object's, also when it is written piece-wise.
+//
+//  Three views of the same counters:
+//    cum  - since the warm-up ended (what the final report counts)
+//    cur  - the interval in progress (from the last interval boundary)
+//    last - the last completed interval (zeros before the first one ends)
+//  An interval is `interval=N` requests (0: one interval for the whole run).
+//
+//  A hint provider calls regionflash_size_view() inside its callbacks
+//  (on_get, on_insert, ...; regionflash_hint.h): it answers for the
+//  RegionFlash running in this thread. Outside RegionFlash, use
+//  regionflash_size_view_of(cache).
+//
+
+#ifndef REGIONFLASH_STATS_H
+#define REGIONFLASH_STATS_H
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct cache;
+
+#define RF_SB_N 33
+
+#define RF_SB_CTRS(X)                                                    \
+  X(reqs) X(req_bytes) X(misses) X(miss_bytes) X(dram_hits)              \
+  X(dram_hit_bytes) X(ssd_lookups) X(ssd_lookup_bytes) X(ssd_hits)       \
+  X(ssd_hit_bytes) X(ssd_admit_objs) X(ssd_admit_bytes)
+
+typedef struct {
+#define X(n) uint64_t n;
+  RF_SB_CTRS(X)
+#undef X
+} rf_sb_ctr_t;
+
+typedef struct {
+  uint64_t t;           // requests so far
+  uint64_t interval;    // interval length in requests, 0: none
+  uint64_t n_interval;  // completed intervals
+  bool measuring;       // the warm-up is over
+  const rf_sb_ctr_t *cum, *cur, *last;  // [RF_SB_N] each
+} rf_size_view_t;
+
+/* the bin of an object size, and its bounds (lo, hi] */
+static inline uint32_t rf_size_bin(uint64_t s) {
+  if (s <= 1) return 0;
+  uint32_t b = 64 - (uint32_t)__builtin_clzll(s - 1);  // ceil(log2(s))
+  return b > RF_SB_N - 1 ? RF_SB_N - 1 : b;
+}
+static inline uint64_t rf_size_bin_hi(uint32_t b) {
+  return b >= RF_SB_N - 1 ? UINT32_MAX : (uint64_t)1 << b;
+}
+static inline uint64_t rf_size_bin_lo(uint32_t b) {  // exclusive
+  return b == 0 ? 0 : rf_size_bin_hi(b - 1);
+}
+
+/* object miss ratio, byte miss ratio; NAN without requests */
+static inline double rf_sb_omr(const rf_sb_ctr_t *c) {
+  return c->reqs ? (double)c->misses / (double)c->reqs : NAN;
+}
+static inline double rf_sb_bmr(const rf_sb_ctr_t *c) {
+  return c->req_bytes ? (double)c->miss_bytes / (double)c->req_bytes : NAN;
+}
+
+/* true and *v filled when called inside RegionFlash's get() (hint callbacks) */
+bool regionflash_size_view(rf_size_view_t *v);
+/* the same for a given RegionFlash cache; false if it is not one */
+bool regionflash_size_view_of(const struct cache *cache, rf_size_view_t *v);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* REGIONFLASH_STATS_H */
diff --git a/libCacheSim/cache/eviction/flash/core/rf_params.c b/libCacheSim/cache/eviction/flash/core/rf_params.c
new file mode 100644
index 0000000..2a6b51d
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/core/rf_params.c
@@ -0,0 +1,107 @@
+//
+//  rf_params.c — parsing RegionFlash's -e parameters (see RegionFlash.c).
+//
+#include "../regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ***********************************************************************
+// ****                       parameters / init                       ****
+// ***********************************************************************
+/* "626M", "4G", "1.5K" -> bytes (binary units) */
+static uint64_t rf_size(const char *v) {
+  char *end;
+  double x = strtod(v, &end);
+  switch (*end) {
+    case 'k': case 'K': x *= KiB; break;
+    case 'm': case 'M': x *= MiB; break;
+    case 'g': case 'G': x *= GiB; break;
+    case 't': case 'T': x *= TiB; break;
+    default: break;
+  }
+  if (x < 0) rf_die("RegionFlash: bad size %s\n", v);
+  return (uint64_t)x;
+}
+
+static int rf_enum(const char *v, const char *const *names, int n,
+                   const char *key) {
+  for (int i = 0; i < n; i++)
+    if (strcasecmp(v, names[i]) == 0) return i;
+  rf_die("RegionFlash: bad value %s for %s\n", v, key);
+}
+
+/* reinsert=none | hits|score|recent[:n=1/max_size=0/p=1/max_frac=0.5/mode=pi|ii/
+ *                       class=keep|reclassify/hint_on_reinsert=no|yes]
+ * (cachesim --reinsert, with '/' for ','; score and recent: rf_region.c) */
+static void rf_parse_reinsert(rf_params_t *p, char *v) {
+  static const char *const MODE[] = {"pi", "ii"}, *const CLS[] = {"keep", "reclassify"},
+                           *const YN[] = {"no", "yes"};
+  char *rest = strchr(v, ':');
+  if (rest != NULL) *rest++ = '\0';
+  int kind = rf_enum(v, (const char *const[]){"none", "hits", "score", "recent"}, 4, "reinsert");
+  p->re_on = kind != 0;
+  p->re_score = kind >= 2;  // recent: the score's selection, ranked by recency
+  p->re_recent = kind == 3;
+  for (char *kv; rest != NULL && (kv = strsep(&rest, "/")) != NULL;) {
+    char *val = strchr(kv, '=');
+    if (val == NULL) rf_die("RegionFlash: reinsert %s has no value\n", kv);
+    *val++ = '\0';
+    if (strcasecmp(kv, "n") == 0) p->re_n = (uint32_t)atoi(val), p->re_n_set = true;
+    else if (strcasecmp(kv, "max_size") == 0) p->re_max_size = rf_size(val);
+    else if (strcasecmp(kv, "p") == 0) p->re_p = strtod(val, NULL);
+    else if (strcasecmp(kv, "max_frac") == 0) p->re_frac = strtod(val, NULL);
+    else if (strcasecmp(kv, "mode") == 0) p->re_ii = rf_enum(val, MODE, 2, kv);
+    else if (strcasecmp(kv, "class") == 0) p->re_reclass = rf_enum(val, CLS, 2, kv);
+    else if (strcasecmp(kv, "hint_on_reinsert") == 0) p->re_hint = rf_enum(val, YN, 2, kv);
+    else rf_die("RegionFlash: reinsert does not have parameter %s\n", kv);
+  }
+}
+
+void rf_parse(rf_params_t *p, const char *params, char algo[T_N][64]) {
+  static const char *const ISO[] = {"ii", "pi"};
+  char *str = strdup(params), *cur = str;
+  while (cur != NULL && cur[0] != '\0') {
+    char *key = strsep(&cur, "="), *value = strsep(&cur, ",");
+    while (cur != NULL && *cur == ' ') cur++;
+    if (value == NULL) rf_die("RegionFlash: parameter %s has no value\n", key);
+    if (strcasecmp(key, "dram-size") == 0) p->dram_cap = rf_size(value);
+    else if (strcasecmp(key, "dram-algo") == 0 || strcasecmp(key, "dram-policy") == 0)
+      snprintf(algo[T_DRAM], 64, "%s", value);
+    else if (strcasecmp(key, "dram-params") == 0) snprintf(p->params[T_DRAM], 256, "%s", value);
+    else if (strcasecmp(key, "inclusion") == 0) p->inclusion = rf_enum(value, INC_NAME, 3, key);
+    else if (strcasecmp(key, "ssd-mode") == 0) p->ssd_mode = rf_enum(value, SSD_NAME, 2, key);
+    else if (strcasecmp(key, "ssd-algo") == 0) snprintf(algo[T_SSD], 64, "%s", value);
+    else if (strcasecmp(key, "ssd-params") == 0) snprintf(p->params[T_SSD], 256, "%s", value);
+    else if (strcasecmp(key, "region-size") == 0) p->R = rf_size(value);
+    else if (strcasecmp(key, "region-evict") == 0) {  // built-in, or lcs:<algorithm>
+      p->rev_lcs = strncasecmp(value, "lcs:", 4) == 0;
+      snprintf(algo[T_REG], 64, "%s", value + (p->rev_lcs ? 4 : 0));
+    } else if (strcasecmp(key, "region-params") == 0) snprintf(p->params[T_REG], 256, "%s", value);
+    else if (strcasecmp(key, "beta") == 0) p->beta = strtod(value, NULL);
+    else if (strcasecmp(key, "chunk") == 0) p->chunk = rf_size(value);
+    else if (strcasecmp(key, "seal-on-repartition") == 0) p->seal_rep = rf_enum(value, SEAL_NAME, 3, key);
+    else if (strcasecmp(key, "admit") == 0) snprintf(p->spec[0], 256, "%s", value);
+    else if (strcasecmp(key, "hint") == 0) snprintf(p->spec[1], 256, "%s", value);
+    else if (strcasecmp(key, "taus") == 0) snprintf(p->taus_s, 256, "%s", value);
+    else if (strcasecmp(key, "st-lambda") == 0) snprintf(p->lambda_s, 32, "%s", value);
+    else if (strcasecmp(key, "seed") == 0) p->seed = strtoull(value, NULL, 10);
+    else if (strcasecmp(key, "warmup-req") == 0) p->warmup = atoll(value);
+    else if (strcasecmp(key, "ru-size") == 0) p->fdp.ru_size = rf_size(value);
+    else if (strcasecmp(key, "ruh") == 0) p->fdp.n_ruh = (uint32_t)atoi(value);
+    else if (strcasecmp(key, "fdp-iso") == 0) p->fdp.pi = rf_enum(value, ISO, 2, key);
+    else if (strcasecmp(key, "fdp-op") == 0) p->fdp.op = strtod(value, NULL);
+    else if (strcasecmp(key, "fdp-trim") == 0) p->fdp.trim = atoi(value) != 0;
+    else if (strcasecmp(key, "reinsert") == 0) rf_parse_reinsert(p, value);
+    else if (strcasecmp(key, "out") == 0 || strcasecmp(key, "prefix") == 0)
+      snprintf(p->out, sizeof(p->out), "%s", value);
+    else if (strcasecmp(key, "interval") == 0) p->interval = strtoull(value, NULL, 10);
+    else rf_die("RegionFlash does not have parameter %s\n", key);
+  }
+  free(str);
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/libCacheSim/cache/eviction/flash/core/rf_report.c b/libCacheSim/cache/eviction/flash/core/rf_report.c
new file mode 100644
index 0000000..0f83397
--- /dev/null
+++ b/libCacheSim/cache/eviction/flash/core/rf_report.c
@@ -0,0 +1,367 @@
+//
+//  rf_report.c — RegionFlash's counters out: the end-of-run table, P.json,
+//  P.class.csv, P.sizebin.csv, the per-interval CSVs, and the size-bin views
+//  for hint providers (regionflash_stats.h).
+//
+#include "../regionflash_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ***********************************************************************
+// ****                           report                              ****
+// ***********************************************************************
+static double rf_div(uint64_t a, uint64_t b) {
+  return b ? (double)a / (double)b : NAN;
+}
+
+#define RF_DERIVED(X)                                                     \
+  X(ohr, rf_div(c->dram_hits + c->ssd_hits, c->reqs))                     \
+  X(bmr, rf_div(c->miss_bytes, c->req_bytes))                             \
+  X(ssd_hit_ratio, rf_div(c->ssd_hits, c->ssd_lookups))                   \
+  X(alwa_region, rf_div(c->flash_region_write_bytes, c->ssd_admit_bytes)) \
+  X(dlwa, rf_div(c->nand_write_bytes, c->flash_region_write_bytes))       \
+  X(waf_total, rf_div(c->nand_write_bytes, c->ssd_admit_bytes))           \
+  X(dead_evict_byte_frac, rf_div(c->dead_evict_bytes, c->ssd_evict_bytes)) \
+  X(mean_ssd_residence, rf_div(c->res_sum, c->ssd_evict_objs))             \
+  RF_MISS_RATIOS(X)
+
+/* object / byte miss ratios of the whole system, of DRAM (it sees every
+ * request) and of the SSD (it sees DRAM's misses): omr = dram_omr * ssd_omr */
+#define RF_MISS_RATIOS(X)                                                    \
+  X(omr, rf_div(c->misses, c->reqs))                                         \
+  X(dram_omr, rf_div(c->reqs - c->dram_hits, c->reqs))                       \
+  X(dram_bmr, rf_div(c->req_bytes - c->dram_hit_bytes, c->req_bytes))        \
+  X(ssd_omr, rf_div(c->ssd_lookups - c->ssd_hits, c->ssd_lookups))           \
+  X(ssd_bmr, rf_div(c->ssd_lookup_bytes - c->ssd_hit_bytes, c->ssd_lookup_bytes))
+
+#define RF_SB_DERIVED(X) \
+  X(bmr, rf_div(c->miss_bytes, c->req_bytes)) RF_MISS_RATIOS(X)
+
+static void rf_num(FILE *f, double v) {
+  if (isfinite(v))
+    fprintf(f, "%.6g", v);
+  else
+    fputs("null", f);
+}
+
+static void rf_csv_num(FILE *f, double v) {  // empty field for NaN
+  if (isfinite(v)) fprintf(f, "%.6g", v);
+}
+
+/* the fields of one JSON object, then its closing brace */
+static void rf_json_ctr(FILE *f, const rf_ctr_t *c) {
+  const char *sep = "";
+#define X(n)                                                           \
+  fprintf(f, "%s\"%s\": %llu", sep, #n, (unsigned long long)c->n); \
+  sep = ", ";
+  RF_CTRS(X)
+#undef X
+#define X(n, e)                        \
+  fprintf(f, ", \"%s\": ", #n); \
+  rf_num(f, e);
+  RF_DERIVED(X)
+#undef X
+  fputc('}', f);
+}
+
+/* CSV: the header names and the values of a row (no newline) */
+static void rf_csv_head(FILE *f) {
+#define X(n) fputs("," #n, f);
+  RF_CTRS(X)
+#undef X
+#define X(n, e) fputs("," #n, f);
+  RF_DERIVED(X)
+#undef X
+}
+
+static void rf_csv_ctr(FILE *f, const rf_ctr_t *c) {
+#define X(n) fprintf(f, ",%llu", (unsigned long long)c->n);
+  RF_CTRS(X)
+#undef X
+#define X(n, e)  \
+  fputc(',', f); \
+  rf_csv_num(f, e);
+  RF_DERIVED(X)
+#undef X
+}
+
+static void rf_csv_sb_head(FILE *f) {
+#define X(n) fputs("," #n, f);
+  RF_SB_CTRS(X)
+#undef X
+#define X(n, e) fputs("," #n, f);
+  RF_SB_DERIVED(X)
+#undef X
+}
+
+static void rf_csv_sb(FILE *f, const rf_sb_ctr_t *c) {
+#define X(n) fprintf(f, ",%llu", (unsigned long long)c->n);
+  RF_SB_CTRS(X)
+#undef X
+#define X(n, e)  \
+  fputc(',', f); \
+  rf_csv_num(f, e);
+  RF_SB_DERIVED(X)
+#undef X
+}
+
+/* the (lo, hi] a hint class covers under the current bounds */
+static void rf_csv_span(FILE *f, const rf_params_t *p, uint32_t c) {
+  int64_t lo = 0, hi = 0;
+  bool any = false, inf = false;
+  for (uint32_t i = 0; i <= p->ntau; i++) {
+    if (p->ivcls[i] != c) continue;
+    int64_t l = i ? p->taus[i - 1] : 0;
+    if (!any || l < lo) lo = l;
+    if (i == p->ntau)
+      inf = true;
+    else if (!any || p->taus[i] > hi)
+      hi = p->taus[i];
+    any = true;
+  }
+  if (!any)
+    fputs(",,", f);  // not used now (the hot class of reinsert mode=ii, ...)
+  else if (inf)
+    fprintf(f, ",%lld,inf", (long long)lo);
+  else
+    fprintf(f, ",%lld,%lld", (long long)lo, (long long)hi);
+}
+
+/* the directories of the path prefix (parallel runs: out=runs/a/x, ...) */
+void rf_mkdirs(const char *prefix) {
+  char d[300];
+  snprintf(d, sizeof(d), "%s", prefix);
+  for (char *q = d + 1; *q; q++) {
+    if (*q != '/') continue;
+    *q = '\0';
+    if (mkdir(d, 0755) != 0 && errno != EEXIST)
+      rf_die("RegionFlash: cannot make %s: %s\n", d, strerror(errno));
+    *q = '/';
+  }
+}
+
+static FILE *rf_open(const rf_params_t *p, const char *suffix) {
+  char path[320];
+  snprintf(path, sizeof(path), "%s%s", p->out, suffix);
+  FILE *f = fopen(path, "w");
+  if (f == NULL) rf_die("RegionFlash: cannot open %s: %s\n", path, strerror(errno));
+  return f;
+}
+
+void rf_interval_open(rf_params_t *p) {
+  p->f_iv = rf_open(p, ".interval.csv");
+  fputs("interval,kind,phase,t_start,t_end,clock_time", p->f_iv);
+  rf_csv_head(p->f_iv);
+  fputs(",ssd_valid_bytes,dram_bytes,free_regions,hint_epoch,n_bounds\n", p->f_iv);
+  p->f_ivc = rf_open(p, ".interval.class.csv");
+  fputs("interval,kind,phase,t_end,class,lo,hi", p->f_ivc);
+  rf_csv_head(p->f_ivc);
+  fputc('\n', p->f_ivc);
+  p->f_ivs = rf_open(p, ".interval.sizebin.csv");
+  fputs("interval,kind,phase,t_end,bin,lo,hi", p->f_ivs);
+  rf_csv_sb_head(p->f_ivs);
+  fputc('\n', p->f_ivs);
+}
+
+/* an interval ended: one "interval" row (its own counts, warm-up included)
+ * and one "cumulative" row (after the warm-up, so far) per scope */
+void rf_interval_end(rf_params_t *p) {
+  const char *ph = p->t - 1 < p->warmup ? "warmup" : "measure";
+  unsigned long long n = (unsigned long long)p->n_ival;
+  long long t = (long long)p->t;
+  for (int k = 0; p->f_iv != NULL && k < 2; k++) {
+    const char *kind = k ? "cumulative" : "interval";
+    fprintf(p->f_iv, "%llu,%s,%s,%llu,%lld,%lld", n, kind, ph,
+            (unsigned long long)p->ival_start, t, (long long)p->req_local->clock_time);
+    rf_csv_ctr(p->f_iv, k ? &p->tot : &p->win);
+    fprintf(p->f_iv, ",%llu,%llu,%u,%u,%u\n", (unsigned long long)p->ssd_used,
+            (unsigned long long)p->dram_used, p->nfree, p->epoch, p->ntau);
+    for (uint32_t c = 0; c < p->kmax; c++) {
+      fprintf(p->f_ivc, "%llu,%s,%s,%lld,%u", n, kind, ph, t, c);
+      rf_csv_span(p->f_ivc, p, c);
+      rf_csv_ctr(p->f_ivc, k ? &p->cls[c] : &p->cwin[c]);
+      fputc('\n', p->f_ivc);
+    }
+    for (uint32_t b = 0; b < RF_SB_N; b++) {
+      fprintf(p->f_ivs, "%llu,%s,%s,%lld,%u,%llu,%llu", n, kind, ph, t, b,
+              (unsigned long long)rf_size_bin_lo(b), (unsigned long long)rf_size_bin_hi(b));
+      rf_csv_sb(p->f_ivs, k ? &p->sb_cum[b] : &p->sb_cur[b]);
+      fputc('\n', p->f_ivs);
+    }
+  }
+  memcpy(p->sb_last, p->sb_cur, sizeof(p->sb_last));
+  memset(p->sb_cur, 0, sizeof(p->sb_cur));
+  memset(&p->win, 0, sizeof(p->win));
+  memset(p->cwin, 0, sizeof(p->cwin));
+  p->n_ival++;
+  p->ival_start = (uint64_t)p->t;
+}
+
+/* regionflash_stats.h */
+static void rf_size_view_fill(const rf_params_t *p, rf_size_view_t *v) {
+  v->t = (uint64_t)p->t;
+  v->interval = p->interval;
+  v->n_interval = p->n_ival;
+  v->measuring = p->t >= p->warmup;
+  v->cum = p->sb_cum;
+  v->cur = p->sb_cur;
+  v->last = p->sb_last;
+}
+
+bool regionflash_size_view(rf_size_view_t *v) {
+  if (rf_cur == NULL) return false;
+  rf_size_view_fill(rf_cur, v);
+  return true;
+}
+
+bool regionflash_size_view_of(const cache_t *cache, rf_size_view_t *v) {
+  if (cache == NULL || cache->cache_init != RegionFlash_init) return false;
+  rf_size_view_fill((const rf_params_t *)cache->eviction_params, v);
+  return true;
+}
+
+/* "fifo", "beta", ... or "lcs:<algorithm>" */
+const char *rf_rev_name(const rf_params_t *p, char *buf, size_t n) {
+  if (p->rops != NULL) return p->rops->name;
+  snprintf(buf, n, "lcs:%s", p->tier[T_REG].algo);
+  return buf;
+}
+
+void rf_report(const rf_params_t *p) {
+  const rf_fdp_t *fd = &p->fdp;
+  char rev[80];
+  const char *dram = p->dram_cap ? p->tier[T_DRAM].algo : "none";
+  const char *ssd = p->ssd_mode == SSD_OBJECT ? p->tier[T_SSD].algo
+                                               : rf_rev_name(p, rev, sizeof(rev));
+  printf("[RegionFlash] SSD %llu B (%s, %s; %u regions x %llu B), DRAM %llu B "
+         "(%s), %s, hint %s (k=%u), chunk %llu, FDP %s, admit %s\n",
+         (unsigned long long)p->ssd_cap, SSD_NAME[p->ssd_mode], ssd, p->N,
+         (unsigned long long)p->R, (unsigned long long)p->dram_cap, dram,
+         INC_NAME[p->inclusion], p->spec[1], p->kmax,
+         (unsigned long long)p->chunk, p->fdp_on ? "on" : "off", p->spec[0]);
+  printf("%6s %12s %8s %8s %8s %8s %16s %16s %16s %8s\n", "class", "reqs", "OMR",
+         "BMR", "DRAM_OMR", "SSD_OMR", "ssd_admit_B", "region_write_B",
+         "nand_write_B", "DLWA");
+  for (uint32_t k = 0; k <= p->kmax; k++) {
+    const rf_ctr_t *c = k == 0 ? &p->tot : &p->cls[k - 1];
+    char name[16] = "total";
+    if (k > 0) snprintf(name, sizeof(name), "%u", k - 1);
+    printf("%6s %12llu %8.4f %8.4f %8.4f %8.4f %16llu %16llu %16llu %8.4f\n", name,
+           (unsigned long long)c->reqs, rf_div(c->misses, c->reqs),
+           rf_div(c->miss_bytes, c->req_bytes), rf_div(c->reqs - c->dram_hits, c->reqs),
+           rf_div(c->ssd_lookups - c->ssd_hits, c->ssd_lookups),
+           (unsigned long long)c->ssd_admit_bytes,
+           (unsigned long long)c->flash_region_write_bytes,
+           (unsigned long long)c->nand_write_bytes,
+           rf_div(c->nand_write_bytes, c->flash_region_write_bytes));
+  }
+  if (p->out[0] == '\0') return;
+
+  char re[160] = "none";
+  if (p->re_on)
+    snprintf(re, sizeof(re),
+             "%s:n=%u,max_size=%llu,p=%g,max_frac=%g,mode=%s,class=%s,hint_on_reinsert=%s",
+             p->re_recent ? "recent" : p->re_score ? "score" : "hits", p->re_n, (unsigned long long)p->re_max_size, p->re_p, p->re_frac,
+             p->re_ii ? "ii" : "pi", p->re_reclass ? "reclassify" : "keep",
+             p->re_hint ? "yes" : "no");
+  FILE *f = rf_open(p, ".json");
+  fprintf(f,
+          "{\"config\": {\"ssd_size\": %llu, \"ssd_mode\": \"%s\", "
+          "\"ssd_algo\": \"%s\", \"region_size\": %llu, \"n_regions\": %u, "
+          "\"k\": %u, \"dram_size\": %llu, \"dram_policy\": \"%s\", "
+          "\"inclusion\": \"%s\", \"region_evict\": \"%s\", \"beta\": %g, "
+          "\"chunk\": %llu, \"seal_on_repartition\": \"%s\", \"hint\": \"%s\", \"warmup_req\": %lld, "
+          "\"interval_req\": %llu, \"reinsert\": \"%s\", \"taus\": [",
+          (unsigned long long)p->ssd_cap, SSD_NAME[p->ssd_mode],
+          p->ssd_mode == SSD_OBJECT ? p->tier[T_SSD].algo : "", (unsigned long long)p->R,
+          p->N, p->kmax, (unsigned long long)p->dram_cap, dram,
+          INC_NAME[p->inclusion], rf_rev_name(p, rev, sizeof(rev)), p->beta,
+          (unsigned long long)p->chunk, SEAL_NAME[p->seal_rep], p->pv[1].name, (long long)p->warmup,
+          (unsigned long long)p->interval, re);
+  for (uint32_t i = 0; i < p->ntau; i++)
+    fprintf(f, "%s%lld", i ? ", " : "", (long long)p->taus[i]);
+  fputs("], \"fdp\": ", f);
+  if (p->fdp_on)
+    fprintf(f,
+            "{\"ru_size\": %llu, \"n_ru\": %u, \"slots_per_ru\": %u, "
+            "\"n_ruh\": %u, \"isolation\": \"%s\", \"op\": %g, \"trim\": %s}",
+            (unsigned long long)fd->ru_size, fd->n_ru, fd->spr, fd->n_ruh,
+            fd->pi ? "pi" : "ii", fd->op, fd->trim ? "true" : "false");
+  else
+    fputs("null", f);
+  fputs("},\n\"total\": {", f);
+  rf_json_ctr(f, &p->tot);
+  fputs(",\n\"class\": [", f);
+  for (uint32_t c = 0; c < p->kmax; c++) {
+    fprintf(f, "%s\n{\"class\": %u, ", c ? "," : "", c);
+    rf_json_ctr(f, &p->cls[c]);
+  }
+  fputs("],\n\"ruh\": [", f);
+  for (uint32_t d = 0; p->fdp_on && d <= fd->n_ruh; d++)
+    fprintf(f, "%s\n{\"ruh\": %d, \"host_write_bytes\": %llu, "
+               "\"gc_write_bytes\": %llu}",
+            d ? "," : "", d < fd->n_ruh ? (int)d : -1,
+            (unsigned long long)fd->ruh_host[d],
+            (unsigned long long)fd->ruh_gc[d]);
+  fputs("],\n\"sizebin\": [", f);  // whole-object sizes, (lo, hi]
+  for (uint32_t b = 0; b < RF_SB_N; b++) {
+    const rf_sb_ctr_t *c = &p->sb_cum[b];
+    fprintf(f, "%s\n{\"bin\": %u, \"lo\": %llu, \"hi\": %llu", b ? "," : "", b,
+            (unsigned long long)rf_size_bin_lo(b), (unsigned long long)rf_size_bin_hi(b));
+#define X(n) fprintf(f, ", \"%s\": %llu", #n, (unsigned long long)c->n);
+    RF_SB_CTRS(X)
+#undef X
+#define X(n, e)                 \
+  fprintf(f, ", \"%s\": ", #n); \
+  rf_num(f, e);
+    RF_SB_DERIVED(X)
+#undef X
+    fputc('}', f);
+  }
+  fputs("],\n\"admit\": ", f);  // as cachesim summary.json: params, report()
+  pv_json(f, &p->pv[0]);
+  fputs(",\n\"admit_result\": ", f);
+  if (p->aops->report) p->aops->report(p->adm, f); else fputs("null", f);
+  fputs(",\n\"hint\": ", f);
+  pv_json(f, &p->pv[1]);
+  fputs(",\n\"hint_result\": ", f);
+  if (p->hops->report) p->hops->report(p->hint, f); else fputs("null", f);
+  if (p->rpol != NULL && p->rops->report) {  // oracle, gl: what the policy did
+    fputs(",\n\"region_policy\": ", f);
+    p->rops->report(p->rpol, f);
+  }
+  fputs("}\n", f);
+  fclose(f);
+
+  f = rf_open(p, ".class.csv");
+  fputs("class,lo,hi", f);
+  rf_csv_head(f);
+  fputs("\ntotal,,", f);
+  rf_csv_ctr(f, &p->tot);
+  fputc('\n', f);
+  for (uint32_t c = 0; c < p->kmax; c++) {
+    fprintf(f, "%u", c);
+    rf_csv_span(f, p, c);
+    rf_csv_ctr(f, &p->cls[c]);
+    fputc('\n', f);
+  }
+  fclose(f);
+
+  f = rf_open(p, ".sizebin.csv");
+  fputs("bin,lo,hi", f);
+  rf_csv_sb_head(f);
+  fputc('\n', f);
+  for (uint32_t b = 0; b < RF_SB_N; b++) {
+    fprintf(f, "%u,%llu,%llu", b, (unsigned long long)rf_size_bin_lo(b),
+            (unsigned long long)rf_size_bin_hi(b));
+    rf_csv_sb(f, &p->sb_cum[b]);
+    fputc('\n', f);
+  }
+  fclose(f);
+}
+
