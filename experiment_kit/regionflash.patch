+
+#define RF_KMAX KMAX_LIMIT
+#define RF_WMAX 64
+#define MD(o) ((o)->RegionFlash)
+
+/* MD(o).flags; RF_KEEP: chosen to be rewritten by reinsert=score (only during
+ * one region's eviction); RF_SEEN: requested before (MD(o).last_t is set) */
+enum { RF_DRAM = 1, RF_SSD = 2, RF_LOST = 4, RF_CHUNK = 8, RF_KEEP = 16, RF_SEEN = 32 };
+enum { INC_CACHELIB, INC_EXCLUSIVE, INC_INCLUSIVE };
+enum { SSD_REGION, SSD_OBJECT };
+enum { SEAL_NONE, SEAL_INACTIVE, SEAL_ALL };
