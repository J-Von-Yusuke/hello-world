index 0000000..84d2bd4
--- /dev/null
+++ b/scripts/regionflash/exp_gl_report.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""exp_gl_report.py — the table of exp_gl.sh: per trace and hint, each Region
+eviction policy's OMR, BMR, flash writes, dead-evicted fraction, run time,
+and the GL policy's training counts. Writes <out>/report.json.
+
+Usage: python3 exp_gl_report.py [/root/exp_gl]
+"""
+import json
+import os
+import re
+import sys
+
+O = sys.argv[1] if len(sys.argv) > 1 else "/root/exp_gl"
+POLS = ["fifo", "lru", "gl", "gl_r4_y0", "gl_r16_y0", "gl_r1_y1", "gl_r4_y1", "gl_r16_y1",
+        "gl_wl", "gl_wl_y1", "gl_wl_q_y1", "gl_wl_r4_y1", "gl_wl_r16_y1"] +        [f"gl_q{q}k_y{y}" for q in (30, 100, 300, 1000, 3000) for y in (0, 1)] + ["gl_olabel", "oracle"]
+
+
+def run_of(d):
+    j = json.load(open(os.path.join(d, "P.json")))
+    t = j["total"]
+    tm = open(os.path.join(d, "time.txt")).read()
+    el = re.search(r"Elapsed \(wall clock\) time.*: (\S+)", tm).group(1).split(":")
+    sec = sum(float(x) * 60 ** i for i, x in enumerate(reversed(el)))
+    rss = int(re.search(r"Maximum resident set size \(kbytes\): (\d+)", tm).group(1))
+    return {"omr": t["omr"], "bmr": t["bmr"], "ohr": t["ohr"], "ssd_omr": t["ssd_omr"],
+            "regions_evicted": t["regions_evicted"], "flash_write": t["flash_region_write_bytes"],
+            "nand_write": t["nand_write_bytes"], "dlwa": t["dlwa"],
+            "dead_frac": t["dead_evict_byte_frac"], "sec": sec, "rss_gb": rss / 2**20,
+            "policy": j.get("region_policy")}
+
+
+def main():
+    rep = {}
+    for trace in sorted(os.listdir(O)):
+        td = os.path.join(O, trace)
+        if not os.path.isdir(td):
+            continue
+        for hint in sorted(os.listdir(td)):
+            for pol in POLS:
+                d = os.path.join(td, hint, pol)
+                if os.path.exists(os.path.join(d, "P.json")):
+                    rep.setdefault(trace, {}).setdefault(hint, {})[pol] = run_of(d)
+    json.dump(rep, open(os.path.join(O, "report.json"), "w"), indent=1)
+    for trace, hs in rep.items():
+        for hint, ps in hs.items():
+            lru = ps.get("lru", {}).get("omr")
+            print(f"\n{trace} hint={hint}")
+            print(f"  {'policy':10} {'OMR':>8} {'dOMR':>8} {'BMR':>8} {'evicted':>8} {'flashTB':>8} {'DLWA':>6} {'dead':>6} {'sec':>6}  GL")
+            for pol in POLS:
+                if pol not in ps:
+                    continue
+                r = ps[pol]
+                d = f"{(r['omr'] - lru) * 100:+.2f}" if lru is not None else ""
+                g = r["policy"] or {}
+                warm = g.get("warm_picks", g.get("fifo_picks"))  # older runs: fifo_picks
+                gl = f"train {g.get('trainings')} warm {warm}" if "trainings" in g else ""
+                print(f"  {pol:10} {r['omr']:8.4f} {d:>8} {r['bmr']:8.4f} {r['regions_evicted']:8d} "
+                      f"{r['flash_write'] / 2**40:8.2f} {r['dlwa'] or 0:6.3f} {r['dead_frac'] or 0:6.3f} "
+                      f"{r['sec']:6.0f}  {gl}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/regionflash/fdp_ref.py b/scripts/regionflash/fdp_ref.py
