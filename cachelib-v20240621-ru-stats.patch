new file mode 100644
index 0000000..d3e661b
--- /dev/null
+++ b/cachelib/navy/common/ObjectInfo.h
@@ -0,0 +1,33 @@
+#pragma once
+#include <cstdint>
+
+namespace facebook::cachelib::navy {
+
+// 8B written by cachebench at offset 0 of every item value (CacheValue).
+// Navy reads it from blob 0 of the serialized NvmItem: the parent object's
+// logical size (pre-chunking) and whether this piece is its representative.
+struct __attribute__((__packed__)) ObjectInfo {
+  uint32_t origSize;
+  // high 16 bit = canary, bit0 = representative,
+  // bits 1..15 = DRAM hit count (saturating at 32767)
+  uint32_t flags;
+
+  static constexpr uint32_t kCanary = 0xCA5A0000u;
+  static constexpr uint32_t kCanaryMask = 0xFFFF0000u;
+  static constexpr uint32_t kRep = 0x1u;
+
+  bool valid() const { return (flags & kCanaryMask) == kCanary; }
+  bool isRep() const { return (flags & kRep) != 0; }
+  static constexpr uint32_t kAccShift = 1;
+  static constexpr uint32_t kAccMax = 0x7FFF;
+  uint32_t accessCount() const { return (flags >> kAccShift) & kAccMax; }
+  void bumpAccess() { // not atomic: an approximate counter is sufficient
+    const uint32_t a = accessCount();
+    if (a < kAccMax) {
+      flags = (flags & ~(kAccMax << kAccShift)) | ((a + 1) << kAccShift);
+    }
+  }
+};
+static_assert(sizeof(ObjectInfo) == 8, "ObjectInfo must be 8B");
+
+} // namespace facebook::cachelib::navy
