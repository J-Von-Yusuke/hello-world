+    victims.emplace_back(Buffer{makeView(k.key())}, Buffer{v});
+  };
+  {
+    std::shared_lock<folly::SharedMutex> sg{sgLock_};
+    std::lock_guard<std::mutex> sl{setLock_[s % kSetLocks]};
+    Bucket& o = memSet(old_, s);
+    Bucket& n = memSet(new_, s);
+    // a copy in FLUSHING is shadowed by the newer one written here
+    removed += o.remove(hk, nullptr);
+    removed += n.remove(hk, nullptr);
+    if (o.remainingBytes() >= need) {
+      o.insert(hk, value, checkExpired_, nullptr);
+    } else {
+      // NEW absorbs the overflow; a full NEW set evicts its oldest entries
+      evicted = n.insert(hk, value, checkExpired_, collect).first;
+      overflowed = true;
+    }
+  }
+  if (destructorCb_) {
+    for (auto& [k, v] : victims) {
+      destructorCb_(makeHK(k), v.view(), DestructorEvent::Recycled);
+    }
+  }
+  itemCount_.add(1);
+  itemCount_.sub(std::min<uint64_t>(removed + evicted, itemCount_.get()));
+  evictionCount_.add(evicted);
+  logicalWritten_.add(hk.key().size() + value.size());
+  succInsertCount_.inc();
+  if (overflowed &&
+      overflow_.fetch_add(1, std::memory_order_relaxed) + 1 >= flushThreshold_) {
+    tryRotate();
+  }
+  return Status::Ok;
+}
+
+bool NemoCache::couldExist(HashedKey hk) {
+  const uint32_t s = setOf(hk);
+  std::shared_lock<folly::SharedMutex> sg{sgLock_};
+  for (uint64_t slot = 0; slot < numSlots_; slot++) {
+    if (slotSeq_[slot] != 0 && bf_.couldExist(bfIdx(slot, s), hk.keyHash())) {
+      return true;
+    }
+  }
+  std::lock_guard<std::mutex> sl{setLock_[s % kSetLocks]};
+  for (int b : {new_, old_, flushing_}) {
+    if (b >= 0 && !memSet(b, s).find(hk).isNull()) {
+      return true;
+    }
+  }
+  lookupCount_.inc(); // counted as a (rejected) lookup, like BigHash
+  return false;
+}
+
+Status NemoCache::lookup(HashedKey hk, Buffer& value) {
+  lookupCount_.inc();
+  const uint32_t s = setOf(hk);
+  std::shared_lock<folly::SharedMutex> sg{sgLock_}; // slots stable while held
+  {
+    std::lock_guard<std::mutex> sl{setLock_[s % kSetLocks]};
+    for (int b : {new_, old_, flushing_}) { // newest first
+      if (b < 0) {
+        continue;
+      }
+      auto v = memSet(b, s).find(hk);
+      if (!v.isNull()) {
+        if (v.size() == 0) {
+          return Status::NotFound; // tombstone
+        }
+        value = Buffer{v};
+        succLookupCount_.inc();
+        return Status::Ok;
+      }
+    }
+  }
+  auto buf = device_.makeIOBuffer(bucketSize_);
+  for (uint64_t r = 0; r < numSlots_; r++) { // newest -> oldest
+    const uint64_t slot = (head_ + numSlots_ - 1 - r) % numSlots_;
+    if (slotSeq_[slot] == 0 || !bf_.couldExist(bfIdx(slot, s), hk.keyHash())) {
+      continue;
+    }
+    flashSetReads_.inc();
+    if (!device_.read(slotOffset(slot) + uint64_t{s} * bucketSize_,
+                      bucketSize_, buf.data())) {
+      ioErrorCount_.inc();
+      return Status::DeviceError;
+    }
+    const auto* bucket = reinterpret_cast<const Bucket*>(buf.data());
+    if (Bucket::computeChecksum(buf.view()) != bucket->getChecksum() ||
+        bucket->generationTime() != generation_) {
+      continue;
+    }
+    auto v = bucket->find(hk);
+    if (v.isNull()) {
+      continue; // Bloom false positive
+    }
+    if (v.size() == 0) {
+      return Status::NotFound;
+    }
+    value = Buffer{v};
+    if (r >= static_cast<uint64_t>(numSlots_ * (1.0 - hotFraction_))) {
+      std::lock_guard<folly::SpinLock> hl{hotLock_[slot % hotLock_.size()]};
+      hot_[slot].insert(hk.keyHash());
+    }
+    succLookupCount_.inc();
+    return Status::Ok;
+  }
+  return Status::NotFound;
+}
+
+Status NemoCache::remove(HashedKey hk) {
+  removeCount_.inc();
+  const uint32_t s = setOf(hk);
+  uint32_t removed = 0;
+  bool shadow = false;
+  {
+    std::shared_lock<folly::SharedMutex> sg{sgLock_};
+    for (uint64_t slot = 0; slot < numSlots_ && !shadow; slot++) {
+      shadow = slotSeq_[slot] != 0 &&
+               bf_.couldExist(bfIdx(slot, s), hk.keyHash());
+    }
+    std::lock_guard<std::mutex> sl{setLock_[s % kSetLocks]};
+    removed += memSet(old_, s).remove(hk, nullptr);
+    removed += memSet(new_, s).remove(hk, nullptr);
+    // FLUSHING may be on its way to the device: never modify it, hide instead
+    if (flushing_ >= 0 && !memSet(flushing_, s).find(hk).isNull()) {
+      shadow = true;
+    }
+    if (shadow) {
+      memSet(new_, s).insert(hk, BufferView{}, checkExpired_, nullptr);
+    }
+  }
+  itemCount_.sub(std::min<uint64_t>(removed, itemCount_.get()));
+  return (removed || shadow) ? Status::Ok : Status::NotFound;
+}
+
+bool NemoCache::tryRotate() {
+  std::lock_guard<std::mutex> f{flushMu_};
+  if (flushPending_) {
+    flushBusyCount_.inc(); // flusher still busy: NEW keeps absorbing
+    return false;
+  }
+  {
+    std::unique_lock<folly::SharedMutex> g{sgLock_};
+    if (overflow_.load(std::memory_order_relaxed) < flushThreshold_) {
+      return false;
+    }
+    flushing_ = old_; // hand OLD to the flusher
+    old_ = new_;
+    new_ = spare_; // initialized when it was recycled
+    spare_ = -1;
+    overflow_ = 0;
+  }
+  flushPending_ = true;
+  flushCv_.notify_all();
+  return true;
+}
+
+void NemoCache::flush() {
+  // force the current OLD out and wait (shutdown / explicit flush)
+  overflow_.store(flushThreshold_, std::memory_order_relaxed);
+  {
+    std::unique_lock<std::mutex> f{flushMu_};
+    flushCv_.wait(f, [this] { return !flushPending_; });
+  }
+  tryRotate();
+  {
+    std::unique_lock<std::mutex> f{flushMu_};
+    flushCv_.wait(f, [this] { return !flushPending_; });
+  }
+  device_.flush();
+}
+
+void NemoCache::flusherLoop() {
+  std::unique_lock<std::mutex> f{flushMu_};
+  while (true) {
+    flushCv_.wait(f, [this] { return stop_ || flushPending_; });
+    if (stop_) {
+      return;
+    }
+    f.unlock();
+    flushOne();
+    f.lock();
+    flushPending_ = false;
+    flushCv_.notify_all();
+  }
+}
+
+bool NemoCache::newerCopyMayExist(HashedKey hk,
+                                  uint32_t s,
+                                  uint64_t evictSlot) {
+  for (int b : {new_, old_, flushing_}) {
+    if (b >= 0 && !memSet(b, s).find(hk).isNull()) {
+      return true;
+    }
+  }
+  for (uint64_t slot = 0; slot < numSlots_; slot++) {
+    if (slot != evictSlot && slotSeq_[slot] != 0 &&
+        bf_.couldExist(bfIdx(slot, s), hk.keyHash())) {
+      return true; // every other occupied slot is newer than evictSlot
+    }
+  }
+  return false;
+}
+
+// Drop the oldest SG (already retired: lookups skip it), re-inserting hot
+// objects into FLUSHING (the SG being written).
+void NemoCache::evictSlot(uint64_t slot) {
+  uint64_t dropped = 0;
+  for (uint64_t off = 0; off < sgSize_; off += chunk_.size()) {
+    const uint64_t len = std::min<uint64_t>(chunk_.size(), sgSize_ - off);
+    if (!device_.read(slotOffset(slot) + off, len, chunk_.data())) {
+      ioErrorCount_.inc();
+      continue;
+    }
+    for (uint64_t b = 0; b < len; b += bucketSize_) {
+      const uint32_t s = static_cast<uint32_t>((off + b) / bucketSize_);
+      BufferView view{bucketSize_, chunk_.data() + b};
+      const auto* bucket = reinterpret_cast<const Bucket*>(view.data());
+      if (Bucket::computeChecksum(view) != bucket->getChecksum() ||
+          bucket->generationTime() != generation_) {
+        continue;
+      }
+      // dropped entries live in chunk_ (flusher-owned) until the next read,
+      // so their views stay valid for the callbacks after the locks go
+      std::vector<std::pair<HashedKey, BufferView>> droppedHere;
+      SCOPE_EXIT {
+        if (destructorCb_) {
+          for (auto& [k, v] : droppedHere) {
+            destructorCb_(k, v, DestructorEvent::Recycled);
+          }
+        }
+      };
+      std::shared_lock<folly::SharedMutex> sg{sgLock_};
+      std::lock_guard<std::mutex> sl{setLock_[s % kSetLocks]};
+      for (auto it = bucket->getFirst(); !it.done();
+           it = bucket->getNext(it)) {
+        if (it.value().size() == 0) {
+          continue; // tombstone expires with its SG
+        }
+        const HashedKey hk =
+            HashedKey::precomputed(toStringPiece(it.key()), it.keyHash());
+        Bucket& f = memSet(flushing_, s);
+        bool isHot;
+        {
+          std::lock_guard<folly::SpinLock> hl{hotLock_[slot % hotLock_.size()]};
+          isHot = hot_[slot].count(it.keyHash()) > 0;
+        }
+        if (isHot &&
+            f.remainingBytes() >= entrySlotSize(it.key().size(),
+                                                it.value().size()) &&
+            !newerCopyMayExist(hk, s, slot)) {
+          f.insert(hk, it.value(), checkExpired_, nullptr);
+          hotReinsertCount_.inc();
+          continue;
+        }
+        dropped++;
+        droppedHere.emplace_back(hk, it.value());
+      }
+    }
+  }
+  itemCount_.sub(std::min<uint64_t>(dropped, itemCount_.get()));
+  evictionCount_.add(dropped);
+  {
+    std::lock_guard<folly::SpinLock> hl{hotLock_[slot % hotLock_.size()]};
+    hot_[slot].clear();
+  }
+  sgEvictCount_.inc();
+  device_.onReclaimUnitFreed(slotOffset(slot), sgSize_); // e.g. Trim
+}
+
+void NemoCache::flushOne() {
+  const uint64_t slot = head_; // only the flusher advances head_
+  const bool occupied = slotSeq_[slot] != 0;
+  if (occupied) {
+    std::unique_lock<folly::SharedMutex> g{sgLock_};
+    slotSeq_[slot] = 0; // retire: lookups stop reading it before overwrite
+    for (uint32_t s = 0; s < setsPerSG_; s++) {
+      bf_.clear(bfIdx(slot, s));
+    }
+  }
+  if (occupied) {
+    evictSlot(slot);
+  }
+  if (ruSize_ != 0 && (slot * sgSize_) % ruSize_ == 0) {
+    device_.updateReclaimUnit(placementHandle_); // FDP: a fresh RU begins
+  }
+  // FLUSHING is now immutable (only evictSlot above wrote into it)
+  uint64_t used = 0;
+  for (uint32_t s = 0; s < setsPerSG_; s++) {
+    Bucket& b = memSet(flushing_, s);
+    used += bucketCapacity_ - b.remainingBytes();
+    for (auto it = b.getFirst(); !it.done(); it = b.getNext(it)) {
+      bf_.set(bfIdx(slot, s), it.keyHash()); // slot not visible yet
+    }
+    b.setChecksum(Bucket::computeChecksum(BufferView{
+        bucketSize_, mem_[flushing_].data() + uint64_t{s} * bucketSize_}));
+  }
+  if (!device_.write(slotOffset(slot), mem_[flushing_].view(),
+                     placementHandle_)) {
+    ioErrorCount_.inc();
+  }
+  physicalWritten_.add(sgSize_);
+  fillBytes_.add(used);
+  fillCapacity_.add(uint64_t{setsPerSG_} * bucketCapacity_);
+  const int done = flushing_;
+  {
+    std::unique_lock<folly::SharedMutex> g{sgLock_}; // publish
+    slotSeq_[slot] = ++nextSeq_;
+    head_ = (slot + 1) % numSlots_;
+    flushing_ = -1;
+  }
+  initMem(done); // nobody references it now
+  {
+    std::unique_lock<folly::SharedMutex> g{sgLock_};
+    spare_ = done;
+  }
+  flushCount_.inc();
+}
+
+void NemoCache::getCounters(const CounterVisitor& visitor) const {
+  visitor("navy_bh_size", getSize());
+  visitor("navy_bh_items", itemCount_.get());
+  visitor("navy_bh_inserts", insertCount_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_succ_inserts", succInsertCount_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_lookups", lookupCount_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_succ_lookups", succLookupCount_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_removes", removeCount_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_evictions", evictionCount_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_logical_written", logicalWritten_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_physical_written", physicalWritten_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_io_errors", ioErrorCount_.get(),
+          CounterVisitor::CounterType::RATE);
+  visitor("navy_bh_nemo_flushes", flushCount_.get());
+  visitor("navy_bh_nemo_flush_busy", flushBusyCount_.get());
+  visitor("navy_bh_nemo_sg_evictions", sgEvictCount_.get());
+  visitor("navy_bh_nemo_hot_reinserts", hotReinsertCount_.get());
+  visitor("navy_bh_nemo_flash_set_reads", flashSetReads_.get());
+  const uint64_t cap = fillCapacity_.get();
+  visitor("navy_bh_nemo_fill_rate_pct",
+          cap ? 100.0 * fillBytes_.get() / cap : 0.0);
+}
+
+} // namespace facebook::cachelib::navy
