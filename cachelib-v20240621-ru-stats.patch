+void BigHash::resetLog() {
+  std::lock_guard<std::mutex> g{logMutex_};
+  for (uint64_t i = 0; i < numBuckets_; i++) {
+    loc_[i].store(kNoSlot, std::memory_order_relaxed);
+    owner_[i] = kNoSlot;
+    slotItems_[i] = 0;
+    slotUsed_[i] = 0;
+  }
+  head_ = batchStart_ = 0;
+  batchFill_ = 0;
+}
+
+// Called when the head enters RU `ru`: every bucket whose latest copy is in
+// this RU loses its content (RU-granular eviction). Older copies of other
+// buckets in the RU are already garbage.
+void BigHash::evictRuLocked(uint32_t ru) {
+  uint64_t items = 0, used = 0;
+  const uint64_t s0 = uint64_t{ru} * slotsPerRu_;
+  for (uint64_t s = s0; s < s0 + slotsPerRu_; s++) {
+    const uint32_t b = owner_[s];
+    if (b != kNoSlot && loc_[b].load(std::memory_order_relaxed) == s) {
+      loc_[b].store(kNoSlot, std::memory_order_release);
+      items += slotItems_[s];
+      used += slotUsed_[s];
+      // bloom filter bits are left set: only extra (empty) reads, no misses
+    }
+    owner_[s] = kNoSlot;
+  }
+  itemCount_.sub(std::min<uint64_t>(items, itemCount_.get()));
+  usedSizeBytes_.sub(std::min<uint64_t>(used, usedSizeBytes_.get()));
+  evictionCount_.add(items);
+  logEvictedItems_.add(items);
+  logRuEvictions_.inc();
+  const uint64_t ruBytes = uint64_t{slotsPerRu_} * bucketSize_;
+  device_.onReclaimUnitFreed(slotOffset(s0), ruBytes); // e.g. Trim
+  device_.updateReclaimUnit(placementHandle_);         // FDP: fresh RU
+}
+
+bool BigHash::flushBatchLocked(bool advance) {
+  bool ok = true;
+  if (batchFill_ > 0) {
+    const size_t len = device_.getIOAlignedSize(size_t{batchFill_} * bucketSize_);
+    ok = device_.write(slotOffset(batchStart_),
+                       BufferView{len, batch_.data()}, placementHandle_);
+    logBatchWrites_.inc();
+  }
+  if (advance) {
+    batchStart_ = head_;
+    batchFill_ = 0;
+  }
+  return ok;
+}
+
+Buffer BigHash::readBucketLog(BucketId bid) {
+  auto buffer = device_.makeIOBuffer(bucketSize_);
+  const uint32_t slot = loc_[bid.index()].load(std::memory_order_acquire);
+  bool have = false;
+  if (slot != kNoSlot) {
+    bool inBatch = false;
+    {
+      std::lock_guard<std::mutex> g{logMutex_};
+      if (slot >= batchStart_ && slot < batchStart_ + batchFill_) {
+        std::memcpy(buffer.data(),
+                    batch_.data() + (slot - batchStart_) * bucketSize_,
+                    bucketSize_);
+        inBatch = have = true;
+      }
+    }
+    if (!inBatch) {
+      if (!device_.read(slotOffset(slot), buffer.size(), buffer.data())) {
+        return {};
+      }
+      // the slot may have been reused while we read it: re-validate
+      have = loc_[bid.index()].load(std::memory_order_acquire) == slot;
+      if (!have) {
+        logStaleReads_.inc();
+      }
+    }
+  }
+  auto* bucket = reinterpret_cast<Bucket*>(buffer.data());
+  if (!have ||
+      Bucket::computeChecksum(buffer.view()) != bucket->getChecksum() ||
+      static_cast<uint64_t>(generationTime_.count()) !=
+          bucket->generationTime()) {
+    Bucket::initNew(buffer.mutableView(), generationTime_.count());
+  }
+  return buffer;
+}
+
+bool BigHash::writeBucketLog(BucketId bid, Buffer buffer) {
+  auto* bucket = reinterpret_cast<Bucket*>(buffer.data());
+  bucket->setChecksum(Bucket::computeChecksum(buffer.view()));
+  const uint16_t items = static_cast<uint16_t>(bucket->size());
+  const uint32_t used = bucketCapacity_ - bucket->remainingBytes();
+  std::lock_guard<std::mutex> g{logMutex_};
+  if (head_ % slotsPerRu_ == 0) {
+    evictRuLocked(static_cast<uint32_t>(head_ / slotsPerRu_));
+  }
+  const uint64_t slot = head_;
+  head_ = (head_ + 1) % numBuckets_;
+  std::memcpy(batch_.data() + (slot - batchStart_) * bucketSize_,
+              buffer.data(), bucketSize_);
+  batchFill_++;
+  owner_[slot] = static_cast<uint32_t>(bid.index());
+  slotItems_[slot] = items;
+  slotUsed_[slot] = used;
+  loc_[bid.index()].store(static_cast<uint32_t>(slot),
+                          std::memory_order_release);
+  if (batchFill_ == slotsPerBatch_) {
+    return flushBatchLocked(true /* advance */);
+  }
+  return true;
+}
