+uint32_t entrySlotSize(size_t keySize, size_t valueSize) {
+  return BucketStorage::slotSize(details::BucketEntry::computeSize(
+      static_cast<uint32_t>(keySize), static_cast<uint32_t>(valueSize)));
+}
+} // namespace
+
+NemoCache::NemoCache(Config&& c)
+    : cacheBaseOffset_{c.cacheBaseOffset},
+      bucketSize_{c.bucketSize},
+      sgSize_{c.sgSize},
+      ruSize_{c.ruSize},
+      hotFraction_{c.hotFraction},
+      device_{*c.device},
+      checkExpired_{std::move(c.checkExpired)},
+      destructorCb_{std::move(c.destructorCb)},
+      placementHandle_{device_.acquirePlacementHandle(0)} { // PID 0
+  if (sgSize_ == 0 || sgSize_ % bucketSize_ != 0 || c.cacheSize < sgSize_) {
+    throw std::invalid_argument(folly::sformat(
+        "Nemo: SG size {} must be a multiple of bucket {} and <= size {}",
+        sgSize_, bucketSize_, c.cacheSize));
+  }
+  if (ruSize_ != 0 && ruSize_ % sgSize_ != 0) {
+    throw std::invalid_argument("Nemo: ruSize must be a multiple of SG size");
+  }
+  numSlots_ = c.cacheSize / sgSize_;
+  if (numSlots_ < 2) {
+    throw std::invalid_argument("Nemo needs >= 2 on-flash Set-Groups");
+  }
+  setsPerSG_ = static_cast<uint32_t>(sgSize_ / bucketSize_);
+  flushThreshold_ = c.flushThreshold ? c.flushThreshold
+                                     : std::max<uint32_t>(setsPerSG_ / 2, 1);
+  slotSeq_.assign(numSlots_, 0);
+  hot_.resize(numSlots_);
+  bf_ = BloomFilter(static_cast<uint32_t>(numSlots_ * setsPerSG_),
+                    c.bfNumHashes, c.bfBitsPerHash);
+  for (auto& m : mem_) {
+    m = device_.makeIOBuffer(sgSize_); // aligned: written with one O_DIRECT IO
+  }
+  chunk_ = device_.makeIOBuffer(std::min<uint64_t>(sgSize_, 4ull << 20));
+  {
+    auto tmp = device_.makeIOBuffer(bucketSize_);
+    Bucket::initNew(tmp.mutableView(), 0);
+    bucketCapacity_ = reinterpret_cast<Bucket*>(tmp.data())->remainingBytes();
+  }
+  reset();
+  flusher_ = std::thread([this] { flusherLoop(); });
+  XLOGF(INFO,
+        "Nemo: {} flash SGs x {} sets ({} MiB), flushThreshold {}, "
+        "hotFraction {}, async flush",
+        numSlots_, setsPerSG_, sgSize_ >> 20, flushThreshold_, hotFraction_);
+}
+
+NemoCache::~NemoCache() {
+  {
+    std::lock_guard<std::mutex> g{flushMu_};
+    stop_ = true;
+  }
+  flushCv_.notify_all();
+  if (flusher_.joinable()) {
+    flusher_.join();
+  }
+}
+
+void NemoCache::initMem(int buf) {
+  for (uint32_t s = 0; s < setsPerSG_; s++) {
+    Bucket::initNew(MutableBufferView{bucketSize_, mem_[buf].data() +
+                                                       uint64_t{s} * bucketSize_},
+                    generation_);
+  }
+}
+
+void NemoCache::reset() {
+  std::unique_lock<std::mutex> f{flushMu_};
+  flushCv_.wait(f, [this] { return !flushPending_; }); // flusher idle
+  std::unique_lock<folly::SharedMutex> g{sgLock_};
+  generation_ = static_cast<uint64_t>(getSteadyClock().count());
+  new_ = 0;
+  old_ = 1;
+  spare_ = 2;
+  flushing_ = -1;
+  for (int b = 0; b < 3; b++) {
+    initMem(b);
+  }
+  overflow_ = 0;
+  head_ = 0;
+  nextSeq_ = 0;
+  std::fill(slotSeq_.begin(), slotSeq_.end(), 0);
+  for (auto& h : hot_) {
+    h.clear();
+  }
+  bf_.reset();
+  itemCount_.set(0);
+}
