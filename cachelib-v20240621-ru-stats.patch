+// Trim [offset, offset+len) of the logical device. Block devices: BLKDISCARD
+// (the kernel issues NVMe Deallocate); regular files: punch a hole. RAID0
+// ranges are split per stripe.
+bool FileDevice::trimImpl(uint64_t offset, uint64_t len) {
+  const uint64_t n = fvec_.size();
+  bool ok = true;
+  while (len > 0) {
+    uint64_t fileIdx = 0, fileOff = offset, chunk = len;
+    if (n > 1) {
+      const uint64_t stripe = offset / stripeSize_;
+      fileIdx = stripe % n;
+      fileOff = (stripe / n) * stripeSize_ + offset % stripeSize_;
+      chunk = std::min<uint64_t>(len, stripeSize_ - offset % stripeSize_);
+    }
+    const int fd = fvec_[fileIdx].fd();
+    struct stat st;
+    if (::fstat(fd, &st) == 0 && S_ISBLK(st.st_mode)) {
+      uint64_t range[2] = {fileOff, chunk};
+      ok = ::ioctl(fd, BLKDISCARD, &range) == 0 && ok;
+    } else {
+      ok = ::fallocate(fd, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE,
+                       static_cast<off_t>(fileOff),
+                       static_cast<off_t>(chunk)) == 0 &&
+           ok;
+    }
+    offset += chunk;
+    len -= chunk;
+  }
+  return ok;
+}
