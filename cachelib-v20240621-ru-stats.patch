+void ProgressTracker::work() {
+  const auto tp = stressor_.aggregateThroughputStats();
+  const auto st = stressor_.getCacheStats();
+  const uint64_t ns = stressor_.getTestDurationNs();
+  if (cfg_.placementMergeAtOps && !merged_ && tp.ops >= cfg_.placementMergeAtOps) {
+    merged_ = true;
+    if (auto* bc = navy::BlockCache::instance()) {
+      for (uint16_t h = 0; h < bc->numHintClasses(); h++) {
+        bc->setHintPlacement(h, 0);
+      }
+      for (uint16_t p = 1; p < bc->numPlacements(); p++) {
+        bc->closePlacement(p);
+      }
+      XLOGF(INFO, "placement merge at {} ops: {} hints -> placement 0",
+            tp.ops, bc->numHintClasses());
+    }
   }
+  for (int a = 0; a < TrackerConfig::kNumAxes; a++) {
+    auto& s = ax_[a];
+    const auto& c = s.cfg;
+    if (!c.interval && !c.warmup && !c.stop) {
+      continue;
+    }
+    const uint64_t v = measure(a, st, tp, ns);
+    if (c.warmup && !s.warmed && v >= c.warmup) {
+      emit(a, "WARMUP", v, st, tp, ns);
+      s.warmed = true;
+      s.warm = st;
+      s.warmTp = tp;
+    }
+    if (c.interval && v >= s.nextEmit) {
+      emit(a, "PROGRESS", v, st, tp, ns);
+      s.nextEmit = (v / c.interval + 1) * c.interval;
+    }
+    if (c.stop && !stopped_ && v >= c.stop) {
+      emit(a, "STOP", v, st, tp, ns);
+      XLOGF(INFO, "Stopping: {} axis reached {} {}", kAxisName[a], v,
+            kAxisUnit[a]);
+      stopped_ = true;
+      stopFn_();
+    }
+  }
+}
 
