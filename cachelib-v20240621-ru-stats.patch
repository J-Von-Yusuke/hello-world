@@ -0,0 +1,52 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace facebook::cachelib::navy {
+
+// RU (Reclaim Unit) / placement extensions for BlockCache and BigHash.
+// Default-constructed = original CacheLib behaviour.
+struct RuConfig {
+  // SuperRegion = regionsPerSuperRegion consecutive BlockCache regions; it is
+  // the eviction (RU) unit. 0 = off (region-granular, original policy).
+  uint32_t regionsPerSuperRegion{0};
+  // free SuperRegions kept ahead of allocation (reclaim target)
+  uint32_t numCleanSuperRegions{1};
+  // BlockCache placement hint from the pre-chunking object size:
+  // hint = #thresholds strictly below origSize. Empty = no size hints.
+  std::vector<uint64_t> placementSizeThresholds;
+  // use the online SplitThreshold estimator instead (2 hints)
+  bool useSplitThreshold{false};
+  // DRAM access-count classes (ObjectInfo); hint = sizeClass*nAcc + accClass
+  std::vector<uint64_t> placementAccessThresholds;
+  // reinsertion placement: 0 original, 1 PI,
+  // 2 II  = one shared isolation placement (#hints + 1 placements),
+  // 3 II per hint (2 * #hints placements). II falls back to PI when
+  // maxPlacementIds is too small.
+  uint8_t reinsertPlacement{0};
+  // placement ids available to BlockCache (0 = unlimited)
+  uint16_t maxPlacementIds{0};
+  // per-placement capacity floors (block_cache/CapacityPolicy.h)
+  std::string capacityPolicy; // "" = off, "static"
+  std::vector<double> capacityFloors;
+  // FDP: SR size := device RU size (RUNS) when the device reports one
+  bool superRegionFromDevice{true};
+  // trim (deallocate) evicted RU-aligned ranges (SR / log RU / Nemo SG)
+  bool trimOnReclaim{false};
+  // issue RUH Update at the first write of each RU-aligned unit
+  bool ruhUpdate{true};
+  // experiments without an FDP SSD: pretend these FDP facts (0 = off)
+  uint32_t simFdpPlacementHandles{0};
+  uint64_t simFdpRuSize{0};
+  // original BlockCache numPriorities (0 = keep default / SFIFO segments)
+  uint16_t numPriorities{0};
+  // BigHash engine: 0 in-place (original), 1 log-structured (RU-aligned,
+  // needs SuperRegions), 2 Nemo (Set-Groups, see bighash/NemoCache.h)
+  uint8_t bigHashMode{0};
+  uint64_t nemoSetGroupSize{64ull << 20};
+  uint32_t nemoFlushThreshold{0}; // 0 = setsPerSG / 2 (sweep: fill 70%)
+  double nemoHotFraction{0.3};
+};
+
+} // namespace facebook::cachelib::navy
