+++ b/cachelib/navy/bighash/NemoCache.h
@@ -0,0 +1,156 @@
+#pragma once
+
+// Simplified Nemo (ASPLOS'26, "Nemo: A Low-Write-Amplification Cache for
+// Tiny Objects on Log-Structured Flash Devices") as a Navy small-item engine.
+//
+//  - Set-Group (SG) = sgSize bytes of 4KiB sets (BigHash Bucket format). A key
+//    maps to set s = hash % setsPerSG in EVERY SG (small hash space ->
+//    collisions -> high set fill rate).
+//  - Three SGs live in DRAM: NEW (takes overflow), OLD (being filled, flushed
+//    next) and FLUSHING (handed to the background flusher). When
+//    `flushThreshold` inserts have overflowed OLD, the roles rotate under a
+//    brief exclusive lock and the flusher thread writes FLUSHING to flash.
+//  - Flusher (async, no lock held during device I/O):
+//      1. retire the oldest on-flash slot (lookups skip it from now on),
+//      2. read it; hot objects (hit while in the oldest hotFraction of the
+//         ring) are re-inserted into FLUSHING unless a newer copy may exist,
+//      3. checksum + Bloom filters, one sequential write of the SG,
+//      4. publish the slot (brief exclusive lock) and recycle the buffer.
+//    FLUSHING is only modified by the flusher in step 2 (under set locks);
+//    removes hide its entries with tombstones in NEW instead.
+//  - Index: one Bloom filter per (slot, set), all in DRAM (the paper's
+//    on-flash PBFG pool is omitted at this scale). Lookup: NEW, OLD,
+//    FLUSHING, then flash SGs newest -> oldest whose filter matches.
+//  - Not persistent (recover() returns false).
+
+#include <folly/SharedMutex.h>
+#include <folly/SpinLock.h>
+#include <folly/container/F14Set.h>
+
+#include <array>
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "cachelib/common/AtomicCounter.h"
+#include "cachelib/common/BloomFilter.h"
+#include "cachelib/navy/bighash/Bucket.h"
+#include "cachelib/navy/common/Buffer.h"
+#include "cachelib/navy/common/Device.h"
+#include "cachelib/navy/engine/Engine.h"
+
+namespace facebook::cachelib::navy {
+
+class NemoCache final : public Engine {
+ public:
+  struct Config {
+    uint64_t cacheBaseOffset{};
+    uint64_t cacheSize{};
+    uint32_t bucketSize{4096};
+    uint64_t sgSize{64ull << 20};
+    uint64_t ruSize{0};          // FDP RU size (0 = no RU hooks)
+    uint32_t flushThreshold{0};  // overflowed inserts before flush (0=auto)
+    double hotFraction{0.3};     // oldest part of the ring tracked for hotness
+    uint32_t bfNumHashes{4};
+    uint32_t bfBitsPerHash{16};
+    Device* device{};
+    ExpiredCheck checkExpired;
+    DestructorCallback destructorCb;
+  };
+
+  explicit NemoCache(Config&& config);
+  NemoCache(const NemoCache&) = delete;
+  NemoCache& operator=(const NemoCache&) = delete;
+  ~NemoCache() override;
+
+  uint64_t getSize() const override { return numSlots_ * sgSize_; }
+  // DRAM SGs + Bloom filters. Called by the Navy driver before scheduling an
+  // async lookup job: a cheap "no" here avoids a thread-pool wakeup per miss.
+  bool couldExist(HashedKey hk) override;
+  uint64_t estimateWriteSize(HashedKey hk, BufferView value) const override;
+  Status insert(HashedKey hk, BufferView value) override;
+  Status lookup(HashedKey hk, Buffer& value) override;
+  Status remove(HashedKey hk) override;
+  void flush() override;
+  void reset() override;
+  void persist(RecordWriter&) override {}
+  bool recover(RecordReader&) override { return false; }
+  void getCounters(const CounterVisitor& visitor) const override;
+  uint64_t getMaxItemSize() const override;
+  std::pair<Status, std::string> getRandomAlloc(Buffer&) override {
+    return {Status::NotFound, ""};
+  }
+
+ private:
+  Bucket& memSet(int buf, uint32_t s) {
+    return *reinterpret_cast<Bucket*>(mem_[buf].data() +
+                                      uint64_t{s} * bucketSize_);
+  }
+  uint32_t setOf(HashedKey hk) const {
+    return static_cast<uint32_t>(hk.keyHash() % setsPerSG_);
+  }
+  uint32_t bfIdx(uint64_t slot, uint32_t s) const {
+    return static_cast<uint32_t>(slot * setsPerSG_ + s);
+  }
+  uint64_t slotOffset(uint64_t slot) const {
+    return cacheBaseOffset_ + slot * sgSize_;
+  }
+  void initMem(int buf);
+  // rotate OLD -> FLUSHING if the flusher is idle; caller holds no locks
+  bool tryRotate();
+  void flusherLoop();
+  void flushOne(); // flusher thread only
+  void evictSlot(uint64_t slot);
+  bool newerCopyMayExist(HashedKey hk, uint32_t s, uint64_t evictSlot);
+
+  const uint64_t cacheBaseOffset_;
+  const uint32_t bucketSize_;
+  const uint64_t sgSize_;
+  const uint64_t ruSize_;
+  const double hotFraction_;
+  Device& device_;
+  const ExpiredCheck checkExpired_;
+  const DestructorCallback destructorCb_;
+  const int placementHandle_;
+  uint64_t numSlots_{0};
+  uint32_t setsPerSG_{0};
+  uint32_t flushThreshold_{0};
+  uint32_t bucketCapacity_{0};
+  uint64_t generation_{0};
+
+  // DRAM SGs (indices into mem_), guarded by sgLock_
+  std::array<Buffer, 3> mem_;
+  int new_{0}, old_{1}, flushing_{-1}, spare_{2};
+  std::atomic<uint32_t> overflow_{0};
+  Buffer chunk_; // eviction read buffer (flusher only)
+
+  // flash ring, guarded by sgLock_ (written by the flusher only)
+  uint64_t head_{0};
+  std::vector<uint64_t> slotSeq_; // 0 = empty / retired
+  uint64_t nextSeq_{0};
+  BloomFilter bf_;
+  std::vector<folly::F14FastSet<uint64_t>> hot_;
+  std::array<folly::SpinLock, 64> hotLock_;
+
+  folly::SharedMutex sgLock_;
+  static constexpr size_t kSetLocks = 4096;
+  std::unique_ptr<std::mutex[]> setLock_{new std::mutex[kSetLocks]};
+
+  // flusher thread
+  std::mutex flushMu_;
+  std::condition_variable flushCv_;
+  bool flushPending_{false}; // FLUSHING holds an SG to write
+  bool stop_{false};
+  std::thread flusher_;
+
+  mutable AtomicCounter itemCount_, insertCount_, succInsertCount_;
+  mutable AtomicCounter lookupCount_, succLookupCount_, removeCount_;
+  mutable AtomicCounter evictionCount_, logicalWritten_, physicalWritten_;
+  mutable AtomicCounter flushCount_, sgEvictCount_, hotReinsertCount_;
+  mutable AtomicCounter flashSetReads_, fillBytes_, fillCapacity_;
+  mutable AtomicCounter ioErrorCount_, flushBusyCount_;
+};
+
+} // namespace facebook::cachelib::navy
