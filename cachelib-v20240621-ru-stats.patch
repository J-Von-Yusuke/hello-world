new file mode 100644
index 0000000..7120739
--- /dev/null
+++ b/cachelib/navy/block_cache/CapacityPolicy.h
@@ -0,0 +1,89 @@
+#pragma once
+
+// Per-placement (PID) capacity lower bounds for BlockCache SuperRegion mode.
+//
+// Mechanism (synth_scaled_prediction.html §8, "大物の分類の容量の下限"):
+// when the eviction policy's victim SR belongs to placement p and p owns
+// <= floorFraction(p) * numSRs SuperRegions, that SR is protected and the
+// oldest SR (FIFO: sealed earliest / LRU: least recently hit) of a placement
+// that is above its floor is evicted instead. A floor below the natural share
+// changes nothing; floor 0 for every placement is the plain policy.
+//
+// The floor is queried at every eviction decision, so a dynamic policy can
+// change it at any time: implement CapacityPolicy (e.g. from observed hit
+// ratios / write bandwidth in CapacitySnapshot, or BlockCache counters) and
+// install it with BlockCache::setCapacityPolicy().
+
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace facebook::cachelib::navy {
+
+// State handed to the policy at each eviction decision (cheap, by value).
+struct CapacitySnapshot {
+  uint32_t numSRs{0};                   // BlockCache SuperRegions in total
+  std::vector<uint32_t> ownedSRs;       // per placement: open + sealed SRs
+  std::vector<uint64_t> evictedSRs;     // per placement: SRs evicted so far
+};
+
+class CapacityPolicy {
+ public:
+  virtual ~CapacityPolicy() = default;
+
+  // Called once per eviction decision, before floorFraction().
+  virtual void observe(const CapacitySnapshot& /*s*/) {}
+
+  // Lower bound for placement p as a fraction of all SRs, in [0, 1].
+  virtual double floorFraction(uint16_t placement) const = 0;
+
+  virtual std::string name() const = 0;
+};
+
+// Fixed floors, e.g. {0, 0.9}: placement 1 (the large-object class) keeps at
+// least 90% of the SuperRegions.
+class StaticCapacityPolicy final : public CapacityPolicy {
+ public:
+  explicit StaticCapacityPolicy(std::vector<double> floors)
+      : floors_{std::move(floors)} {
+    double sum = 0;
+    for (double f : floors_) {
+      if (f < 0 || f > 1) {
+        throw std::invalid_argument("capacity floor must be in [0, 1]");
+      }
+      sum += f;
+    }
+    if (sum > 1.0) {
+      throw std::invalid_argument("sum of capacity floors exceeds 1");
+    }
+  }
+  double floorFraction(uint16_t p) const override {
+    return p < floors_.size() ? floors_[p] : 0.0;
+  }
+  std::string name() const override { return "static"; }
+
+ private:
+  const std::vector<double> floors_;
+};
+
+// Config-side description (Config.json -> navyCapacityPolicy / floors).
+struct CapacityPolicyConfig {
+  std::string type;            // "" = off, "static"
+  std::vector<double> floors;  // per placement
+};
+
+// Factory used by BlockCache. New dynamic policies register a type here.
+inline std::shared_ptr<CapacityPolicy> makeCapacityPolicy(
+    const CapacityPolicyConfig& c) {
+  if (c.type.empty()) {
+    return nullptr;
+  }
+  if (c.type == "static") {
+    return std::make_shared<StaticCapacityPolicy>(c.floors);
+  }
+  throw std::invalid_argument("unknown capacity policy: " + c.type);
+}
+
