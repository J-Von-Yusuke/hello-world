diff --git a/cachelib/cachebench/workload/OracleGeneralReplayGenerator.h b/cachelib/cachebench/workload/OracleGeneralReplayGenerator.h
new file mode 100644
index 0000000..2ca8f85
--- /dev/null
+++ b/cachelib/cachebench/workload/OracleGeneralReplayGenerator.h
@@ -0,0 +1,381 @@
+#pragma once
+
+// oracleGeneral zstd trace replay with chunking.
+//
+//   producer thread : zstd stream -> records -> shard(objId) -> batch of 32
+//                     objects -> per-worker SPSC queue
+//   worker (getReq) : pops batches, expands each object into N chunk GETs,
+//                     fixed-width keys written in place into a reused buffer
+//   stats           : per-worker single-writer counters (relaxed store, no
+//                     RMW); ratios, warmup / window deltas computed at render
+//                     time from snapshots.
+
+#include <folly/ProducerConsumerQueue.h>
+#include <folly/ThreadLocal.h>
+#include <folly/container/F14Set.h>
+#include <folly/hash/Hash.h>
+#include <folly/logging/xlog.h>
+
+#include <array>
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+#include "cachelib/cachebench/util/Exceptions.h"
+#include "cachelib/cachebench/util/Request.h"
+#include "cachelib/cachebench/workload/OracleGeneralTrace.h"
+#include "cachelib/cachebench/workload/ReplayGeneratorBase.h"
+
+namespace facebook {
+namespace cachelib {
+namespace cachebench {
+
+// ------------------------------------------------------------------ stats
+struct OgSnap {
+  static constexpr uint32_t kBins = 33; // 2^0 .. 2^32 (obj_size is uint32)
+  enum F {
+    kObjReq, kObjBytes, kChunkReq, kChunkHit, kHitBytes, kMissBytes,
+    kFullHit, kPartialHit, kHeadHit, kTailReq, kTailHit, kNumF
+  };
+  std::array<std::array<uint64_t, kBins>, kNumF> v{};
+  uint64_t total(F f) const {
+    uint64_t s = 0;
+    for (auto x : v[f]) s += x;
+    return s;
+  }
+  OgSnap operator-(const OgSnap& o) const {
+    OgSnap r;
+    for (int f = 0; f < kNumF; f++)
+      for (uint32_t b = 0; b < kBins; b++) r.v[f][b] = v[f][b] - o.v[f][b];
+    return r;
+  }
+};
+
+// single-writer counters: owner thread does load+store (no lock prefix)
+struct OgCounters {
+  std::array<std::array<std::atomic<uint64_t>, OgSnap::kBins>, OgSnap::kNumF>
+      v{};
+  void add(OgSnap::F f, uint32_t b, uint64_t x) {
+    auto& a = v[f][b];
+    a.store(a.load(std::memory_order_relaxed) + x, std::memory_order_relaxed);
+  }
+  void addTo(OgSnap& s) const {
+    for (int f = 0; f < OgSnap::kNumF; f++)
+      for (uint32_t b = 0; b < OgSnap::kBins; b++)
+        s.v[f][b] += v[f][b].load(std::memory_order_relaxed);
+  }
+};
+
+class OracleGeneralReplayGenerator : public ReplayGeneratorBase {
+ public:
+  static constexpr size_t kBatchObjs = 32;
+  static constexpr size_t kQueueBatches = 1024;
+  static constexpr size_t kMaxChunkSize = 4ull * 1024 * 1024 - 1024;
+
+  explicit OracleGeneralReplayGenerator(const StressorConfig& config)
+      : ReplayGeneratorBase(config),
+        chunkSize_(config.cachePieceSize),
+        trackUnique_(config.replayGeneratorConfig.oracleTrackUnique),
+        stream_(config.traceFileName) {
+    if (chunkSize_ == 0 || chunkSize_ > kMaxChunkSize) {
+      throw std::invalid_argument(folly::sformat(
+          "cachePieceSize must be in (0, {}]; got {}", kMaxChunkSize,
+          chunkSize_));
+    }
+    if (!config.enableLookaside) {
+      XLOG(WARN) << "oracle-general-replay without enableLookaside: nothing "
+                    "will ever be inserted";
+    }
+    for (uint32_t i = 0; i < numShards_; i++) {
+      shards_.push_back(std::make_unique<Shard>(chunkSize_));
+    }
+    OracleGeneralRecord r;
+    for (uint64_t i = 0; i < config.replayGeneratorConfig.oracleFastForward;
+         i++) {
+      if (!stream_.readRecord(r)) {
+        throw std::invalid_argument("fastForwardCount exceeds trace length");
+      }
+    }
+    XLOGF(INFO, "oracleGeneral replay: file={} chunk={} shards={} amp={}",
+          config.traceFileName, chunkSize_, numShards_, ampFactor_);
+    producer_ = std::thread([this] { produce(); });
+  }
+
+  ~OracleGeneralReplayGenerator() override {
+    markShutdown();
+    if (producer_.joinable()) producer_.join();
+  }
+
+  const Request& getReq(uint8_t,
+                        std::mt19937_64&,
+                        std::optional<uint64_t>) override {
+    auto& s = shard();
+    if (s.chunk == s.nChunks) {
+      nextObject(s);
+    }
+    OgKey::write(s.key.data(), s.cur.amp, s.cur.objId, s.chunk);
+    s.lastBytes = ogChunkBytes(s.cur.objSize, s.chunk, chunkSize_);
+    s.sizes[0] = s.lastBytes;
+    s.req.origSize = std::max<uint32_t>(s.cur.objSize, 1);
+    s.req.isRep = (s.chunk == 0);
+    s.req.timestamp = s.cur.ts;
+    return s.req;
+  }
+
+  void notifyResult(uint64_t, OpResultType result) override {
+    auto& s = shard();
+    const bool hit = result == OpResultType::kGetHit;
+    const uint32_t b = s.bin;
+    auto& c = s.ctr;
+    c.add(OgSnap::kChunkReq, b, 1);
+    if (hit) {
+      c.add(OgSnap::kChunkHit, b, 1);
+      c.add(OgSnap::kHitBytes, b, s.lastBytes);
+      ++s.objHits;
+      if (s.chunk == 0) c.add(OgSnap::kHeadHit, b, 1);
+    } else {
+      c.add(OgSnap::kMissBytes, b, s.lastBytes);
+    }
+    if (s.chunk > 0 && s.chunk + 1 == s.nChunks) {
+      c.add(OgSnap::kTailReq, b, 1);
+      if (hit) c.add(OgSnap::kTailHit, b, 1);
+    }
+    if (++s.chunk == s.nChunks) { // object complete
+      c.add(OgSnap::kObjReq, b, 1);
+      c.add(OgSnap::kObjBytes, b, std::max<uint32_t>(s.cur.objSize, 1));
+      if (s.objHits == s.nChunks) c.add(OgSnap::kFullHit, b, 1);
+      else if (s.objHits > 0) c.add(OgSnap::kPartialHit, b, 1);
+    }
+  }
+
+  void markFinish() override { shard().finished = true; }
+
+  void setNvmCacheWarmedUp(uint64_t) override {
+    std::lock_guard<std::mutex> g(snapMu_);
+    warm_ = aggregate();
+    warmed_ = true;
+  }
+
+  void renderStats(uint64_t ns, std::ostream& out) const override {
+    const OgSnap all = aggregate();
+    out << "== oracleGeneral replay stats (cumulative) ==\n";
+    renderSnap(all, ns / 1e9, out);
+    {
+      std::lock_guard<std::mutex> g(snapMu_);
+      if (warmed_) {
+        out << "== oracleGeneral replay stats (since NVM warmup) ==\n";
+        renderSnap(all - warm_, 0, out);
+      }
+    }
+    out << folly::sformat(
+               "  io: decompressed {}B fileReads {} producerFullWaits {} "
+               "consumerEmptyWaits {} records {} batches {}",
+               decompBytes_.load(), fileReads_.load(), prodWaits_.load(),
+               consWaits(), nRecords_.load(), nBatches_.load())
+        << std::endl;
+    if (trackUnique_) {
+      out << "  -- trace footprint (distinct objects, by first-seen size) --\n";
+      for (uint32_t b = 0; b < OgSnap::kBins; b++) {
+        const uint64_t n = uniqObjs_[b].load(std::memory_order_relaxed);
+        if (n)
+          out << folly::sformat("  [2^{:2}] uniqObjs {:>12} uniqBytes {:>16}\n",
+                                b, n,
+                                uniqBytes_[b].load(std::memory_order_relaxed));
+      }
+    }
+  }
+
+  void renderStats(uint64_t, folly::UserCounters& c) const override {
+    const OgSnap s = aggregate();
+    c["og_objects"] = s.total(OgSnap::kObjReq);
+    c["og_chunks"] = s.total(OgSnap::kChunkReq);
+    c["og_get_bytes"] =
+        s.total(OgSnap::kHitBytes) + s.total(OgSnap::kMissBytes);
+    c["og_miss_bytes"] = s.total(OgSnap::kMissBytes);
+  }
+
+  void renderWindowStats(double secs, std::ostream& out) const override {
+    std::lock_guard<std::mutex> g(snapMu_);
+    const OgSnap now = aggregate();
+    out << folly::sformat("== oracleGeneral window ({:.0f}s) ==\n", secs);
+    renderSnap(now - window_, 0, out);
+    window_ = now;
+  }
+
+ private:
+  struct Obj {
+    uint32_t ts;
+    uint32_t objSize;
+    uint64_t objId;
+    uint32_t amp;
+  };
+  struct Batch {
+    uint32_t n{0};
+    std::array<Obj, kBatchObjs> o;
+  };
+  struct Shard {
+    explicit Shard(size_t) {}
+    folly::ProducerConsumerQueue<Batch> q{kQueueBatches};
+    // consumer-side state (owner thread only)
+    Batch batch{};
+    uint32_t pos{0};
+    Obj cur{};
+    uint32_t chunk{0}, nChunks{0}, objHits{0}, bin{0};
+    uint64_t lastBytes{0};
+    std::string key = std::string(OgKey::kKeyLen, '0');
+    std::vector<size_t> sizes{1};
+    Request req{key, sizes.begin(), sizes.end(), OpType::kGet, 0};
+    OgCounters ctr;
+    std::atomic<uint64_t> emptyWaits{0};
+    bool finished{false};
+    // producer-side pending batch
+    Batch pending{};
+  };
+
+  Shard& shard() {
+    if (!idx_.get()) idx_.reset(new uint32_t(nextIdx_++));
+    return *shards_[*idx_ % shards_.size()];
+  }
+
+  void nextObject(Shard& s) {
+    if (s.pos == s.batch.n) {
+      while (!s.q.read(s.batch)) {
+        if (eof_.load(std::memory_order_acquire) && s.q.isEmpty()) {
+          throw cachelib::cachebench::EndOfTrace("oracleGeneral EOF");
+        }
+        s.emptyWaits.store(s.emptyWaits.load(std::memory_order_relaxed) + 1,
+                           std::memory_order_relaxed);
+        std::this_thread::yield();
+      }
+      s.pos = 0;
+    }
+    s.cur = s.batch.o[s.pos++];
+    s.chunk = 0;
+    s.objHits = 0;
+    s.nChunks = ogNumChunks(s.cur.objSize, chunkSize_);
+    s.bin = ogSizeBin(std::max<uint32_t>(s.cur.objSize, 1), OgSnap::kBins);
+  }
+
+  void push(uint32_t sh) {
+    auto& s = *shards_[sh];
+    while (!s.q.write(s.pending)) {
+      if (shouldShutdown()) return;
+      prodWaits_.fetch_add(1, std::memory_order_relaxed);
+      std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+    nBatches_.fetch_add(1, std::memory_order_relaxed);
+    s.pending.n = 0;
+  }
+
+  void produce() {
+    std::vector<OracleGeneralRecord> buf(4096);
+    folly::F14FastSet<uint64_t> seen;
+    const uint64_t ts0Div = std::max<uint64_t>(timestampFactor_, 1);
+    while (!shouldShutdown()) {
+      size_t n = stream_.readRecords(buf.data(), buf.size());
+      if (n == 0) {
+        if (!repeatTraceReplay_) break;
+        stream_.rewind();
+        n = stream_.readRecords(buf.data(), buf.size());
+        if (n == 0) break;
+      }
+      for (size_t i = 0; i < n; i++) {
+        const auto& r = buf[i];
+        if (trackUnique_ && seen.insert(r.objId).second) {
+          const uint32_t b = ogSizeBin(std::max<uint32_t>(r.objSize, 1),
+                                       OgSnap::kBins);
+          uniqObjs_[b].fetch_add(1, std::memory_order_relaxed);
+          uniqBytes_[b].fetch_add(std::max<uint32_t>(r.objSize, 1),
+                                  std::memory_order_relaxed);
+        }
+        for (uint32_t a = 0; a < ampFactor_; a++) {
+          // shard by object, not chunk: all chunks of an object stay on one
+          // worker (keeps them adjacent in DRAM LRU -> same Navy region)
+          const uint32_t sh = static_cast<uint32_t>(
+              folly::hash::twang_mix64(r.objId * 1009 + a) % shards_.size());
+          auto& p = shards_[sh]->pending;
+          p.o[p.n++] = Obj{static_cast<uint32_t>(r.timestamp / ts0Div), r.objSize, r.objId, a};
+          if (p.n == kBatchObjs) push(sh);
+        }
+      }
+      nRecords_.fetch_add(n, std::memory_order_relaxed);
+      decompBytes_.store(stream_.decompressedBytes(),
+                         std::memory_order_relaxed);
+      fileReads_.store(stream_.fileReads(), std::memory_order_relaxed);
+    }
+    for (uint32_t sh = 0; sh < shards_.size(); sh++) {
+      if (shards_[sh]->pending.n) push(sh);
+    }
+    eof_.store(true, std::memory_order_release);
+    XLOGF(INFO, "oracleGeneral producer done: records={}", nRecords_.load());
+  }
+
+  OgSnap aggregate() const {
+    OgSnap s;
+    for (auto& sh : shards_) sh->ctr.addTo(s);
+    return s;
+  }
+  uint64_t consWaits() const {
+    uint64_t w = 0;
+    for (auto& sh : shards_) w += sh->emptyWaits.load();
+    return w;
+  }
+
+  static double pct(uint64_t a, uint64_t b) { return b ? 100.0 * a / b : 0.0; }
+
+  static void renderSnap(const OgSnap& s, double secs, std::ostream& out) {
+    using F = OgSnap;
+    const uint64_t objs = s.total(F::kObjReq), ch = s.total(F::kChunkReq);
+    const uint64_t hb = s.total(F::kHitBytes), mb = s.total(F::kMissBytes);
+    out << folly::sformat(
+        "  objects {} chunks {} chunk/obj {:.2f} getBytes {} missBytes {}\n"
+        "  objHit(full) {:.2f}% objHit(partial) {:.2f}% chunkHit {:.2f}% "
+        "byteHit {:.2f}% byteMiss {:.2f}%\n"
+        "  headHit {:.2f}% tailHit {:.2f}%",
+        objs, ch, objs ? double(ch) / objs : 0.0, hb + mb, mb,
+        pct(s.total(F::kFullHit), objs), pct(s.total(F::kPartialHit), objs),
+        pct(s.total(F::kChunkHit), ch), pct(hb, hb + mb), pct(mb, hb + mb),
+        pct(s.total(F::kHeadHit), objs),
+        pct(s.total(F::kTailHit), s.total(F::kTailReq)));
+    if (secs > 0) out << folly::sformat("  objects/s {:.0f}", objs / secs);
+    out << "\n  -- by object size (floor log2) --\n"
+        << "  bin       objReq     reqBytes%  fullHit%  partHit%  chunkHit%  "
+           "byteHit%  byteMiss%      missBytes\n";
+    const uint64_t allB = hb + mb;
+    for (uint32_t b = 0; b < F::kBins; b++) {
+      const uint64_t o = s.v[F::kObjReq][b];
+      if (!o) continue;
+      const uint64_t bh = s.v[F::kHitBytes][b], bm = s.v[F::kMissBytes][b];
+      out << folly::sformat(
+          "  2^{:<3} {:>12} {:>12.2f} {:>9.2f} {:>9.2f} {:>10.2f} {:>9.2f} "
+          "{:>10.2f} {:>14}\n",
+          b, o, pct(bh + bm, allB), pct(s.v[F::kFullHit][b], o),
+          pct(s.v[F::kPartialHit][b], o),
+          pct(s.v[F::kChunkHit][b], s.v[F::kChunkReq][b]), pct(bh, bh + bm),
+          pct(bm, bh + bm), bm);
+    }
+  }
+
+  const uint64_t chunkSize_;
+  const bool trackUnique_;
+  ZstdRecordStream stream_;
+  std::vector<std::unique_ptr<Shard>> shards_;
+  std::atomic<uint32_t> nextIdx_{0};
+  folly::ThreadLocalPtr<uint32_t> idx_;
+  std::thread producer_;
+  std::atomic<bool> eof_{false};
+
+  std::atomic<uint64_t> nRecords_{0}, nBatches_{0}, prodWaits_{0};
+  std::atomic<uint64_t> decompBytes_{0}, fileReads_{0};
+  std::array<std::atomic<uint64_t>, OgSnap::kBins> uniqObjs_{}, uniqBytes_{};
+
+  mutable std::mutex snapMu_;
+  OgSnap warm_{};
+  bool warmed_{false};
+  mutable OgSnap window_{};
+};
+
+} // namespace cachebench
+} // namespace cachelib
+} // namespace facebook
diff --git a/cachelib/cachebench/workload/OracleGeneralTrace.h b/cachelib/cachebench/workload/OracleGeneralTrace.h
new file mode 100644
index 0000000..f37e6f2
--- /dev/null
+++ b/cachelib/cachebench/workload/OracleGeneralTrace.h
@@ -0,0 +1,170 @@
+#pragma once
+
+// oracleGeneral (libCacheSim) zstd trace reader + chunk/key helpers.
+// Depends only on zstd + std, so it can be unit-tested without CacheLib.
+
+#include <zstd.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace facebook {
+namespace cachelib {
+namespace cachebench {
+
+#pragma pack(push, 1)
+struct OracleGeneralRecord {
+  uint32_t timestamp;
+  uint64_t objId;
+  uint32_t objSize;
+  int64_t nextAccessVtime; // unused
+};
+#pragma pack(pop)
+static_assert(sizeof(OracleGeneralRecord) == 24, "record must be 24B packed");
+
+// Streaming zstd decompressor. Output is decompressed into a large buffer and
+// records are handed out in bulk (readRecords) so the per-record cost is a
+// memcpy of 24B; a record may straddle refills and is stitched in carry_.
+class ZstdRecordStream {
+ public:
+  explicit ZstdRecordStream(std::string path, size_t outBufBytes = 4 << 20)
+      : path_(std::move(path)), outBuf_(outBufBytes) {
+    open();
+  }
+  ~ZstdRecordStream() { closeAll(); }
+  ZstdRecordStream(const ZstdRecordStream&) = delete;
+  ZstdRecordStream& operator=(const ZstdRecordStream&) = delete;
+
+  void rewind() {
+    closeAll();
+    open();
+  }
+
+  // Fills up to n records; returns how many. 0 = clean EOF.
+  size_t readRecords(OracleGeneralRecord* dst, size_t n) {
+    size_t got = 0;
+    auto* out = reinterpret_cast<char*>(dst);
+    size_t want = n * sizeof(OracleGeneralRecord);
+    size_t have = 0;
+    while (have < want) {
+      if (outPos_ == outEnd_ && !refill()) {
+        break;
+      }
+      const size_t take = std::min(want - have, outEnd_ - outPos_);
+      std::memcpy(out + have, outBuf_.data() + outPos_, take);
+      outPos_ += take;
+      have += take;
+    }
+    got = have / sizeof(OracleGeneralRecord);
+    if (have % sizeof(OracleGeneralRecord) != 0) {
+      throw std::runtime_error("oracleGeneral: truncated record at EOF");
+    }
+    decompressedBytes_ += have;
+    return got;
+  }
+
+  bool readRecord(OracleGeneralRecord& r) { return readRecords(&r, 1) == 1; }
+  uint64_t decompressedBytes() const { return decompressedBytes_; }
+  uint64_t fileReads() const { return fileReads_; }
+
+ private:
+  void open() {
+    f_ = std::fopen(path_.c_str(), "rb");
+    if (f_ == nullptr) {
+      throw std::invalid_argument("cannot open trace: " + path_);
+    }
+    zds_ = ZSTD_createDStream();
+    ZSTD_initDStream(zds_);
+    inBuf_.resize(std::max<size_t>(ZSTD_DStreamInSize(), 1 << 20));
+    zin_ = {inBuf_.data(), 0, 0};
+    outPos_ = outEnd_ = 0;
+  }
+  void closeAll() {
+    if (zds_) {
+      ZSTD_freeDStream(zds_);
+      zds_ = nullptr;
+    }
+    if (f_) {
+      std::fclose(f_);
+      f_ = nullptr;
+    }
+  }
+  bool refill() {
+    while (true) {
+      if (zin_.pos == zin_.size) {
+        const size_t rd = std::fread(inBuf_.data(), 1, inBuf_.size(), f_);
+        ++fileReads_;
+        if (rd == 0) {
+          return false;
+        }
+        zin_ = {inBuf_.data(), rd, 0};
+      }
+      ZSTD_outBuffer zout{outBuf_.data(), outBuf_.size(), 0};
+      const size_t ret = ZSTD_decompressStream(zds_, &zout, &zin_);
+      if (ZSTD_isError(ret)) {
+        throw std::runtime_error(std::string("zstd: ") +
+                                 ZSTD_getErrorName(ret));
+      }
+      if (zout.pos > 0) {
+        outPos_ = 0;
+        outEnd_ = zout.pos;
+        return true;
+      }
+    }
+  }
+
+  std::string path_;
+  std::FILE* f_{nullptr};
+  ZSTD_DStream* zds_{nullptr};
+  std::vector<char> inBuf_, outBuf_;
+  ZSTD_inBuffer zin_{};
+  size_t outPos_{0}, outEnd_{0};
+  uint64_t decompressedBytes_{0}, fileReads_{0};
+};
+
+// ---- chunk boundaries: the single definition shared by producer/consumer
+inline uint32_t ogNumChunks(uint64_t objSize, uint64_t chunkSize) {
+  const uint64_t s = std::max<uint64_t>(objSize, 1);
+  return static_cast<uint32_t>((s + chunkSize - 1) / chunkSize);
+}
+inline uint64_t ogChunkBytes(uint64_t objSize, uint32_t idx, uint64_t chunk) {
+  const uint64_t s = std::max<uint64_t>(objSize, 1);
+  const uint64_t off = static_cast<uint64_t>(idx) * chunk;
+  return std::min(chunk, s - off);
+}
+
+// floor(log2(size)), size<2 -> 0, capped to nBins-1. Same as SplitThreshold.
+inline uint32_t ogSizeBin(uint64_t size, uint32_t nBins) {
+  const uint32_t b = size < 2 ? 0 : 63 - __builtin_clzll(size);
+  return std::min(b, nBins - 1);
+}
+
+// Fixed-width key "<amp 4><objId 20>_<chunk 6>" (31 chars). Writes every digit
+// explicitly (no formatter, no allocation once capacity >= kKeyLen).
+struct OgKey {
+  static constexpr size_t kKeyLen = 31;
+  static void write(char* p, uint32_t amp, uint64_t objId, uint32_t chunk) {
+    for (int i = 3; i >= 0; i--) {
+      p[i] = static_cast<char>('0' + amp % 10);
+      amp /= 10;
+    }
+    for (int i = 23; i >= 4; i--) {
+      p[i] = static_cast<char>('0' + objId % 10);
+      objId /= 10;
+    }
+    p[24] = '_';
+    for (int i = 30; i >= 25; i--) {
+      p[i] = static_cast<char>('0' + chunk % 10);
+      chunk /= 10;
+    }
+  }
+};
