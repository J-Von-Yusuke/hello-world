+std::pair<OpenStatus, std::unique_ptr<CondWaiter>>
+RegionManager::getCleanRegionSR(RegionId& rid,
+                                bool addWaiter,
+                                uint16_t p) {
+  XDCHECK_LT(p, srOpen_.size());
+  auto status = OpenStatus::Retry;
+  std::unique_ptr<CondWaiter> waiter;
+  std::vector<uint32_t> toReclaim;
+  bool opened = false;
+  {
+    std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+    if (srRetry_[p].valid()) {
+      rid = srRetry_[p];
+      srRetry_[p] = RegionId{};
+      status = OpenStatus::Ready;
+    } else {
+      if (srOpen_[p] >= 0 && srNext_[p] == regionsPerSR_) {
+        srOpen_[p] = -1; // SR fully handed out; it seals once all flush
+      }
+      if (srOpen_[p] < 0 && !srFree_.empty()) {
+        srOpen_[p] = srFree_.front();
+        srFree_.pop_front();
+        srNext_[p] = 0;
+        opened = true;
+        srOwner_[srOpen_[p]] = p;
+        owned_[p]++;
+        XLOGF(DBG, "[SRDBG] open sr={} for p={}", srOpen_[p], p);
+      }
+      const bool onWorker = isOnWorker(); // reclaim (reinsertion) context
+      if (srOpen_[p] < 0 && onWorker) {
+        // no free SR: the reclaim thread adopts the SR it is reclaiming (its
+        // head is already empty) for its reinsertions
+        for (uint32_t x = 0; x < numSRs_; x++) {
+          if (srReclaiming_[x] && srAdoptedBy_[x] == -1 && srCursor_[x] > 0) {
+            srAdoptedBy_[x] = p;
+            srOpen_[p] = x;
+            if (srOwner_[x] != p) { // ownership moves to the adopter
+              if (srOwner_[x] >= 0) {
+                owned_[srOwner_[x]]--;
+              }
+              srOwner_[x] = p;
+              owned_[p]++;
+            }
+            srNext_[p] = 0;
+            opened = true;
+            srAdoptCount_.inc();
+            break;
+          }
+        }
+      }
+      // while the adopted SR is still being reclaimed its emptied head is
+      // reserved for reinsertions; regular inserts wait for the reclaim end
+      const bool behindCursor =
+          srOpen_[p] >= 0 && srReclaiming_[srOpen_[p]] &&
+          (srNext_[p] >= srCursor_[srOpen_[p]] || !onWorker);
+      if (onWorker && srOpen_[p] < 0) {
+        wkFailNoSR_.inc();
+      } else if (onWorker && behindCursor) {
+        wkFailCursor_.inc();
+      }
+      if (srOpen_[p] >= 0 && !behindCursor) {
+        rid = RegionId{static_cast<uint32_t>(srOpen_[p]) * regionsPerSR_ +
+                       srNext_[p]++};
+        status = OpenStatus::Ready;
+      } else {
+        srNoFreeCount_.inc();
+      }
+      if (status != OpenStatus::Ready && addWaiter) {
+        XLOG_EVERY_MS(WARN, 10000) << folly::sformat(
+            "[SRDBG] no free SR p={} free={} sealed={} outst={} cnt={}", p,
+            srFree_.size(), srSealedN_, srReclaimsOutstanding_,
+            folly::join(",", srSealedCnt_));
+        waiter = std::make_unique<CondWaiter>();
+        cleanRegionsCond_.addWaiter(waiter.get());
+      }
+    }
+    scheduleVictimsLocked(toReclaim);
+  }
+  if (opened) {
+    srOpenCount_.inc(); // RUH Update happens at the SR's first write
+  }
+  for (auto sr : toReclaim) {
+    getNextWorker().addTaskRemote([this, sr]() { doReclaimSR(sr); });
+  }
+  if (status == OpenStatus::Ready) {
+    std::tie(status, waiter) = assignBufferToRegion(rid, addWaiter);
+    if (status != OpenStatus::Ready) {
+      std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+      srRetry_[p] = rid; // keep SR order: hand the same region out next time
+      srNoBufferCount_.inc();
+      if (isOnWorker()) {
+        wkFailBuffer_.inc();
+      }
+    }
+  } else {
+    cleanRegionRetries_.inc();
+  }
+  return {status, std::move(waiter)};
+}
+
+void RegionManager::setCapacityPolicy(std::shared_ptr<CapacityPolicy> p) {
+  if (!superRegionMode()) {
+    throw std::invalid_argument("capacity floors need SuperRegion mode");
+  }
+  std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+  if (!p || (!capPolicy_ && srSealedN_ > 0)) {
+    throw std::logic_error(
+        "capacity policy: install before the first seal, and do not remove");
+  }
+  if (!capPolicy_) {
+    lruSel_ = dynamic_cast<LruPolicy*>(policy_.get()) != nullptr;
+    if (!lruSel_ && dynamic_cast<FifoPolicy*>(policy_.get()) == nullptr) {
+      XLOG(WARN) << "capacity floors: segmented FIFO not supported, using FIFO";
+    }
+  }
+  XLOGF(INFO, "capacity policy '{}' installed ({} selection)", p->name(),
+        lruSel_ ? "LRU" : "FIFO");
+  capPolicy_ = std::move(p);
+}
+
+uint32_t RegionManager::ownedSRs(uint16_t placement) const {
+  std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+  return placement < owned_.size() ? owned_[placement] : 0;
+}
+
+// cleanRegionsMutex_ held. Returns the SR to reclaim or -1.
+int64_t RegionManager::pickVictimLocked() {
+  if (!capPolicy_) {
+    const RegionId v = policy_->evict(); // LRU / FIFO / SFIFO
+    return v.valid() ? int64_t{superRegionOf(v)} : -1;
+  }
+  capPolicy_->observe(CapacitySnapshot{numSRs_, owned_, evictedPl_});
+  auto key = [this](uint32_t sr) {
+    return lruSel_ ? srLastAccess_[sr].load(std::memory_order_relaxed)
+                   : srSealSeq_[sr];
+  };
+  auto isProtected = [this](uint32_t sr) {
+    const int32_t p = srOwner_[sr];
+    return p >= 0 &&
+           owned_[p] <= capPolicy_->floorFraction(static_cast<uint16_t>(p)) *
+                            numSRs_;
+  };
+  int64_t best = -1, bestUnprotected = -1;
+  for (uint32_t sr = 0; sr < numSRs_; sr++) {
+    if (!srInPool_[sr]) {
+      continue;
+    }
+    if (best < 0 || key(sr) < key(static_cast<uint32_t>(best))) {
+      best = sr;
+    }
+    if (!isProtected(sr) &&
+        (bestUnprotected < 0 ||
+         key(sr) < key(static_cast<uint32_t>(bestUnprotected)))) {
+      bestUnprotected = sr;
+    }
+  }
+  if (best < 0) {
+    return -1;
+  }
+  int64_t chosen = best;
+  if (isProtected(static_cast<uint32_t>(best))) {
+    if (bestUnprotected >= 0) {
+      chosen = bestUnprotected; // oldest SR of a placement above its floor
+      floorProtectCount_.inc();
+    } else {
+      floorOverrideCount_.inc(); // every candidate protected: plain policy
+    }
+  }
+  srInPool_[chosen] = 0;
+  if (srOwner_[chosen] >= 0) {
+    evictedPl_[srOwner_[chosen]]++;
+  }
+  return chosen;
+}
+
+void RegionManager::scheduleVictimsLocked(std::vector<uint32_t>& toReclaim) {
+  while (srFree_.size() + srReclaimsOutstanding_ < numCleanSRs_ &&
+         srSealedN_ > 0) {
+    const int64_t v = pickVictimLocked();
+    if (v < 0) {
+      break;
+    }
+    srSealedN_--;
+    toReclaim.push_back(static_cast<uint32_t>(v));
+    srReclaimsOutstanding_++;
+  }
+}
+
+void RegionManager::closeOpenSR(uint16_t p) {
+  if (!superRegionMode()) {
+    return;
+  }
+  std::vector<RegionId> finished;
+  {
+    std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+    if (srRetry_[p].valid()) { // issued but never got a buffer: unused
+      finished.push_back(srRetry_[p]);
+      srRetry_[p] = RegionId{};
+    }
+    if (srOpen_[p] >= 0) {
+      const uint32_t sr = static_cast<uint32_t>(srOpen_[p]);
+      for (uint32_t n = srNext_[p]; n < regionsPerSR_; n++) {
+        finished.push_back(RegionId{sr * regionsPerSR_ + n});
+      }
+      srOpen_[p] = -1;
+    }
+  }
+  for (auto rid : finished) {
+    markRegionSealedSR(rid); // empty subRegions: reclaim reads nothing
+  }
+}
+
+void RegionManager::markRegionSealedSR(RegionId rid) {
+  // Sealing must itself trigger reclaim: if every writer is already parked
+  // waiting for a free SR, no further getCleanRegionSR() call would ever
+  // schedule it (deadlock).
+  std::vector<uint32_t> toReclaim;
+  {
+    std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+    const uint32_t sr = superRegionOf(rid);
+    if (++srSealedCnt_[sr] == regionsPerSR_) {
+      srWritten_[sr] = 1;
+      // representative = first subRegion. Segmented FIFO segments by the
+      // region priority, which here is the placement id: present the SR's
+      // segment instead (insert SR = 0, reinsertion SR = higher) for the
+      // track() call only, then restore the placement.
+      if (capPolicy_) {
+        srInPool_[sr] = 1;
+        srSealSeq_[sr] = ++sealSeqCounter_;
+        srLastAccess_[sr].store(getSteadyClock().count(),
+                                std::memory_order_relaxed);
+        srSealedN_++;
+        // (skip the EvictionPolicy object entirely)
+      }
+      auto& rep = getRegion(RegionId{sr * regionsPerSR_});
+      const uint16_t pl = rep.getPriority();
+      rep.setPriority(pl < placementSegment_.size() ? placementSegment_[pl]
+                                                    : 0);
+      if (!capPolicy_) {
+        policy_->track(rep);
+        srSealedN_++;
+      }
+      rep.setPriority(pl);
+      XLOGF(DBG, "[SRDBG] sealed sr={}", sr);
+    }
+    scheduleVictimsLocked(toReclaim);
+  }
+  for (auto sr : toReclaim) {
+    getNextWorker().addTaskRemote([this, sr]() { doReclaimSR(sr); });
+  }
+}
+
+void RegionManager::doReclaimSR(uint32_t sr) {
+  const auto startTime = getSteadyClock();
+  XLOGF(DBG, "[SRDBG] reclaim begin sr={}", sr);
+  {
+    std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+    srSealedCnt_[sr] = 0; // adopted subRegions count from here on
+    srCursor_[sr] = 0;
+    srAdoptedBy_[sr] = -1;
+    srReclaiming_[sr] = 1;
+  }
+  for (uint32_t i = 0; i < regionsPerSR_; i++) {
+    const RegionId rid{sr * regionsPerSR_ + i};
+    auto& region = getRegion(rid);
+    bool ok = region.readyForReclaim(true);
+    XDCHECK(ok);
+    if (region.getNumItems() != 0) {
+      XDCHECK(!region.hasBuffer());
+      auto desc = RegionDescriptor::makeReadDescriptor(
+          OpenStatus::Ready, RegionId{rid}, true /* physRead */);
+      auto sizeToRead = region.getLastEntryEndOffset();
+      auto buffer = read(desc, RelAddress{rid, 0}, sizeToRead);
+      if (buffer.size() != sizeToRead) {
+        reclaimRegionErrors_.inc();
+      } else {
+        doEviction(rid, buffer.view());
+      }
+    }
+    externalFragmentation_.sub(region.getFragmentationSize());
+    seqNumber_.fetch_add(1, std::memory_order_acq_rel);
+    region.reset();
+    reclaimCount_.inc();
+    {
+      std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+      srCursor_[sr] = i + 1; // subRegion i is empty: adoptable
+      if (srAdoptedBy_[sr] >= 0 && cleanRegionsCond_.numWaiters() > 0) {
+        cleanRegionsCond_.notifyAll();
+      }
+    }
+    if (subRegionReclaimedCb_) {
+      subRegionReclaimedCb_(i + 1 == regionsPerSR_); // drain parked items
+    }
+  }
+  // whole SR evicted -> e.g. Trim of its LBA range. If a placement adopted
+  // it, part of the range already holds new data, so no trim (the old RU is
+  // still fully invalidated: its LBAs were all rewritten or trimmed later).
+  bool adopted;
+  {
+    std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+    adopted = srAdoptedBy_[sr] >= 0;
+    if (!adopted) {
+      srAdoptedBy_[sr] = -2; // closed for adoption while we trim
+    }
+  }
+  // Trim BEFORE the SR can be handed out again: a trim racing with new
+  // writes into the same range would wipe them.
+  if (!adopted) {
+    const auto [off, len] = superRegionRange(sr);
+    device_.onReclaimUnitFreed(off, len);
+  }
+  {
+    std::lock_guard<TimedMutex> lock{cleanRegionsMutex_};
+    srReclaiming_[sr] = 0;
+    srReclaimsOutstanding_--;
+    if (!adopted) {
+      srAdoptedBy_[sr] = -1;
+      if (srOwner_[sr] >= 0) {
+        owned_[srOwner_[sr]]--;
+      }
+      srOwner_[sr] = -1;
+      srFree_.push_back(sr);
+    } // else: stays the adopter's open SR
+    if (cleanRegionsCond_.numWaiters() > 0) {
+      cleanRegionsCond_.notifyAll();
+    }
+  }
+  srReclaimCount_.inc();
+  XLOGF(DBG, "[SRDBG] reclaim end sr={}", sr);
+  reclaimTimeCountUs_.add(toMicros(getSteadyClock() - startTime).count());
+}
