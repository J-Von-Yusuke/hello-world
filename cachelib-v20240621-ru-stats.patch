+// segmented FIFO segment per placement in SuperRegion mode: SRs filled by
+// reinsertions (II placements) hold objects that already proved hot.
+std::vector<uint16_t> BlockCache::placementSegments(const Config& c) {
+  std::vector<uint16_t> seg(c.numPriorities, 0);
+  const uint16_t h = c.hintsEnabled() ? c.numHints() : 1;
+  for (uint16_t p = 0; p < c.numPriorities; p++) {
+    const bool reinsertPl = (c.reinsertPlacement == 2 && p == c.numPriorities - 1) ||
+                            (c.reinsertPlacement == 3 && p >= h);
+    seg[p] = reinsertPl ? 1 : 0;
+  }
+  return seg;
+}
