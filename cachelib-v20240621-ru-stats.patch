+
+uint16_t BlockCache::hintOf(BufferView value, const ObjectInfo*& oi) {
+  oi = probeObjectInfo(value);
+  uint64_t sz = value.size(); // fallback: own size
+  if (oi != nullptr && oi->origSize != 0) {
+    sz = oi->origSize;
+  } else {
+    oi = nullptr;
+    headerMissCount_.inc();
+  }
+  if (!hintsEnabled_) {
+    return kDefaultItemPriority;
+  }
+  uint16_t sc = 0;
+  if (useSplitThreshold_) {
+    sc = static_cast<uint16_t>(splitThreshold_.poolOf(sz));
+  } else {
+    while (sc < placementSizeThresholds_.size() &&
+           sz > placementSizeThresholds_[sc]) {
+      sc++;
+    }
+  }
+  uint16_t ac = 0;
+  const uint64_t acc = oi != nullptr ? oi->accessCount() : 0;
+  while (ac < placementAccessThresholds_.size() &&
+         acc > placementAccessThresholds_[ac]) {
+    ac++;
+  }
+  return sc * numAccessClasses_ + ac;
+}
