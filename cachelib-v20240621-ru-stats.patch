+
+void FdpNvme::readFdpConfig() {
+  // 1) Endurance Group of the namespace: Identify Namespace (CNS 00h),
+  //    ENDGID at bytes 103:102
+  std::vector<uint8_t> id(4096);
+  if (nvmeAdmin(0x06, nvmeData_.nsId(), id.data(), id.size(), 0x00, 0,
+                nullptr) != 0) {
+    XLOG(WARN) << "FDP: Identify Namespace failed; RU size unknown";
+    return;
+  }
+  const uint16_t endgid = rdLe<uint16_t>(id.data() + 102);
+  // 2) active configuration: Get Features FDP (FID 1Dh), CDW11 = ENDGID;
+  //    result bit 0 = FDPE, bits 15:8 = FDPCIDX
+  uint32_t feat = 0;
+  if (nvmeAdmin(0x0A, 0, nullptr, 0, 0x1D, endgid, &feat) != 0) {
+    XLOG(WARN) << "FDP: Get Features (FDP) failed; RU size unknown";
+    return;
+  }
+  const uint32_t cfgIdx = (feat >> 8) & 0xFF;
+  // 3) FDP Configurations log page (LID 20h), LSI = ENDGID. Header: 01:00
+  //    NUMFDPC (0's based), 07:04 total size; descriptors from byte 16.
+  auto getLog = [&](std::vector<uint8_t>& buf) {
+    const uint32_t numd = static_cast<uint32_t>(buf.size() / 4 - 1);
+    const uint32_t cdw10 = 0x20 | ((numd & 0xFFFF) << 16);
+    const uint32_t cdw11 = (numd >> 16) | (uint32_t{endgid} << 16);
+    return nvmeAdmin(0x02, 0xFFFFFFFF, buf.data(), buf.size(), cdw10, cdw11,
+                     nullptr);
+  };
+  std::vector<uint8_t> hdr(16);
+  if (getLog(hdr) != 0) {
+    XLOG(WARN) << "FDP: Get Log Page 20h failed; RU size unknown";
+    return;
+  }
+  const uint32_t total = rdLe<uint32_t>(hdr.data() + 4);
+  const uint32_t numCfg = rdLe<uint16_t>(hdr.data()) + 1u;
+  if (total < 16 || total > (1u << 20)) {
+    return;
+  }
+  std::vector<uint8_t> log((total + 3) & ~3u);
+  if (getLog(log) != 0) {
+    return;
+  }
+  size_t off = 16;
+  for (uint32_t c = 0; c < numCfg && off + 28 <= log.size(); c++) {
+    const uint8_t* d = log.data() + off;
+    const uint16_t dsze = rdLe<uint16_t>(d);
+    if (dsze < 28) {
+      break;
+    }
+    if (c == cfgIdx) {
+      fdpInfo_.nrg = rdLe<uint32_t>(d + 4);
+      fdpInfo_.nruh = rdLe<uint16_t>(d + 8);
+      fdpInfo_.maxPids = rdLe<uint16_t>(d + 10) + 1u; // 0's based
+      fdpInfo_.ruSize = rdLe<uint64_t>(d + 16);
+      fdpInfo_.ruTimeLimitSec = rdLe<uint32_t>(d + 24);
+      return;
+    }
+    off += dsze;
+  }
+  XLOGF(WARN, "FDP: configuration {} not found in log page", cfgIdx);
+}
+
+bool FdpNvme::ruhUpdate(uint16_t phndl) {
+  if (phndl > maxPIDIdx_) {
+    return false;
+  }
+  uint16_t pid = getFdpPID(phndl);
+  // I/O Management Send (1Dh): CDW10 [7:0] MO = 01h, [31:16] NPID (0's
+  // based) = 0 -> one Placement Identifier in the data buffer
+  struct nvme_passthru_cmd cmd {};
+  cmd.opcode = 0x1D;
+  cmd.nsid = nvmeData_.nsId();
+  cmd.addr = reinterpret_cast<uint64_t>(&pid);
+  cmd.data_len = sizeof(pid);
+  cmd.cdw10 = 0x01;
+  cmd.timeout_ms = NVME_DEFAULT_IOCTL_TIMEOUT;
+  return ioctl(file_.fd(), NVME_IOCTL_IO_CMD, &cmd) == 0;
+}
