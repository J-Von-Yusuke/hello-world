+
+void BlockCache::setHintPlacement(uint16_t hint, uint16_t placement) {
+  if (hint >= numHints_ || placement >= numPriorities_) {
+    throw std::invalid_argument(folly::sformat(
+        "hint {} / placement {} out of range ({} hints, {} placements)", hint,
+        placement, numHints_, numPriorities_));
+  }
+  hintToPlacement_[hint].store(placement, std::memory_order_relaxed);
+}
+
+void BlockCache::closePlacement(uint16_t placement) {
+  if (placement >= numPriorities_) {
+    throw std::invalid_argument("placement out of range");
+  }
+  allocator_.flushPriority(placement);
+  regionManager_.closeOpenSR(placement);
+}
