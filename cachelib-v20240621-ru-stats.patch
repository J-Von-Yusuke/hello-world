 // @return the starting offset of the setup bighash (inclusive)
+// SR size := device RU size (FDP RUNS) if available, keeping a subRegion in
+// [16, 256] MiB that divides it (nearest to the configured region size).
+// Otherwise the configured SuperRegion stays.
+void applyDeviceRuSize(navy::BlockCacheConfig& bc,
+                       const cachelib::navy::Device& device) {
+  auto ru = bc.getRuConfig();
+  const auto info = device.getFdpInfo();
+  if (ru.regionsPerSuperRegion == 0 || !ru.superRegionFromDevice ||
+      !info.valid || info.ruSize == 0) {
+    return;
+  }
+  constexpr uint64_t MiB = 1ull << 20;
+  if (info.ruSize % MiB != 0) {
+    XLOGF(WARN, "FDP RU {} B is not a MiB multiple: keeping configured SR",
+          info.ruSize);
+    return;
+  }
+  const uint64_t ruMB = info.ruSize / MiB, req = bc.getRegionSize() / MiB;
+  uint64_t best = 0;
+  for (uint64_t r = 16; r <= 256; r++) {
+    if (ruMB % r == 0 &&
+        (best == 0 || (r > req ? r - req : req - r) <
+                          (best > req ? best - req : req - best))) {
+      best = r;
+    }
+  }
+  if (best == 0) {
+    XLOGF(WARN, "FDP RU {} MiB has no divisor in [16,256] MiB: keeping SR",
+          ruMB);
+    return;
+  }
+  XLOGF(INFO, "SuperRegion := FDP RU {} MiB ({} x {} MiB subRegions; was {} "
+        "x {} MiB)", ruMB, ruMB / best, best, ru.regionsPerSuperRegion,
+        req);
+  ru.regionsPerSuperRegion = static_cast<uint32_t>(ruMB / best);
+  bc.setRegionSize(static_cast<uint32_t>(best * MiB));
+  bc.setRuConfig(std::move(ru));
+}
